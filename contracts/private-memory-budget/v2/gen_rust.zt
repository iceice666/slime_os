refl ::= import stdlib.reflect;
n ::= import stdlib.num;
w ::= import wire.python;
r ::= import wire.rust;
c ::= import wire.codec;
Format :: type {
  formatVersion : Int; maxEntitlements : Int; maxSubjects : Int;
  fixedMode : Int; poolMode : Int;
  pageBytes : Int; maxValue : Int; maxPages : Int;
  headerFields : List refl.SchemaField;
  entitlementFields : List refl.SchemaField;
  subjectFields : List refl.SchemaField;
  headerLayout : List w.WireField;
  entitlementLayout : List w.WireField;
  subjectLayout : List w.WireField;
};
records :: Format -> List w.WireRecord = f => {
  { pythonName = "PRIVATE_MEMORY_POLICY_HEADER"; constPrefix = "PRIVATE_MEMORY_POLICY_HEADER"; size = c.wireBytes f.headerLayout; trailingPadding = 0; fields = f.headerFields; layout = f.headerLayout; };
  { pythonName = "PRIVATE_MEMORY_POLICY_ENTITLEMENT"; constPrefix = "PRIVATE_MEMORY_POLICY_ENTITLEMENT"; size = c.wireBytes f.entitlementLayout; trailingPadding = 0; fields = f.entitlementFields; layout = f.entitlementLayout; };
  { pythonName = "PRIVATE_MEMORY_POLICY_SUBJECT"; constPrefix = "PRIVATE_MEMORY_POLICY_SUBJECT"; size = c.wireBytes f.subjectLayout; trailingPadding = 0; fields = f.subjectFields; layout = f.subjectLayout; };
};
pythonBindings :: Format -> Text = f => w.join {
  "PRIVATE_MEMORY_POLICY_MAGIC = b\"SLIMEPM\\0\"\n";
  "PRIVATE_MEMORY_POLICY_VERSION = "; n.toText f.formatVersion; "\n";
  "PRIVATE_MEMORY_POLICY_HEADER_BYTES = "; n.toText (c.wireBytes f.headerLayout); "\n";
  "PRIVATE_MEMORY_POLICY_ENTITLEMENT_BYTES = "; n.toText (c.wireBytes f.entitlementLayout); "\n";
  "PRIVATE_MEMORY_POLICY_SUBJECT_BYTES = "; n.toText (c.wireBytes f.subjectLayout); "\n";
  "PRIVATE_MEMORY_POLICY_MAX_ENTITLEMENTS = "; n.toText f.maxEntitlements; "\n";
  "PRIVATE_MEMORY_POLICY_MAX_SUBJECTS = "; n.toText f.maxSubjects; "\n";
  "PRIVATE_MEMORY_POLICY_FIXED = "; n.toText f.fixedMode; "\n";
  "PRIVATE_MEMORY_POLICY_PAGE_BYTES = "; n.toText f.pageBytes; "\n";
  "PRIVATE_MEMORY_POLICY_MAX_VALUE = "; n.toText f.maxValue; "\n";
  "PRIVATE_MEMORY_POLICY_MAX_PAGES = "; n.toText f.maxPages; "\n";
  "PRIVATE_MEMORY_POLICY_POOL = "; n.toText f.poolMode; "\n";
  w.renderRecords (records f);
};
rustBindings :: Format -> Text = f => r.join {
  "// @generated by contracts/private-memory-budget/v2/gen_rust.zt; do not edit.\n";
  "pub const MAGIC: [u8; 8] = *b\"SLIMEPM\\0\";\n";
  r.u32Const "FORMAT_VERSION" f.formatVersion;
  r.usizeConst "HEADER_BYTES" (c.wireBytes f.headerLayout);
  r.usizeConst "ENTITLEMENT_BYTES" (c.wireBytes f.entitlementLayout);
  r.usizeConst "SUBJECT_BYTES" (c.wireBytes f.subjectLayout);
  r.usizeConst "MAX_ENTITLEMENTS" f.maxEntitlements;
  r.usizeConst "MAX_SUBJECTS" f.maxSubjects;
  r.u32Const "FIXED" f.fixedMode;
  r.u32Const "POOL" f.poolMode;
  r.u64Const "PAGE_BYTES" f.pageBytes;
  r.u64Const "MAX_VALUE" f.maxValue;
  r.u64Const "MAX_PAGES" f.maxPages;
  c.offsetConstsWithEnds "HEADER" 0 f.headerLayout;
  c.offsetConstsWithEnds "ENTITLEMENT" 0 f.entitlementLayout;
  c.offsetConstsWithEnds "SUBJECT" 0 f.subjectLayout;
  c.wireStruct "private-memory policy" "Header" "HEADER" "HEADER_BYTES" f.headerLayout;
  c.wireStruct "private-memory policy" "Entitlement" "ENTITLEMENT" "ENTITLEMENT_BYTES" f.entitlementLayout;
  c.wireStruct "private-memory policy" "Subject" "SUBJECT" "SUBJECT_BYTES" f.subjectLayout;
};
render :: Format -> { python : Text; rust : Text; } = f => if w.recordsValid (records f)
  then { python = pythonBindings f; rust = rustBindings f; }
  else { python = "INVALID_PRIVATE_MEMORY_POLICY_SCHEMA"; rust = "INVALID_PRIVATE_MEMORY_POLICY_SCHEMA"; };
{ render =; }
