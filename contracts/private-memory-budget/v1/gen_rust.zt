-- Schema-reflected Python + Rust renderer for private-memory-budget/v1.
-- Shared struct.Struct mechanics live in the `wire.python` package module;
-- shared Rust scalar-const mechanics live in `wire.rust`.

refl ::= import stdlib.reflect;
n ::= import stdlib.num;
w ::= import wire.python;
r ::= import wire.rust;

Format :: type {
  formatVersion : Int;
  headerBytes : Int;
  entryBytes : Int;
  maxHolders : Int;
  regionPages : Int;
  totalPages : Int;
  headerFields : List refl.SchemaField;
  entryFields : List refl.SchemaField;
  headerLayout : List w.WireField;
  entryLayout : List w.WireField;
};

records :: Format -> List w.WireRecord = format => {
  { pythonName = "PRIVATE_MEMORY_BUDGET_HEADER"; constPrefix = "PRIVATE_MEMORY_BUDGET"; size = format.headerBytes; trailingPadding = 0; fields = format.headerFields; layout = format.headerLayout; };
  { pythonName = "PRIVATE_MEMORY_BUDGET_ENTRY"; constPrefix = "PRIVATE_MEMORY_BUDGET_ENTRY"; size = format.entryBytes; trailingPadding = 0; fields = format.entryFields; layout = format.entryLayout; };
};

pythonBindings :: Format -> Text = format => w.join {
  "PRIVATE_MEMORY_BUDGET_MAGIC = b\"SLIMEPM\\0\"\n";
  "PRIVATE_MEMORY_BUDGET_VERSION = "; n.toText format.formatVersion; "\n";
  "PRIVATE_MEMORY_BUDGET_HEADER_BYTES = "; n.toText format.headerBytes; "\n";
  "PRIVATE_MEMORY_BUDGET_ENTRY_BYTES = "; n.toText format.entryBytes; "\n";
  "MAX_PRIVATE_MEMORY_BUDGET_HOLDERS = "; n.toText format.maxHolders; "\n";
  "PRIVATE_MEMORY_ROOT_REGION_PAGES = "; n.toText format.regionPages; "\n";
  "PRIVATE_MEMORY_ROOT_TOTAL_PAGES = "; n.toText format.totalPages; "\n";
  w.renderRecords (records format);
};

-- Schema-owned scalars shared with boot-contracts/src/private_memory_budget.rs.
-- The magic tag, derived MAX_BYTES, and decode machinery stay hand-written in
-- that module.
rustBindings :: Format -> Text = format => r.join {
  "// @generated by contracts/private-memory-budget/v1/gen_rust.zt; do not edit.\n";
  "// Source contract: contracts/private-memory-budget/v1/schema.zt\n\n";
  r.u32Const "FORMAT_VERSION" format.formatVersion;
  r.usizeConst "HEADER_BYTES" format.headerBytes;
  r.usizeConst "ENTRY_BYTES" format.entryBytes;
  r.usizeConst "MAX_HOLDERS" format.maxHolders;
  r.usizeConst "ROOT_REGION_PAGES" format.regionPages;
  r.usizeConst "ROOT_TOTAL_PAGES" format.totalPages;
};

render :: Format -> { python : Text; rust : Text; }
  = format => if w.recordsValid (records format)
    then { python = pythonBindings format; rust = rustBindings format; }
    else { python = "INVALID_PRIVATE_MEMORY_BUDGET_SCHEMA"; rust = "INVALID_PRIVATE_MEMORY_BUDGET_SCHEMA"; };
{ render =; }
