-- Pure renderer for the frame store: the Rust module the no_std reader validates with, and the Python
-- module the host converter writes with, carrying the same constants, refusal classes and layouts.

refl ::= import stdlib.reflect;
n ::= import stdlib.num;
l ::= import stdlib.list;
t ::= import stdlib.text;
w ::= import wire.rust;
c ::= import wire.codec;
py ::= import wire.python;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

Format :: type {
  formatVersion : Int;
  frameStoreMagic : Int;
  hashVersionRihs01 : Int;
  headerBytes : Int;
  indexEntryBytes : Int;
  typeHashBytes : Int;
  alignment : Int;
  maxFrames : Int;
  maxPayloadBytes : Int;
  maxStoreBytes : Int;
  maxTopicBytes : Int;
  maxTypeNameBytes : Int;
  maxSchemaBytes : Int;
  refusalClasses : List Text;
  headerFields : List refl.SchemaField;
  headerLayout : List WireField;
  indexEntryFields : List refl.SchemaField;
  indexEntryLayout : List WireField;
};

label :: Text = "frame-store";

-- `"a", "b"`: quoted and comma-separated, with no trailing separator.
quoted :: List Text -> Text
  = names => match names {
    | {;} => "";
    | { name; ...rest } => match rest {
      | {;} => w.join { "\""; name; "\""; };
      | { next; ...more } => w.join { "\""; name; "\", "; quoted rest; };
    };
  };

-- A refusal class is lowercase words joined by `-`. It holds no quote, backslash or space, so it needs no
-- escaping in either language.
classValid :: Text -> Bool
  = name => name != ""
    && t.toLower name == name
    && not (t.contains name "\"")
    && not (t.contains name "\\")
    && not (t.contains name " ");

rustBindings :: Format -> Text
  = format => w.join {
    "// @generated by contracts/frame-store/v1/gen_rust.zt; do not edit.\n";
    "// Source contract: contracts/frame-store/v1/schema.zt\n\n";
    "pub const FORMAT_VERSION: u16 = "; n.toText format.formatVersion; ";\n";
    "pub const FRAME_STORE_MAGIC: u32 = "; n.toText format.frameStoreMagic; ";\n";
    "pub const HASH_VERSION_RIHS01: u8 = "; n.toText format.hashVersionRihs01; ";\n";
    "pub const HEADER_BYTES: usize = "; n.toText format.headerBytes; ";\n";
    "pub const INDEX_ENTRY_BYTES: usize = "; n.toText format.indexEntryBytes; ";\n";
    "pub const TYPE_HASH_BYTES: usize = "; n.toText format.typeHashBytes; ";\n";
    "pub const ALIGNMENT: usize = "; n.toText format.alignment; ";\n";
    "pub const MAX_FRAMES: usize = "; n.toText format.maxFrames; ";\n";
    "pub const MAX_PAYLOAD_BYTES: usize = "; n.toText format.maxPayloadBytes; ";\n";
    "pub const MAX_STORE_BYTES: usize = "; n.toText format.maxStoreBytes; ";\n";
    "pub const MAX_TOPIC_BYTES: usize = "; n.toText format.maxTopicBytes; ";\n";
    "pub const MAX_TYPE_NAME_BYTES: usize = "; n.toText format.maxTypeNameBytes; ";\n";
    "pub const MAX_SCHEMA_BYTES: usize = "; n.toText format.maxSchemaBytes; ";\n\n";
    "/// The refusal classes, in the order of the first check that can produce each.\n";
    "pub const REFUSAL_CLASSES: [&str; "; n.toText (l.length format.refusalClasses); "] = [";
    quoted format.refusalClasses; "];\n\n";
    c.offsetConsts "HEADER" 0 format.headerLayout;
    "\n";
    c.offsetConsts "ENTRY" 0 format.indexEntryLayout;
    "\n";
    -- The field names are the schema's, which are camelCase; renaming them would change the contract.
    "#[allow(non_snake_case)]\n";
    c.wireStruct label "WireFrameStoreHeader" "HEADER" "HEADER_BYTES" format.headerLayout;
    "\n#[allow(non_snake_case)]\n";
    c.wireStruct label "WireFrameIndexEntry" "ENTRY" "INDEX_ENTRY_BYTES" format.indexEntryLayout;
  };

records :: Format -> List py.WireRecord
  = format => {
    {
      pythonName = "FRAME_STORE_HEADER";
      constPrefix = "FRAME_STORE_HEADER";
      size = format.headerBytes;
      trailingPadding = 0;
      fields = format.headerFields;
      layout = format.headerLayout;
    };
    {
      pythonName = "FRAME_INDEX_ENTRY";
      constPrefix = "FRAME_INDEX_ENTRY";
      size = format.indexEntryBytes;
      trailingPadding = 0;
      fields = format.indexEntryFields;
      layout = format.indexEntryLayout;
    };
  };

pythonBindings :: Format -> Text
  = format => py.join {
    "# @generated by contracts/frame-store/v1/gen_rust.zt; do not edit.\n";
    "# Source contract: contracts/frame-store/v1/schema.zt\n\n";
    "import struct\n\n";
    "FORMAT_VERSION = "; n.toText format.formatVersion; "\n";
    "FRAME_STORE_MAGIC = "; n.toText format.frameStoreMagic; "\n";
    "HASH_VERSION_RIHS01 = "; n.toText format.hashVersionRihs01; "\n";
    "HEADER_BYTES = "; n.toText format.headerBytes; "\n";
    "INDEX_ENTRY_BYTES = "; n.toText format.indexEntryBytes; "\n";
    "TYPE_HASH_BYTES = "; n.toText format.typeHashBytes; "\n";
    "ALIGNMENT = "; n.toText format.alignment; "\n";
    "MAX_FRAMES = "; n.toText format.maxFrames; "\n";
    "MAX_PAYLOAD_BYTES = "; n.toText format.maxPayloadBytes; "\n";
    "MAX_STORE_BYTES = "; n.toText format.maxStoreBytes; "\n";
    "MAX_TOPIC_BYTES = "; n.toText format.maxTopicBytes; "\n";
    "MAX_TYPE_NAME_BYTES = "; n.toText format.maxTypeNameBytes; "\n";
    "MAX_SCHEMA_BYTES = "; n.toText format.maxSchemaBytes; "\n\n";
    "REFUSAL_CLASSES = ("; quoted format.refusalClasses; ")\n\n";
    py.renderRecords (records format);
  };

valid :: Format -> Bool
  = format =>
    w.schemaFieldsValid format.headerFields
      && w.schemaNames format.headerFields == c.layoutNames format.headerLayout
      && w.schemaFieldsValid format.indexEntryFields
      && w.schemaNames format.indexEntryFields == c.layoutNames format.indexEntryLayout
      && c.allValid format.headerLayout
      && c.allValid format.indexEntryLayout
      && py.recordsValid (records format)
      && c.wireBytes format.headerLayout == format.headerBytes
      && c.wireBytes format.indexEntryLayout == format.indexEntryBytes
      && n.rem format.headerBytes format.alignment == 0
      && n.rem format.indexEntryBytes format.alignment == 0
      && format.typeHashBytes == 32
      && format.maxPayloadBytes <= format.maxStoreBytes
      && l.length format.refusalClasses > 0
      && l.all classValid format.refusalClasses;

render :: Format -> { rust : Text; python : Text; }
  = format => if valid format
    then { rust = rustBindings format; python = pythonBindings format; }
    else { rust = "INVALID_FRAME_STORE_SCHEMA"; python = "INVALID_FRAME_STORE_SCHEMA"; };

{ render =; }
