--| Observation records (observation/v1). Never committed to `main`.
--|
--| A machine record is what one `just` target observed under one closure
--| digest. Locally it is `target/observations/<target>.zt`; on the
--| `evidence` branch it is `<target>/<closureDigest>.zt`.
--|
--| A human record is one person's signed answer to one `h.human`
--| acceptance. On the `evidence` branch it is
--| `human/<requirement>/<acceptance>/<requirementsDigest>.zt` with the
--| `ssh-keygen -Y sign` signature in `.zt.sig` beside it.
--|
--| Each record file is `o ::= import "<this file>"; r :: o.Record = {...}; r`,
--| so Zutai type-checks it against this file and the reader keeps no
--| second copy of the shape.

--| One counted observation: `casesObserved = 12`.
Count :: type { key : Text; value : Int; };

--| One boolean observation other than `passed`: `tasksCheckPassed = true`.
Flag :: type { key : Text; value : Bool; };

--| Toolchain identity is metadata. It is not part of `closureDigest`:
--| bumping Zutai or rustc does not stale a record by itself, the toolchain
--| files inside the closure do.
Tool :: type { name : Text; version : Text; };

--| `closureDigest` is the digest `scripts/spec` computed for `target` at
--| the commit the record was taken from. `passed` is the recipe's exit
--| status; the checker cannot vouch for itself. `runner` names who ran it
--| (`ci`, or an operator principal for hardware targets).
Record :: type {
  schema : Text;
  target : Text;
  closureDigest : Text;
  passed : Bool;
  exitCode : Int;
  counts : List Count;
  flags : List Flag;
  observedAt : Text;
  runner : Text;
  toolchain : List Tool;
};

--| `requirementsDigest` binds the answer to the acceptance's wording:
--| rewording the question invalidates the signature, rewording a decision
--| or an invariant does not.
HumanRecord :: type {
  schema : Text;
  area : Text;
  requirement : Text;
  acceptance : Text;
  requirementsDigest : Text;
  value : Bool;
  note : Text;
  signer : Text;
  observedAt : Text;
};

schemaVersion :: Text = "observation/v1";

{ Count =; Flag =; Tool =; Record =; HumanRecord =; schemaVersion =; }
