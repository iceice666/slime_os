-- Slime OS LinkDevice control protocol, version 1 (IO3).
--
-- These records are the device-specific payloads carried by the IO0 queue
-- envelope. The envelope owns request identity, epochs, leases, directions,
-- lifecycle, and terminal status; this contract owns Ethernet frame bounds and
-- link semantics. Transmit and receive replenishment use separate bounded IO0
-- queues. A replenished receive buffer remains device-owned until completion,
-- and a transmit buffer remains retained through completion or cancellation.
--
-- Frames exclude the four-byte Ethernet FCS. The minimum is the shortest
-- untagged Ethernet frame without FCS; the maximum admits one 802.1Q tag.
-- Shorter or larger byte sequences are malformed rather than implicitly padded
-- or truncated. Counters are per direction and saturate at their wire maximum.

env ::= import stdlib.env;
fs ::= import stdlib.fs;
gen ::= import "gen_rust.zt";
t ::= import stdlib.text;

formatVersion :: Int = 1;
requestLen :: Int = 56;
replyLen :: Int = 24;
linkMagic :: Int = 1145785932;

minFrameBytes :: Int = 60;
maxFrameBytes :: Int = 1518;

-- TX and RX are distinct bounded queues. Their provisioning records choose a
-- power-of-two slot count in this inclusive range; IO0 enforces occupancy.
queueTx :: Int = 1;
queueRx :: Int = 2;
minQueueSlots :: Int = 2;
maxQueueSlots :: Int = 256;

opTransmit :: Int = 1;
opProvideReceive :: Int = 2;
opQueryLink :: Int = 3;
opStatistics :: Int = 4;
opReset :: Int = 5;
opClose :: Int = 6;

linkUnknown :: Int = 0;
linkDown :: Int = 1;
linkUp :: Int = 2;

-- No request flags are defined in version 1. IO0's fenced flag remains in the
-- queue envelope and is not duplicated here.
knownRequestFlags :: Int = 0;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

-- For transmit, frame_len is the exact number of bytes in the device-read IO0
-- slice. For receive provisioning it is the writable capacity and must admit a
-- maximum-size frame. Control operations carry zero. All unused bytes are
-- explicit reserved storage so every admissible encoding is canonical.
LinkRequest :: type {
  magic : Int;
  version : Int;
  op : Int;
  flags : Int;
  frame_len : Int;
  reserved : Int;
  padding : Int;
};

-- The completion echoes the operation because the payload is independently
-- decodable while debugging a queue. frame_len is the received/transmitted byte
-- count when applicable. Link state is always from the declared vocabulary.
-- Statistics reports saturating per-direction frame counters; other operations
-- leave both counters zero. detail is device-specific completion detail and is
-- meaningful only when the IO0 completion status is STATUS_DEVICE_ERROR.
LinkReply :: type {
  magic : Int;
  version : Int;
  op : Int;
  link_state : Int;
  frame_len : Int;
  reserved : Int;
  tx_frames : Int;
  rx_frames : Int;
  detail : Int;
};

requestSchema ::= schema LinkRequest;
replySchema ::= schema LinkReply;

requestLayout :: List WireField = {
  { name = "magic"; width = 4; signed = false; byteArray = false; };
  { name = "version"; width = 2; signed = false; byteArray = false; };
  { name = "op"; width = 1; signed = false; byteArray = false; };
  { name = "flags"; width = 1; signed = false; byteArray = false; };
  { name = "frame_len"; width = 2; signed = false; byteArray = false; };
  { name = "reserved"; width = 2; signed = false; byteArray = true; };
  { name = "padding"; width = 44; signed = false; byteArray = true; };
};

replyLayout :: List WireField = {
  { name = "magic"; width = 4; signed = false; byteArray = false; };
  { name = "version"; width = 2; signed = false; byteArray = false; };
  { name = "op"; width = 1; signed = false; byteArray = false; };
  { name = "link_state"; width = 1; signed = false; byteArray = false; };
  { name = "frame_len"; width = 2; signed = false; byteArray = false; };
  { name = "reserved"; width = 2; signed = false; byteArray = true; };
  { name = "tx_frames"; width = 4; signed = false; byteArray = false; };
  { name = "rx_frames"; width = 4; signed = false; byteArray = false; };
  { name = "detail"; width = 4; signed = false; byteArray = false; };
};

protocol ::= {
  formatVersion =;
  requestLen =;
  replyLen =;
  linkMagic =;
  minFrameBytes =;
  maxFrameBytes =;
  queueTx =;
  queueRx =;
  minQueueSlots =;
  maxQueueSlots =;
  opTransmit =;
  opProvideReceive =;
  opQueryLink =;
  opStatistics =;
  opReset =;
  opClose =;
  linkUnknown =;
  linkDown =;
  linkUp =;
  knownRequestFlags =;
  requestFields = requestSchema.fields ?? {;};
  replyFields = replySchema.fields ?? {;};
  requestLayout =;
  replyLayout =;
};

main :: { write : FsWrite; env : Env; } -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_LINK_DEVICE_BINDINGS_ROOT" ?? ".";
    bindings := gen.render protocol;
    path := t.join "" { root; "/components/proto/src/link_device.rs"; };
    fs.writeAll caps.write path bindings.rust
  ];

main
