-- Pure renderer for Slime OS LinkDevice bindings (IO3).
-- Reflect both payload records, prove declaration order and exact IO0 payload
-- widths, then emit packed little-endian Rust codecs and field offsets.

refl ::= import stdlib.reflect;
n ::= import stdlib.num;
t ::= import stdlib.text;
l ::= import stdlib.list;
w ::= import wire.rust;
c ::= import wire.codec;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

Protocol :: type {
  formatVersion : Int;
  requestLen : Int;
  replyLen : Int;
  linkMagic : Int;
  minFrameBytes : Int;
  maxFrameBytes : Int;
  queueTx : Int;
  queueRx : Int;
  minQueueSlots : Int;
  maxQueueSlots : Int;
  opTransmit : Int;
  opProvideReceive : Int;
  opQueryLink : Int;
  opStatistics : Int;
  opReset : Int;
  opClose : Int;
  linkUnknown : Int;
  linkDown : Int;
  linkUp : Int;
  knownRequestFlags : Int;
  requestFields : List refl.SchemaField;
  replyFields : List refl.SchemaField;
  requestLayout : List WireField;
  replyLayout : List WireField;
};

-- Offset and codec emitters come from `wire.codec`, which owns the
-- byte-array-aware mechanics fourteen renderers previously each copied. The
-- validity predicate below stays here: what makes *this* layout admissible is
-- contract-specific.
layoutNames :: List WireField -> List Text = c.layoutNames;
allValid :: List WireField -> Bool = c.allValid;
wireBytes :: List WireField -> Int = c.wireBytes;
offsetConsts :: Text -> Int -> List WireField -> Text = c.offsetConsts;
wireStruct :: Text -> Text -> Text -> List WireField -> Text
  = name prefix lengthName fields => c.wireStruct "link-device" name prefix lengthName fields;


rustBindings :: Protocol -> Text
  = protocol => w.join {
    "// @generated by contracts/link-device/v1/gen_rust.zt; do not edit.\n";
    "// Source contract: contracts/link-device/v1/schema.zt\n\n";
    "pub const FORMAT_VERSION: u16 = "; n.toText protocol.formatVersion; ";\n";
    "pub const REQUEST_LEN: usize = "; n.toText protocol.requestLen; ";\n";
    "pub const REPLY_LEN: usize = "; n.toText protocol.replyLen; ";\n";
    "pub const LINK_MAGIC: u32 = "; n.toText protocol.linkMagic; ";\n";
    "pub const MIN_FRAME_BYTES: usize = "; n.toText protocol.minFrameBytes; ";\n";
    "pub const MAX_FRAME_BYTES: usize = "; n.toText protocol.maxFrameBytes; ";\n";
    "pub const QUEUE_TX: u32 = "; n.toText protocol.queueTx; ";\n";
    "pub const QUEUE_RX: u32 = "; n.toText protocol.queueRx; ";\n";
    "pub const MIN_QUEUE_SLOTS: usize = "; n.toText protocol.minQueueSlots; ";\n";
    "pub const MAX_QUEUE_SLOTS: usize = "; n.toText protocol.maxQueueSlots; ";\n";
    "pub const OP_TRANSMIT: u8 = "; n.toText protocol.opTransmit; ";\n";
    "pub const OP_PROVIDE_RECEIVE: u8 = "; n.toText protocol.opProvideReceive; ";\n";
    "pub const OP_QUERY_LINK: u8 = "; n.toText protocol.opQueryLink; ";\n";
    "pub const OP_STATISTICS: u8 = "; n.toText protocol.opStatistics; ";\n";
    "pub const OP_RESET: u8 = "; n.toText protocol.opReset; ";\n";
    "pub const OP_CLOSE: u8 = "; n.toText protocol.opClose; ";\n";
    "pub const LINK_UNKNOWN: u8 = "; n.toText protocol.linkUnknown; ";\n";
    "pub const LINK_DOWN: u8 = "; n.toText protocol.linkDown; ";\n";
    "pub const LINK_UP: u8 = "; n.toText protocol.linkUp; ";\n";
    "pub const KNOWN_REQUEST_FLAGS: u8 = "; n.toText protocol.knownRequestFlags; ";\n\n";
    offsetConsts "REQUEST" 0 protocol.requestLayout;
    "\n";
    wireStruct "WireLinkRequest" "REQUEST" "REQUEST_LEN" protocol.requestLayout;
    "\n";
    offsetConsts "REPLY" 0 protocol.replyLayout;
    "\n";
    wireStruct "WireLinkReply" "REPLY" "REPLY_LEN" protocol.replyLayout;
  };

valid :: Protocol -> Bool
  = protocol =>
    w.schemaFieldsValid protocol.requestFields
      && w.schemaFieldsValid protocol.replyFields
      && w.schemaNames protocol.requestFields == layoutNames protocol.requestLayout
      && w.schemaNames protocol.replyFields == layoutNames protocol.replyLayout
      && allValid protocol.requestLayout
      && allValid protocol.replyLayout
      && wireBytes protocol.requestLayout == protocol.requestLen
      && wireBytes protocol.replyLayout == protocol.replyLen
      && protocol.requestLen == 56
      && protocol.replyLen == 24
      && protocol.minFrameBytes > 0
      && protocol.minFrameBytes <= protocol.maxFrameBytes
      && protocol.minQueueSlots >= 2
      && protocol.maxQueueSlots >= protocol.minQueueSlots;

render :: Protocol -> { rust : Text; }
  = protocol => if valid protocol
    then { rust = rustBindings protocol; }
    else { rust = "INVALID_LINK_DEVICE_SCHEMA"; };

{ render =; }
