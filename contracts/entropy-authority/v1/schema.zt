-- Slime OS entropy authority table, version 1.
--
-- One entry per holder the generation lets draw from the userspace entropy
-- service: its name, whether its stream is seeded from the hardware source or
-- from a declared seed, and the total bytes it may draw. A hardware row's seed
-- is all zero; a seeded row's stream is a pure function of its seed and name.
-- The table is read only by the generation's declared entropy service.

env ::= import stdlib.env;
fs ::= import stdlib.fs;
gen ::= import "gen_rust.zt";
t ::= import stdlib.text;

formatVersion :: Int = 1;
headerBytes :: Int = 32;
entryBytes :: Int = 104;
maxHolders :: Int = 16;
holderNameBytes :: Int = 32;
seedBytes :: Int = 32;
sourceHardware :: Int = 1;
sourceSeeded :: Int = 2;
-- An inclusive per-holder bound: a budget is a positive count of bytes no
-- larger than one MiB.
maxByteBudget :: Int = 1048576;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

EntropyHeader :: type {
  magic : Int;
  format_version : Int;
  header_size : Int;
  required_flags : Int;
  holder_count : Int;
  total_len : Int;
};

EntropyEntry :: type {
  holder_identity : Int;
  holder_name : Int;
  holder_name_len : Int;
  source : Int;
  reserved : Int;
  byte_budget : Int;
  seed : Int;
};

headerSchema ::= schema EntropyHeader;
entrySchema ::= schema EntropyEntry;
headerLayout :: List WireField = {
  { name = "magic"; width = 8; signed = false; byteArray = true; };
  { name = "format_version"; width = 4; signed = false; byteArray = false; };
  { name = "header_size"; width = 4; signed = false; byteArray = false; };
  { name = "required_flags"; width = 8; signed = false; byteArray = false; };
  { name = "holder_count"; width = 4; signed = false; byteArray = false; };
  { name = "total_len"; width = 4; signed = false; byteArray = false; };
};
entryLayout :: List WireField = {
  { name = "holder_identity"; width = 32; signed = false; byteArray = true; };
  { name = "holder_name"; width = 32; signed = false; byteArray = true; };
  { name = "holder_name_len"; width = 1; signed = false; byteArray = false; };
  { name = "source"; width = 1; signed = false; byteArray = false; };
  { name = "reserved"; width = 2; signed = false; byteArray = true; };
  { name = "byte_budget"; width = 4; signed = false; byteArray = false; };
  { name = "seed"; width = 32; signed = false; byteArray = true; };
};

format ::= {
  formatVersion =; headerBytes =; entryBytes =; maxHolders =;
  holderNameBytes =; seedBytes =; sourceHardware =; sourceSeeded =; maxByteBudget =;
  headerFields = headerSchema.fields ?? {;}; entryFields = entrySchema.fields ?? {;};
  headerLayout =; entryLayout =;
};

main :: { write : FsWrite; env : Env; } -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_BOOT_BINDINGS_ROOT" ?? ".";
    bindings := gen.render format;
    fs.writeAll caps.write (t.join "" { root; "/entropy_authority.py"; }) bindings.python;
    fs.writeAll caps.write (t.join "" { root; "/entropy_authority.rs"; }) bindings.rust
  ];

main
