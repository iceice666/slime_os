-- Schema-reflected Python + Rust renderer for entropy-authority/v1.
refl ::= import stdlib.reflect;
n ::= import stdlib.num;
w ::= import wire.python;
r ::= import wire.rust;
c ::= import wire.codec;

Format :: type {
  formatVersion : Int; headerBytes : Int; entryBytes : Int; maxHolders : Int;
  holderNameBytes : Int; seedBytes : Int; sourceHardware : Int; sourceSeeded : Int; maxByteBudget : Int;
  headerFields : List refl.SchemaField; entryFields : List refl.SchemaField;
  headerLayout : List w.WireField; entryLayout : List w.WireField;
};
records :: Format -> List w.WireRecord = f => {
  { pythonName = "ENTROPY_AUTHORITY_HEADER"; constPrefix = "ENTROPY_AUTHORITY"; size = f.headerBytes; trailingPadding = 0; fields = f.headerFields; layout = f.headerLayout; };
  { pythonName = "ENTROPY_AUTHORITY_ENTRY"; constPrefix = "ENTROPY_AUTHORITY_ENTRY"; size = f.entryBytes; trailingPadding = 0; fields = f.entryFields; layout = f.entryLayout; };
};
pythonBindings :: Format -> Text = f => w.join {
  "ENTROPY_AUTHORITY_MAGIC = b\"SLIMEEA\\0\"\n";
  "ENTROPY_AUTHORITY_VERSION = "; n.toText f.formatVersion; "\n";
  "ENTROPY_AUTHORITY_HEADER_BYTES = "; n.toText f.headerBytes; "\nENTROPY_AUTHORITY_ENTRY_BYTES = "; n.toText f.entryBytes; "\n";
  "MAX_ENTROPY_AUTHORITY_HOLDERS = "; n.toText f.maxHolders; "\n";
  "ENTROPY_AUTHORITY_HOLDER_NAME_BYTES = "; n.toText f.holderNameBytes; "\nENTROPY_AUTHORITY_SEED_BYTES = "; n.toText f.seedBytes; "\n";
  "ENTROPY_AUTHORITY_SOURCE_HARDWARE = "; n.toText f.sourceHardware; "\nENTROPY_AUTHORITY_SOURCE_SEEDED = "; n.toText f.sourceSeeded; "\n";
  "ENTROPY_AUTHORITY_MAX_BYTE_BUDGET = "; n.toText f.maxByteBudget; "\n";
  w.renderRecords (records f);
};

-- Every byte-array field is read as a range, so each offset has its `_END`
-- companion, as `network-interface/v1`'s do.
wireBytes :: List w.WireField -> Int = c.wireBytes;
offsetConsts :: Text -> Int -> List w.WireField -> Text = c.offsetConstsWithEnds;
rustBindings :: Format -> Text = f => r.join {
  "// @generated by contracts/entropy-authority/v1/gen_rust.zt; do not edit.\n// Source contract: contracts/entropy-authority/v1/schema.zt\n\n";
  r.u32Const "FORMAT_VERSION" f.formatVersion; r.usizeConst "HEADER_BYTES" f.headerBytes; r.usizeConst "ENTRY_BYTES" f.entryBytes;
  r.usizeConst "MAX_HOLDERS" f.maxHolders; r.usizeConst "HOLDER_NAME_BYTES" f.holderNameBytes; r.usizeConst "SEED_BYTES" f.seedBytes;
  r.join { "pub const SOURCE_HARDWARE: u8 = "; n.toText f.sourceHardware; ";\npub const SOURCE_SEEDED: u8 = "; n.toText f.sourceSeeded; ";\n"; };
  r.u32Const "MAX_BYTE_BUDGET" f.maxByteBudget;
  "\n"; offsetConsts "HEADER" 0 f.headerLayout;
  "\n"; offsetConsts "ENTRY" 0 f.entryLayout;
};
render :: Format -> { python : Text; rust : Text; } = f => if w.recordsValid (records f)
  && wireBytes f.headerLayout == f.headerBytes
  && wireBytes f.entryLayout == f.entryBytes
  && f.holderNameBytes == 32 && f.seedBytes == 32
  && f.sourceHardware > 0 && f.sourceSeeded > f.sourceHardware && f.sourceSeeded < 256
  && f.maxByteBudget > 0 && f.maxHolders > 0
  then { python = pythonBindings f; rust = rustBindings f; }
  else { python = "INVALID_ENTROPY_AUTHORITY_SCHEMA"; rust = "INVALID_ENTROPY_AUTHORITY_SCHEMA"; };
{ render =; }
