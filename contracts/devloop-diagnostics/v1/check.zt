s ::= import "schema.zt";
env ::= import stdlib.env;
load ::= import stdlib.load;

main :: { env : Env; load : Load; }
  -> Validation DecodeIssue s.DiagnosticReceipt
  ! { * env.GetEffects; * load.ZtiEffects; }
  = caps => [
    path := env.get caps.env "SLIME_DIAGNOSTIC_RECEIPT" ?? "";
    s.decodeReceipt (load.zti caps.load path)
  ];
main
