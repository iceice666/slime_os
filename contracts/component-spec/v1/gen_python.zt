-- Generated host constants for the CP0 component-spec validator.
--
-- `scripts/check/check-component-spec.py` consumes these rather than restating
-- the bounds and vocabularies `schema.zt` declares. The gate is then unable to
-- admit a value the contract does not name, which is the property B60 and B70
-- both turn on: a checker with its own copy of a vocabulary is a second
-- authority on it.

schema ::= import "schema.zt";
env ::= import stdlib.env;
fs ::= import stdlib.fs;
n ::= import stdlib.num;
t ::= import stdlib.text;

line :: Text -> Int -> Text
  = name value => t.join "" { name; " = "; n.toText value; "\n"; };

text :: Text -> Text -> Text
  = name value => t.join "" { name; " = "; t.show value; "\n"; };

textTuple :: List Text -> Text
  = values => match values {
    | {;} => "";
    | { entry; ...rest } => t.join "" { t.show entry; ", "; textTuple rest; };
  };

tuple :: Text -> List Text -> Text
  = name values => t.join "" { name; " = ("; textTuple values; ")\n"; };

render :: Text = t.join "" {
  "# @generated by contracts/component-spec/v1/gen_python.zt; do not edit.\n";
  line "FORMAT_VERSION" schema.formatVersion;
  "IDENTITY_DOMAIN = "; t.show schema.identityDomain; ".encode(\"utf-8\")\n";
  line "MAX_SPECS" schema.maxSpecs;
  line "MAX_SOURCE_BYTES" schema.maxSourceBytes;
  line "MAX_NORMALIZED_BYTES" schema.maxNormalizedBytes;
  line "MAX_NAME_BYTES" schema.maxNameBytes;
  line "MAX_PURPOSE_BYTES" schema.maxPurposeBytes;
  line "MAX_TEXT_BYTES" schema.maxTextBytes;
  line "MAX_CAPABILITY_KINDS" schema.maxCapabilityKinds;
  line "MAX_INTERFACES" schema.maxInterfaces;
  line "MAX_QOS_POLICIES" schema.maxQosPolicies;
  line "MAX_DEPENDENCIES" schema.maxDependencies;
  line "MAX_PARAMETERS" schema.maxParameters;
  line "MAX_LIFECYCLE_STATES" schema.maxLifecycleStates;
  line "MAX_DEVICE_REQUIREMENTS" schema.maxDeviceRequirements;
  tuple "COMPONENT_TYPES" {
    schema.componentTypeInit;
    schema.componentTypeService;
    schema.componentTypeApplication;
  };
  text "COMPONENT_TYPE_INIT" schema.componentTypeInit;
  text "COMPONENT_TYPE_SERVICE" schema.componentTypeService;
  text "COMPONENT_TYPE_APPLICATION" schema.componentTypeApplication;
  tuple "INTERFACE_TAGS" {
    schema.interfaceTagInput;
    schema.interfaceTagOutput;
    schema.interfaceTagCommand;
    schema.interfaceTagEvent;
  };
  text "INTERFACE_TAG_INPUT" schema.interfaceTagInput;
  text "INTERFACE_TAG_OUTPUT" schema.interfaceTagOutput;
  text "INTERFACE_TAG_COMMAND" schema.interfaceTagCommand;
  text "INTERFACE_TAG_EVENT" schema.interfaceTagEvent;
  tuple "PROVIDERS" {
    schema.providerWorkspace;
    schema.providerExternal;
    schema.providerUndeclared;
  };
  text "PROVIDER_WORKSPACE" schema.providerWorkspace;
  text "PROVIDER_EXTERNAL" schema.providerExternal;
  text "PROVIDER_UNDECLARED" schema.providerUndeclared;
  tuple "SEMANTICS" {
    schema.semanticNone;
    schema.semanticStream;
    schema.semanticCall;
    schema.semanticOperation;
    schema.semanticMixed;
  };
  text "SEMANTIC_NONE" schema.semanticNone;
  text "SEMANTIC_STREAM" schema.semanticStream;
  text "SEMANTIC_CALL" schema.semanticCall;
  text "SEMANTIC_OPERATION" schema.semanticOperation;
  text "SEMANTIC_MIXED" schema.semanticMixed;
  -- Canonical order, not a set: a spec's declared states are validated as an
  -- ordered subsequence of this, so a lifecycle listing Stop before Start is a
  -- rejection rather than a set-equal pass.
  tuple "LIFECYCLE_STATES" {
    schema.lifecycleInitialize;
    schema.lifecycleConfigure;
    schema.lifecycleStart;
    schema.lifecycleReady;
    schema.lifecycleRunning;
    schema.lifecycleDegraded;
    schema.lifecycleStop;
    schema.lifecycleError;
  };
  tuple "LIFECYCLE_REQUIRED" schema.lifecycleRequired;
  text "LIFECYCLE_CONFIGURE" schema.lifecycleConfigure;
  text "LIFECYCLE_READY" schema.lifecycleReady;
  text "LIFECYCLE_DEGRADED" schema.lifecycleDegraded;
  text "LIFECYCLE_STOP" schema.lifecycleStop;
  tuple "CONSTRAINTS" {
    schema.constraintExact;
    schema.constraintAtMost;
    schema.constraintCompatible;
    schema.constraintNone;
  };
  text "CONSTRAINT_EXACT" schema.constraintExact;
  text "CONSTRAINT_AT_MOST" schema.constraintAtMost;
  text "CONSTRAINT_COMPATIBLE" schema.constraintCompatible;
  text "CONSTRAINT_NONE" schema.constraintNone;
  tuple "HEALTH_POLICIES" { schema.healthRequired; schema.healthOptional; };
  text "HEALTH_REQUIRED" schema.healthRequired;
  text "HEALTH_OPTIONAL" schema.healthOptional;
};

main :: { write : FsWrite; env : Env; }
  -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_COMPONENT_SPEC_BINDINGS_ROOT" ?? ".";
    path := t.join "" { root; "/component_spec_contract.py"; };
    fs.writeAll caps.write path render
  ];

main
