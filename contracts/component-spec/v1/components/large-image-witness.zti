{
  formatVersion = 1;
  name = "large-image-witness";
  componentType = "application";
  version = "1.0.0";
  owner = "root";
  purpose = "Remains resident while the large image is reclaimed.";
  implementation = {
    provider = "workspace";
    binary = "large-image-witness";
    contentHash = "";
  };
  provides = [];
  requires = [];
  interfaces = [];
  dependencies = [];
  communication = {
    semantic = "none";
    qos = [];
  };
  configuration = [];
  lifecycle = [
    "Initialize";
    "Start";
    "Running";
    "Error";
  ];
  runtime = {
    executionEnvironment = "aarch64-sel4-qemu-virt";
    resource = {
      stackBytes = 16384;
      spawnBudget = 0;
      extraThreads = 0;
      bufferBytePages = 0;
      bufferCount = 0;
      mappingCount = 0;
      loanCount = 0;
      privatePageQuota = 0;
    };
    devices = [];
  };
  health = "optional";
  lifetime = "bounded";
  compatibility = {
