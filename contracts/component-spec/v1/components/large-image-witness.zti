    interface = "contracts/interface-schema/v1";
    dependency = "none";
    resource = "atMost";
    runtime = "exact";
    qos = "none";
  };
  test = {
    testCondition = "the sel4_large_image_check gate boots this component";
    expectedResult = "four large-image incarnations verify and reclaim with unchanged witness accounting";
    passFailCriteria = "seL4 large-image check: a component image past every former bound was admitted, verified ";
    requiredTestEnvironment = "sel4_large_image_check";
  };
}
