{
  formatVersion = 1;
  name = "fabric-probe";
  componentType = "application";
  version = "1.0.0";
  owner = "root";
  purpose = "Holds a real control endpoint but no participant entry, proving exact route credentials are still denied.";
  implementation = {
    provider = "workspace";
    binary = "fabric-probe";
    contentHash = "";
  };
  provides = [
    "endpoint";
  ];
  requires = [];
  interfaces = [];
  dependencies = [
    "fabric-service";
  ];
  communication = {
    semantic = "none";
    qos = [];
  };
  configuration = [];
  lifecycle = [
    "Initialize";
    "Start";
    "Running";
    "Error";
  ];
  runtime = {
    executionEnvironment = "x86_64-qemu-virtio";
    resource = {
      stackBytes = 16384;
      spawnBudget = 0;
      extraThreads = 0;
      bufferBytePages = 0;
      bufferCount = 0;
      mappingCount = 0;
      loanCount = 0;
      privatePageQuota = 0;
    };
    devices = [];
  };
  health = "optional";
  compatibility = {
    platform = "x86_64-qemu-virtio";
    interface = "contracts/interface-schema/v1";
    dependency = "exact";
    resource = "atMost";
    runtime = "exact";
    qos = "none";
  };
  test = {
    testCondition = "the sel4_boot_check gate boots a generation declaring fabric-probe";
    expectedResult = "fabric-probe reaches its declared behavior under that gate";
    passFailCriteria = "[fabric-probe] undeclared edge denied";
    requiredTestEnvironment = "sel4_boot_check";
  };
}
