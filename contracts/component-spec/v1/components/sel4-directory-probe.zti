{
  formatVersion = 1;
  name = "sel4-directory-probe";
  componentType = "application";
  version = "1.0.0";
  owner = "init";
  purpose = "Resolves, writes, and commits through a granted directory view, then derives a narrowed subdirectory capability and reads through the scoped view.";
  implementation = {
    provider = "workspace";
    binary = "sel4-directory-probe";
    contentHash = "";
  };
  provides = [
    "directory";
    "endpoint";
  ];
  requires = [
    "directory";
    "endpoint";
  ];
  interfaces = [];
  dependencies = [];
  communication = {
    semantic = "none";
    qos = [];
  };
  configuration = [];
  lifecycle = [
    "Initialize";
    "Start";
    "Running";
    "Error";
  ];
  runtime = {
    executionEnvironment = "aarch64-sel4-qemu-virt";
    resource = {
      stackBytes = 16384;
      spawnBudget = 0;
      extraThreads = 0;
      bufferBytePages = 0;
      bufferCount = 0;
      mappingCount = 0;
      loanCount = 0;
      privatePageQuota = 0;
    };
    devices = [];
  };
  health = "optional";
  compatibility = {
    platform = "aarch64-sel4-qemu-virt";
    interface = "contracts/interface-schema/v1";
    dependency = "none";
    resource = "atMost";
    runtime = "exact";
    qos = "none";
  };
  test = {
    testCondition = "the sel4_directory_check gate boots a generation declaring sel4-directory-probe";
    expectedResult = "a root transition commits, an interrupted transition preserves the previous root, and a derived view stays narrowed";
    passFailCriteria = "[init] directory plane complete";
    requiredTestEnvironment = "sel4_directory_check";
  };
}
