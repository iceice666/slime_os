{
  formatVersion = 1;
  name = "io-network-lifetime-probe";
  componentType = "application";
  version = "1.0.0";
  owner = "root";
  purpose = "Exercises real client VM-fault cleanup and supervised fresh local-network incarnations with independently checked bytes.";
  implementation = { provider = "workspace"; binary = "io-network-lifetime-probe"; contentHash = ""; };
  provides = [];
  requires = [ "endpoint"; ];
  interfaces = [];
  dependencies = [ "network-service"; ];
  communication = { semantic = "none"; qos = []; };
  configuration = [];
  lifecycle = [ "Initialize"; "Start"; "Running"; "Error"; ];
  runtime = {
    executionEnvironment = "aarch64-sel4-qemu-virt";
    resource = {
      stackBytes = 16384;
      spawnBudget = 0;
      extraThreads = 0;
      bufferBytePages = 0;
      bufferCount = 0;
      mappingCount = 0;
      loanCount = 0;
      privatePageQuota = 0;
    };
    devices = [];
  };
  health = "required";
  lifetime = "bounded";
  compatibility = {
    platform = "aarch64-sel4-qemu-virt";
    interface = "contracts/interface-schema/v1";
    dependency = "exact";
    resource = "atMost";
    runtime = "exact";
    qos = "none";
  };
  test = {
    testCondition = "io_network_lifetime_check runs two supervised local-network incarnations";
    expectedResult = "A client VM fault produces real peer reset and reclamation; restarted clients and service complete a fresh byte exchange and graceful close.";
    passFailCriteria = "[io-network-lifetime-probe] rounds=2 reclaimed=1 restarted=1";
    requiredTestEnvironment = "io_network_lifetime_check";
  };
}
