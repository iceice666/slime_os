{
  formatVersion = 1;
  name = "mavlink-heartbeat";
  componentType = "application";
  version = "1.0.0";
  owner = "init";
  purpose = "One MAVLink v2 HEARTBEAT per second on a fixed monotonic-clock grid, sent over serial-device v1; reports each refusal and keeps its cadence.";
  implementation = {
    provider = "workspace";
    binary = "mavlink-heartbeat";
    contentHash = "";
  };
  provides = [
    "endpoint";
  ];
  requires = [];
  interfaces = [];
  dependencies = [];
  communication = {
    semantic = "none";
    qos = [];
  };
  configuration = [];
  lifecycle = [
    "Initialize";
    "Start";
    "Running";
    "Error";
  ];
  runtime = {
    executionEnvironment = "aarch64-sel4-qemu-virt";
    resource = {
      stackBytes = 16384;
      spawnBudget = 0;
      extraThreads = 0;
      bufferBytePages = 0;
      bufferCount = 0;
      mappingCount = 0;
      loanCount = 0;
      privatePageQuota = 0;
    };
    devices = [];
  };
  health = "required";
  compatibility = {
    platform = "aarch64-sel4-qemu-virt";
    interface = "contracts/mavlink-heartbeat/v1";
    dependency = "none";
    resource = "atMost";
    runtime = "exact";
    qos = "none";
  };
  test = {
    testCondition = "sel4_mavlink_graph_check boots generation 56 under QEMU, where the serial driver binds no device";
    expectedResult = "the producer sends a heartbeat on each one-second deadline, reports each refusal as no-device, and the graph stays healthy";
    passFailCriteria = "[mavlink-heartbeat] send seq=0 status=no-device";
    requiredTestEnvironment = "sel4_mavlink_graph_check";
  };
}
