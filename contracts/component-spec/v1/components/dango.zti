{
  formatVersion = 1;
  name = "dango";
  componentType = "application";
  version = "1.0.0";
  owner = "root";
  purpose = "Retired Dango shell identity retained only for the frozen CP1 reference baseline.";
  implementation = {
    provider = "undeclared";
    binary = "";
    contentHash = "";
  };
  provides = [
    "endpoint";
  ];
  requires = [
    "directory";
    "endpoint";
    "input";
    "sharedBufferFactory";
  ];
  interfaces = [];
  dependencies = [
    "console";
  ];
  communication = {
    semantic = "none";
    qos = [];
  };
  configuration = [
    {
      name = "spawnBudget";
      default = 8;
      minimum = 0;
      maximum = 32;
    };
  ];
  lifecycle = [
    "Initialize";
    "Configure";
    "Start";
    "Running";
    "Error";
  ];
  runtime = {
    executionEnvironment = "x86_64-qemu-virtio";
    resource = {
      stackBytes = 16384;
      spawnBudget = 8;
      extraThreads = 0;
      bufferBytePages = 8;
      bufferCount = 2;
      mappingCount = 4;
      loanCount = 2;
      privatePageQuota = 0;
    };
    devices = [
      "input";
    ];
  };
  health = "required";
  compatibility = {
    platform = "x86_64-qemu-virtio";
    interface = "contracts/interface-schema/v1";
    dependency = "exact";
    resource = "atMost";
    runtime = "exact";
    qos = "none";
  };
  test = {
    testCondition = "the component_spec_check gate validates the retired Dango reference contract";
    expectedResult = "Dango remains structurally declared but has no implementation provider";
    passFailCriteria = "declared-without-implementation set";
    requiredTestEnvironment = "component_spec_check";
  };
}
