{
  formatVersion = 1;
  name = "fabric-intruder";
  componentType = "application";
  version = "1.0.0";
  owner = "root";
  purpose = "Holds a real control endpoint but no declared edge, proving route credentials alone cannot mint access.";
  implementation = {
    provider = "workspace";
    binary = "fabric-intruder";
    contentHash = "";
  };
  provides = [
    "endpoint";
  ];
  requires = [];
  interfaces = [
    {
      name = "telemetry";
      tag = "input";
      interface = "TelemetryStream";
    };
    {
      name = "telemetry";
      tag = "output";
      interface = "TelemetryStream";
    };
  ];
  dependencies = [
    "fabric-service";
  ];
  communication = {
    semantic = "stream";
    qos = [];
  };
  configuration = [];
  lifecycle = [
    "Initialize";
    "Start";
    "Running";
    "Error";
  ];
  runtime = {
    executionEnvironment = "x86_64-qemu-virtio";
    resource = {
      stackBytes = 16384;
      spawnBudget = 0;
      extraThreads = 0;
      bufferBytePages = 0;
      bufferCount = 0;
      mappingCount = 0;
      loanCount = 0;
    };
    devices = [];
  };
  health = "optional";
  compatibility = {
    platform = "x86_64-qemu-virtio";
    interface = "contracts/interface-schema/v1";
    dependency = "exact";
    resource = "atMost";
    runtime = "exact";
    qos = "none";
  };
  test = {
    testCondition = "the sel4_stream_check gate boots a generation declaring fabric-intruder";
    expectedResult = "fabric-intruder reaches its declared behavior under that gate";
    passFailCriteria = "[fabric-intruder] undeclared edge denied";
    requiredTestEnvironment = "sel4_stream_check";
  };
}
