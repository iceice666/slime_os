{
  formatVersion = 1;
  name = "io-tcp-probe";
  componentType = "application";
  version = "1.0.0";
  owner = "root";
  purpose = "Exchanges and compares 4096 TCP stream bytes through network-service IO0 payloads, checks exact-destination refusals, and closes its connection and loans.";
  implementation =  {
    provider = "workspace";
    binary = "io-tcp-probe";
    contentHash = "";
  };
  provides = [
  ];
  requires = [
    "endpoint";
  ];
  interfaces = [
  ];
  dependencies = [
    "network-service";
  ];
  communication =  {
    semantic = "none";
    qos = [
    ];
  };
  configuration = [
  ];
  lifecycle = [
    "Initialize";
    "Start";
    "Running";
    "Error";
  ];
  runtime =  {
    executionEnvironment = "aarch64-sel4-qemu-virt";
    resource = {
      stackBytes = 16384;
      spawnBudget = 0;
      extraThreads = 0;
      bufferBytePages = 0;
      bufferCount = 0;
      mappingCount = 0;
      loanCount = 0;
      privatePageQuota = 0;
    };
    devices = [
    ];
  };
  health = "required";
  lifetime = "bounded";
  compatibility =  {
    platform = "aarch64-sel4-qemu-virt";
    interface = "contracts/interface-schema/v1";
    dependency = "exact";
    resource = "atMost";
    runtime = "exact";
    qos = "none";
  };
  test =  {
    testCondition = "io_tcp_check boots sel4-io-tcp";
    expectedResult = "a real TCP handshake and 4096 byte-identical echoed bytes with partial I/O, peer refusal and undeclared destination denial, retained ARP/ICMP, and connection and buffer cleanup";
    passFailCriteria = "[io-tcp-probe] closed capabilities=1 shutdown=1";
    requiredTestEnvironment = "io_tcp_check";
  };
}
