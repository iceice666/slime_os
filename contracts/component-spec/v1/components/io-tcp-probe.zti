{
  formatVersion = 1;
  name = "io-tcp-probe";
  componentType = "application";
  version = "1.0.0";
  owner = "root";
  purpose = "Echoes a seeded stream to its declared TCP destination, reads a peer-first close as end of stream, echoes again after an idle hold, and sees the refused arms.";
  implementation =  {
    provider = "workspace";
    binary = "io-tcp-probe";
    contentHash = "";
  };
  provides = [
  ];
  requires = [
    "endpoint";
    "sharedBufferFactory";
  ];
  interfaces = [
  ];
  dependencies = [
    "network-service";
  ];
  communication =  {
    semantic = "none";
    qos = [
    ];
  };
  configuration = [
  ];
  lifecycle = [
    "Initialize";
    "Start";
    "Running";
    "Error";
  ];
  runtime =  {
    executionEnvironment = "aarch64-sel4-qemu-virt";
    resource = {
      stackBytes = 16384;
      spawnBudget = 0;
      extraThreads = 0;
      bufferBytePages = 3;
      bufferCount = 3;
      mappingCount = 3;
      loanCount = 3;
      privatePageQuota = 0;
    };
    devices = [
    ];
  };
  health = "required";
  compatibility =  {
    platform = "aarch64-sel4-qemu-virt";
    interface = "contracts/interface-schema/v1";
    dependency = "exact";
    resource = "atMost";
    runtime = "exact";
    qos = "none";
  };
  test =  {
    testCondition = "io_tcp_check boots sel4-io-tcp";
    expectedResult = "the client sends 4096 bytes and reads them back unchanged over its lent queue, sees the closed port refused and the undeclared host denied, reads end of stream where the peer closes first, echoes again after a 6 s idle hold, and closes what it opened";
    passFailCriteria = "[io-tcp-probe] stream verified bytes=4096 mismatches=0";
    requiredTestEnvironment = "io_tcp_check";
  };
}
