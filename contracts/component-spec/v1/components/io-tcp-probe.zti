{
  formatVersion = 1;
  name = "io-tcp-probe";
  componentType = "application";
  version = "1.0.0";
  owner = "root";
  purpose = "Opens its one declared TCP destination through the network service, holds the service on its link for the peer, and closes what it opened.";
  implementation =  {
    provider = "workspace";
    binary = "io-tcp-probe";
    contentHash = "";
  };
  provides = [
  ];
  requires = [
    "endpoint";
  ];
  interfaces = [
  ];
  dependencies = [
    "network-service";
  ];
  communication =  {
    semantic = "none";
    qos = [
    ];
  };
  configuration = [
  ];
  lifecycle = [
    "Initialize";
    "Start";
    "Running";
    "Error";
  ];
  runtime =  {
    executionEnvironment = "aarch64-sel4-qemu-virt";
    resource = {
      stackBytes = 16384;
      spawnBudget = 0;
      extraThreads = 0;
      bufferBytePages = 0;
      bufferCount = 0;
      mappingCount = 0;
      loanCount = 0;
      privatePageQuota = 0;
    };
    devices = [
    ];
  };
  health = "required";
  compatibility =  {
    platform = "aarch64-sel4-qemu-virt";
    interface = "contracts/interface-schema/v1";
    dependency = "exact";
    resource = "atMost";
    runtime = "exact";
    qos = "none";
  };
  test =  {
    testCondition = "io_tcp_check boots sel4-io-tcp";
    expectedResult = "the granted client opens exactly its declared destination, the service answers the peer's ARP and ICMP on the declared interface meanwhile, and the client closes what it opened";
    passFailCriteria = "[io-tcp-probe] closed capabilities=1 shutdown=1";
    requiredTestEnvironment = "io_tcp_check";
  };
}
