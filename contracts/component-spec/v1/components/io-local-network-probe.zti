{
  formatVersion = 1;
  name = "io-local-network-probe";
  componentType = "application";
  version = "1.0.0";
  owner = "root";
  purpose = "Compares bidirectional local TCP streams through declared publisher/subscriber sessions, then verifies EOF and explicit teardown.";
  implementation = {
    provider = "workspace";
    binary = "io-local-network-probe";
    contentHash = "";
  };
  provides = [];
  requires = [ "endpoint"; ];
  interfaces = [];
  dependencies = [ "network-service"; ];
  communication = { semantic = "none"; qos = []; };
  configuration = [];
  lifecycle = [ "Initialize"; "Start"; "Running"; "Error"; ];
  runtime = {
    executionEnvironment = "aarch64-sel4-qemu-virt";
    resource = {
      stackBytes = 16384;
      spawnBudget = 0;
      extraThreads = 0;
      bufferBytePages = 0;
      bufferCount = 0;
      mappingCount = 0;
      loanCount = 0;
      privatePageQuota = 0;
    };
    devices = [];
  };
  health = "required";
  lifetime = "bounded";
  compatibility = {
    platform = "aarch64-sel4-qemu-virt";
    interface = "contracts/interface-schema/v1";
    dependency = "exact";
    resource = "atMost";
    runtime = "exact";
    qos = "none";
  };
  test = {
    testCondition = "sel4-io-local runs one publisher session and one subscriber session";
    expectedResult = "4096 request bytes and 2048 different response bytes independently match, with listener acceptance, EOF, connection and listener closure, and loan return";
    passFailCriteria = "[io-local-network-probe] role=publisher loans returned=2 shutdown=1";
    requiredTestEnvironment = "io_local_check";
  };
}
