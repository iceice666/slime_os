{
  formatVersion = 1;
  name = "fabric-observer";
  componentType = "application";
  version = "1.0.0";
  owner = "root";
  purpose = "Holds a read-only visibility-filtered view of the graph, proving introspection grants no route authority.";
  implementation = {
    provider = "workspace";
    binary = "fabric-observer";
    contentHash = "";
  };
  provides = [
    "endpoint";
  ];
  requires = [];
  interfaces = [
    {
      interface = "DiagnosticsStream";
      name = "diagnostics";
      tag = "input";
    };
    {
      name = "telemetry";
      tag = "input";
      interface = "TelemetryStream";
    };
  ];
  dependencies = [
    "fabric-service";
  ];
  communication = {
    semantic = "stream";
    qos = [
      {
        reference = "telemetry";
        reliability = "bestEffort";
        durability = "volatile";
        liveliness = "automatic";
        historyDepth = 4;
        retainedDepth = 0;
        deadlineNs = 0;
        lifespanNs = 0;
        leaseNs = 0;
      };
    ];
  };
  configuration = [];
  lifecycle = [
    "Initialize";
    "Start";
    "Running";
    "Error";
  ];
  runtime = {
    executionEnvironment = "x86_64-qemu-virtio";
    resource = {
      stackBytes = 16384;
      spawnBudget = 0;
      extraThreads = 0;
      bufferBytePages = 0;
      bufferCount = 0;
      mappingCount = 0;
      loanCount = 0;
      privatePageQuota = 0;
    };
    devices = [];
  };
  health = "optional";
  compatibility = {
    platform = "x86_64-qemu-virtio";
    interface = "contracts/interface-schema/v1";
    dependency = "exact";
    resource = "atMost";
    runtime = "exact";
    qos = "compatible";
  };
  test = {
    testCondition = "the sel4_matrix_check gate boots a generation declaring fabric-observer";
    expectedResult = "fabric-observer reaches its declared behavior under that gate";
    passFailCriteria = "[fabric-observer] matrix filtered view routes=1";
    requiredTestEnvironment = "sel4_matrix_check";
  };
}
