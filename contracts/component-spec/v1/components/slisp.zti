{
  formatVersion = 1;
  name = "slisp";
  componentType = "application";
  version = "1.0.0";
  owner = "root";
  purpose = "Runs the bounded pure S-expression Slisp REPL over declared console and input capabilities.";
  implementation = {
    provider = "external";
    binary = "slisp-external";
    contentHash = "e1b09a0925a3f15955018cb12e32a7767cb219244c68fd951204a0001ee1470f";
  };
  provides = [];
  requires = [
    "input";
  ];
  interfaces = [];
  dependencies = [
    "console";
  ];
  communication = {
    semantic = "none";
    qos = [];
  };
  configuration = [];
  lifecycle = [
    "Initialize";
    "Start";
    "Running";
    "Error";
  ];
  runtime = {
    executionEnvironment = "aarch64-sel4-qemu-virt";
    resource = {
      stackBytes = 65536;
      spawnBudget = 0;
      extraThreads = 0;
      bufferBytePages = 0;
      bufferCount = 0;
      mappingCount = 0;
      loanCount = 0;
      privatePageQuota = 0;
    };
    devices = [
      "input";
    ];
  };
  health = "required";
  compatibility = {
    platform = "aarch64-sel4-qemu-virt";
    interface = "contracts/interface-schema/v1";
    dependency = "exact";
    resource = "atMost";
    runtime = "exact";
    qos = "none";
  };
  test = {
    testCondition = "the sel4_component_graph_check gate boots the product generation declaring slisp";
    expectedResult = "slisp reaches its prompt and blocks on its declared empty input source";
    passFailCriteria = "[slisp] resident input wait";
    requiredTestEnvironment = "sel4_component_graph_check";
  };
}
