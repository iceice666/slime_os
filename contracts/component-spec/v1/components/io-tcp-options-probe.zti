{
  formatVersion = 1;
  name = "io-tcp-options-probe";
  componentType = "application";
  version = "1.0.0";
  owner = "root";
  purpose = "Opens TCP connections under the options its generation row declares, proves it cannot change them, and reports each scripted scenario.";
  implementation =  {
    provider = "workspace";
    binary = "io-tcp-options-probe";
    contentHash = "";
  };
  provides = [
  ];
  requires = [
    "endpoint";
  ];
  interfaces = [
  ];
  dependencies = [
    "network-service";
  ];
  communication =  {
    semantic = "none";
    qos = [
    ];
  };
  configuration = [
  ];
  lifecycle = [
    "Initialize";
    "Start";
    "Running";
    "Error";
  ];
  runtime =  {
    executionEnvironment = "aarch64-sel4-qemu-virt";
    resource = {
      stackBytes = 16384;
      spawnBudget = 0;
      extraThreads = 0;
      bufferBytePages = 0;
      bufferCount = 0;
      mappingCount = 0;
      loanCount = 0;
      privatePageQuota = 0;
    };
    devices = [
    ];
  };
  health = "required";
  lifetime = "bounded";
  compatibility =  {
    platform = "aarch64-sel4-qemu-virt";
    interface = "contracts/interface-schema/v1";
    dependency = "exact";
    resource = "atMost";
    runtime = "exact";
    qos = "none";
  };
  test =  {
    testCondition = "io_tcp_options_check boots sel4-io-tcp-options behind the scripted options peer";
    expectedResult = "an option mutation refused as unsupported, each completed scenario closed gracefully, and each mute connection ended by a typed timeout";
    passFailCriteria = "[io-tcp-options-probe] role=tuned scenarios=3 shutdown=1";
    requiredTestEnvironment = "io_tcp_options_check";
  };
}
