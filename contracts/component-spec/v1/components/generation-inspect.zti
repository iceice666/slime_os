{
  formatVersion = 1;
  name = "generation-inspect";
  componentType = "application";
  version = "1.0.0";
  owner = "root";
  purpose = "Issues an inspect request to the generation manager and reports the generation number, object count, and flags.";
  implementation = {
    provider = "workspace";
    binary = "generation-inspect";
    contentHash = "";
  };
  provides = [
    "endpoint";
  ];
  requires = [];
  interfaces = [];
  dependencies = [
    "generation-manager";
  ];
  communication = {
    semantic = "none";
    qos = [];
  };
  configuration = [];
  lifecycle = [
    "Initialize";
    "Start";
    "Running";
    "Error";
  ];
  runtime = {
    executionEnvironment = "x86_64-qemu-virtio";
    resource = {
      stackBytes = 16384;
      spawnBudget = 0;
      extraThreads = 0;
      bufferBytePages = 0;
      bufferCount = 0;
      mappingCount = 0;
      loanCount = 0;
      privatePageQuota = 0;
    };
    devices = [];
  };
  health = "optional";
  compatibility = {
    platform = "x86_64-qemu-virtio";
    interface = "contracts/interface-schema/v1";
    dependency = "exact";
    resource = "atMost";
    runtime = "exact";
    qos = "none";
  };
  test = {
    testCondition = "the generation_check gate boots a generation declaring generation-inspect";
    expectedResult = "generation-inspect reaches its declared behavior under that gate";
    passFailCriteria = "generation determinism check";
    requiredTestEnvironment = "generation_check";
  };
}
