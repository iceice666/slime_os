{
  formatVersion = 1;
  name = "sel4-store-probe";
  componentType = "application";
  version = "1.0.0";
  owner = "init";
  purpose = "Puts and gets content-addressed objects through the userspace object store over its declared block rings, including a missing-object refusal.";
  implementation = {
    provider = "workspace";
    binary = "sel4-store-probe";
    contentHash = "";
  };
  provides = [
    "endpoint";
  ];
  requires = [
    "endpoint";
    "sharedBufferFactory";
  ];
  interfaces = [];
  dependencies = [];
  communication = {
    semantic = "none";
    qos = [];
  };
  configuration = [];
  lifecycle = [
    "Initialize";
    "Start";
    "Running";
    "Error";
  ];
  runtime = {
    executionEnvironment = "aarch64-sel4-qemu-virt";
    resource = {
      stackBytes = 16384;
      spawnBudget = 0;
      extraThreads = 0;
      bufferBytePages = 0;
      bufferCount = 0;
      mappingCount = 0;
      loanCount = 0;
      privatePageQuota = 0;
    };
    devices = [];
  };
  health = "optional";
  compatibility = {
    platform = "aarch64-sel4-qemu-virt";
    interface = "contracts/interface-schema/v1";
    dependency = "none";
    resource = "atMost";
    runtime = "exact";
    qos = "none";
  };
  test = {
    testCondition = "the sel4_store_check gate boots a generation declaring sel4-store-probe";
    expectedResult = "objects round-trip by content hash and an absent hash is refused";
    passFailCriteria = "[init] store plane complete";
    requiredTestEnvironment = "sel4_store_check";
  };
}
