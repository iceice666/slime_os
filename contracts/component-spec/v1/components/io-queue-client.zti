{
  formatVersion = 1;
  name = "io-queue-client";
  componentType = "application";
  version = "1.0.0";
  owner = "root";
  purpose = "Proves bounded asynchronous request submission, completion draining, backpressure, reset epochs, and slice validation over the shared I/O queue substrate.";
  implementation = {
    provider = "workspace";
    binary = "io-queue-client";
    contentHash = "";
  };
  provides = [
    "endpoint";
  ];
  requires = [
    "sharedBufferFactory";
    "supervision";
  ];
  interfaces = [];
  dependencies = [
    "io-queue-driver";
  ];
  communication = {
    semantic = "none";
    qos = [];
  };
  configuration = [];
  lifecycle = [
    "Initialize";
    "Start";
    "Running";
    "Stop";
    "Error";
  ];
  runtime = {
    executionEnvironment = "aarch64-sel4-qemu-virt";
    resource = {
      stackBytes = 16384;
      spawnBudget = 0;
      extraThreads = 0;
      bufferBytePages = 1;
      bufferCount = 1;
      mappingCount = 1;
      loanCount = 1;
      privatePageQuota = 0;
    };
    devices = [];
  };
  health = "required";
  compatibility = {
    platform = "aarch64-sel4-qemu-virt";
    interface = "contracts/interface-schema/v1";
    dependency = "exact";
    resource = "atMost";
    runtime = "exact";
    qos = "none";
  };
  test = {
    testCondition = "the io_queue_check gate boots the sel4-io-queue composition";
    expectedResult = "the client proves every queue arm and reaches its terminal marker";
    passFailCriteria = "[io-queue-client] io queue plane complete";
    requiredTestEnvironment = "io_queue_check";
  };
}
