{
  formatVersion = 1;
  name = "powerbox-probe";
  componentType = "application";
  version = "1.0.0";
  owner = "root";
  purpose = "Asserts capability-less directory operations are denied, then receives one selected file capability by powerbox.";
  implementation = {
    provider = "workspace";
    binary = "powerbox-probe";
  };
  provides = [
    "endpoint";
  ];
  requires = [];
  interfaces = [];
  dependencies = [
    "powerbox-chooser";
  ];
  communication = {
    semantic = "none";
    qos = [];
  };
  configuration = [];
  lifecycle = [
    "Initialize";
    "Start";
    "Running";
    "Error";
  ];
  runtime = {
    executionEnvironment = "x86_64-qemu-virtio";
    resource = {
      stackBytes = 16384;
      spawnBudget = 0;
      extraThreads = 0;
      bufferBytePages = 0;
      bufferCount = 0;
      mappingCount = 0;
      loanCount = 0;
    };
    devices = [];
  };
  health = "optional";
  compatibility = {
    platform = "x86_64-qemu-virtio";
    interface = "contracts/interface-schema/v1";
    dependency = "exact";
    resource = "atMost";
    runtime = "exact";
    qos = "none";
  };
  test = {
    testCondition = "the sel4_powerbox_check gate boots a generation declaring powerbox-probe";
    expectedResult = "powerbox-probe reaches its declared behavior under that gate";
    passFailCriteria = "[powerbox-probe] done";
    requiredTestEnvironment = "sel4_powerbox_check";
  };
}
