{
  formatVersion = 1;
  name = "fabric-op-worker";
  componentType = "service";
  version = "1.0.0";
  owner = "root";
  purpose = "A dedicated task running the bounded operation broker for the navigation and nav-backup routes alone.";
  implementation = {
    provider = "workspace";
    binary = "fabric-op-worker";
    contentHash = "";
  };
  provides = [];
  requires = [];
  interfaces = [
    {
      name = "nav-backup";
      tag = "input";
      interface = "NavigationOperation";
    };
    {
      name = "nav-backup";
      tag = "output";
      interface = "NavigationOperation";
    };
    {
      name = "navigation";
      tag = "input";
      interface = "NavigationOperation";
    };
    {
      name = "navigation";
      tag = "output";
      interface = "NavigationOperation";
    };
  ];
  dependencies = [
    "fabric-service";
  ];
  communication = {
    semantic = "operation";
    qos = [];
  };
  configuration = [
    {
      name = "stackBytes";
      default = 49152;
      minimum = 4096;
      maximum = 1048576;
    };
  ];
  lifecycle = [
    "Initialize";
    "Configure";
    "Start";
    "Ready";
    "Running";
    "Error";
  ];
  runtime = {
    executionEnvironment = "x86_64-qemu-virtio";
    resource = {
      stackBytes = 49152;
      spawnBudget = 0;
      extraThreads = 0;
      bufferBytePages = 0;
      bufferCount = 0;
      mappingCount = 0;
      loanCount = 0;
      privatePageQuota = 0;
    };
    devices = [];
  };
  health = "optional";
  compatibility = {
    platform = "x86_64-qemu-virtio";
    interface = "contracts/interface-schema/v1";
    dependency = "exact";
    resource = "atMost";
    runtime = "exact";
    qos = "none";
  };
  test = {
    testCondition = "the sel4_boot_check gate boots a generation declaring fabric-op-worker";
    expectedResult = "fabric-op-worker reaches its declared behavior under that gate";
    passFailCriteria = "[init] fabric boot operation plane spawned";
    requiredTestEnvironment = "sel4_boot_check";
  };
}
