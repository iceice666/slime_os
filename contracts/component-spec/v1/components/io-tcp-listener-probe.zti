{
  formatVersion = 1;
  name = "io-tcp-listener-probe";
  componentType = "application";
  version = "1.0.0";
  owner = "root";
  purpose = "Holds one exact external TCP listener through network-service, or as an intruder proves it cannot listen, and drives every scripted close.";
  implementation =  {
    provider = "workspace";
    binary = "io-tcp-listener-probe";
    contentHash = "";
  };
  provides = [
  ];
  requires = [
    "endpoint";
  ];
  interfaces = [
  ];
  dependencies = [
    "network-service";
  ];
  communication =  {
    semantic = "none";
    qos = [
    ];
  };
  configuration = [
  ];
  lifecycle = [
    "Initialize";
    "Start";
    "Running";
    "Error";
  ];
  runtime =  {
    executionEnvironment = "aarch64-sel4-qemu-virt";
    resource = {
      stackBytes = 16384;
      spawnBudget = 0;
      extraThreads = 0;
      bufferBytePages = 0;
      bufferCount = 0;
      mappingCount = 0;
      loanCount = 0;
      privatePageQuota = 0;
    };
    devices = [
    ];
  };
  health = "required";
  lifetime = "bounded";
  compatibility =  {
    platform = "aarch64-sel4-qemu-virt";
    interface = "contracts/interface-schema/v1";
    dependency = "exact";
    resource = "atMost";
    runtime = "exact";
    qos = "none";
  };
  test =  {
    testCondition = "io_tcp_listener_check boots sel4-io-tcp-listener behind the scripted listener peer";
    expectedResult = "an exact echo on the accepted connection, refused listens outside the declaration, and every scripted close settled with its handle refused afterwards";
    passFailCriteria = "[io-tcp-listener-probe] role=listener listener_closed=1 scenarios=5 shutdown=1";
    requiredTestEnvironment = "io_tcp_listener_check";
  };
}
