{
  formatVersion = 1;
  name = "pwm-servo-driver";
  componentType = "service";
  version = "1.0.0";
  owner = "root";
  purpose = "Servo PWM on a declared device page, serving pwm-servo v1 on its endpoint through the platform's register model; resident and refusing when bound no device.";
  implementation = {
    provider = "workspace";
    binary = "pwm-servo-driver";
    contentHash = "";
  };
  provides = [];
  requires = [
    "device";
    "endpoint";
    "mmioRegion";
  ];
  interfaces = [];
  dependencies = [];
  communication = {
    semantic = "none";
    qos = [];
  };
  configuration = [];
  lifecycle = [
    "Initialize";
    "Start";
    "Ready";
    "Running";
    "Error";
  ];
  runtime = {
    executionEnvironment = "aarch64-sel4-qemu-virt";
    resource = {
      stackBytes = 16384;
      spawnBudget = 0;
      extraThreads = 0;
      bufferBytePages = 0;
      bufferCount = 0;
      mappingCount = 0;
      loanCount = 0;
      privatePageQuota = 0;
    };
    devices = [
      "device";
    ];
  };
  health = "required";
  compatibility = {
    platform = "aarch64-sel4-qemu-virt";
    interface = "contracts/pwm-servo/v1";
    dependency = "none";
    resource = "atMost";
    runtime = "exact";
    qos = "none";
  };
  test = {
    testCondition = "sel4_pwm_graph_check boots generation 55 under QEMU, where no PWM block exists, and asks Slisp for (pwm 0 1600)";
    expectedResult = "the driver binds no device, stays resident, answers the request with STATUS_NO_DEVICE, and the graph stays healthy";
    passFailCriteria = "[pwm-servo-driver] device absent, refusing requests";
    requiredTestEnvironment = "sel4_pwm_graph_check";
  };
}
