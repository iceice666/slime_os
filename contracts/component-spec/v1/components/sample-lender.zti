{
  formatVersion = 1;
  name = "sample-lender";
  componentType = "application";
  version = "1.0.0";
  owner = "root";
  purpose = "Allocates, fills, seals, and loans a shared buffer, sending only its bounded descriptor over IPC.";
  implementation = {
    provider = "workspace";
    binary = "sample-lender";
    contentHash = "";
  };
  provides = [
    "endpoint";
  ];
  requires = [
    "sharedBufferFactory";
    "supervision";
  ];
  interfaces = [];
  dependencies = [
    "init";
  ];
  communication = {
    semantic = "none";
    qos = [];
  };
  configuration = [];
  lifecycle = [
    "Initialize";
    "Start";
    "Running";
    "Stop";
    "Error";
  ];
  runtime = {
    executionEnvironment = "x86_64-qemu-virtio";
    resource = {
      stackBytes = 16384;
      spawnBudget = 0;
      extraThreads = 0;
      bufferBytePages = 4;
      bufferCount = 1;
      mappingCount = 2;
      loanCount = 1;
    };
    devices = [];
  };
  health = "optional";
  compatibility = {
    platform = "x86_64-qemu-virtio";
    interface = "contracts/interface-schema/v1";
    dependency = "exact";
    resource = "atMost";
    runtime = "exact";
    qos = "none";
  };
  test = {
    testCondition = "the sel4_sample_check gate boots a generation declaring sample-lender";
    expectedResult = "sample-lender reaches its declared behavior under that gate";
    passFailCriteria = "[sample-lender] done";
    requiredTestEnvironment = "sel4_sample_check";
  };
}
