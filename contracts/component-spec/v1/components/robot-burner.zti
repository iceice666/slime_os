  test = {
    testCondition = "the robot_runtime_check gate boots a generation declaring robot-burner";
    expectedResult = "the burner reports its scheduling band and spins in bounded chunks the foreground/normal traffic preempts";
    passFailCriteria = "[robot-burner] bestEffort priority=";
    requiredTestEnvironment = "robot_runtime_check";
  };
