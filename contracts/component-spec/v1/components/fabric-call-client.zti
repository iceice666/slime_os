{
  formatVersion = 1;
  name = "fabric-call-client";
  componentType = "application";
  version = "1.0.0";
  owner = "root";
  purpose = "Requests a client role on the parameters route and issues non-idempotent call requests.";
  implementation = {
    provider = "workspace";
    binary = "fabric-call-client";
    contentHash = "";
  };
  provides = [
    "endpoint";
  ];
  requires = [
    "sharedBufferFactory";
  ];
  interfaces = [
    {
      name = "parameters";
      tag = "command";
      interface = "ParameterCall";
    };
  ];
  dependencies = [
    "fabric-service";
  ];
  communication = {
    semantic = "call";
    qos = [
      {
        reference = "parameters";
        reliability = "reliable";
        durability = "volatile";
        liveliness = "automatic";
        historyDepth = 4;
        retainedDepth = 0;
        deadlineNs = 1000000;
        lifespanNs = 2000000;
        leaseNs = 0;
      };
    ];
  };
  configuration = [];
  lifecycle = [
    "Initialize";
    "Start";
    "Running";
    "Degraded";
    "Error";
  ];
  runtime = {
    executionEnvironment = "x86_64-qemu-virtio";
    resource = {
      stackBytes = 16384;
      spawnBudget = 0;
      extraThreads = 0;
      bufferBytePages = 2;
      bufferCount = 1;
      mappingCount = 2;
      loanCount = 1;
      privatePageQuota = 0;
    };
    devices = [];
  };
  health = "optional";
  compatibility = {
    platform = "x86_64-qemu-virtio";
    interface = "contracts/interface-schema/v1";
    dependency = "exact";
    resource = "atMost";
    runtime = "exact";
    qos = "compatible";
  };
  test = {
    testCondition = "the sel4_call_check gate boots a generation declaring fabric-call-client";
    expectedResult = "fabric-call-client reaches its declared behavior under that gate";
    passFailCriteria = "[fabric-call-client] success correlated";
    requiredTestEnvironment = "sel4_call_check";
  };
}
