{
  formatVersion = 1;
  name = "io-tcp-impairment-probe";
  componentType = "application";
  version = "1.0.0";
  owner = "root";
  purpose = "Runs the TCP impairment scenarios through network-service: reordered and lossy echoes, a silent peer, an application stall and a zero-window peer.";
  implementation =  {
    provider = "workspace";
    binary = "io-tcp-impairment-probe";
    contentHash = "";
  };
  provides = [
  ];
  requires = [
    "endpoint";
  ];
  interfaces = [
  ];
  dependencies = [
    "network-service";
  ];
  communication =  {
    semantic = "none";
    qos = [
    ];
  };
  configuration = [
  ];
  lifecycle = [
    "Initialize";
    "Start";
    "Running";
    "Error";
  ];
  runtime =  {
    executionEnvironment = "aarch64-sel4-qemu-virt";
    resource = {
      stackBytes = 16384;
      spawnBudget = 0;
      extraThreads = 0;
      bufferBytePages = 0;
      bufferCount = 0;
      mappingCount = 0;
      loanCount = 0;
      privatePageQuota = 0;
    };
    devices = [
    ];
  };
  health = "required";
  lifetime = "bounded";
  compatibility =  {
    platform = "aarch64-sel4-qemu-virt";
    interface = "contracts/interface-schema/v1";
    dependency = "exact";
    resource = "atMost";
    runtime = "exact";
    qos = "none";
  };
  test =  {
    testCondition = "io_tcp_impairment_check boots sel4-io-tcp-impairment behind the scripted impairment peer";
    expectedResult = "exact 4096-byte echoes through reordering and loss, a typed timeout and reclamation for a silent peer followed by a fresh exchange, and bounded zero-window behavior in both directions";
    passFailCriteria = "[io-tcp-impairment-probe] scenarios=5 shutdown=1";
    requiredTestEnvironment = "io_tcp_impairment_check";
  };
}
