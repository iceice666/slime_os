{
  formatVersion = 1;
  name = "fabric-call-time";
  componentType = "service";
  version = "1.0.0";
  owner = "root";
  purpose = "Advances the call plane's monotonic clock in client-signalled phases, driving timeout and expiry transitions.";
  implementation = {
    provider = "workspace";
    binary = "fabric-call-time";
  };
  provides = [
    "endpoint";
  ];
  requires = [];
  interfaces = [];
  dependencies = [
    "fabric-service";
  ];
  communication = {
    semantic = "none";
    qos = [];
  };
  configuration = [];
  lifecycle = [
    "Initialize";
    "Start";
    "Ready";
    "Running";
    "Error";
  ];
  runtime = {
    executionEnvironment = "x86_64-qemu-virtio";
    resource = {
      stackBytes = 16384;
      spawnBudget = 0;
      extraThreads = 0;
      bufferBytePages = 0;
      bufferCount = 0;
      mappingCount = 0;
      loanCount = 0;
    };
    devices = [];
  };
  health = "optional";
  compatibility = {
    platform = "x86_64-qemu-virtio";
    interface = "contracts/interface-schema/v1";
    dependency = "exact";
    resource = "atMost";
    runtime = "exact";
    qos = "none";
  };
  test = {
    testCondition = "the sel4_call_check gate boots a generation declaring fabric-call-time";
    expectedResult = "fabric-call-time reaches its declared behavior under that gate";
    passFailCriteria = "[fabric-call-time] bounded time completed";
    requiredTestEnvironment = "sel4_call_check";
  };
}
