{
  formatVersion = 1;
  name = "robot-sensor";
  componentType = "application";
  version = "1.0.0";
  owner = "init";
  purpose = "C9.6's periodic robot sensor: publishes bounded telemetry samples on a real timer cadence at the foreground band, ending its stream with a terminal flag.";
  implementation = {
    provider = "workspace";
    binary = "robot-sensor";
    contentHash = "";
  };
  provides = [
    "endpoint";
  ];
  requires = [];
  interfaces = [
    {
      name = "telemetry";
      tag = "output";
      interface = "TelemetryStream";
    };
  ];
  dependencies = [];
  communication = {
    semantic = "stream";
    qos = [
      {
        reference = "telemetry";
        reliability = "bestEffort";
        durability = "retained";
        liveliness = "automatic";
        historyDepth = 4;
        retainedDepth = 2;
        deadlineNs = 0;
        lifespanNs = 0;
        leaseNs = 0;
      };
    ];
  };
  configuration = [];
  lifecycle = [
    "Initialize";
    "Start";
    "Running";
    "Error";
  ];
  runtime = {
    executionEnvironment = "aarch64-sel4-qemu-virt";
    resource = {
      stackBytes = 16384;
      spawnBudget = 0;
      extraThreads = 0;
      bufferBytePages = 4;
      bufferCount = 0;
      mappingCount = 4;
      loanCount = 0;
      privatePageQuota = 0;
    };
    devices = [];
  };
  health = "required";
  compatibility = {
    platform = "aarch64-sel4-qemu-virt";
    interface = "contracts/interface-schema/v1";
    dependency = "none";
    resource = "atMost";
    runtime = "exact";
    qos = "compatible";
  };
  test = {
    testCondition = "the robot_runtime_check gate boots a generation declaring robot-sensor";
    expectedResult = "the sensor publishes one timed sample per timer expiry at the foreground band and ends its stream in order";
    passFailCriteria = "[robot-sensor] publish role received";
    requiredTestEnvironment = "robot_runtime_check";
  };
}
