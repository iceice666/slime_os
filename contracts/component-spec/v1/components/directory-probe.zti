{
  formatVersion = 1;
  name = "directory-probe";
  componentType = "application";
  version = "1.0.0";
  owner = "root";
  purpose = "Asserts an ungranted directory derive is denied, then exercises the granted directory-rights protocol.";
  implementation = {
    provider = "workspace";
    binary = "directory-probe";
    contentHash = "";
  };
  provides = [
    "endpoint";
  ];
  requires = [
    "directory";
  ];
  interfaces = [];
  dependencies = [
    "filesystem-service";
  ];
  communication = {
    semantic = "none";
    qos = [];
  };
  configuration = [];
  lifecycle = [
    "Initialize";
    "Start";
    "Running";
    "Error";
  ];
  runtime = {
    executionEnvironment = "x86_64-qemu-virtio";
    resource = {
      stackBytes = 16384;
      spawnBudget = 0;
      extraThreads = 0;
      bufferBytePages = 0;
      bufferCount = 0;
      mappingCount = 0;
      loanCount = 0;
      privatePageQuota = 0;
    };
    devices = [];
  };
  health = "optional";
  compatibility = {
    platform = "x86_64-qemu-virtio";
    interface = "contracts/interface-schema/v1";
    dependency = "exact";
    resource = "atMost";
    runtime = "exact";
    qos = "none";
  };
  test = {
    testCondition = "the sel4_directory_check gate boots a generation declaring directory-probe";
    expectedResult = "directory-probe reaches its declared behavior under that gate";
    passFailCriteria = "[init] directory plane complete";
    requiredTestEnvironment = "sel4_directory_check";
  };
}
