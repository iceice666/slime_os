-- Schema-reflected Python and Rust layouts for network-application/v1.
refl ::= import stdlib.reflect;
n ::= import stdlib.num;
w ::= import wire.python;
r ::= import wire.rust;
c ::= import wire.codec;
Format :: type {
  formatVersion : Int;
  incarnationParameterKey : Int;
  headerBytes : Int;
  entryBytes : Int;
  maxApplications : Int;
  bindingBytes : Int;
  minQueueDepth : Int;
  maxQueueDepth : Int;
  maxByteBudget : Int;
  bytesPerAcceptedSocket : Int;
  maxTimerBudget : Int;
  maxRetryLimit : Int;
  maxReconnectLimit : Int;
  maxBacklog : Int;
  maxAcceptedSockets : Int;
  roleClient : Int;
  roleListener : Int;
  backendExternal : Int;
  backendLoopback : Int;
  rightListen : Int;
  rightSend : Int;
  rightRecv : Int;
  knownRights : Int;
  headerFields : List refl.SchemaField; entryFields : List refl.SchemaField;
  headerLayout : List w.WireField; entryLayout : List w.WireField;
};
records :: Format -> List w.WireRecord = f => {
  { pythonName = "NETWORK_APPLICATION_HEADER"; constPrefix = "NETWORK_APPLICATION"; size = f.headerBytes; trailingPadding = 0; fields = f.headerFields; layout = f.headerLayout; };
  { pythonName = "NETWORK_APPLICATION_ENTRY"; constPrefix = "NETWORK_APPLICATION_ENTRY"; size = f.entryBytes; trailingPadding = 0; fields = f.entryFields; layout = f.entryLayout; };
};
pythonBindings :: Format -> Text = f => w.join {
  "NETWORK_APPLICATION_MAGIC = b\"SLIMENA\\0\"\n";
  "NETWORK_APPLICATION_INCARNATION_PARAMETER_KEY = "; n.toText f.incarnationParameterKey; "\n";
  "NETWORK_APPLICATION_FORMAT_VERSION = "; n.toText f.formatVersion; "\n";
  "NETWORK_APPLICATION_HEADER_BYTES = "; n.toText f.headerBytes; "\n";
  "NETWORK_APPLICATION_ENTRY_BYTES = "; n.toText f.entryBytes; "\n";
  "NETWORK_APPLICATION_MAX_APPLICATIONS = "; n.toText f.maxApplications; "\n";
  "NETWORK_APPLICATION_BINDING_BYTES = "; n.toText f.bindingBytes; "\n";
  "NETWORK_APPLICATION_MIN_QUEUE_DEPTH = "; n.toText f.minQueueDepth; "\n";
  "NETWORK_APPLICATION_MAX_QUEUE_DEPTH = "; n.toText f.maxQueueDepth; "\n";
  "NETWORK_APPLICATION_MAX_BYTE_BUDGET = "; n.toText f.maxByteBudget; "\n";
  "NETWORK_APPLICATION_BYTES_PER_ACCEPTED_SOCKET = "; n.toText f.bytesPerAcceptedSocket; "\n";
  "NETWORK_APPLICATION_MAX_TIMER_BUDGET = "; n.toText f.maxTimerBudget; "\n";
  "NETWORK_APPLICATION_MAX_RETRY_LIMIT = "; n.toText f.maxRetryLimit; "\n";
  "NETWORK_APPLICATION_MAX_RECONNECT_LIMIT = "; n.toText f.maxReconnectLimit; "\n";
  "NETWORK_APPLICATION_MAX_BACKLOG = "; n.toText f.maxBacklog; "\n";
  "NETWORK_APPLICATION_MAX_ACCEPTED_SOCKETS = "; n.toText f.maxAcceptedSockets; "\n";
  "NETWORK_APPLICATION_ROLE_CLIENT = "; n.toText f.roleClient; "\n";
  "NETWORK_APPLICATION_ROLE_LISTENER = "; n.toText f.roleListener; "\n";
  "NETWORK_APPLICATION_BACKEND_EXTERNAL = "; n.toText f.backendExternal; "\n";
  "NETWORK_APPLICATION_BACKEND_LOOPBACK = "; n.toText f.backendLoopback; "\n";
  "NETWORK_APPLICATION_RIGHT_LISTEN = "; n.toText f.rightListen; "\n";
  "NETWORK_APPLICATION_RIGHT_SEND = "; n.toText f.rightSend; "\n";
  "NETWORK_APPLICATION_RIGHT_RECV = "; n.toText f.rightRecv; "\n";
  "NETWORK_APPLICATION_KNOWN_RIGHTS = "; n.toText f.knownRights; "\n";
  w.renderRecords (records f);
};
rustBindings :: Format -> Text = f => r.join {
  "// @generated by contracts/network-application/v1/gen_rust.zt; do not edit.\n// Source contract: contracts/network-application/v1/schema.zt\n\n";
  "pub const MAGIC: [u8; 8] = *b\"SLIMENA\\0\";\n";
  "pub const INCARNATION_PARAMETER_KEY: u64 = "; n.toText f.incarnationParameterKey; ";\n";
  "pub const FORMAT_VERSION: u32 = "; n.toText f.formatVersion; ";\n";
  "pub const HEADER_BYTES: usize = "; n.toText f.headerBytes; ";\n";
  "pub const ENTRY_BYTES: usize = "; n.toText f.entryBytes; ";\n";
  "pub const MAX_APPLICATIONS: usize = "; n.toText f.maxApplications; ";\n";
  "pub const BINDING_BYTES: usize = "; n.toText f.bindingBytes; ";\n";
  "pub const MIN_QUEUE_DEPTH: u32 = "; n.toText f.minQueueDepth; ";\n";
  "pub const MAX_QUEUE_DEPTH: u32 = "; n.toText f.maxQueueDepth; ";\n";
  "pub const MAX_BYTE_BUDGET: u32 = "; n.toText f.maxByteBudget; ";\n";
  "pub const BYTES_PER_ACCEPTED_SOCKET: u32 = "; n.toText f.bytesPerAcceptedSocket; ";\n";
  "pub const MAX_TIMER_BUDGET: u32 = "; n.toText f.maxTimerBudget; ";\n";
  "pub const MAX_RETRY_LIMIT: u32 = "; n.toText f.maxRetryLimit; ";\n";
  "pub const MAX_RECONNECT_LIMIT: u32 = "; n.toText f.maxReconnectLimit; ";\n";
  "pub const MAX_BACKLOG: u32 = "; n.toText f.maxBacklog; ";\n";
  "pub const MAX_ACCEPTED_SOCKETS: u32 = "; n.toText f.maxAcceptedSockets; ";\n";
  "pub const ROLE_CLIENT: u8 = "; n.toText f.roleClient; ";\n";
  "pub const ROLE_LISTENER: u8 = "; n.toText f.roleListener; ";\n";
  "pub const BACKEND_EXTERNAL: u8 = "; n.toText f.backendExternal; ";\n";
  "pub const BACKEND_LOOPBACK: u8 = "; n.toText f.backendLoopback; ";\n";
  "pub const RIGHT_LISTEN: u16 = "; n.toText f.rightListen; ";\n";
  "pub const RIGHT_SEND: u16 = "; n.toText f.rightSend; ";\n";
  "pub const RIGHT_RECV: u16 = "; n.toText f.rightRecv; ";\n";
  "pub const KNOWN_RIGHTS: u16 = "; n.toText f.knownRights; ";\n";
  c.offsetConstsWithEnds "HEADER" 0 f.headerLayout;
  c.offsetConstsWithEnds "ENTRY" 0 f.entryLayout;
};
render :: Format -> { python : Text; rust : Text; } = f => if w.recordsValid (records f)
  && c.wireBytes f.headerLayout == f.headerBytes
  && c.wireBytes f.entryLayout == f.entryBytes
  && f.bindingBytes == 32
  then { python = pythonBindings f; rust = rustBindings f; }
  else { python = "INVALID_NETWORK_APPLICATION_SCHEMA"; rust = "INVALID_NETWORK_APPLICATION_SCHEMA"; };
{ render =; }
