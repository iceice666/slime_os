-- An rmw_zenoh peer's sessions, handed from the rmw exam's checker to its Rust tests.
--
-- `check-zenoh-profile0.py --slice rmw` writes one record of this shape to
-- `build/zenoh-rmw/fixtures.zti`; the `zenoh_rmw::` tests read it. The bytes are eclipse-zenoh's and
-- rmw_zenoh's, not ours: `talker`, `listener` and `lists` are the batch bodies (no 2-byte stream
-- length) an rmw_zenoh 0.6.10 peer sent a Profile 0 listener, in order, one group for each node it ran,
-- and `refuse` is what the exam builds from them. Only the container is fixed here.

Row :: type {
  name : Text;
  hex : Text;
};

Session :: type {
  formatVersion : Int;
  talker : List Row;
  listener : List Row;
  lists : List Row;
  refuse : List Row;
};

FromData @Row :: derive
FromData @Session :: derive

formatVersion :: Int = 1;
talkerCount :: Int = 33;
listenerCount :: Int = 14;
listsCount :: Int = 13;
refuseCount :: Int = 11;
maxBatchBytes :: Int = 512;
maxNameBytes :: Int = 64;

d ::= import stdlib.data;
r ::= import stdlib.result;

-- `decode` ignores a field it does not know, so the field set is closed here: every record, at the top
-- level and in each row, may name only the fields below.
topFields :: List Text = { "formatVersion"; "talker"; "listener"; "lists"; "refuse"; };
rowFields :: List Text = { "name"; "hex"; };

isAllowed :: Text -> List Text -> Bool
  = wanted allowed => match allowed {
    | {;} => false;
    | {head; ...tail} => if head == wanted then true else isAllowed wanted tail;
  };

onlyThese :: List Text -> List d.DataField -> Bool
  = allowed found => match found {
    | {;} => true;
    | {head; ...tail} => isAllowed head.name allowed && onlyThese allowed tail;
  };

recordIsClosed :: List Text -> Data -> Bool
  = allowed data => match d.asRecord data {
    | #ok { value = found; } => onlyThese allowed found;
    | #err { error = _; } => true;
  };

everyRowClosed :: List Data -> Bool
  = rows => match rows {
    | {;} => true;
    | {head; ...tail} => recordIsClosed rowFields head && everyRowClosed tail;
  };

rowsAreClosed :: Text -> Data -> Bool
  = group data => match d.field group data {
    | #ok { value = value; } => match d.asList value {
      | #ok { value = rows; } => everyRowClosed rows;
      | #err { error = _; } => true;
    };
    | #err { error = _; } => true;
  };

closedSession :: Data -> Bool
  = data => recordIsClosed topFields data && rowsAreClosed "talker" data && rowsAreClosed "listener" data && rowsAreClosed "lists" data && rowsAreClosed "refuse" data;

extraField :: DecodeIssue
  = { path = {;}; error = #custom { message = "a field the contract does not name"; }; };

decodeSession :: Data -> Validation DecodeIssue Session
  = data => if closedSession data then decode data else r.invalidOne extraField;

{
  Row =;
  Session =;
  decodeSession =;
  formatVersion =;
  talkerCount =;
  listenerCount =;
  listsCount =;
  refuseCount =;
  maxBatchBytes =;
  maxNameBytes =;
}
