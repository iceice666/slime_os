-- Pure renderer for Slime OS capability-transfer protocol bindings (C8.3).

refl ::= import stdlib.reflect;
n ::= import stdlib.num;
t ::= import stdlib.text;
w ::= import wire.rust;
c ::= import wire.codec;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

Protocol :: type {
  formatVersion : Int;
  requestLen : Int;
  transferLen : Int;
  maxRouteNameBytes : Int;
  fabricRequestMagic : Int;
  capabilityTransferMagic : Int;
  objectKindEndpoint : Int;
  objectKindSharedBuffer : Int;
  objectKindSharedBufferLoan : Int;
  objectKindSupervision : Int;
  objectKindDirectory : Int;
  flagRetainTransfer : Int;
  knownFlags : Int;
  directionPublish : Int;
  directionSubscribe : Int;
  directionClient : Int;
  directionServer : Int;
  requestFields : List refl.SchemaField;
  transferFields : List refl.SchemaField;
  requestLayout : List WireField;
  transferLayout : List WireField;
};

-- Offset and codec emitters come from `wire.codec`, which owns the
-- byte-array-aware mechanics fourteen renderers previously each copied. The
-- validity predicate below stays here: what makes *this* layout admissible is
-- contract-specific.
layoutNames :: List WireField -> List Text = c.layoutNames;
allValid :: List WireField -> Bool = c.allValid;
wireBytes :: List WireField -> Int = c.wireBytes;
offsetConsts :: Text -> Int -> List WireField -> Text = c.offsetConsts;
wireStruct :: Text -> Text -> Text -> List WireField -> Text
  = name prefix lengthName fields => c.wireStruct "capability-transfer" name prefix lengthName fields;


rustBindings :: Protocol -> Text
  = protocol => w.join {
    "// @generated by contracts/capability-transfer/v1/gen_rust.zt; do not edit.\n";
    "// Source contract: contracts/capability-transfer/v1/schema.zt\n\n";
    "pub const FORMAT_VERSION: u32 = "; n.toText protocol.formatVersion; ";\n";
    "pub const FABRIC_REQUEST_MAGIC: u32 = "; n.toText protocol.fabricRequestMagic; ";\n";
    "pub const CAPABILITY_TRANSFER_MAGIC: u32 = "; n.toText protocol.capabilityTransferMagic; ";\n";
    "pub const REQUEST_LEN: usize = "; n.toText protocol.requestLen; ";\n";
    "pub const TRANSFER_LEN: usize = "; n.toText protocol.transferLen; ";\n";
    "pub const MAX_ROUTE_NAME_BYTES: usize = "; n.toText protocol.maxRouteNameBytes; ";\n";
    "pub const OBJECT_KIND_ENDPOINT: u32 = "; n.toText protocol.objectKindEndpoint; ";\n";
    "pub const OBJECT_KIND_SHARED_BUFFER: u32 = "; n.toText protocol.objectKindSharedBuffer; ";\n";
    "pub const OBJECT_KIND_SHARED_BUFFER_LOAN: u32 = "; n.toText protocol.objectKindSharedBufferLoan; ";\n";
    "pub const OBJECT_KIND_SUPERVISION: u32 = "; n.toText protocol.objectKindSupervision; ";\n";
    "pub const OBJECT_KIND_DIRECTORY: u32 = "; n.toText protocol.objectKindDirectory; ";\n";
    "pub const FLAG_RETAIN_TRANSFER: u32 = "; n.toText protocol.flagRetainTransfer; ";\n";
    "pub const KNOWN_FLAGS: u32 = "; n.toText protocol.knownFlags; ";\n";
    "pub const DIRECTION_PUBLISH: u32 = "; n.toText protocol.directionPublish; ";\n";
    "pub const DIRECTION_SUBSCRIBE: u32 = "; n.toText protocol.directionSubscribe; ";\n";
    "pub const DIRECTION_CLIENT: u32 = "; n.toText protocol.directionClient; ";\n";
    "pub const DIRECTION_SERVER: u32 = "; n.toText protocol.directionServer; ";\n\n";
    offsetConsts "REQUEST" 0 protocol.requestLayout;
    "\n";
    wireStruct "WireFabricRequest" "REQUEST" "REQUEST_LEN" protocol.requestLayout;
    "\n";
    offsetConsts "TRANSFER" 0 protocol.transferLayout;
    "\n";
    wireStruct "WireCapabilityTransfer" "TRANSFER" "TRANSFER_LEN" protocol.transferLayout;
  };

valid :: Protocol -> Bool
  = protocol =>
    w.schemaFieldsValid protocol.requestFields
      && w.schemaFieldsValid protocol.transferFields
      && w.schemaNames protocol.requestFields == layoutNames protocol.requestLayout
      && w.schemaNames protocol.transferFields == layoutNames protocol.transferLayout
      && allValid protocol.requestLayout
      && allValid protocol.transferLayout
      && wireBytes protocol.requestLayout <= protocol.requestLen
      && wireBytes protocol.transferLayout <= protocol.transferLen;

render :: Protocol -> { rust : Text; }
  = protocol => if valid protocol
    then { rust = rustBindings protocol; }
    else { rust = "INVALID_CAPABILITY_TRANSFER_SCHEMA"; };

{ render =; }
