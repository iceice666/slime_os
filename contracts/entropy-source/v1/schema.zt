-- Slime OS entropy-source protocol, version 1.
-- The entropy service's one call to the virtio-rng driver over the driver's
-- endpoint. A `fill` asks for 1..maxFill device bytes and the reply carries
-- exactly the bytes the device wrote; `release` ends the session and the
-- driver exits. A driver without its device answers every fill with
-- `statusUnavailable` and no bytes, never with bytes it made up.

env ::= import stdlib.env;
fs ::= import stdlib.fs;
gen ::= import "gen_rust.zt";
t ::= import stdlib.text;

formatVersion :: Int = 1;
requestLen :: Int = 16;
replyLen :: Int = 64;
maxFill :: Int = 48;
opFill :: Int = 1;
opRelease :: Int = 2;
statusOk :: Int = 0;
statusUnavailable :: Int = -1;
statusMalformed :: Int = -2;
statusDeviceError :: Int = -3;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

EntropySourceRequest :: type {
  magic : Int;
  version : Int;
  op : Int;
  length : Int;
};

-- `length` counts the leading `bytes` the device wrote: the requested length
-- on `statusOk`, zero otherwise. Bytes past `length` are zero.
EntropySourceReply :: type {
  magic : Int;
  version : Int;
  status : Int;
  length : Int;
  bytes : Int;
};

requestSchema ::= schema EntropySourceRequest;
replySchema ::= schema EntropySourceReply;

requestLayout :: List WireField = {
  { name = "magic"; width = 4; signed = false; byteArray = false; };
  { name = "version"; width = 4; signed = false; byteArray = false; };
  { name = "op"; width = 4; signed = false; byteArray = false; };
  { name = "length"; width = 4; signed = false; byteArray = false; };
};

replyLayout :: List WireField = {
  { name = "magic"; width = 4; signed = false; byteArray = false; };
  { name = "version"; width = 4; signed = false; byteArray = false; };
  { name = "status"; width = 4; signed = true; byteArray = false; };
  { name = "length"; width = 4; signed = false; byteArray = false; };
  { name = "bytes"; width = 48; signed = false; byteArray = true; };
};

format ::= {
  formatVersion =;
  requestLen =;
  replyLen =;
  maxFill =;
  opFill =;
  opRelease =;
  statusOk =;
  statusUnavailable =;
  statusMalformed =;
  statusDeviceError =;
  requestFields = requestSchema.fields ?? {;};
  replyFields = replySchema.fields ?? {;};
  requestLayout =;
  replyLayout =;
};

main :: { write : FsWrite; env : Env; } -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_ENTROPY_BINDINGS_ROOT" ?? ".";
    rustPath := t.join "" { root; "/components/proto/src/entropy_source.rs"; };
    fs.writeAll caps.write rustPath (gen.render format)
  ];

main
