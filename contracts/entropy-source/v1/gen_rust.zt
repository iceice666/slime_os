-- Pure renderer for Slime OS entropy-source protocol bindings: the Rust module
-- the virtio-rng driver and the entropy service import.

refl ::= import stdlib.reflect;
n ::= import stdlib.num;
w ::= import wire.rust;
c ::= import wire.codec;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

Protocol :: type {
  formatVersion : Int;
  requestLen : Int;
  replyLen : Int;
  maxFill : Int;
  opFill : Int;
  opRelease : Int;
  statusOk : Int;
  statusUnavailable : Int;
  statusMalformed : Int;
  statusDeviceError : Int;
  requestFields : List refl.SchemaField;
  replyFields : List refl.SchemaField;
  requestLayout : List WireField;
  replyLayout : List WireField;
};

layoutNames :: List WireField -> List Text = c.layoutNames;
allValid :: List WireField -> Bool = c.allValid;
wireBytes :: List WireField -> Int = c.wireBytes;
offsetConsts :: Text -> Int -> List WireField -> Text = c.offsetConsts;
wireStruct :: Text -> Text -> Text -> List WireField -> Text
  = name prefix lengthName fields => c.wireStruct "entropy_source" name prefix lengthName fields;

-- "RNGS" as a little-endian u32.
magic :: Int = 1397182034;

rustBindings :: Protocol -> Text
  = protocol => w.join {
    "// @generated by contracts/entropy-source/v1/gen_rust.zt; do not edit.\n";
    "// Source contract: contracts/entropy-source/v1/schema.zt\n\n";
    "pub const FORMAT_VERSION: u32 = "; n.toText protocol.formatVersion; ";\n";
    "pub const ENTROPY_SOURCE_MAGIC: u32 = "; n.toText magic; ";\n";
    "pub const REQUEST_LEN: usize = "; n.toText protocol.requestLen; ";\n";
    "pub const REPLY_LEN: usize = "; n.toText protocol.replyLen; ";\n";
    "pub const MAX_FILL: usize = "; n.toText protocol.maxFill; ";\n";
    "pub const OP_FILL: u32 = "; n.toText protocol.opFill; ";\n";
    "pub const OP_RELEASE: u32 = "; n.toText protocol.opRelease; ";\n\n";
    "pub const STATUS_OK: i32 = "; n.toText protocol.statusOk; ";\n";
    "pub const STATUS_UNAVAILABLE: i32 = "; n.toText protocol.statusUnavailable; ";\n";
    "pub const STATUS_MALFORMED: i32 = "; n.toText protocol.statusMalformed; ";\n";
    "pub const STATUS_DEVICE_ERROR: i32 = "; n.toText protocol.statusDeviceError; ";\n\n";
    offsetConsts "REQUEST" 0 protocol.requestLayout;
    "\n";
    offsetConsts "REPLY" 0 protocol.replyLayout;
    "\n";
    wireStruct "WireEntropySourceRequest" "REQUEST" "REQUEST_LEN" protocol.requestLayout;
    "\n";
    wireStruct "WireEntropySourceReply" "REPLY" "REPLY_LEN" protocol.replyLayout;
  };

-- The reply's byte field holds exactly one maximal fill, and every refusal is
-- a distinct negative status, so a refusal can never read as device bytes.
valid :: Protocol -> Bool
  = protocol =>
    w.schemaFieldsValid protocol.requestFields
      && w.schemaFieldsValid protocol.replyFields
      && w.schemaNames protocol.requestFields == layoutNames protocol.requestLayout
      && w.schemaNames protocol.replyFields == layoutNames protocol.replyLayout
      && allValid protocol.requestLayout
      && allValid protocol.replyLayout
      && wireBytes protocol.requestLayout == protocol.requestLen
      && wireBytes protocol.replyLayout == protocol.replyLen
      && protocol.replyLen == 16 + protocol.maxFill
      && protocol.maxFill > 0
      && protocol.opFill > 0
      && protocol.opRelease > 0
      && protocol.opFill != protocol.opRelease
      && protocol.statusOk == 0
      && protocol.statusUnavailable < 0
      && protocol.statusMalformed < 0
      && protocol.statusDeviceError < 0
      && protocol.statusUnavailable != protocol.statusMalformed
      && protocol.statusUnavailable != protocol.statusDeviceError
      && protocol.statusMalformed != protocol.statusDeviceError;

render :: Protocol -> Text
  = protocol => if valid protocol then rustBindings protocol else "INVALID_ENTROPY_SOURCE_SCHEMA";

{ render =; }
