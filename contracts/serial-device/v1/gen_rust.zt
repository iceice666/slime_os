-- Pure renderer for Slime OS serial-device protocol bindings.

refl ::= import stdlib.reflect;
n ::= import stdlib.num;
w ::= import wire.rust;
c ::= import wire.codec;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

Protocol :: type {
  formatVersion : Int;
  requestLen : Int;
  replyLen : Int;
  maxPayload : Int;
  opWrite : Int;
  knownRequestFlags : Int;
  statusOk : Int;
  statusBadLength : Int;
  statusBadOp : Int;
  statusNoDevice : Int;
  statusDeviceError : Int;
  statusTimeout : Int;
  statusMalformed : Int;
  requestFields : List refl.SchemaField;
  replyFields : List refl.SchemaField;
  requestLayout : List WireField;
  replyLayout : List WireField;
};

layoutNames :: List WireField -> List Text = c.layoutNames;
allValid :: List WireField -> Bool = c.allValid;
wireBytes :: List WireField -> Int = c.wireBytes;
offsetConsts :: Text -> Int -> List WireField -> Text = c.offsetConsts;
wireStruct :: Text -> Text -> Text -> List WireField -> Text
  = name prefix lengthName fields => c.wireStruct "serial-device" name prefix lengthName fields;

-- "SRDV" as a little-endian u32.
magic :: Int = 1447318099;

rustBindings :: Protocol -> Text
  = protocol => w.join {
    "// @generated by contracts/serial-device/v1/gen_rust.zt; do not edit.\n";
    "// Source contract: contracts/serial-device/v1/schema.zt\n\n";
    "pub const FORMAT_VERSION: u16 = "; n.toText protocol.formatVersion; ";\n";
    "pub const SERIAL_MAGIC: u32 = "; n.toText magic; ";\n";
    "pub const REQUEST_LEN: usize = "; n.toText protocol.requestLen; ";\n";
    "pub const REPLY_LEN: usize = "; n.toText protocol.replyLen; ";\n";
    "pub const MAX_PAYLOAD: usize = "; n.toText protocol.maxPayload; ";\n";
    "pub const OP_WRITE: u8 = "; n.toText protocol.opWrite; ";\n";
    "pub const KNOWN_REQUEST_FLAGS: u8 = "; n.toText protocol.knownRequestFlags; ";\n\n";
    "pub const STATUS_OK: i32 = "; n.toText protocol.statusOk; ";\n";
    "pub const STATUS_BAD_LENGTH: i32 = "; n.toText protocol.statusBadLength; ";\n";
    "pub const STATUS_BAD_OP: i32 = "; n.toText protocol.statusBadOp; ";\n";
    "pub const STATUS_NO_DEVICE: i32 = "; n.toText protocol.statusNoDevice; ";\n";
    "pub const STATUS_DEVICE_ERROR: i32 = "; n.toText protocol.statusDeviceError; ";\n";
    "pub const STATUS_TIMEOUT: i32 = "; n.toText protocol.statusTimeout; ";\n";
    "pub const STATUS_MALFORMED: i32 = "; n.toText protocol.statusMalformed; ";\n\n";
    offsetConsts "REQUEST" 0 protocol.requestLayout;
    "\n";
    offsetConsts "REPLY" 0 protocol.replyLayout;
    "\n";
    wireStruct "WireSerialRequest" "REQUEST" "REQUEST_LEN" protocol.requestLayout;
    "\n";
    wireStruct "WireSerialReply" "REPLY" "REPLY_LEN" protocol.replyLayout;
  };

-- The request is exactly one kernel message and its payload is what remains
-- after the header; every refusal is a distinct negative status, so a client
-- can never mistake one for success.
valid :: Protocol -> Bool
  = protocol =>
    w.schemaFieldsValid protocol.requestFields
      && w.schemaFieldsValid protocol.replyFields
      && w.schemaNames protocol.requestFields == layoutNames protocol.requestLayout
      && w.schemaNames protocol.replyFields == layoutNames protocol.replyLayout
      && allValid protocol.requestLayout
      && allValid protocol.replyLayout
      && wireBytes protocol.requestLayout == protocol.requestLen
      && wireBytes protocol.replyLayout == protocol.replyLen
      && protocol.requestLen == 64
      && protocol.replyLen == 16
      && protocol.maxPayload == protocol.requestLen - 12
      && protocol.opWrite > 0
      && protocol.statusOk == 0
      && protocol.statusBadLength < 0
      && protocol.statusBadOp < 0
      && protocol.statusNoDevice < 0
      && protocol.statusDeviceError < 0
      && protocol.statusTimeout < 0
      && protocol.statusMalformed < 0
      && protocol.statusBadLength != protocol.statusBadOp
      && protocol.statusBadLength != protocol.statusNoDevice
      && protocol.statusBadLength != protocol.statusDeviceError
      && protocol.statusBadLength != protocol.statusTimeout
      && protocol.statusBadLength != protocol.statusMalformed
      && protocol.statusBadOp != protocol.statusNoDevice
      && protocol.statusBadOp != protocol.statusDeviceError
      && protocol.statusBadOp != protocol.statusTimeout
      && protocol.statusBadOp != protocol.statusMalformed
      && protocol.statusNoDevice != protocol.statusDeviceError
      && protocol.statusNoDevice != protocol.statusTimeout
      && protocol.statusNoDevice != protocol.statusMalformed
      && protocol.statusDeviceError != protocol.statusTimeout
      && protocol.statusDeviceError != protocol.statusMalformed
      && protocol.statusTimeout != protocol.statusMalformed;

render :: Protocol -> { rust : Text; }
  = protocol => if valid protocol
    then { rust = rustBindings protocol; }
    else { rust = "INVALID_SERIAL_DEVICE_SCHEMA"; };

{ render =; }
