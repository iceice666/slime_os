-- Slime OS serial-device transmit protocol, version 1.
--
-- One request hands a serial driver up to `maxPayload` bytes to put on its
-- line; the reply says how many it wrote and with what status. Requests are
-- the kernel's 64-byte message bound and replies 16, exchanged as one call
-- over the driver's endpoint, so a client is parked on the reply rather than
-- the driver on the client.
--
-- The driver is byte-transparent: framing belongs to the client. Line
-- configuration (clock, divisor, register stride) is the platform's and never
-- travels in this protocol. Unused payload bytes and reserved storage are zero,
-- so every admissible encoding is canonical.

env ::= import stdlib.env;
fs ::= import stdlib.fs;
gen ::= import "gen_rust.zt";
t ::= import stdlib.text;

formatVersion :: Int = 1;
requestLen :: Int = 64;
replyLen :: Int = 16;
maxPayload :: Int = 52;

opWrite :: Int = 1;
knownRequestFlags :: Int = 0;

statusOk :: Int = 0;
statusBadLength :: Int = -1;
statusBadOp :: Int = -2;
statusNoDevice :: Int = -3;
statusDeviceError :: Int = -4;
statusTimeout :: Int = -5;
statusMalformed :: Int = -6;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

-- `length` is the number of leading payload bytes to transmit, 1 to
-- `maxPayload` inclusive.
SerialRequest :: type {
  magic : Int;
  version : Int;
  op : Int;
  flags : Int;
  length : Int;
  reserved : Int;
  payload : Int;
};

-- `bytes_written` counts bytes the line accepted before the status was
-- decided: all of them on `statusOk`, the prefix on `statusTimeout`, zero
-- otherwise. `detail` is the line's transmitter-empty bits at completion.
SerialReply :: type {
  magic : Int;
  version : Int;
  bytes_written : Int;
  status : Int;
  detail : Int;
};

requestSchema ::= schema SerialRequest;
replySchema ::= schema SerialReply;

requestLayout :: List WireField = {
  { name = "magic"; width = 4; signed = false; byteArray = false; };
  { name = "version"; width = 2; signed = false; byteArray = false; };
  { name = "op"; width = 1; signed = false; byteArray = false; };
  { name = "flags"; width = 1; signed = false; byteArray = false; };
  { name = "length"; width = 2; signed = false; byteArray = false; };
  { name = "reserved"; width = 2; signed = false; byteArray = true; };
  { name = "payload"; width = 52; signed = false; byteArray = true; };
};

replyLayout :: List WireField = {
  { name = "magic"; width = 4; signed = false; byteArray = false; };
  { name = "version"; width = 2; signed = false; byteArray = false; };
  { name = "bytes_written"; width = 2; signed = false; byteArray = false; };
  { name = "status"; width = 4; signed = true; byteArray = false; };
  { name = "detail"; width = 4; signed = false; byteArray = false; };
};

protocol ::= {
  formatVersion =;
  requestLen =;
  replyLen =;
  maxPayload =;
  opWrite =;
  knownRequestFlags =;
  statusOk =;
  statusBadLength =;
  statusBadOp =;
  statusNoDevice =;
  statusDeviceError =;
  statusTimeout =;
  statusMalformed =;
  requestFields = requestSchema.fields ?? {;};
  replyFields = replySchema.fields ?? {;};
  requestLayout =;
  replyLayout =;
};

main :: { write : FsWrite; env : Env; } -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_SERIAL_DEVICE_BINDINGS_ROOT" ?? ".";
    bindings := gen.render protocol;
    path := t.join "" { root; "/components/proto/src/serial_device.rs"; };
    fs.writeAll caps.write path bindings.rust
  ];

main
