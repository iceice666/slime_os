schema ::= import "schema.zt";
env ::= import stdlib.env;
fs ::= import stdlib.fs;
n ::= import stdlib.num;
t ::= import stdlib.text;

line :: Text -> Int -> Text
  = name value => t.join "" { name; " = "; n.toText value; "\n"; };

render :: Text = t.join "" {
  "# @generated by contracts/closure-resolution/v1/gen_python.zt; do not edit.\n";
  line "FORMAT_VERSION" schema.formatVersion;
  line "MAX_NAME_BYTES" schema.maxNameBytes;
  line "DERIVATION_ID_BYTES" schema.derivationIdBytes;
};

main :: { write : FsWrite; env : Env; }
  -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_CLOSURE_RESOLUTION_BINDINGS_ROOT" ?? ".";
    path := t.join "" { root; "/closure_resolution_contract.py"; };
    fs.writeAll caps.write path render
  ];

main
