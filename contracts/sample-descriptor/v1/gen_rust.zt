-- Pure renderer for Slime OS sample-descriptor protocol bindings (C7.6).

refl ::= import stdlib.reflect;
n ::= import stdlib.num;
t ::= import stdlib.text;
w ::= import wire.rust;
c ::= import wire.codec;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

Protocol :: type {
  formatVersion : Int;
  descriptorLen : Int;
  maxSampleBytes : Int;
  capabilityKindLoan : Int;
  flagLast : Int;
  knownFlags : Int;
  descriptorFields : List refl.SchemaField;
  descriptorLayout : List WireField;
};

-- Offset and codec emitters come from `wire.codec`, which owns the
-- byte-array-aware mechanics fourteen renderers previously each copied. The
-- validity predicate below stays here: what makes *this* layout admissible is
-- contract-specific.
layoutNames :: List WireField -> List Text = c.layoutNames;
allValid :: List WireField -> Bool = c.allValid;
wireBytes :: List WireField -> Int = c.wireBytes;
offsetConsts :: Text -> Int -> List WireField -> Text = c.offsetConsts;
wireStruct :: Text -> Text -> Text -> List WireField -> Text
  = name prefix lengthName fields => c.wireStruct "sample-descriptor" name prefix lengthName fields;


rustBindings :: Protocol -> Text
  = protocol => w.join {
    "// @generated by contracts/sample-descriptor/v1/gen_rust.zt; do not edit.\n";
    "// Source contract: contracts/sample-descriptor/v1/schema.zt\n\n";
    "pub const FORMAT_VERSION: u32 = "; n.toText protocol.formatVersion; ";\n";
    "pub const SAMPLE_DESCRIPTOR_MAGIC: u32 = 1146113363;\n";
    "pub const DESCRIPTOR_LEN: usize = "; n.toText protocol.descriptorLen; ";\n";
    "pub const MAX_SAMPLE_BYTES: usize = "; n.toText protocol.maxSampleBytes; ";\n";
    "pub const CAPABILITY_KIND_LOAN: u32 = "; n.toText protocol.capabilityKindLoan; ";\n";
    "pub const FLAG_LAST: u32 = "; n.toText protocol.flagLast; ";\n";
    "pub const KNOWN_FLAGS: u32 = "; n.toText protocol.knownFlags; ";\n\n";
    offsetConsts "DESCRIPTOR" 0 protocol.descriptorLayout;
    "\n";
    wireStruct "WireSampleDescriptor" "DESCRIPTOR" "DESCRIPTOR_LEN" protocol.descriptorLayout;
  };

valid :: Protocol -> Bool
  = protocol =>
    w.schemaFieldsValid protocol.descriptorFields
      && w.schemaNames protocol.descriptorFields == layoutNames protocol.descriptorLayout
      && allValid protocol.descriptorLayout
      && wireBytes protocol.descriptorLayout <= protocol.descriptorLen;

render :: Protocol -> { rust : Text; }
  = protocol => if valid protocol
    then { rust = rustBindings protocol; }
    else { rust = "INVALID_SAMPLE_DESCRIPTOR_SCHEMA"; };

{ render =; }
