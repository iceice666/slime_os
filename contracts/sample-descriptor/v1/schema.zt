-- Slime OS sample descriptor, version 1 (C7.6).
--
-- A descriptor is a fixed control message that fits the existing channel
-- message bound (MAX_MSG = 64 bytes) and references an exact transferred
-- shared-buffer loan: its capability kind, unforgeable loan identity, the
-- offset and length of the sample bytes within the loaned region, a type
-- identity, a monotonic sequence, and declared flags. The descriptor travels
-- through an ordinary channel while the payload bytes stay in the shared
-- buffer, so a sample larger than MAX_MSG never copies through the kernel
-- message queue.
--
-- Logical record and concrete packed little-endian layout live together. The
-- renderer reflects the record, checks field order against the layout, and
-- writes the Rust binding fragment consumed by slime-proto.

env ::= import stdlib.env;
fs ::= import stdlib.fs;
gen ::= import "gen_rust.zt";
t ::= import stdlib.text;

formatVersion :: Int = 1;
descriptorLen :: Int = 64;
maxSampleBytes :: Int = 1048576;
capabilityKindLoan :: Int = 1;
flagLast :: Int = 1;
knownFlags :: Int = 1;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

SampleDescriptor :: type {
  magic : Int;
  version : Int;
  flags : Int;
  capability_kind : Int;
  loan_id : Int;
  offset : Int;
  length : Int;
  type_identity : Int;
  sequence : Int;
  reserved : Int;
};

descriptorSchema ::= schema SampleDescriptor;

descriptorLayout :: List WireField = {
  { name = "magic"; width = 4; signed = false; byteArray = false; };
  { name = "version"; width = 4; signed = false; byteArray = false; };
  { name = "flags"; width = 4; signed = false; byteArray = false; };
  { name = "capability_kind"; width = 4; signed = false; byteArray = false; };
  { name = "loan_id"; width = 8; signed = false; byteArray = false; };
  { name = "offset"; width = 8; signed = false; byteArray = false; };
  { name = "length"; width = 8; signed = false; byteArray = false; };
  { name = "type_identity"; width = 8; signed = false; byteArray = false; };
  { name = "sequence"; width = 8; signed = false; byteArray = false; };
  { name = "reserved"; width = 8; signed = false; byteArray = true; };
};

format ::= {
  formatVersion = formatVersion;
  descriptorLen = descriptorLen;
  maxSampleBytes = maxSampleBytes;
  capabilityKindLoan = capabilityKindLoan;
  flagLast = flagLast;
  knownFlags = knownFlags;
  descriptorFields = descriptorSchema.fields ?? {;};
  descriptorLayout = descriptorLayout;
};

main :: { write : FsWrite; env : Env; } -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_SAMPLE_DESCRIPTOR_BINDINGS_ROOT" ?? ".";
    bindings := gen.render format;
    path := t.join "" { root; "/components/proto/src/sample_descriptor.rs"; };
    fs.writeAll caps.write path bindings.rust
  ];

main
