-- Pure renderer for Slime OS pwm-servo protocol bindings: the Rust module the
-- driver and probes import, and the C header the Slisp component encodes with.

refl ::= import stdlib.reflect;
n ::= import stdlib.num;
t ::= import stdlib.text;
w ::= import wire.rust;
c ::= import wire.codec;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

Protocol :: type {
  formatVersion : Int;
  requestLen : Int;
  replyLen : Int;
  maxChannel : Int;
  minPeriodUs : Int;
  maxPeriodUs : Int;
  minPulseUs : Int;
  maxPulseUs : Int;
  pulseDisable : Int;
  clockHz : Int;
  failsafeNs : Int;
  statusOk : Int;
  statusBadChannel : Int;
  statusBadPeriod : Int;
  statusBadPulse : Int;
  statusNoDevice : Int;
  statusDeviceError : Int;
  statusMalformed : Int;
  requestFields : List refl.SchemaField;
  replyFields : List refl.SchemaField;
  requestLayout : List WireField;
  replyLayout : List WireField;
};

layoutNames :: List WireField -> List Text = c.layoutNames;
allValid :: List WireField -> Bool = c.allValid;
wireBytes :: List WireField -> Int = c.wireBytes;
offsetConsts :: Text -> Int -> List WireField -> Text = c.offsetConsts;
wireStruct :: Text -> Text -> Text -> List WireField -> Text
  = name prefix lengthName fields => c.wireStruct "pwm_servo" name prefix lengthName fields;

-- "PWMS" as a little-endian u32.
magic :: Int = 1397577552;

rustBindings :: Protocol -> Text
  = protocol => w.join {
    "// @generated by contracts/pwm-servo/v1/gen_rust.zt; do not edit.\n";
    "// Source contract: contracts/pwm-servo/v1/schema.zt\n\n";
    "pub const FORMAT_VERSION: u32 = "; n.toText protocol.formatVersion; ";\n";
    "pub const PWM_SERVO_MAGIC: u32 = "; n.toText magic; ";\n";
    "pub const REQUEST_LEN: usize = "; n.toText protocol.requestLen; ";\n";
    "pub const REPLY_LEN: usize = "; n.toText protocol.replyLen; ";\n";
    "pub const MAX_CHANNEL: u32 = "; n.toText protocol.maxChannel; ";\n";
    "pub const MIN_PERIOD_US: u32 = "; n.toText protocol.minPeriodUs; ";\n";
    "pub const MAX_PERIOD_US: u32 = "; n.toText protocol.maxPeriodUs; ";\n";
    "pub const MIN_PULSE_US: u32 = "; n.toText protocol.minPulseUs; ";\n";
    "pub const MAX_PULSE_US: u32 = "; n.toText protocol.maxPulseUs; ";\n";
    "pub const PULSE_DISABLE: u32 = "; n.toText protocol.pulseDisable; ";\n";
    "pub const CLOCK_HZ: u32 = "; n.toText protocol.clockHz; ";\n";
    "pub const FAILSAFE_NS: u64 = "; n.toText protocol.failsafeNs; ";\n\n";
    "pub const STATUS_OK: i32 = "; n.toText protocol.statusOk; ";\n";
    "pub const STATUS_BAD_CHANNEL: i32 = "; n.toText protocol.statusBadChannel; ";\n";
    "pub const STATUS_BAD_PERIOD: i32 = "; n.toText protocol.statusBadPeriod; ";\n";
    "pub const STATUS_BAD_PULSE: i32 = "; n.toText protocol.statusBadPulse; ";\n";
    "pub const STATUS_NO_DEVICE: i32 = "; n.toText protocol.statusNoDevice; ";\n";
    "pub const STATUS_DEVICE_ERROR: i32 = "; n.toText protocol.statusDeviceError; ";\n";
    "pub const STATUS_MALFORMED: i32 = "; n.toText protocol.statusMalformed; ";\n\n";
    offsetConsts "REQUEST" 0 protocol.requestLayout;
    "\n";
    offsetConsts "REPLY" 0 protocol.replyLayout;
    "\n";
    wireStruct "WirePwmServoRequest" "REQUEST" "REQUEST_LEN" protocol.requestLayout;
    "\n";
    wireStruct "WirePwmServoReply" "REPLY" "REPLY_LEN" protocol.replyLayout;
  };

cOffsetConsts :: Text -> Int -> List WireField -> Text
  = prefix offset fields => match fields {
    | {;} => "";
    | { field; ...rest } => w.join {
      "#define SLIME_PWM_SERVO_OFF_"; prefix; "_"; t.toUpper field.name; " "; n.toText offset; "U\n";
      cOffsetConsts prefix (offset + field.width) rest;
    };
  };

cBindings :: Protocol -> Text
  = protocol => w.join {
    "/* @generated by contracts/pwm-servo/v1/gen_rust.zt; do not edit. */\n";
    "/* Source contract: contracts/pwm-servo/v1/schema.zt */\n";
    "#ifndef SLIME_PWM_SERVO_H\n#define SLIME_PWM_SERVO_H\n\n";
    "#include <stddef.h>\n#include <stdint.h>\n\n";
    "#define SLIME_PWM_SERVO_FORMAT_VERSION "; n.toText protocol.formatVersion; "U\n";
    "#define SLIME_PWM_SERVO_MAGIC "; n.toText magic; "U\n";
    "#define SLIME_PWM_SERVO_REQUEST_LEN "; n.toText protocol.requestLen; "U\n";
    "#define SLIME_PWM_SERVO_REPLY_LEN "; n.toText protocol.replyLen; "U\n";
    "#define SLIME_PWM_SERVO_MAX_CHANNEL "; n.toText protocol.maxChannel; "U\n";
    "#define SLIME_PWM_SERVO_MIN_PERIOD_US "; n.toText protocol.minPeriodUs; "U\n";
    "#define SLIME_PWM_SERVO_MAX_PERIOD_US "; n.toText protocol.maxPeriodUs; "U\n";
    "#define SLIME_PWM_SERVO_MIN_PULSE_US "; n.toText protocol.minPulseUs; "U\n";
    "#define SLIME_PWM_SERVO_MAX_PULSE_US "; n.toText protocol.maxPulseUs; "U\n";
    "#define SLIME_PWM_SERVO_PULSE_DISABLE "; n.toText protocol.pulseDisable; "U\n";
    "#define SLIME_PWM_SERVO_CLOCK_HZ "; n.toText protocol.clockHz; "U\n";
    "#define SLIME_PWM_SERVO_STATUS_OK "; n.toText protocol.statusOk; "\n";
    "#define SLIME_PWM_SERVO_STATUS_BAD_CHANNEL ("; n.toText protocol.statusBadChannel; ")\n";
    "#define SLIME_PWM_SERVO_STATUS_BAD_PERIOD ("; n.toText protocol.statusBadPeriod; ")\n";
    "#define SLIME_PWM_SERVO_STATUS_BAD_PULSE ("; n.toText protocol.statusBadPulse; ")\n";
    "#define SLIME_PWM_SERVO_STATUS_NO_DEVICE ("; n.toText protocol.statusNoDevice; ")\n";
    "#define SLIME_PWM_SERVO_STATUS_DEVICE_ERROR ("; n.toText protocol.statusDeviceError; ")\n";
    "#define SLIME_PWM_SERVO_STATUS_MALFORMED ("; n.toText protocol.statusMalformed; ")\n\n";
    cOffsetConsts "REQUEST" 0 protocol.requestLayout;
    cOffsetConsts "REPLY" 0 protocol.replyLayout;
    "\ntypedef struct {\n";
    "    uint32_t channel;\n    uint32_t period_us;\n    uint32_t pulse_us;\n    uint32_t flags;\n";
    "} SlimePwmServoRequest;\n\n";
    "typedef struct {\n    int32_t status;\n    uint32_t detail;\n} SlimePwmServoReply;\n\n";
    "static inline void slime_pwm_servo_store_u32(uint8_t *out, uint32_t value)\n{\n";
    "    size_t index;\n    for (index = 0; index < 4; ++index) { out[index] = (uint8_t)(value >> (index * 8)); }\n}\n\n";
    "static inline uint32_t slime_pwm_servo_load_u32(const uint8_t *in)\n{\n";
    "    size_t index;\n    uint32_t value = 0;\n    for (index = 0; index < 4; ++index) { value |= (uint32_t)in[index] << (index * 8); }\n    return value;\n}\n\n";
    "static inline void slime_pwm_servo_request_encode(const SlimePwmServoRequest *request, uint8_t out[SLIME_PWM_SERVO_REQUEST_LEN])\n{\n";
    "    size_t index;\n    for (index = 0; index < SLIME_PWM_SERVO_REQUEST_LEN; ++index) { out[index] = 0; }\n";
    "    slime_pwm_servo_store_u32(out + SLIME_PWM_SERVO_OFF_REQUEST_MAGIC, SLIME_PWM_SERVO_MAGIC);\n";
    "    slime_pwm_servo_store_u32(out + SLIME_PWM_SERVO_OFF_REQUEST_VERSION, SLIME_PWM_SERVO_FORMAT_VERSION);\n";
    "    slime_pwm_servo_store_u32(out + SLIME_PWM_SERVO_OFF_REQUEST_CHANNEL, request->channel);\n";
    "    slime_pwm_servo_store_u32(out + SLIME_PWM_SERVO_OFF_REQUEST_PERIOD_US, request->period_us);\n";
    "    slime_pwm_servo_store_u32(out + SLIME_PWM_SERVO_OFF_REQUEST_PULSE_US, request->pulse_us);\n";
    "    slime_pwm_servo_store_u32(out + SLIME_PWM_SERVO_OFF_REQUEST_FLAGS, request->flags);\n}\n\n";
    "static inline int slime_pwm_servo_reply_decode(const uint8_t *in, size_t len, SlimePwmServoReply *reply)\n{\n";
    "    if (len < SLIME_PWM_SERVO_REPLY_LEN || reply == NULL\n";
    "        || slime_pwm_servo_load_u32(in + SLIME_PWM_SERVO_OFF_REPLY_MAGIC) != SLIME_PWM_SERVO_MAGIC\n";
    "        || slime_pwm_servo_load_u32(in + SLIME_PWM_SERVO_OFF_REPLY_VERSION) != SLIME_PWM_SERVO_FORMAT_VERSION) { return 0; }\n";
    "    reply->status = (int32_t)slime_pwm_servo_load_u32(in + SLIME_PWM_SERVO_OFF_REPLY_STATUS);\n";
    "    reply->detail = slime_pwm_servo_load_u32(in + SLIME_PWM_SERVO_OFF_REPLY_DETAIL);\n    return 1;\n}\n\n";
    "#endif\n";
  };

-- The bounds must nest (a pulse fits in a period) and every refusal must be a
-- distinct negative status, so a client can never mistake one for success.
valid :: Protocol -> Bool
  = protocol =>
    w.schemaFieldsValid protocol.requestFields
      && w.schemaFieldsValid protocol.replyFields
      && w.schemaNames protocol.requestFields == layoutNames protocol.requestLayout
      && w.schemaNames protocol.replyFields == layoutNames protocol.replyLayout
      && allValid protocol.requestLayout
      && allValid protocol.replyLayout
      && wireBytes protocol.requestLayout == protocol.requestLen
      && wireBytes protocol.replyLayout == protocol.replyLen
      && protocol.minPulseUs > protocol.pulseDisable
      && protocol.minPulseUs < protocol.maxPulseUs
      && protocol.maxPulseUs <= protocol.minPeriodUs
      && protocol.minPeriodUs < protocol.maxPeriodUs
      && protocol.statusOk == 0
      && protocol.statusBadChannel < 0
      && protocol.statusBadPeriod < 0
      && protocol.statusBadPulse < 0
      && protocol.statusNoDevice < 0
      && protocol.statusDeviceError < 0
      && protocol.statusMalformed < 0
      && protocol.statusBadChannel != protocol.statusBadPeriod
      && protocol.statusBadChannel != protocol.statusBadPulse
      && protocol.statusBadChannel != protocol.statusNoDevice
      && protocol.statusBadChannel != protocol.statusDeviceError
      && protocol.statusBadChannel != protocol.statusMalformed
      && protocol.statusBadPeriod != protocol.statusBadPulse
      && protocol.statusBadPeriod != protocol.statusNoDevice
      && protocol.statusBadPeriod != protocol.statusDeviceError
      && protocol.statusBadPeriod != protocol.statusMalformed
      && protocol.statusBadPulse != protocol.statusNoDevice
      && protocol.statusBadPulse != protocol.statusDeviceError
      && protocol.statusBadPulse != protocol.statusMalformed
      && protocol.statusNoDevice != protocol.statusDeviceError
      && protocol.statusNoDevice != protocol.statusMalformed
      && protocol.statusDeviceError != protocol.statusMalformed;

render :: Protocol -> { rust : Text; c : Text; }
  = protocol => if valid protocol
    then { rust = rustBindings protocol; c = cBindings protocol; }
    else { rust = "INVALID_PWM_SERVO_SCHEMA"; c = "INVALID_PWM_SERVO_SCHEMA"; };

{ render =; }
