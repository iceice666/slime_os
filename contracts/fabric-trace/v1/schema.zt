-- Slime OS bounded semantic-trace record, version 1 (C8.11).
--
-- One fixed 64-byte record carries every trace family the fabric emits:
-- schema admission, route provisioning, QoS policy, call, operation,
-- visibility, interposition, denial, fault, and resource high-water evidence.
-- A single kind-discriminated record rather than ten layouts, for two reasons
-- the sink forces. The sink is a bounded array of equal-width slots, so ten
-- layouts would size every slot to the widest of them anyway; and the declared
-- total order compares `now_ns` and `order_class` across families, which needs
-- those fields at one fixed offset rather than ten.
--
-- Nothing here names a task, an address, a capability, or a scheduler
-- observation. `route_identity` is the C8.2 folded route identity, which is
-- already the graph's own name for an edge; `correlation` is the request or
-- sample correlation the plane assigned. A reader that wants to know *which
-- task* emitted a record cannot learn it from these bytes, which is the point:
-- a trace that carried task ids would not be comparable across boots.
--
-- `order_class` is the declared tie order. Two records bearing equal `now_ns`
-- are emitted in ascending `order_class`, and within one class in ascending
-- `sequence`. The four classes are the four things a worker can observe at one
-- simulated instant: data, an acknowledgement, a peer death, and the clock
-- itself. Time sorts last because a time advance closes an instant rather than
-- occurring within it.

env ::= import stdlib.env;
fs ::= import stdlib.fs;
gen ::= import "gen_rust.zt";
t ::= import stdlib.text;

formatVersion :: Int = 1;
recordLen :: Int = 64;
magic :: Int = 1163084372; -- `TRCT`

-- Trace families. Each names one evidence class C8.11 requires; a record whose
-- `kind` is outside this set is rejected rather than skipped, so a future
-- family cannot be silently dropped by an older reader.
kindSchema :: Int = 1;
kindRoute :: Int = 2;
kindQos :: Int = 3;
kindCall :: Int = 4;
kindOperation :: Int = 5;
kindVisibility :: Int = 6;
kindInterposition :: Int = 7;
kindDenial :: Int = 8;
kindFault :: Int = 9;
kindResource :: Int = 10;
maxKind :: Int = 10;

-- Which count a `resource` record carries. C8.11 records resource *high-water*
-- evidence, and a bare number is not evidence unless the reader knows what was
-- counted -- so the `event` field on a resource record names the counter rather
-- than being reused as a QoS event code. `sinkDropped` is the sink reporting on
-- itself; the rest are the bounded tables a worker holds.
--
-- C8.13 records each of `resourceBuffers`, `resourceRetries`, and
-- `resourceRetained` *twice* per worker under its own code where the counted
-- table is held-and-released (buffers, retained results): once as the
-- historical peak, taken while traffic runs, and again -- always later, since
-- a worker's own clock only advances -- as the value observed once the
-- scenario has drained, right before the terminal record. `resourceRetries`
-- is cumulative rather than held-and-released and carries only the peak. Two
-- records under one counter rather than a distinct baseline code, because the
-- fact a reader needs is "this counter, then and now", and the total order
-- the format already guarantees (a worker's own records are non-decreasing in
-- `now_ns`/`sequence`) is what tells the two apart without adding a bit whose
-- only job would be restating that order.
--
-- `resourceQueue` and `resourceHistory` extend the same held-and-released
-- convention to two more bounded tables the stream worker holds: the
-- per-subscriber outstanding-delivery count (`resourceQueue`, bounded in
-- practice by the subscriber's own ring/history capacity and QoS retry
-- policy -- nothing currently enforces the graph-wide `queueDepth` field
-- against it) and KEEP_LAST backlog occupancy (`resourceHistory`, bounded by
-- each participant's declared `historyDepth`).
--
-- `resourceMapping` and `resourceLoan` are the shared-buffer *occupancy* a
-- holder reports about itself: its own live charges as the root's
-- `SharedBufferTable` accounts them, rather than as the worker counts its own
-- frames. The two disagreeing is the accounting regression they exist to
-- catch. Both became expressible only once a self-scoped query existed to
-- observe them: until then every component-side shared-buffer operation
-- returned success or a fresh handle and never a live occupancy, so a worker
-- could report a provisioning-time constant but not evidence.
--
-- They follow the held-and-released convention with different expected shapes,
-- and each shape is the assertion. A region is mapped when a role is
-- provisioned and stays mapped while its holder lives, so `resourceMapping`'s
-- baseline equals its peak, and a baseline that had drained instead would mean
-- a mapping was lost. `resourceLoan` is the traffic-varying half: it rises as
-- receivers take loans and returns to zero as each settles (measured 0 to 5 and
-- back). A counter whose value cannot move is still evidence when *not moving*
-- is the invariant; it is not evidence when the number is merely a capacity
-- every boot would report identically.
--
-- Two kinds of holder report `resourceMapping`, and the difference is worth
-- stating because it decides what the equality proves. A broker has a sweep
-- loop: it samples per sweep and reads a genuine post-drain baseline, so both
-- halves are measured (the stream broker, a flat 6 across a whole boot). A
-- scripted participant has no loop: it reads its occupancy once, at the end,
-- and records that number twice, because serial writes must stay off the path
-- of the traffic they describe. Its pair is therefore identical by
-- construction, and what carries the evidence is the value -- the count of
-- regions its role was provisioned, 1 or 2 for the four stream participants,
-- which a reader checks against the graph rather than against a drain. Such a
-- holder's transient peaks go unreported by design: a receiver mapping an
-- arriving loan, or a lender holding a copy it lent, is released before the
-- report.
--
-- Which holder emits which counter is bounded by trace-sink capacity and by
-- whether the holder has anything to report, not by interest. Three of the
-- eight holders the traffic graph declares report nothing, each for a distinct
-- reason: the call worker holds the same loan and mapping state but spends all
-- 62 of its ordinary records on evidence C8.4-C8.13 already verify, and
-- reporting both counters there would cost four more (a peak and a baseline
-- each) against a `maxTraceDepth` that is a page-sized ceiling rather than a
-- fixture value; the call client's own charge lives and dies inside one helper,
-- so it holds nothing at any point it could report and its pair could only be
-- a measured zero; and the call server ends by exiting mid-loop on an injected
-- peer death, so it never reaches a flush.
--
-- Emission of these counters is per-plane, not unconditional per worker: a
-- worker records one only when its own generation drives the traffic that
-- makes the counter meaningful and declares enough `traceDepth` to carry it.
-- The stream worker, for one, records `resourceBuffers`, `resourceQueue`,
-- `resourceHistory`, and `resourceRetries` only under the concurrent-traffic
-- action -- absence from a given trace is silence about a ceiling that
-- plane's own scenario does not exercise, not a validator refusal.
--
-- `resourceCapabilitySlots` is the same discipline applied to the one declared
-- ceiling that had no signal of any kind: `capabilitySlots`. Until C8.13.3
-- nothing in the root tracked a live child's slot occupancy, so the field was
-- only ever compared to a fixed global constant at decode time, and no query
-- could have returned it.
--
-- What this counter carries is occupancy in the space that ceiling actually
-- bounds: the holder's own logical slot numbering from 0, which the generation
-- builder budgets as `FABRIC_FIRST_CONTROL_SLOT + control endpoints + buffers`.
-- The root reports the physical child-CNode count alongside it, and that number
-- is deliberately *not* what lands here: a logical index of 3 lives at physical
-- slot 36, so a reader comparing the physical count to `capabilitySlots` would
-- be comparing quantities from different spaces.
--
-- Its pair is peak then live, and unlike `resourceMapping` it genuinely drains:
-- measured at peak 33 and baseline 29 on the traffic plane, because the broker
-- installs a control endpoint per participant plus its own factories and then
-- drops the supervision handles it no longer waits on. So it carries
-- `resourceLoan`'s held-and-released shape rather than `resourceMapping`'s
-- constant one -- a nonzero peak with a baseline bounded by it.
resourceFrames :: Int = 1;
resourceOperations :: Int = 2;
resourceCalls :: Int = 3;
resourceSinkDropped :: Int = 4;
resourceRoles :: Int = 5;
resourceBuffers :: Int = 6;
resourceRetries :: Int = 7;
resourceRetained :: Int = 8;
resourceQueue :: Int = 9;
resourceHistory :: Int = 10;
resourceEvent :: Int = 11;
resourceLoan :: Int = 12;
resourceMapping :: Int = 13;
resourceCapabilitySlots :: Int = 14;
resourceComplete :: Int = 15;
maxResourceCounter :: Int = 15;

-- What a `visibility` or `interposition` record's `event` names. Both families
-- are graph-shaped -- an edge, no outcome code, and an event saying what was
-- observed or traversed over it -- so the event is the only field carrying
-- meaning and it is schema-owned for the same reason the resource counters
-- above are: a bare nonzero number is not evidence unless the reader knows
-- what it names, and two runs reporting different events would otherwise
-- compare as equal.
graphViewAnswered :: Int = 1;
graphHopTraversed :: Int = 2;
maxGraphEvent :: Int = 2;

-- The declared total tie order across everything observable at one instant.
orderData :: Int = 1;
orderAck :: Int = 2;
orderPeerDeath :: Int = 3;
orderTime :: Int = 4;
maxOrderClass :: Int = 4;

-- `terminal` marks a record the sink must never drop: the mandatory
-- end-of-stream evidence a reader needs to distinguish a completed trace from
-- a truncated one. `dropped` marks the single saturation record that reports
-- how many records a full sink refused, so loss is counted rather than silent.
flagTerminal :: Int = 1;
flagDropped :: Int = 2;
knownFlags :: Int = 3;

-- Overflow discipline a generation may declare. `saturate` refuses further
-- ordinary records once the sink is full and counts them, then reports the
-- count in one record flagged `dropped`.
--
-- Only one discipline, deliberately. Evicting the *oldest* record to make room
-- was the obvious alternative and is worse here: the earliest records are the
-- schema-admission and route-provisioning evidence a reader needs to interpret
-- everything after them, so evicting them to admit later traffic destroys the
-- more valuable half of the trace. A second code would also be a wire value no
-- component implements, which is a format promising behaviour that does not
-- exist. A future discipline gets a value and an implementation together.
overflowSaturate :: Int = 1;
maxOverflow :: Int = 1;

-- Structural ceiling on the sink capacity a generation may declare, and the
-- slots held back for mandatory terminal records. The reservation is part of
-- the format rather than a component's choice: a sink that could spend its
-- last slot on ordinary evidence would have nowhere to write the record that
-- says the trace ended.
maxTraceDepth :: Int = 64;
terminalReserve :: Int = 2;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

TraceRecord :: type {
  magic : Int;
  version : Int;
  kind : Int;
  flags : Int;
  route_identity : Int;
  correlation : Int;
  sequence : Int;
  now_ns : Int;
  status : Int;
  event : Int;
  high_water : Int;
  order_class : Int;
  reserved : Int;
};

schemaValue ::= schema TraceRecord;

layout :: List WireField = {
  { name = "magic"; width = 4; signed = false; byteArray = false; };
  { name = "version"; width = 4; signed = false; byteArray = false; };
  { name = "kind"; width = 4; signed = false; byteArray = false; };
  { name = "flags"; width = 4; signed = false; byteArray = false; };
  { name = "route_identity"; width = 8; signed = false; byteArray = false; };
  { name = "correlation"; width = 8; signed = false; byteArray = false; };
  { name = "sequence"; width = 8; signed = false; byteArray = false; };
  { name = "now_ns"; width = 8; signed = false; byteArray = false; };
  { name = "status"; width = 4; signed = true; byteArray = false; };
  { name = "event"; width = 4; signed = false; byteArray = false; };
  { name = "high_water"; width = 4; signed = false; byteArray = false; };
  { name = "order_class"; width = 1; signed = false; byteArray = false; };
  { name = "reserved"; width = 3; signed = false; byteArray = true; };
};

format ::= {
  formatVersion =;
  recordLen =;
  magic =;
  kindSchema =;
  kindRoute =;
  kindQos =;
  kindCall =;
  kindOperation =;
  kindVisibility =;
  kindInterposition =;
  kindDenial =;
  kindFault =;
  kindResource =;
  maxKind =;
  resourceFrames =;
  resourceOperations =;
  resourceCalls =;
  resourceSinkDropped =;
  resourceRoles =;
  resourceBuffers =;
  resourceRetries =;
  resourceRetained =;
  resourceQueue =;
  resourceHistory =;
  resourceEvent =;
  resourceLoan =;
  resourceMapping =;
  resourceCapabilitySlots =;
  resourceComplete =;
  maxResourceCounter =;
  graphViewAnswered =;
  graphHopTraversed =;
  maxGraphEvent =;
  orderData =;
  orderAck =;
  orderPeerDeath =;
  orderTime =;
  maxOrderClass =;
  flagTerminal =;
  flagDropped =;
  knownFlags =;
  overflowSaturate =;
  maxOverflow =;
  maxTraceDepth =;
  terminalReserve =;
  fields = schemaValue.fields ?? {;};
  layout =;
};

main :: { write : FsWrite; env : Env; } -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_FABRIC_TRACE_BINDINGS_ROOT" ?? ".";
    bindings := gen.render format;
    rustPath := t.join "" { root; "/components/proto/src/fabric_trace.rs"; };
    pythonPath := t.join "" { root; "/scripts/lib/fabric_trace_contract.py"; };
    fs.writeAll caps.write rustPath bindings.rust;
    fs.writeAll caps.write pythonPath bindings.python
  ];

main
