-- Slime OS target-profile table, version 1 (P0).
--
-- A target profile is a complete executable and platform contract, not only an
-- instruction set. Two artifacts belong to the same profile only when their
-- architecture, architecture-qualified ABI, page profile, and required-feature
-- set all agree; a different page granule, privilege model, firmware handoff,
-- or board topology is a new profile until its own checks pass.
--
-- This table is the single source of truth for those identifiers. It is not
-- itself a wire format -- nothing serializes a profile record -- but every
-- field it names *is* serialized: component-image v2 and kernel-image v2 carry
-- `architecture`, `abi`, `page_profile`, and `required_features` in their
-- headers, and the generation/release `target` string carries `name`. Rendering
-- one table into both the host builder and the Rust admission path is what
-- keeps the builder that emits those headers and the decoder that admits them
-- from disagreeing by inspection.
--
-- Numeric identifiers are dense and stable: a value is never reused for a
-- different meaning, because retained rollback-window artifacts still carry the
-- old encoding. `requiredFeatures` is a bitmask an image must declare exactly;
-- it is not a "supported" set the platform may exceed, so an image asking for a
-- feature the profile does not name fails closed rather than being downgraded.

env ::= import stdlib.env;
fs ::= import stdlib.fs;
gen ::= import "gen_rust.zt";
t ::= import stdlib.text;

formatVersion :: Int = 1;
-- Matches release/v1 `maxTargetBytes`: the signed release header carries the
-- profile name in a fixed 32-byte area, so no profile name may exceed it.
maxNameBytes :: Int = 32;

Named :: type { constName : Text; value : Int; };

Profile :: type {
  constName : Text;
  name : Text;
  id : Int;
  architecture : Int;
  abi : Int;
  pageProfile : Int;
  requiredFeatures : Int;
  elfMachine : Int;
  pageBytes : Int;
  kernelPreferredBaseText : Text;
  kernelLoadBaseText : Text;
  componentBaseText : Text;
  cargoTarget : Text;
  qemuBinary : Text;
};

architectures :: List Named = {
  { constName = "X86_64"; value = 1; };
  { constName = "AARCH64"; value = 2; };
  { constName = "RISCV64"; value = 3; };
};

-- ABI identifiers are architecture-qualified by construction: one number names
-- both the instruction set and the calling convention documented for it in
-- docs/syscall-abi.md, so an AArch64 image can never claim the x86-64 ABI.
abis :: List Named = {
  { constName = "SLIME_X86_64_V1"; value = 1; };
  { constName = "SLIME_AARCH64_V1"; value = 2; };
  { constName = "SLIME_RISCV64_V1"; value = 3; };
  -- P5.2. A distinct ABI rather than a reuse of `SLIME_AARCH64_V1`, because the
  -- calling convention genuinely differs: a component here reaches its
  -- operations by `seL4_Call` on the root service endpoint in its own CSpace,
  -- not by `svc` into a Slime kernel that reads caller memory by pointer. The
  -- semantic syscall table is identical -- same numbers, errors, and bounds --
  -- but how an operation reaches its implementation is exactly what an ABI
  -- identifier names, and an image built for one cannot run under the other.
  { constName = "SLIME_AARCH64_SEL4_V1"; value = 4; };
  -- P3. The same native seL4 transport as the AArch64 product, with RISC-V's
  -- register and ELF conventions. Keeping a distinct number is what makes an
  -- AArch64 seL4 component fail admission before any executable byte is mapped.
  { constName = "SLIME_RISCV64_SEL4_V1"; value = 5; };
  -- P6.1. The x86-64 seL4 userspace ABI. Distinct from `SLIME_X86_64_V1`,
  -- which names the retired custom kernel's `int 0x80` trap ABI: retained
  -- rollback-window artifacts still carry that number, and an image built for
  -- it cannot run under the seL4 transport. See docs/syscall-abi.md.
  { constName = "SLIME_X86_64_SEL4_V1"; value = 6; };
};

pageProfiles :: List Named = {
  { constName = "X86_64_4K"; value = 1; };
  { constName = "AARCH64_4K"; value = 2; };
  { constName = "RISCV64_SV39_4K"; value = 3; };
};

-- Required-feature bits. An executable declares the exact set it needs; the
-- profile declares the exact set it provides. Admission requires equality, not
-- containment, so an artifact built for a richer platform is rejected here
-- rather than faulting on a missing instruction later.
features :: List Named = {
  { constName = "X86_64_BASELINE"; value = 1; };
  { constName = "AARCH64_BASELINE"; value = 2; };
  { constName = "AARCH64_GICV3"; value = 4; };
  { constName = "AARCH64_GICV2"; value = 32; };
  { constName = "AARCH64_GENERIC_TIMER"; value = 8; };
  { constName = "RISCV64_BASELINE"; value = 16; };
  -- P5.2. Names the seL4 kernel itself as a required platform feature: under
  -- this profile the interrupt controller, timer, and privilege transitions
  -- belong to seL4, so an image declares that it targets that mechanism rather
  -- than enumerating GICv2/GICv3 and the generic timer as the custom kernel's
  -- profiles must.
  { constName = "AARCH64_SEL4"; value = 64; };
  -- P3. RISC-V uses the same separation: PLIC, supervisor timer interrupts,
  -- Sv39 transitions, and `ecall` entry are upstream seL4 mechanism rather than
  -- component-visible features.
  { constName = "RISCV64_SEL4"; value = 128; };
  -- P6.1. Same separation on x86-64: the IOAPIC, local APIC timer, TSC,
  -- privilege transitions, and `syscall` entry are upstream seL4 pc99
  -- mechanism rather than component-visible features.
  { constName = "X86_64_SEL4"; value = 256; };
};

profiles :: List Profile = {
  {
    constName = "X86_64_QEMU_VIRTIO";
    name = "x86_64-qemu-virtio";
    id = 1;
    architecture = 1;
    abi = 1;
    pageProfile = 1;
    requiredFeatures = 1;
    elfMachine = 62;
    pageBytes = 4096;
    kernelPreferredBaseText = "0xFFFF_FFFF_8000_0000";
    kernelLoadBaseText = "0xFFFF_FFFF_9000_0000";
    componentBaseText = "0x0040_0000";
    cargoTarget = "x86_64-unknown-none";
    qemuBinary = "qemu-system-x86_64";
  };
  {
    constName = "AARCH64_QEMU_VIRT";
    name = "aarch64-qemu-virt";
    id = 2;
    architecture = 2;
    abi = 2;
    pageProfile = 2;
    requiredFeatures = 14;
    elfMachine = 183;
    pageBytes = 4096;
    kernelPreferredBaseText = "0xFFFF_FFFF_8000_0000";
    kernelLoadBaseText = "0xFFFF_FFFF_9000_0000";
    componentBaseText = "0x0040_0000";
    cargoTarget = "aarch64-unknown-none";
    qemuBinary = "qemu-system-aarch64";
  };
  {
    constName = "AARCH64_RPI5";
    name = "aarch64-rpi5";
    id = 3;
    architecture = 2;
    abi = 2;
    pageProfile = 2;
    requiredFeatures = 42;
    elfMachine = 183;
    pageBytes = 4096;
    kernelPreferredBaseText = "0xFFFF_FFFF_8000_0000";
    kernelLoadBaseText = "0xFFFF_FFFF_9000_0000";
    componentBaseText = "0x0040_0000";
    cargoTarget = "aarch64-unknown-none";
    qemuBinary = "";
  };
  {
    constName = "AARCH64_SEL4_QEMU_VIRT";
    name = "aarch64-sel4-qemu-virt";
    id = 5;
    architecture = 2;
    abi = 4;
    pageProfile = 2;
    -- AArch64 baseline plus seL4. GICv2/GICv3 and the generic timer are absent
    -- on purpose: they are seL4's to drive, and admission is equality, so
    -- naming them would reject every image this profile actually builds.
    requiredFeatures = 66;
    elfMachine = 183;
    pageBytes = 4096;
    -- No Slime kernel image exists for this profile: seL4 is the kernel, built
    -- and pinned separately under `sel4/pins.toml`. The bases are retained at
    -- the table's shared values so the record stays uniform; nothing reads them
    -- for this profile, and `component_base` is likewise unused because a
    -- component here is an ordinary seL4 ELF task loaded at its own link
    -- address rather than re-based onto a fixed load base.
    kernelPreferredBaseText = "0xFFFF_FFFF_8000_0000";
    kernelLoadBaseText = "0xFFFF_FFFF_9000_0000";
    componentBaseText = "0x0040_0000";
    -- A JSON target specification, resolved relative to the repository root.
    -- Cargo names its output directory by this path's file stem.
    cargoTarget = "deps/rust-sel4/support/targets/aarch64-sel4-minimal.json";
    qemuBinary = "qemu-system-aarch64";
  };
  {
    constName = "RISCV64_QEMU_VIRT";
    name = "riscv64-qemu-virt";
    id = 4;
    architecture = 3;
    abi = 3;
    pageProfile = 3;
    requiredFeatures = 16;
    elfMachine = 243;
    pageBytes = 4096;
    kernelPreferredBaseText = "0xFFFF_FFFF_8000_0000";
    kernelLoadBaseText = "0xFFFF_FFFF_9000_0000";
    componentBaseText = "0x0040_0000";
    cargoTarget = "riscv64gc-unknown-none-elf";
    qemuBinary = "qemu-system-riscv64";
  };
  {
    constName = "RISCV64_SEL4_QEMU_VIRT";
    name = "riscv64-sel4-qemu-virt";
    id = 6;
    architecture = 3;
    abi = 5;
    pageProfile = 3;
    requiredFeatures = 144;
    elfMachine = 243;
    pageBytes = 4096;
    kernelPreferredBaseText = "0xFFFF_FFFF_8000_0000";
    kernelLoadBaseText = "0xFFFF_FFFF_9000_0000";
    componentBaseText = "0x0040_0000";
    cargoTarget = "deps/rust-sel4/support/targets/riscv64imac-sel4-minimal.json";
    qemuBinary = "qemu-system-riscv64";
  };
  {
    constName = "RISCV64_SEL4_MILKV_DUO";
    name = "riscv64-sel4-milkv-duo";
    id = 7;
    architecture = 3;
    abi = 5;
    pageProfile = 3;
    -- Same userspace ABI as the RV64 seL4 reference, but a distinct exact
    -- platform identity. The board's C906, firmware handoff, PLIC, timer, and
    -- 63.25 MiB memory window are not interchangeable with QEMU `virt`.
    requiredFeatures = 144;
    elfMachine = 243;
    pageBytes = 4096;
    kernelPreferredBaseText = "0xFFFF_FFFF_8000_0000";
    kernelLoadBaseText = "0xFFFF_FFFF_9000_0000";
    componentBaseText = "0x0040_0000";
    cargoTarget = "deps/rust-sel4/support/targets/riscv64imac-sel4-minimal.json";
    qemuBinary = "";
  };
  {
    constName = "X86_64_SEL4_QEMU_PC99";
    name = "x86_64-sel4-qemu-pc99";
    id = 8;
    architecture = 1;
    abi = 6;
    pageProfile = 1;
    -- x86-64 baseline plus seL4. The IOAPIC, local APIC, and TSC are absent
    -- for the same reason GICv2/GICv3 are absent from the AArch64 seL4
    -- profile: they are seL4's to drive, and admission is equality.
    requiredFeatures = 257;
    elfMachine = 62;
    pageBytes = 4096;
    kernelPreferredBaseText = "0xFFFF_FFFF_8000_0000";
    kernelLoadBaseText = "0xFFFF_FFFF_9000_0000";
    componentBaseText = "0x0040_0000";
    -- Repo-owned rather than one of rust-sel4's `x86_64-sel4-*.json`. Those
    -- specs pair `-sse,-sse2` with `rustc-abi = softfloat`, and that pair has
    -- no LLVM lowering for the 128-bit integer arithmetic `ed25519-dalek`
    -- performs for release-signature verification: the root task fails to
    -- codegen with `Do not know how to split the result of this operator!`.
    -- seL4 pc99 saves and restores x87/SSE state per thread (`XSAVE`), so
    -- hardware float is the correct x86-64 configuration, unlike AArch64 and
    -- RV64 where the pinned kernels export no FP context.
    cargoTarget = "sel4/targets/x86_64-sel4-minimal.json";
    qemuBinary = "qemu-system-x86_64";
  };
  {
    constName = "X86_64_SEL4_FRAMEWORK13_AI300";
    name = "x86_64-sel4-framework13-ai300";
    id = 9;
    architecture = 1;
    abi = 6;
    pageProfile = 1;
    -- Same userspace ABI as the pc99 QEMU reference, but a distinct exact
    -- platform identity: the Framework Laptop 13's AMD Ryzen AI 300 firmware,
    -- ACPI/APIC topology, UEFI removable-media handoff, and GOP evidence
    -- channel are not interchangeable with QEMU q35/OVMF. P6.6 owns the first
    -- physical observation; nothing here claims one.
    requiredFeatures = 257;
    elfMachine = 62;
    pageBytes = 4096;
    kernelPreferredBaseText = "0xFFFF_FFFF_8000_0000";
    kernelLoadBaseText = "0xFFFF_FFFF_9000_0000";
    componentBaseText = "0x0040_0000";
    cargoTarget = "sel4/targets/x86_64-sel4-minimal.json";
    -- No emulator runs this profile.
    qemuBinary = "";
  };
};

format ::= {
  formatVersion =;
  maxNameBytes =;
  architectures =;
  abis =;
  pageProfiles =;
  features =;
  profiles =;
};

main :: { write : FsWrite; env : Env; } -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_BOOT_BINDINGS_ROOT" ?? ".";
    bindings := gen.render format;
    pythonPath := t.join "" { root; "/target_profile.py"; };
    rustPath := t.join "" { root; "/target_profile.rs"; };
    fs.writeAll caps.write pythonPath bindings.python;
    fs.writeAll caps.write rustPath bindings.rust
  ];

main