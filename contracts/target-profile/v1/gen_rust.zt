-- Pure renderer for the Slime OS target-profile table (P0).
-- schema.zt owns the concrete profile set and effectful output.
-- Shared Rust text mechanics live in the `wire.rust` package module.
--
-- The profile table is not a wire format: no boot, process, or persistence
-- boundary transmits it. It is one source of truth for the identifiers that
-- *are* serialized -- the architecture, ABI, page-profile, and required-feature
-- fields carried by component-image v2, kernel-image v2, and the generation
-- target string -- rendered into both the host builder and the Rust admission
-- path so the two cannot disagree by inspection.

n ::= import stdlib.num;
r ::= import wire.rust;

Profile :: type {
  constName : Text;
  name : Text;
  id : Int;
  architecture : Int;
  abi : Int;
  pageProfile : Int;
  requiredFeatures : Int;
  elfMachine : Int;
  pageBytes : Int;
  kernelPreferredBaseText : Text;
  kernelLoadBaseText : Text;
  componentBaseText : Text;
  cargoTarget : Text;
  qemuBinary : Text;
};

Named :: type { constName : Text; value : Int; };

Format :: type {
  formatVersion : Int;
  maxNameBytes : Int;
  architectures : List Named;
  abis : List Named;
  pageProfiles : List Named;
  features : List Named;
  profiles : List Profile;
};

countProfiles :: List Profile -> Int
  = values => match values {
    | {;} => 0;
    | { _; ...rest } => 1 + countProfiles rest;
  };

namedConsts :: Text -> List Named -> Text
  = prefix values => match values {
    | {;} => "";
    | { entry; ...rest } => r.join {
      r.u32Const (r.join { prefix; "_"; entry.constName; }) entry.value;
      namedConsts prefix rest;
    };
  };

namedConsts64 :: Text -> List Named -> Text
  = prefix values => match values {
    | {;} => "";
    | { entry; ...rest } => r.join {
      r.u64Const (r.join { prefix; "_"; entry.constName; }) entry.value;
      namedConsts64 prefix rest;
    };
  };

profileIdConsts :: List Profile -> Text
  = values => match values {
    | {;} => "";
    | { profile; ...rest } => r.join {
      r.u32Const (r.join { "PROFILE_"; profile.constName; }) profile.id;
      profileIdConsts rest;
    };
  };

profileRust :: Profile -> Text
  = profile => r.join {
    "    TargetProfile {\n";
    "        id: "; n.toText profile.id; ",\n";
    "        name: \""; profile.name; "\",\n";
    "        architecture: "; n.toText profile.architecture; ",\n";
    "        abi: "; n.toText profile.abi; ",\n";
    "        page_profile: "; n.toText profile.pageProfile; ",\n";
    "        required_features: "; n.toText profile.requiredFeatures; ",\n";
    "        elf_machine: "; n.toText profile.elfMachine; ",\n";
    "        page_bytes: "; n.toText profile.pageBytes; ",\n";
    "        kernel_preferred_base: "; profile.kernelPreferredBaseText; ",\n";
    "        kernel_load_base: "; profile.kernelLoadBaseText; ",\n";
    "        component_base: "; profile.componentBaseText; ",\n";
    "    },\n";
  };

profilesRust :: List Profile -> Text
  = values => match values {
    | {;} => "";
    | { profile; ...rest } => r.join { profileRust profile; profilesRust rest; };
  };

rustBindings :: Format -> Text
  = format => r.join {
    "// @generated by contracts/target-profile/v1/gen_rust.zt; do not edit.\n";
    "// Source contract: contracts/target-profile/v1/schema.zt\n\n";
    r.u32Const "FORMAT_VERSION" format.formatVersion;
    r.usizeConst "MAX_NAME_BYTES" format.maxNameBytes;
    r.usizeConst "PROFILE_COUNT" (countProfiles format.profiles);
    "\n";
    namedConsts "ARCH" format.architectures;
    "\n";
    namedConsts "ABI" format.abis;
    "\n";
    namedConsts "PAGE_PROFILE" format.pageProfiles;
    "\n";
    namedConsts64 "FEATURE" format.features;
    "\n";
    profileIdConsts format.profiles;
    "\n";
    "pub const PROFILES: [TargetProfile; PROFILE_COUNT] = [\n";
    profilesRust format.profiles;
    "];\n";
  };

profilePython :: Profile -> Text
  = profile => r.join {
    "    TargetProfile(\n";
    "        id="; n.toText profile.id; ",\n";
    "        name=\""; profile.name; "\",\n";
    "        architecture="; n.toText profile.architecture; ",\n";
    "        abi="; n.toText profile.abi; ",\n";
    "        page_profile="; n.toText profile.pageProfile; ",\n";
    "        required_features="; n.toText profile.requiredFeatures; ",\n";
    "        elf_machine="; n.toText profile.elfMachine; ",\n";
    "        page_bytes="; n.toText profile.pageBytes; ",\n";
    "        kernel_preferred_base="; profile.kernelPreferredBaseText; ",\n";
    "        kernel_load_base="; profile.kernelLoadBaseText; ",\n";
    "        component_base="; profile.componentBaseText; ",\n";
    "        cargo_target=\""; profile.cargoTarget; "\",\n";
    "        qemu_binary=\""; profile.qemuBinary; "\",\n";
    "    ),\n";
  };

profilesPython :: List Profile -> Text
  = values => match values {
    | {;} => "";
    | { profile; ...rest } => r.join { profilePython profile; profilesPython rest; };
  };

namedPython :: Text -> List Named -> Text
  = prefix values => match values {
    | {;} => "";
    | { entry; ...rest } => r.join {
      prefix; "_"; entry.constName; " = "; n.toText entry.value; "\n";
      namedPython prefix rest;
    };
  };

profileIdPython :: List Profile -> Text
  = values => match values {
    | {;} => "";
    | { profile; ...rest } => r.join {
      "PROFILE_"; profile.constName; " = "; n.toText profile.id; "\n";
      profileIdPython rest;
    };
  };

pythonBindings :: Format -> Text
  = format => r.join {
    "TARGET_PROFILE_VERSION = "; n.toText format.formatVersion; "\n";
    "TARGET_PROFILE_MAX_NAME_BYTES = "; n.toText format.maxNameBytes; "\n";
    namedPython "ARCH" format.architectures;
    namedPython "ABI" format.abis;
    namedPython "PAGE_PROFILE" format.pageProfiles;
    namedPython "FEATURE" format.features;
    profileIdPython format.profiles;
    "\n";
    "class TargetProfile(typing.NamedTuple):\n";
    "    id: int\n";
    "    name: str\n";
    "    architecture: int\n";
    "    abi: int\n";
    "    page_profile: int\n";
    "    required_features: int\n";
    "    elf_machine: int\n";
    "    page_bytes: int\n";
    "    kernel_preferred_base: int\n";
    "    kernel_load_base: int\n";
    "    component_base: int\n";
    "    cargo_target: str\n";
    "    qemu_binary: str\n";
    "\n\n";
    "TARGET_PROFILES = (\n";
    profilesPython format.profiles;
    ")\n";
    "TARGET_PROFILES_BY_NAME = {profile.name: profile for profile in TARGET_PROFILES}\n";
    "TARGET_PROFILES_BY_ID = {profile.id: profile for profile in TARGET_PROFILES}\n";
  };

positive :: Int -> Bool = value => value > 0;

profileValid :: Profile -> Bool
  = profile =>
    positive profile.id
      && positive profile.architecture
      && positive profile.abi
      && positive profile.pageProfile
      && positive profile.requiredFeatures
      && positive profile.elfMachine
      && positive profile.pageBytes;

profilesValid :: List Profile -> Bool
  = values => match values {
    | {;} => true;
    | { profile; ...rest } => profileValid profile && profilesValid rest;
  };

namedValid :: List Named -> Bool
  = values => match values {
    | {;} => true;
    | { entry; ...rest } => positive entry.value && namedValid rest;
  };

valid :: Format -> Bool
  = format =>
    positive format.formatVersion
      && positive format.maxNameBytes
      && countProfiles format.profiles > 0
      && namedValid format.architectures
      && namedValid format.abis
      && namedValid format.pageProfiles
      && namedValid format.features
      && profilesValid format.profiles;

render :: Format -> { python : Text; rust : Text; }
  = format => if valid format
    then { python = pythonBindings format; rust = rustBindings format; }
    else { python = "INVALID_TARGET_PROFILE_SCHEMA"; rust = "INVALID_TARGET_PROFILE_SCHEMA"; };

{ render = render; }
