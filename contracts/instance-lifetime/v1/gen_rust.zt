-- Schema-reflected Python + Rust renderer for instance-lifetime/v1.
-- Shared struct.Struct mechanics live in the `wire.python` package module;
-- shared Rust scalar-const mechanics live in `wire.rust`.

refl ::= import stdlib.reflect;
n ::= import stdlib.num;
w ::= import wire.python;
r ::= import wire.rust;

Format :: type {
  formatVersion : Int;
  headerBytes : Int;
  entryBytes : Int;
  maxRows : Int;
  lifetimeBounded : Int;
  lifetimeResident : Int;
  headerFields : List refl.SchemaField;
  entryFields : List refl.SchemaField;
  headerLayout : List w.WireField;
  entryLayout : List w.WireField;
};

records :: Format -> List w.WireRecord = format => {
  { pythonName = "INSTANCE_LIFETIME_HEADER"; constPrefix = "INSTANCE_LIFETIME"; size = format.headerBytes; trailingPadding = 0; fields = format.headerFields; layout = format.headerLayout; };
  { pythonName = "INSTANCE_LIFETIME_ENTRY"; constPrefix = "INSTANCE_LIFETIME_ENTRY"; size = format.entryBytes; trailingPadding = 0; fields = format.entryFields; layout = format.entryLayout; };
};

pythonBindings :: Format -> Text = format => w.join {
  "INSTANCE_LIFETIME_MAGIC = b\"SLIMELT\\0\"\n";
  "INSTANCE_LIFETIME_VERSION = "; n.toText format.formatVersion; "\n";
  "INSTANCE_LIFETIME_HEADER_BYTES = "; n.toText format.headerBytes; "\n";
  "INSTANCE_LIFETIME_ENTRY_BYTES = "; n.toText format.entryBytes; "\n";
  "MAX_INSTANCE_LIFETIME_ROWS = "; n.toText format.maxRows; "\n";
  "INSTANCE_LIFETIME_BOUNDED = "; n.toText format.lifetimeBounded; "\n";
  "INSTANCE_LIFETIME_RESIDENT = "; n.toText format.lifetimeResident; "\n";
  w.renderRecords (records format);
};

-- Schema-owned scalars shared with boot-contracts/src/instance_lifetime.rs.
-- The magic tag, derived MAX_BYTES, and decode machinery stay hand-written in
-- that module.
rustBindings :: Format -> Text = format => r.join {
  "// @generated by contracts/instance-lifetime/v1/gen_rust.zt; do not edit.\n";
  "// Source contract: contracts/instance-lifetime/v1/schema.zt\n\n";
  r.u32Const "FORMAT_VERSION" format.formatVersion;
  r.usizeConst "HEADER_BYTES" format.headerBytes;
  r.usizeConst "ENTRY_BYTES" format.entryBytes;
  r.usizeConst "MAX_ROWS" format.maxRows;
  "pub const LIFETIME_BOUNDED: u8 = "; n.toText format.lifetimeBounded; ";\n";
  "pub const LIFETIME_RESIDENT: u8 = "; n.toText format.lifetimeResident; ";\n";
};

render :: Format -> { python : Text; rust : Text; }
  = format => if w.recordsValid (records format)
    then { python = pythonBindings format; rust = rustBindings format; }
    else { python = "INVALID_INSTANCE_LIFETIME_SCHEMA"; rust = "INVALID_INSTANCE_LIFETIME_SCHEMA"; };
{ render =; }
