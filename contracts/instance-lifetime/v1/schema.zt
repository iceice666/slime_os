-- Slime OS instance lifetime, version 1.
--
-- A generation resource object naming the instances declared resident: each
-- runs for the life of its graph, so the root treats its exit as a failure
-- rather than as completion. Every instance the object does not name is
-- bounded. The builder emits the object only when a composition declares a
-- resident instance, so a generation without it has every instance bounded.
-- Embedded as a KIND_RESOURCE object and authenticated by the generation's
-- existing object digest table; it adds no field to the instance record.
--
-- Rows are keyed by instance, not component: the same executable may be
-- resident in one instance and bounded in another. The identity uses this
-- contract's own domain tag, so an identity computed for another resource can
-- never name a row here.

env ::= import stdlib.env;
fs ::= import stdlib.fs;
gen ::= import "gen_rust.zt";
t ::= import stdlib.text;

formatVersion :: Int = 1;
headerBytes :: Int = 32;
entryBytes :: Int = 36;
-- The generation's own instance bound: a table can name each instance once.
maxRows :: Int = 48;
lifetimeBounded :: Int = 0;
lifetimeResident :: Int = 1;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

LifetimeHeader :: type {
  magic : Int;
  format_version : Int;
  header_size : Int;
  required_flags : Int;
  row_count : Int;
  total_len : Int;
};

LifetimeEntry :: type {
  instance_identity : Int;
  lifetime : Int;
  reserved : Int;
};

headerSchema ::= schema LifetimeHeader;
entrySchema ::= schema LifetimeEntry;

headerLayout :: List WireField = {
  { name = "magic"; width = 8; signed = false; byteArray = true; };
  { name = "format_version"; width = 4; signed = false; byteArray = false; };
  { name = "header_size"; width = 4; signed = false; byteArray = false; };
  { name = "required_flags"; width = 8; signed = false; byteArray = false; };
  { name = "row_count"; width = 4; signed = false; byteArray = false; };
  { name = "total_len"; width = 4; signed = false; byteArray = false; };
};

entryLayout :: List WireField = {
  { name = "instance_identity"; width = 32; signed = false; byteArray = true; };
  { name = "lifetime"; width = 1; signed = false; byteArray = false; };
  { name = "reserved"; width = 3; signed = false; byteArray = true; };
};

format ::= {
  formatVersion =;
  headerBytes =;
  entryBytes =;
  maxRows =;
  lifetimeBounded =;
  lifetimeResident =;
  headerFields = headerSchema.fields ?? {;};
  entryFields = entrySchema.fields ?? {;};
  headerLayout =;
  entryLayout =;
};

main :: { write : FsWrite; env : Env; } -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_BOOT_BINDINGS_ROOT" ?? ".";
    bindings := gen.render format;
    pythonPath := t.join "" { root; "/instance_lifetime.py"; };
    rustPath := t.join "" { root; "/instance_lifetime.rs"; };
    fs.writeAll caps.write pythonPath bindings.python;
    fs.writeAll caps.write rustPath bindings.rust
  ];

main
