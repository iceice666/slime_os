-- Canonical resolved userspace fabric profile, version 1 (C8.9).
--
-- Python emits the exact resolved value as compact sorted-key JSON with one
-- trailing newline. Rust build scripts consume that artifact without re-reading
-- or interpreting the generation source. The types below own the projection.

ProfileLimit :: type { name : Text; value : Int; };
ProfileSchema :: type {
  name : Text;
  identity : Text;
  typeTag : Text;
  contractKind : Int;
  maxEncodedBytes : Int;
};
ProfileRoute :: type {
  name : Text;
  interface : Text;
  identity : Text;
  contractKind : Int;
};
ProfileParticipant :: type {
  component : Text;
  route : Text;
  interface : Text;
  direction : Int;
  visibility : Int;
  reliability : Int;
  durability : Int;
  liveliness : Int;
  historyDepth : Int;
  retainedDepth : Int;
  deadlineNs : Int;
  lifespanNs : Int;
  leaseNs : Int;
  interposition : List Text;
};
ProfileControl :: type { component : Text; slot : Int; };
ProfilePlane :: type { name : Text; controls : List ProfileControl; };
-- One bounded route worker (C8.10): the whole routes it carries and the number
-- of live wake sources it registers at once. `waitSources` is bounded by the
-- wake-source ceiling, so a partition that cannot block on its own graph is
-- rejected at build time rather than polling at runtime.
ProfileWorker :: type { name : Text; routes : List Text; waitSources : Int; };
ResolvedDataFabricProfile :: type {
  formatVersion : Int;
  name : Text;
  fabricComponent : Text;
  firstControlSlot : Int;
  copyPages : Int;
  frameCapacity : Int;
  requiredCapabilitySlots : Int;
  -- C8.11's bounded semantic-trace sink, resolved from the graph: how many
  -- records one worker's sink holds, and the overflow code it applies when
  -- full. Dedicated fields rather than `limits` entries because the overflow
  -- discipline is a vocabulary selector, not a ceiling.
  traceDepth : Int;
  traceOverflow : Int;
  limits : List ProfileLimit;
  schemas : List ProfileSchema;
  routes : List ProfileRoute;
  participants : List ProfileParticipant;
  workers : List ProfileWorker;
  planes : List ProfilePlane;
  supervision : List ProfileControl;
};

FromData @ProfileLimit :: derive
FromData @ProfileSchema :: derive
FromData @ProfileRoute :: derive
FromData @ProfileParticipant :: derive
FromData @ProfileControl :: derive
FromData @ProfilePlane :: derive
FromData @ProfileWorker :: derive
FromData @ResolvedDataFabricProfile :: derive

decodeProfile :: Data -> Validation DecodeIssue ResolvedDataFabricProfile = data => decode data;

{
  ProfileLimit =;
  ProfileSchema =;
  ProfileRoute =;
  ProfileParticipant =;
  ProfileControl =;
  ProfilePlane =;
  ProfileWorker =;
  ResolvedDataFabricProfile =;
  decodeProfile =;
}
