-- Slime OS filtered fabric introspection and interposition trace framing, v1 (C8.8).
--
-- Every record is exactly the kernel's 64-byte channel bound. Introspection is
-- cursor-paged one record per request, so a graph at its admitted ceiling never
-- depends on channel queue depth. Route and QoS records are separate: the route
-- record retains the full schema identity and bounded name, while the QoS record
-- carries every declared transport field without truncation. These bytes convey
-- metadata only; no response may carry a capability.
--
-- Interposition traces are authenticated by the control endpoint they arrive on.
-- The component identity is therefore deliberately absent from the bytes: a
-- caller-supplied identity would be weaker than the endpoint binding init made at
-- spawn. A trace names the exact route identity and sequence it observed.

env ::= import stdlib.env;
fs ::= import stdlib.fs;
gen ::= import "gen_rust.zt";
t ::= import stdlib.text;

formatVersion :: Int = 1;
recordLen :: Int = 64;
routeNameBytes :: Int = 16;

visibilityRequestMagic :: Int = 1381062214; -- `FVQR`
visibilityRouteMagic :: Int = 1414682182;   -- `FVRT`
visibilityQosMagic :: Int = 1330730566;     -- `FVQO`
interpositionTraceMagic :: Int = 1381258822; -- `FVTR`

statusRecord :: Int = 0;
statusEnd :: Int = 1;
knownRequestFlags :: Int = 0;
knownRouteFlags :: Int = 0;
knownQosFlags :: Int = 0;
knownTraceFlags :: Int = 0;
traceRelayed :: Int = 1;
traceProxyLost :: Int = 2;
eventProxyLost :: Int = 1;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

VisibilityRequest :: type {
  magic : Int;
  version : Int;
  cursor : Int;
  flags : Int;
  reserved : Int;
};

VisibilityRouteRecord :: type {
  magic : Int;
  version : Int;
  status : Int;
  cursor : Int;
  contract_kind : Int;
  route_name_len : Int;
  reserved0 : Int;
  route_name : Int;
  schema_identity : Int;
  flags : Int;
};

VisibilityQosRecord :: type {
  magic : Int;
  version : Int;
  status : Int;
  cursor : Int;
  flags : Int;
  route_name : Int;
  reliability : Int;
  durability : Int;
  liveliness : Int;
  matched : Int;
  history_depth : Int;
  retained_depth : Int;
  deadline_ns : Int;
  lifespan_ns : Int;
  lease_ns : Int;
  event_mask : Int;
};

InterpositionTrace :: type {
  magic : Int;
  version : Int;
  event : Int;
  flags : Int;
  route_identity : Int;
  sequence : Int;
  reserved : Int;
};

requestSchema ::= schema VisibilityRequest;
routeSchema ::= schema VisibilityRouteRecord;
qosSchema ::= schema VisibilityQosRecord;
traceSchema ::= schema InterpositionTrace;

requestLayout :: List WireField = {
  { name = "magic"; width = 4; signed = false; byteArray = false; };
  { name = "version"; width = 1; signed = false; byteArray = false; };
  { name = "cursor"; width = 1; signed = false; byteArray = false; };
  { name = "flags"; width = 2; signed = false; byteArray = false; };
  { name = "reserved"; width = 56; signed = false; byteArray = true; };
};

routeLayout :: List WireField = {
  { name = "magic"; width = 4; signed = false; byteArray = false; };
  { name = "version"; width = 1; signed = false; byteArray = false; };
  { name = "status"; width = 1; signed = false; byteArray = false; };
  { name = "cursor"; width = 1; signed = false; byteArray = false; };
  { name = "contract_kind"; width = 1; signed = false; byteArray = false; };
  { name = "route_name_len"; width = 1; signed = false; byteArray = false; };
  { name = "reserved0"; width = 3; signed = false; byteArray = true; };
  { name = "route_name"; width = 16; signed = false; byteArray = true; };
  { name = "schema_identity"; width = 32; signed = false; byteArray = true; };
  { name = "flags"; width = 4; signed = false; byteArray = false; };
};

qosLayout :: List WireField = {
  { name = "magic"; width = 4; signed = false; byteArray = false; };
  { name = "version"; width = 1; signed = false; byteArray = false; };
  { name = "status"; width = 1; signed = false; byteArray = false; };
  { name = "cursor"; width = 1; signed = false; byteArray = false; };
  { name = "flags"; width = 1; signed = false; byteArray = false; };
  { name = "route_name"; width = 16; signed = false; byteArray = true; };
  { name = "reliability"; width = 1; signed = false; byteArray = false; };
  { name = "durability"; width = 1; signed = false; byteArray = false; };
  { name = "liveliness"; width = 1; signed = false; byteArray = false; };
  { name = "matched"; width = 1; signed = false; byteArray = false; };
  { name = "history_depth"; width = 4; signed = false; byteArray = false; };
  { name = "retained_depth"; width = 4; signed = false; byteArray = false; };
  { name = "deadline_ns"; width = 8; signed = false; byteArray = false; };
  { name = "lifespan_ns"; width = 8; signed = false; byteArray = false; };
  { name = "lease_ns"; width = 8; signed = false; byteArray = false; };
  { name = "event_mask"; width = 4; signed = false; byteArray = false; };
};

traceLayout :: List WireField = {
  { name = "magic"; width = 4; signed = false; byteArray = false; };
  { name = "version"; width = 1; signed = false; byteArray = false; };
  { name = "event"; width = 1; signed = false; byteArray = false; };
  { name = "flags"; width = 2; signed = false; byteArray = false; };
  { name = "route_identity"; width = 32; signed = false; byteArray = true; };
  { name = "sequence"; width = 8; signed = false; byteArray = false; };
  { name = "reserved"; width = 16; signed = false; byteArray = true; };
};

format ::= {
  formatVersion = formatVersion;
  recordLen = recordLen;
  routeNameBytes = routeNameBytes;
  visibilityRequestMagic = visibilityRequestMagic;
  visibilityRouteMagic = visibilityRouteMagic;
  visibilityQosMagic = visibilityQosMagic;
  interpositionTraceMagic = interpositionTraceMagic;
  statusRecord = statusRecord;
  statusEnd = statusEnd;
  knownRequestFlags = knownRequestFlags;
  knownRouteFlags = knownRouteFlags;
  knownQosFlags = knownQosFlags;
  knownTraceFlags = knownTraceFlags;
  traceRelayed = traceRelayed;
  traceProxyLost = traceProxyLost;
  eventProxyLost = eventProxyLost;
  requestFields = requestSchema.fields ?? {;};
  routeFields = routeSchema.fields ?? {;};
  qosFields = qosSchema.fields ?? {;};
  traceFields = traceSchema.fields ?? {;};
  requestLayout = requestLayout;
  routeLayout = routeLayout;
  qosLayout = qosLayout;
  traceLayout = traceLayout;
};

main :: { write : FsWrite; env : Env; } -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_FABRIC_VISIBILITY_BINDINGS_ROOT" ?? ".";
    bindings := gen.render format;
    path := t.join "" { root; "/components/proto/src/fabric_visibility.rs"; };
    fs.writeAll caps.write path bindings.rust
  ];

main
