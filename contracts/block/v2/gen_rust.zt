-- Pure renderer for the asynchronous BlockDevice v2 payload bindings (IO2).

refl ::= import stdlib.reflect;
n ::= import stdlib.num;
t ::= import stdlib.text;
l ::= import stdlib.list;
w ::= import wire.rust;
c ::= import wire.codec;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

Protocol :: type {
  formatVersion : Int;
  requestLen : Int;
  replyLen : Int;
  blockMagic : Int;
  sectorBytes : Int;
  maxSectorsPerRequest : Int;
  opRead : Int;
  opWrite : Int;
  opFlush : Int;
  opGeometry : Int;
  knownRequestFlags : Int;
  deviceStatusOk : Int;
  deviceStatusIoErr : Int;
  deviceStatusUnsupported : Int;
  requestFields : List refl.SchemaField;
  replyFields : List refl.SchemaField;
  requestLayout : List WireField;
  replyLayout : List WireField;
};

-- Offset and codec emitters come from `wire.codec`, which owns the
-- byte-array-aware mechanics fourteen renderers previously each copied. The
-- validity predicate below stays here: what makes *this* layout admissible is
-- contract-specific.
layoutNames :: List WireField -> List Text = c.layoutNames;
allValid :: List WireField -> Bool = c.allValid;
wireBytes :: List WireField -> Int = c.wireBytes;
offsetConsts :: Text -> Int -> List WireField -> Text = c.offsetConsts;
wireStruct :: Text -> Text -> Text -> List WireField -> Text
  = name prefix lengthName fields => c.wireStruct "block-v2" name prefix lengthName fields;


rustBindings :: Protocol -> Text
  = protocol => w.join {
    "// @generated by contracts/block/v2/gen_rust.zt; do not edit.\n";
    "// Source contract: contracts/block/v2/schema.zt\n\n";
    "pub const FORMAT_VERSION: u16 = "; n.toText protocol.formatVersion; ";\n";
    "pub const REQUEST_LEN: usize = "; n.toText protocol.requestLen; ";\n";
    "pub const REPLY_LEN: usize = "; n.toText protocol.replyLen; ";\n";
    "pub const BLOCK_MAGIC: u32 = "; n.toText protocol.blockMagic; ";\n";
    "pub const SECTOR_BYTES: usize = "; n.toText protocol.sectorBytes; ";\n";
    "pub const MAX_SECTORS_PER_REQUEST: u32 = "; n.toText protocol.maxSectorsPerRequest; ";\n";
    "pub const OP_READ: u8 = "; n.toText protocol.opRead; ";\n";
    "pub const OP_WRITE: u8 = "; n.toText protocol.opWrite; ";\n";
    "pub const OP_FLUSH: u8 = "; n.toText protocol.opFlush; ";\n";
    "pub const OP_GEOMETRY: u8 = "; n.toText protocol.opGeometry; ";\n";
    "pub const KNOWN_REQUEST_FLAGS: u8 = "; n.toText protocol.knownRequestFlags; ";\n";
    "pub const DEVICE_STATUS_OK: u32 = "; n.toText protocol.deviceStatusOk; ";\n";
    "pub const DEVICE_STATUS_IO_ERR: u32 = "; n.toText protocol.deviceStatusIoErr; ";\n";
    "pub const DEVICE_STATUS_UNSUPPORTED: u32 = "; n.toText protocol.deviceStatusUnsupported; ";\n\n";
    offsetConsts "REQUEST" 0 protocol.requestLayout;
    "\n";
    wireStruct "WireBlockRequest" "REQUEST" "REQUEST_LEN" protocol.requestLayout;
    "\n";
    offsetConsts "REPLY" 0 protocol.replyLayout;
    "\n";
    wireStruct "WireBlockReply" "REPLY" "REPLY_LEN" protocol.replyLayout;
  };

valid :: Protocol -> Bool
  = protocol =>
    w.schemaFieldsValid protocol.requestFields
      && w.schemaFieldsValid protocol.replyFields
      && w.schemaNames protocol.requestFields == layoutNames protocol.requestLayout
      && w.schemaNames protocol.replyFields == layoutNames protocol.replyLayout
      && allValid protocol.requestLayout
      && allValid protocol.replyLayout
      && wireBytes protocol.requestLayout == protocol.requestLen
      && wireBytes protocol.replyLayout == protocol.replyLen
      && protocol.requestLen == 56
      && protocol.replyLen == 24
      && protocol.sectorBytes == 512
      && protocol.maxSectorsPerRequest > 1;

render :: Protocol -> { rust : Text; }
  = protocol => if valid protocol
    then { rust = rustBindings protocol; }
    else { rust = "INVALID_BLOCK_V2_SCHEMA"; };

{ render =; }
