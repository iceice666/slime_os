-- Pure renderer for Slime OS bounded call framing (C8.6).

refl ::= import stdlib.reflect;
n ::= import stdlib.num;
t ::= import stdlib.text;
w ::= import wire.rust;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };
Protocol :: type {
  formatVersion : Int;
  recordLen : Int;
  inlineBytes : Int;
  magic : Int;
  timeMagic : Int;
  kindRequest : Int;
  kindReply : Int;
  kindCancel : Int;
  kindTerminal : Int;
  kindTerminalAck : Int;
  kindReplyAck : Int;
  flagNonIdempotent : Int;
  flagSharedPayload : Int;
  knownFlags : Int;
  statusSuccess : Int;
  statusRejected : Int;
  statusTimeout : Int;
  statusCancelled : Int;
  statusRetryExhausted : Int;
  statusMalformedReply : Int;
  statusPeerDead : Int;
  statusDuplicate : Int;
  statusStale : Int;
  fields : List refl.SchemaField;
  layout : List WireField;
  timeFields : List refl.SchemaField;
  timeLayout : List WireField;
};
layoutNames :: List WireField -> List Text = fields => map _.name fields;
validField :: WireField -> Bool = field => if field.byteArray then field.width > 0 && not field.signed else w.validWidthSigned4 { name = field.name; width = field.width; signed = field.signed; };
allValid :: List WireField -> Bool = fields => match fields { | {;} => true; | { field; ...rest } => validField field && allValid rest; };
addWidth :: Int -> WireField -> Int = total field => total + field.width;
wireBytes :: List WireField -> Int = fields => fold addWidth 0 fields;
constName :: Text -> Text = name => w.join { "OFF_CALL_"; t.toUpper name; };
timeConstName :: Text -> Text = name => w.join { "OFF_CALL_TIME_"; t.toUpper name; };
offsetConsts :: Int -> List WireField -> Text = offset fields => match fields {
  | {;} => "";
  | { field; ...rest } => w.join { "pub const "; constName field.name; ": usize = "; n.toText offset; ";\n"; offsetConsts (offset + field.width) rest; };
};
timeOffsetConsts :: Int -> List WireField -> Text = offset fields => match fields {
  | {;} => "";
  | { field; ...rest } => w.join { "pub const "; timeConstName field.name; ": usize = "; n.toText offset; ";\n"; timeOffsetConsts (offset + field.width) rest; };
};
rustType :: WireField -> Text = field => if field.byteArray then w.join { "[u8; "; n.toText field.width; "]"; } else w.rustType { name = field.name; width = field.width; signed = field.signed; };
fieldDecls :: List WireField -> Text = fields => match fields { | {;} => ""; | { field; ...rest } => w.join { "    pub "; field.name; ": "; rustType field; ",\n"; fieldDecls rest; }; };
decodeExpr :: Text -> WireField -> Text = prefix field => if field.byteArray
  then w.join { "buf["; prefix; t.toUpper field.name; ".."; prefix; t.toUpper field.name; " + "; n.toText field.width; "].try_into().expect(\"generated fabric-call layout\")"; }
  else if field.width == 1 then w.join { "buf["; prefix; t.toUpper field.name; "]"; }
  else w.join { rustType field; "::from_le_bytes(buf["; prefix; t.toUpper field.name; ".."; prefix; t.toUpper field.name; " + "; n.toText field.width; "].try_into().expect(\"generated fabric-call layout\"))"; };
decodeFields :: Text -> List WireField -> Text = prefix fields => match fields { | {;} => ""; | { field; ...rest } => w.join { "            "; field.name; ": "; decodeExpr prefix field; ",\n"; decodeFields prefix rest; }; };
encodeField :: Text -> WireField -> Text = prefix field => if field.byteArray
  then w.join { "        buf["; prefix; t.toUpper field.name; ".."; prefix; t.toUpper field.name; " + "; n.toText field.width; "].copy_from_slice(&self."; field.name; ");\n"; }
  else if field.width == 1 then w.join { "        buf["; prefix; t.toUpper field.name; "] = self."; field.name; ";\n"; }
  else w.join { "        buf["; prefix; t.toUpper field.name; ".."; prefix; t.toUpper field.name; " + "; n.toText field.width; "].copy_from_slice(&self."; field.name; ".to_le_bytes());\n"; };
encodeFields :: Text -> List WireField -> Text = prefix fields => match fields { | {;} => ""; | { field; ...rest } => w.join { encodeField prefix field; encodeFields prefix rest; }; };
wireStruct :: Text -> Text -> Text -> Text -> List WireField -> Text = name len prefix expectation fields => w.join {
  "#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub struct "; name; " {\n"; fieldDecls fields; "}\n\n";
  "impl "; name; " {\n    pub fn decode(buf: &[u8]) -> Option<Self> {\n        if buf.len() < "; len; " { return None; }\n        Some(Self {\n"; decodeFields prefix fields; "        })\n    }\n\n    pub fn encode(self) -> [u8; "; len; "] {\n        let mut buf = [0u8; "; len; "];\n"; encodeFields prefix fields; "        buf\n    }\n}\n";
};
rustBindings :: Protocol -> Text = protocol => w.join {
  "// @generated by contracts/fabric-call/v1/gen_rust.zt; do not edit.\n// Source contract: contracts/fabric-call/v1/schema.zt\n\n";
  "pub const FORMAT_VERSION: u32 = "; n.toText protocol.formatVersion; ";\n";
  "pub const CALL_MAGIC: u32 = "; n.toText protocol.magic; ";\n";
  "pub const CALL_TIME_MAGIC: u32 = "; n.toText protocol.timeMagic; ";\n";
  "pub const CALL_LEN: usize = "; n.toText protocol.recordLen; ";\n";
  "pub const CALL_TIME_LEN: usize = "; n.toText protocol.recordLen; ";\n";
  "pub const INLINE_BYTES: usize = "; n.toText protocol.inlineBytes; ";\n";
  "pub const KIND_REQUEST: u32 = "; n.toText protocol.kindRequest; ";\n";
  "pub const KIND_REPLY: u32 = "; n.toText protocol.kindReply; ";\n";
  "pub const KIND_CANCEL: u32 = "; n.toText protocol.kindCancel; ";\n";
  "pub const KIND_TERMINAL: u32 = "; n.toText protocol.kindTerminal; ";\n";
  "pub const KIND_TERMINAL_ACK: u32 = "; n.toText protocol.kindTerminalAck; ";\n";
  "pub const KIND_REPLY_ACK: u32 = "; n.toText protocol.kindReplyAck; ";\n";
  "pub const FLAG_NON_IDEMPOTENT: u32 = "; n.toText protocol.flagNonIdempotent; ";\n";
  "pub const FLAG_SHARED_PAYLOAD: u32 = "; n.toText protocol.flagSharedPayload; ";\n";
  "pub const KNOWN_FLAGS: u32 = "; n.toText protocol.knownFlags; ";\n";
  "pub const STATUS_SUCCESS: i32 = "; n.toText protocol.statusSuccess; ";\n";
  "pub const STATUS_REJECTED: i32 = "; n.toText protocol.statusRejected; ";\n";
  "pub const STATUS_TIMEOUT: i32 = "; n.toText protocol.statusTimeout; ";\n";
  "pub const STATUS_CANCELLED: i32 = "; n.toText protocol.statusCancelled; ";\n";
  "pub const STATUS_RETRY_EXHAUSTED: i32 = "; n.toText protocol.statusRetryExhausted; ";\n";
  "pub const STATUS_MALFORMED_REPLY: i32 = "; n.toText protocol.statusMalformedReply; ";\n";
  "pub const STATUS_PEER_DEAD: i32 = "; n.toText protocol.statusPeerDead; ";\n";
  "pub const STATUS_DUPLICATE: i32 = "; n.toText protocol.statusDuplicate; ";\n";
  "pub const STATUS_STALE: i32 = "; n.toText protocol.statusStale; ";\n\n";
  offsetConsts 0 protocol.layout; "\n";
  timeOffsetConsts 0 protocol.timeLayout; "\n";
  wireStruct "WireCallEnvelope" "CALL_LEN" "OFF_CALL_" "call" protocol.layout; "\n";
  wireStruct "WireCallTimeAdvance" "CALL_TIME_LEN" "OFF_CALL_TIME_" "time" protocol.timeLayout;
};
valid :: Protocol -> Bool = protocol =>
  w.schemaFieldsValid protocol.fields
  && w.schemaNames protocol.fields == layoutNames protocol.layout
  && w.schemaFieldsValid protocol.timeFields
  && w.schemaNames protocol.timeFields == layoutNames protocol.timeLayout
  && allValid protocol.layout
  && allValid protocol.timeLayout
  && wireBytes protocol.layout == protocol.recordLen
  && wireBytes protocol.timeLayout == protocol.recordLen
  && protocol.inlineBytes == 8;
render :: Protocol -> { rust : Text; } = protocol => if valid protocol then { rust = rustBindings protocol; } else { rust = "INVALID_FABRIC_CALL_SCHEMA"; };
{ render =; }
