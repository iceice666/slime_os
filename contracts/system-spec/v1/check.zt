schema ::= import "schema.zt";
env ::= import stdlib.env;
load ::= import stdlib.load;

main :: { env : Env; load : Load; }
  -> Validation DecodeIssue schema.SystemSpec
  ! { * env.GetEffects; * load.ZtiEffects; }
  = caps => [
    path := env.get caps.env "SLIME_SYSTEM_SPEC_PATH" ?? "";
    schema.decodeSystemSpec (load.zti caps.load path)
  ];

main
