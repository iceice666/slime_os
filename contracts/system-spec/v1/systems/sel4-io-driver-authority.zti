      source = "io-driver-supervisor";
      target = "io-driver-worker";
      rights = [
        "mapMmio";
      ];
      transferable = false;
    };
    {
      name = "probe-irq";
      capabilityKind = "interruptSource";
      source = "io-driver-supervisor";
      target = "io-driver-worker";
      rights = [
        "irqAck";
      ];
      transferable = false;
    };
    {
      name = "probe-dma";
      capabilityKind = "dmaAccount";
      source = "io-driver-supervisor";
      target = "io-driver-worker";
      rights = [
        "dmaPin";
        "dmaRelease";
      ];
      transferable = false;
    };
  ];
  slotPins = [
