      reason = "allocatorOrder";
    };
    {
      holder = "io-driver-supervisor";
      grant = "probe-dma";
      slot = 4;
      reason = "allocatorOrder";
    };
    {
      holder = "io-driver-worker";
      grant = "probe-device";
      slot = 0;
      reason = "componentAbi";
    };
    {
      holder = "io-driver-worker";
      grant = "probe-mmio";
      slot = 1;
      reason = "componentAbi";
    };
    {
      holder = "io-driver-worker";
      grant = "probe-irq";
      slot = 2;
      reason = "componentAbi";
    };
    {
      holder = "io-driver-worker";
      grant = "probe-dma";
      slot = 3;
      reason = "componentAbi";
    };
  ];
  extraBindings = [
