-- Pure renderer for Slime OS component image v2 bindings.
-- schema.zt owns concrete reflection and effectful output.
-- Shared Rust-wire mechanics live in the `wire.rust` package module.

refl ::= import stdlib.reflect;
n ::= import stdlib.num;
w ::= import wire.rust;
p ::= import wire.python;

Format :: type {
  formatVersion : Int;
  kernelAbiVersion : Int;
  headerLen : Int;
  segmentLen : Int;
  maxSegments : Int;
  maxImageBytes : Int;
  maxStackBytes : Int;
  defaultStackBytes : Int;
  segmentFlagWrite : Int;
  segmentFlagExec : Int;
  imageMagic : Int;
  legacyMagic : Int;
  legacyFormatVersion : Int;
  legacyHeaderLen : Int;
  headerFields : List refl.SchemaField;
  segmentFields : List refl.SchemaField;
  headerLayout : List w.WireField;
  segmentLayout : List w.WireField;
  pythonHeaderLayout : List p.WireField;
  pythonSegmentLayout : List p.WireField;
};

rustBindings :: Format -> Text
  = format => w.join {
    "// @generated by contracts/component/v2/gen_rust.zt; do not edit.\n";
    "// Source contract: contracts/component/v2/schema.zt\n\n";
    "pub const FORMAT_VERSION: u32 = "; n.toText format.formatVersion; ";\n";
    "pub const KERNEL_ABI_VERSION: u32 = "; n.toText format.kernelAbiVersion; ";\n";
    "pub const HEADER_LEN: usize = "; n.toText format.headerLen; ";\n";
    "pub const SEGMENT_LEN: usize = "; n.toText format.segmentLen; ";\n";
    "pub const MAX_SEGMENTS: u16 = "; n.toText format.maxSegments; ";\n";
    "pub const MAX_IMAGE_BYTES: u64 = "; n.toText format.maxImageBytes; ";\n";
    "pub const MAX_STACK_BYTES: u32 = "; n.toText format.maxStackBytes; ";\n";
    "pub const DEFAULT_STACK_BYTES: u32 = "; n.toText format.defaultStackBytes; ";\n";
    "pub const SEGMENT_FLAG_WRITE: u16 = "; n.toText format.segmentFlagWrite; ";\n";
    "pub const SEGMENT_FLAG_EXEC: u16 = "; n.toText format.segmentFlagExec; ";\n";
    "pub const IMAGE_MAGIC: u64 = "; n.toText format.imageMagic; ";\n";
    "pub const IMAGE_MAGIC_BYTES: [u8; 8] = IMAGE_MAGIC.to_le_bytes();\n";
    "pub const LEGACY_IMAGE_MAGIC: u64 = "; n.toText format.legacyMagic; ";\n";
    "pub const LEGACY_IMAGE_MAGIC_BYTES: [u8; 8] = LEGACY_IMAGE_MAGIC.to_le_bytes();\n";
    "pub const LEGACY_FORMAT_VERSION: u32 = "; n.toText format.legacyFormatVersion; ";\n";
    "pub const LEGACY_HEADER_LEN: usize = "; n.toText format.legacyHeaderLen; ";\n\n";
    "// Retained v1 header offsets. The first four fields (magic, format_version,\n";
    "// header_size, kernel_abi) are byte-identical to v2; v1 diverges from offset\n";
    "// 20 because it lacks the target-qualification fields. A v1 image is an\n";
    "// `x86_64-qemu-virtio` image whose target was implied by its builder, so the\n";
    "// rollback window must decode exactly the bytes that were written.\n";
    "pub const OFF_LEGACY_HEADER_ENTRY_OFFSET: usize = 20;\n";
    "pub const OFF_LEGACY_HEADER_SEGMENT_COUNT: usize = 24;\n";
    "pub const OFF_LEGACY_HEADER_RESERVED: usize = 26;\n";
    "pub const OFF_LEGACY_HEADER_STACK_BYTES: usize = 28;\n\n";
    w.offsetConsts "HEADER" 0 format.headerLayout;
    "\n";
    w.offsetConsts "SEGMENT" 0 format.segmentLayout;
    "\n";
    w.wireStruct "component" "WireImageHeader" "HEADER" "HEADER_LEN" format.headerLayout;
    "\n";
    w.wireStruct "component" "WireSegmentRecord" "SEGMENT" "SEGMENT_LEN" format.segmentLayout;
  };

-- The host builder emits these headers and the host checker verifies them, so
-- both read the layout from here rather than each pinning its own copy.
pythonRecords :: Format -> List p.WireRecord = format => {
  { pythonName = "COMPONENT_IMAGE_HEADER"; constPrefix = "COMPONENT_IMAGE_HEADER"; size = format.headerLen; trailingPadding = 0; fields = format.headerFields; layout = format.pythonHeaderLayout; };
  { pythonName = "COMPONENT_IMAGE_SEGMENT"; constPrefix = "COMPONENT_IMAGE_SEGMENT"; size = format.segmentLen; trailingPadding = 0; fields = format.segmentFields; layout = format.pythonSegmentLayout; };
};

pythonBindings :: Format -> Text = format => p.join {
  "COMPONENT_IMAGE_MAGIC = b\"SLIMECM2\"\n";
  "COMPONENT_IMAGE_LEGACY_MAGIC = b\"SLIMECMP\"\n";
  "COMPONENT_IMAGE_VERSION = "; n.toText format.formatVersion; "\n";
  "COMPONENT_IMAGE_LEGACY_VERSION = "; n.toText format.legacyFormatVersion; "\n";
  "COMPONENT_IMAGE_LEGACY_HEADER_LEN = "; n.toText format.legacyHeaderLen; "\n";
  "COMPONENT_IMAGE_KERNEL_ABI = "; n.toText format.kernelAbiVersion; "\n";
  "COMPONENT_IMAGE_MAX_SEGMENTS = "; n.toText format.maxSegments; "\n";
  "MAX_COMPONENT_IMAGE_BYTES = "; n.toText format.maxImageBytes; "\n";
  "COMPONENT_MAX_STACK_BYTES = "; n.toText format.maxStackBytes; "\n";
  "COMPONENT_DEFAULT_STACK_BYTES = "; n.toText format.defaultStackBytes; "\n";
  "COMPONENT_SEGMENT_FLAG_WRITE = "; n.toText format.segmentFlagWrite; "\n";
  "COMPONENT_SEGMENT_FLAG_EXEC = "; n.toText format.segmentFlagExec; "\n";
  p.renderRecords (pythonRecords format);
};

valid :: Format -> Bool
  = format =>
    w.schemaFieldsValid format.headerFields
      && w.schemaFieldsValid format.segmentFields
      && w.schemaNames format.headerFields == w.layoutNames format.headerLayout
      && w.schemaNames format.segmentFields == w.layoutNames format.segmentLayout
      && w.allValidWidths w.validWidthUnsigned format.headerLayout
      && w.allValidWidths w.validWidthUnsigned format.segmentLayout
      && w.wireBytes format.headerLayout == format.headerLen
      && w.wireBytes format.segmentLayout == format.segmentLen
      && p.recordsValid (pythonRecords format);

render :: Format -> { python : Text; rust : Text; }
  = format => if valid format
    then {
      python = pythonBindings format;
      rust = rustBindings format;
    }
    else {
      python = "INVALID_COMPONENT_SCHEMA";
      rust = "INVALID_COMPONENT_SCHEMA";
    };

{ render = render; }
