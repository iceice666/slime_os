-- Slime OS generation manifest schema, format version 1.
--
-- This module owns the typed host-side validation boundary. The boot-time binary
-- encoding is deliberately not frozen by this source schema.

-- Enumerated identifiers remain Text at the serialization boundary in format 1.
-- The builder validates the closed value sets documented with this contract.

Object :: type {
  id : Text;
  kind : Text;
  size : Int;
};

Component :: type {
  name : Text;
  object : Text;
  role : Text;
  dependencies : List Text;
  -- Optional per-component stack size in bytes for the component image
  -- header (contracts/component/v1). Must be a positive page multiple
  -- within the component format's stack bound; the builder substitutes its
  -- default when absent.
  stackBytes? : Int;
  -- Maximum simultaneous children this component may spawn. Zero disables
  -- spawning; the bootstrap component receives the declared graph budget.
  spawnBudget : Int;
  -- Command names this component may resolve through the spawn service.
  commandProfile : List Text;
};

CapabilityGrant :: type {
  name : Text;
  source : Text;
  target : Text;
  rights : List Text;
  transferable : Bool;
};

StateBinding :: type {
  name : Text;
  owner : Text;
  schemaVersion : Int;
  policy : Text;
};

-- One participant's exact role on one fabric route (C8.2). `interposition` is
-- the ordered proxy chain, outermost first; an empty list is a direct edge.
FabricParticipant :: type {
  component : Text;
  direction : Text;
  visibility : Text;
  interposition : List Text;
  reliability : Text;
  durability : Text;
  liveliness : Text;
  historyDepth : Int;
  retainedDepth : Int;
  deadlineNs : Int;
  lifespanNs : Int;
  leaseNs : Int;
};

FabricRoute :: type {
  name : Text;
  interface : Text;
  participants : List FabricParticipant;
};

-- Every per-graph resource ceiling the fabric and its clients are admitted
-- against. Nothing at runtime may raise them.
FabricLimits :: type {
  routes : Int;
  ingressSources : Int;
  publishers : Int;
  subscribers : Int;
  clients : Int;
  servers : Int;
  sampleBytes : Int;
  queueDepth : Int;
  historyDepth : Int;
  eventDepth : Int;
  retainedSamples : Int;
  retries : Int;
  inFlightCalls : Int;
  inFlightOperations : Int;
  bufferPages : Int;
  mappings : Int;
  loans : Int;
  capabilitySlots : Int;
};

FabricGraph :: type {
  fabricComponent : Text;
  limits : FabricLimits;
  routes : List FabricRoute;
};

HealthPolicy :: type {
  bootAttempts : Int;
  requiredComponents : List Text;
};

GenerationManifest :: type {
  formatVersion : Int;
  generation : Int;
  target : Text;
  parent? : Int;
  kernelObject : Text;
  bootstrapComponent : Text;
  interfaceSchemas : List Text;
  objects : List Object;
  components : List Component;
  grants : List CapabilityGrant;
  state : List StateBinding;
  health : HealthPolicy;
  -- Optional C8.2 fabric graph. Absent means the generation declares no
  -- native data fabric; no component then receives any route authority.
  fabricGraph? : FabricGraph;
};

FromData @Object :: derive
FromData @Component :: derive
FromData @CapabilityGrant :: derive
FromData @StateBinding :: derive
FromData @HealthPolicy :: derive
FromData @FabricParticipant :: derive
FromData @FabricRoute :: derive
FromData @FabricLimits :: derive
FromData @FabricGraph :: derive
FromData @GenerationManifest :: derive

decodeManifest :: Data -> Validation DecodeIssue GenerationManifest
  = data => decode data;

{
  Object = Object;
  Component = Component;
  CapabilityGrant = CapabilityGrant;
  StateBinding = StateBinding;
  HealthPolicy = HealthPolicy;
  FabricParticipant = FabricParticipant;
  FabricRoute = FabricRoute;
  FabricLimits = FabricLimits;
  FabricGraph = FabricGraph;
  GenerationManifest = GenerationManifest;
  decodeManifest = decodeManifest;
}
