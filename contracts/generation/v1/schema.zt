-- Slime OS generation manifest schema, format version 1.
--
-- This module owns the typed host-side validation boundary. The boot-time binary
-- encoding is deliberately not frozen by this source schema.

-- Enumerated identifiers remain Text at the serialization boundary in format 1.
-- The builder validates the closed value sets documented with this contract.

Object :: type {
  id : Text;
  kind : Text;
  size : Int;
};

Executable :: type {
  name : Text;
  object : Text;
  role : Text;
  -- Optional per-executable stack size in bytes for the component image.
  stackBytes? : Int;
  spawnBudget : Int;
  commandProfile : List Text;
};

InstanceBinding :: type {
  grant : Text;
  slot : Int;
};

Instance :: type {
  name : Text;
  executable : Text;
  owner : Text;
  autostart : Bool;
  dependencies : List Text;
  health : Text;
  bindings : List InstanceBinding;
};

CapabilityGrant :: type {
  name : Text;
  source : Text;
  target : Text;
  rights : List Text;
  transferable : Bool;
};

StateBinding :: type {
  name : Text;
  owner : Text;
  schemaVersion : Int;
  policy : Text;
};

-- Per-holder C7 shared-buffer quota carried by the authenticated generation.
-- Omission is deny-by-default; each listed ceiling is absolute live usage.
SharedBufferBudgetEntry :: type {
  holder : Text;
  bytePages : Int;
  bufferCount : Int;
  mappingCount : Int;
  loanCount : Int;
};

-- One named full-graph profile override. Profiles may replace only an exact
-- participant's interposition chain; every other authority and policy field
-- remains fixed by the base graph.
FabricProfileInterposition :: type {
  route : Text;
  participant : Text;
  chain : List Text;
};

FabricProfile :: type {
  name : Text;
  interpositions : List FabricProfileInterposition;
};

-- One named boot profile: which instances the generation declares beyond the
-- product set, and which fabric interposition chains apply (B11).
BootProfile :: type {
  name : Text;
  fabricProfile : Text;
  instances : List Text;
  requiredInstances : List Text;
};

-- One participant's exact role on one fabric route (C8.2). `interposition` is
-- the ordered proxy chain, outermost first; an empty list is a direct edge.
FabricParticipant :: type {
  component : Text;
  direction : Text;
  visibility : Text;
  interposition : List Text;
  reliability : Text;
  durability : Text;
  liveliness : Text;
  historyDepth : Int;
  retainedDepth : Int;
  deadlineNs : Int;
  lifespanNs : Int;
  leaseNs : Int;
};

FabricRoute :: type {
  name : Text;
  interface : Text;
  participants : List FabricParticipant;
};

-- Every per-graph resource ceiling the fabric and its clients are admitted
-- against. Nothing at runtime may raise them.
FabricLimits :: type {
  routes : Int;
  ingressSources : Int;
  publishers : Int;
  subscribers : Int;
  clients : Int;
  servers : Int;
  sampleBytes : Int;
  queueDepth : Int;
  historyDepth : Int;
  eventDepth : Int;
  retainedSamples : Int;
  retries : Int;
  inFlightCalls : Int;
  inFlightOperations : Int;
  bufferPages : Int;
  mappings : Int;
  loans : Int;
  capabilitySlots : Int;
  buffers : Int;
};

FabricGraph :: type {
  fabricComponent : Text;
  limits : FabricLimits;
  routes : List FabricRoute;
  profiles : List FabricProfile;
};

HealthPolicy :: type {
  bootAttempts : Int;
  requiredInstances : List Text;
};

GenerationManifest :: type {
  formatVersion : Int;
  generation : Int;
  target : Text;
  parent? : Int;
  bootstrapInstance : Text;
  interfaceSchemas : List Text;
  sharedBufferBudget : List SharedBufferBudgetEntry;
  objects : List Object;
  executables : List Executable;
  instances : List Instance;
  grants : List CapabilityGrant;
  state : List StateBinding;
  -- Fallback health policy, used by a profile that declares no required set of
  -- its own.
  health : HealthPolicy;
  bootProfiles : List BootProfile;
  -- Optional C8.2 fabric graph. Absent means the generation declares no
  -- native data fabric; no component then receives any route authority.
  fabricGraph? : FabricGraph;
};

FromData @Object :: derive
FromData @Executable :: derive
FromData @InstanceBinding :: derive
FromData @Instance :: derive
FromData @CapabilityGrant :: derive
FromData @StateBinding :: derive
FromData @HealthPolicy :: derive
FromData @SharedBufferBudgetEntry :: derive
FromData @FabricProfileInterposition :: derive
FromData @FabricProfile :: derive
FromData @FabricParticipant :: derive
FromData @FabricRoute :: derive
FromData @FabricLimits :: derive
FromData @FabricGraph :: derive
FromData @BootProfile :: derive
FromData @GenerationManifest :: derive

decodeManifest :: Data -> Validation DecodeIssue GenerationManifest
  = data => decode data;

{
  Object = Object;
  Executable = Executable;
  InstanceBinding = InstanceBinding;
  Instance = Instance;
  SharedBufferBudgetEntry = SharedBufferBudgetEntry;
  FabricProfileInterposition = FabricProfileInterposition;
  FabricProfile = FabricProfile;
  CapabilityGrant = CapabilityGrant;
  StateBinding = StateBinding;
  HealthPolicy = HealthPolicy;
  FabricParticipant = FabricParticipant;
  FabricRoute = FabricRoute;
  FabricLimits = FabricLimits;
  FabricGraph = FabricGraph;
  BootProfile = BootProfile;
  GenerationManifest = GenerationManifest;
  decodeManifest = decodeManifest;
}
