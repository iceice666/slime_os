-- Slime OS bounded native operation control records, version 1 (C8.7).
--
-- One `OperationEnvelope` carries every leg an `Operation<Goal, Feedback,
-- Result>` is composed from: the start-goal call, the transport
-- accepted/rejected answer, the operation-keyed feedback stream, the result
-- call and its retained retrieval, the cancellation request, and the single
-- terminal outcome. Composition is the point of the record — the goal, its
-- feedback, and its result are correlated by `operation_id` alone, so no leg
-- needs a private framing and none can be replayed into another operation.
--
-- `session` is the generation/session qualifier and `operation_id` the
-- per-session identity; together they are what makes a stale or restarted
-- participant's identity distinguishable from a live one. `sequence` orders
-- feedback within one operation and is meaningless on every other kind.
--
-- Application goal policy and the ROS action state machine are deliberately
-- absent: `status` names transport outcomes only.
--
-- Time is not restated here. Deadline and retained-result expiry are driven by
-- the C8.5 `contracts/fabric-time/v1` monotonic record, which exists for
-- exactly this and keeps one simulated-time source across the fabric.

env ::= import stdlib.env;
fs ::= import stdlib.fs;
gen ::= import "gen_rust.zt";
t ::= import stdlib.text;

formatVersion :: Int = 1;
recordLen :: Int = 64;
inlineBytes :: Int = 16;
magic :: Int = 1381323091; -- `SOPR`

-- Every leg of one operation. `goal` opens it, `accepted`/`rejected` answer the
-- start call, `feedback` streams progress under the operation key, `result`
-- and `resultRequest` are the result call, `cancel` requests cancellation,
-- `terminal` is the one transport outcome the client is owed, and
-- `serverIdle` fences the final server record for one handled request.
kindGoal :: Int = 1;
kindAccepted :: Int = 2;
kindFeedback :: Int = 3;
kindResult :: Int = 4;
kindResultRequest :: Int = 5;
kindCancel :: Int = 6;
kindTerminal :: Int = 7;
kindServerIdle :: Int = 8;

-- Transport outcomes. `active` and `cancelRequested` are progress states an
-- `accepted` record reports; the rest are terminal.
statusSuccess :: Int = 0;
statusRejected :: Int = 1;
statusCancelled :: Int = 2;
statusExpired :: Int = 3;
statusTimeout :: Int = 4;
statusPeerDead :: Int = 5;
statusDuplicate :: Int = 6;
statusStale :: Int = 7;
statusMalformed :: Int = 8;
statusRetryExhausted :: Int = 9;
statusActive :: Int = 10;
statusCancelRequested :: Int = 11;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };
OperationEnvelope :: type {
  magic : Int;
  version : Int;
  kind : Int;
  status : Int;
  session : Int;
  operation_id : Int;
  type_identity : Int;
  sequence : Int;
  payload_len : Int;
  payload : Int;
};
schemaValue ::= schema OperationEnvelope;
layout :: List WireField = {
  { name = "magic"; width = 4; signed = false; byteArray = false; };
  { name = "version"; width = 4; signed = false; byteArray = false; };
  { name = "kind"; width = 4; signed = false; byteArray = false; };
  { name = "status"; width = 4; signed = true; byteArray = false; };
  { name = "session"; width = 8; signed = false; byteArray = false; };
  { name = "operation_id"; width = 8; signed = false; byteArray = false; };
  { name = "type_identity"; width = 8; signed = false; byteArray = false; };
  { name = "sequence"; width = 4; signed = false; byteArray = false; };
  { name = "payload_len"; width = 4; signed = false; byteArray = false; };
  { name = "payload"; width = 16; signed = false; byteArray = true; };
};
format ::= {
  formatVersion =;
  recordLen =;
  inlineBytes =;
  magic =;
  kindGoal =;
  kindAccepted =;
  kindFeedback =;
  kindResult =;
  kindResultRequest =;
  kindCancel =;
  kindTerminal =;
  kindServerIdle =;
  statusSuccess =;
  statusRejected =;
  statusCancelled =;
  statusExpired =;
  statusTimeout =;
  statusPeerDead =;
  statusDuplicate =;
  statusStale =;
  statusMalformed =;
  statusRetryExhausted =;
  statusActive =;
  statusCancelRequested =;
  fields = schemaValue.fields ?? {;};
  layout =;
};
main :: { write : FsWrite; env : Env; } -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_FABRIC_OPERATION_BINDINGS_ROOT" ?? ".";
    bindings := gen.render format;
    path := t.join "" { root; "/components/proto/src/fabric_operation.rs"; };
    fs.writeAll caps.write path bindings.rust
  ];
main
