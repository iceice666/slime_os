-- Pure renderer for Slime OS bounded operation framing (C8.7).

refl ::= import stdlib.reflect;
n ::= import stdlib.num;
t ::= import stdlib.text;
w ::= import wire.rust;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };
Protocol :: type {
  formatVersion : Int;
  recordLen : Int;
  inlineBytes : Int;
  magic : Int;
  kindGoal : Int;
  kindAccepted : Int;
  kindFeedback : Int;
  kindResult : Int;
  kindResultRequest : Int;
  kindCancel : Int;
  kindTerminal : Int;
  statusSuccess : Int;
  statusRejected : Int;
  statusCancelled : Int;
  statusExpired : Int;
  statusTimeout : Int;
  statusPeerDead : Int;
  statusDuplicate : Int;
  statusStale : Int;
  statusMalformed : Int;
  statusRetryExhausted : Int;
  statusActive : Int;
  statusCancelRequested : Int;
  fields : List refl.SchemaField;
  layout : List WireField;
};
layoutNames :: List WireField -> List Text = fields => map _.name fields;
validField :: WireField -> Bool = field => if field.byteArray then field.width > 0 && not field.signed else w.validWidthSigned4 { name = field.name; width = field.width; signed = field.signed; };
allValid :: List WireField -> Bool = fields => match fields { | {;} => true; | { field; ...rest } => validField field && allValid rest; };
addWidth :: Int -> WireField -> Int = total field => total + field.width;
wireBytes :: List WireField -> Int = fields => fold addWidth 0 fields;
constName :: Text -> Text = name => w.join { "OFF_OPERATION_"; t.toUpper name; };
offsetConsts :: Int -> List WireField -> Text = offset fields => match fields {
  | {;} => "";
  | { field; ...rest } => w.join { "pub const "; constName field.name; ": usize = "; n.toText offset; ";\n"; offsetConsts (offset + field.width) rest; };
};
rustType :: WireField -> Text = field => if field.byteArray then w.join { "[u8; "; n.toText field.width; "]"; } else w.rustType { name = field.name; width = field.width; signed = field.signed; };
fieldDecls :: List WireField -> Text = fields => match fields { | {;} => ""; | { field; ...rest } => w.join { "    pub "; field.name; ": "; rustType field; ",\n"; fieldDecls rest; }; };
decodeExpr :: WireField -> Text = field => if field.byteArray
  then w.join { "buf["; constName field.name; ".."; constName field.name; " + "; n.toText field.width; "].try_into().expect(\"generated fabric-operation layout\")"; }
  else if field.width == 1 then w.join { "buf["; constName field.name; "]"; }
  else w.join { rustType field; "::from_le_bytes(buf["; constName field.name; ".."; constName field.name; " + "; n.toText field.width; "].try_into().expect(\"generated fabric-operation layout\"))"; };
decodeFields :: List WireField -> Text = fields => match fields { | {;} => ""; | { field; ...rest } => w.join { "            "; field.name; ": "; decodeExpr field; ",\n"; decodeFields rest; }; };
encodeField :: WireField -> Text = field => if field.byteArray
  then w.join { "        buf["; constName field.name; ".."; constName field.name; " + "; n.toText field.width; "].copy_from_slice(&self."; field.name; ");\n"; }
  else if field.width == 1 then w.join { "        buf["; constName field.name; "] = self."; field.name; ";\n"; }
  else w.join { "        buf["; constName field.name; ".."; constName field.name; " + "; n.toText field.width; "].copy_from_slice(&self."; field.name; ".to_le_bytes());\n"; };
encodeFields :: List WireField -> Text = fields => match fields { | {;} => ""; | { field; ...rest } => w.join { encodeField field; encodeFields rest; }; };
wireStruct :: Text -> Text -> List WireField -> Text = name len fields => w.join {
  "#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub struct "; name; " {\n"; fieldDecls fields; "}\n\n";
  "impl "; name; " {\n    pub fn decode(buf: &[u8]) -> Option<Self> {\n        if buf.len() < "; len; " { return None; }\n        Some(Self {\n"; decodeFields fields; "        })\n    }\n\n    pub fn encode(self) -> [u8; "; len; "] {\n        let mut buf = [0u8; "; len; "];\n"; encodeFields fields; "        buf\n    }\n}\n";
};
rustBindings :: Protocol -> Text = protocol => w.join {
  "// @generated by contracts/fabric-operation/v1/gen_rust.zt; do not edit.\n// Source contract: contracts/fabric-operation/v1/schema.zt\n\n";
  "pub const FORMAT_VERSION: u32 = "; n.toText protocol.formatVersion; ";\n";
  "pub const OPERATION_MAGIC: u32 = "; n.toText protocol.magic; ";\n";
  "pub const OPERATION_LEN: usize = "; n.toText protocol.recordLen; ";\n";
  "pub const INLINE_BYTES: usize = "; n.toText protocol.inlineBytes; ";\n";
  "pub const KIND_GOAL: u32 = "; n.toText protocol.kindGoal; ";\n";
  "pub const KIND_ACCEPTED: u32 = "; n.toText protocol.kindAccepted; ";\n";
  "pub const KIND_FEEDBACK: u32 = "; n.toText protocol.kindFeedback; ";\n";
  "pub const KIND_RESULT: u32 = "; n.toText protocol.kindResult; ";\n";
  "pub const KIND_RESULT_REQUEST: u32 = "; n.toText protocol.kindResultRequest; ";\n";
  "pub const KIND_CANCEL: u32 = "; n.toText protocol.kindCancel; ";\n";
  "pub const KIND_TERMINAL: u32 = "; n.toText protocol.kindTerminal; ";\n";
  "pub const STATUS_SUCCESS: i32 = "; n.toText protocol.statusSuccess; ";\n";
  "pub const STATUS_REJECTED: i32 = "; n.toText protocol.statusRejected; ";\n";
  "pub const STATUS_CANCELLED: i32 = "; n.toText protocol.statusCancelled; ";\n";
  "pub const STATUS_EXPIRED: i32 = "; n.toText protocol.statusExpired; ";\n";
  "pub const STATUS_TIMEOUT: i32 = "; n.toText protocol.statusTimeout; ";\n";
  "pub const STATUS_PEER_DEAD: i32 = "; n.toText protocol.statusPeerDead; ";\n";
  "pub const STATUS_DUPLICATE: i32 = "; n.toText protocol.statusDuplicate; ";\n";
  "pub const STATUS_STALE: i32 = "; n.toText protocol.statusStale; ";\n";
  "pub const STATUS_MALFORMED: i32 = "; n.toText protocol.statusMalformed; ";\n";
  "pub const STATUS_RETRY_EXHAUSTED: i32 = "; n.toText protocol.statusRetryExhausted; ";\n";
  "pub const STATUS_ACTIVE: i32 = "; n.toText protocol.statusActive; ";\n";
  "pub const STATUS_CANCEL_REQUESTED: i32 = "; n.toText protocol.statusCancelRequested; ";\n\n";
  offsetConsts 0 protocol.layout; "\n";
  wireStruct "WireOperationEnvelope" "OPERATION_LEN" protocol.layout;
};
valid :: Protocol -> Bool = protocol =>
  w.schemaFieldsValid protocol.fields
  && w.schemaNames protocol.fields == layoutNames protocol.layout
  && allValid protocol.layout
  && wireBytes protocol.layout == protocol.recordLen
  && protocol.inlineBytes == 16;
render :: Protocol -> { rust : Text; } = protocol => if valid protocol then { rust = rustBindings protocol; } else { rust = "INVALID_FABRIC_OPERATION_SCHEMA"; };
{ render = render; }
