-- Schema-reflected Python + Rust renderer for wait-set/v1.

refl ::= import stdlib.reflect;
n ::= import stdlib.num;
w ::= import wire.python;
r ::= import wire.rust;

Format :: type {
  formatVersion : Int;
  headerBytes : Int;
  entryBytes : Int;
  maxEntries : Int;
  maxSourcesPerWaiter : Int;
  maxCallbacksPerWake : Int;
  kindStream : Int;
  kindCall : Int;
  kindOperation : Int;
  kindTimer : Int;
  kindSupervision : Int;
  kindQosEvent : Int;
  drainSlotAbsent : Int;
  headerFields : List refl.SchemaField;
  entryFields : List refl.SchemaField;
  headerLayout : List w.WireField;
  entryLayout : List w.WireField;
};

records :: Format -> List w.WireRecord = format => {
  { pythonName = "WAIT_SET_HEADER"; constPrefix = "WAIT_SET"; size = format.headerBytes; trailingPadding = 0; fields = format.headerFields; layout = format.headerLayout; };
  { pythonName = "WAIT_SET_ENTRY"; constPrefix = "WAIT_SET_ENTRY"; size = format.entryBytes; trailingPadding = 0; fields = format.entryFields; layout = format.entryLayout; };
};

pythonBindings :: Format -> Text = format => w.join {
  "WAIT_SET_MAGIC = b\"SLIMEWS\\0\"\n";
  "WAIT_SET_VERSION = "; n.toText format.formatVersion; "\n";
  "WAIT_SET_HEADER_BYTES = "; n.toText format.headerBytes; "\n";
  "WAIT_SET_ENTRY_BYTES = "; n.toText format.entryBytes; "\n";
  "WAIT_SET_MAX_ENTRIES = "; n.toText format.maxEntries; "\n";
  "WAIT_SET_MAX_SOURCES_PER_WAITER = "; n.toText format.maxSourcesPerWaiter; "\n";
  "WAIT_SET_MAX_CALLBACKS_PER_WAKE = "; n.toText format.maxCallbacksPerWake; "\n";
  "WAIT_SET_KIND_STREAM = "; n.toText format.kindStream; "\n";
  "WAIT_SET_KIND_CALL = "; n.toText format.kindCall; "\n";
  "WAIT_SET_KIND_OPERATION = "; n.toText format.kindOperation; "\n";
  "WAIT_SET_KIND_TIMER = "; n.toText format.kindTimer; "\n";
  "WAIT_SET_KIND_SUPERVISION = "; n.toText format.kindSupervision; "\n";
  "WAIT_SET_KIND_QOS_EVENT = "; n.toText format.kindQosEvent; "\n";
  "WAIT_SET_DRAIN_SLOT_ABSENT = "; n.toText format.drainSlotAbsent; "\n";
  w.renderRecords (records format);
};

rustBindings :: Format -> Text = format => r.join {
  "// @generated by contracts/wait-set/v1/gen_rust.zt; do not edit.\n";
  "// Source contract: contracts/wait-set/v1/schema.zt\n\n";
  r.u32Const "FORMAT_VERSION" format.formatVersion;
  r.usizeConst "HEADER_BYTES" format.headerBytes;
  r.usizeConst "ENTRY_BYTES" format.entryBytes;
  r.usizeConst "MAX_ENTRIES" format.maxEntries;
  r.usizeConst "MAX_SOURCES_PER_WAITER" format.maxSourcesPerWaiter;
  r.usizeConst "MAX_CALLBACKS_PER_WAKE" format.maxCallbacksPerWake;
  r.u32Const "KIND_STREAM" format.kindStream;
  r.u32Const "KIND_CALL" format.kindCall;
  r.u32Const "KIND_OPERATION" format.kindOperation;
  r.u32Const "KIND_TIMER" format.kindTimer;
  r.u32Const "KIND_SUPERVISION" format.kindSupervision;
  r.u32Const "KIND_QOS_EVENT" format.kindQosEvent;
  r.u32Const "DRAIN_SLOT_ABSENT" format.drainSlotAbsent;
};

render :: Format -> { python : Text; rust : Text; }
  = format => if w.recordsValid (records format)
    then { python = pythonBindings format; rust = rustBindings format; }
    else { python = "INVALID_WAIT_SET_SCHEMA"; rust = "INVALID_WAIT_SET_SCHEMA"; };
{ render =; }
