-- Renderer for the data volume: the Rust constants the guest reader validates with and the Python constants
-- the host builder writes with, both read from `schema.zt` so the two cannot drift.

schema ::= import "schema.zt";
env ::= import stdlib.env;
fs ::= import stdlib.fs;
n ::= import stdlib.num;
l ::= import stdlib.list;
t ::= import stdlib.text;
c ::= import wire.codec;

-- `"a", "b"`: quoted and comma-separated, with no trailing separator. Refusal classes are lowercase words
-- joined by `-`, so they need no escaping in either language.
quoted :: List Text -> Text
= names => match names {
  | {;} => "";
  | { name; ...rest } => match rest {
    | {;} => t.join "" { "\""; name; "\""; };
    | { next; ...more } => t.join "" { "\""; name; "\", "; quoted rest; };
  };
};

layoutBytes :: List c.WireField -> Int
= fields => match fields {
  | {;} => 0;
  | { field; ...rest } => field.width + layoutBytes rest;
};

layout :: List c.WireField = schema.volumeHeaderLayout;

rust :: Text = t.join "" {
  "// @generated by contracts/data-volume/v1/gen.zt; do not edit.\n";
  "// Source contract: contracts/data-volume/v1/schema.zt\n\n";
  "pub const FORMAT_VERSION: u16 = "; n.toText schema.formatVersion; ";\n";
  "pub const VOLUME_MAGIC: u32 = "; n.toText schema.volumeMagic; ";\n";
  "pub const KIND_FRAME_STORE: u16 = "; n.toText schema.kindFrameStore; ";\n";
  "pub const SECTOR_BYTES: usize = "; n.toText schema.sectorBytes; ";\n";
  "pub const FIRST_LBA: u64 = "; n.toText schema.firstLba; ";\n";
  "pub const GPT_ENTRY_COUNT: u32 = "; n.toText schema.gptEntryCount; ";\n";
  "pub const GPT_ENTRY_BYTES: u32 = "; n.toText schema.gptEntryBytes; ";\n";
  "pub const MAX_PAYLOAD_BYTES: u64 = "; n.toText schema.maxPayloadBytes; ";\n";
  "pub const PARTITION_TYPE_GUID: &str = \""; schema.partitionTypeGuid; "\";\n";
  "pub const PARTITION_NAME: &str = \""; schema.partitionName; "\";\n";
  "pub const DISK_GUID_DOMAIN: &str = \""; schema.diskGuidDomain; "\";\n";
  "pub const PARTITION_GUID_DOMAIN: &str = \""; schema.partitionGuidDomain; "\";\n\n";
  "/// The refusal classes, in the order of the first check that can produce each.\n";
  "pub const REFUSAL_CLASSES: [&str; "; n.toText (l.length schema.refusalClasses); "] = [";
  quoted schema.refusalClasses; "];\n\n";
  "pub const VOLUME_HEADER_BYTES: usize = "; n.toText (layoutBytes layout); ";\n";
  c.offsetConsts "HEADER" 0 layout;
};

python :: Text = t.join "" {
  "# @generated by contracts/data-volume/v1/gen.zt; do not edit.\n";
  "# Source contract: contracts/data-volume/v1/schema.zt\n\n";
  "FORMAT_VERSION = "; n.toText schema.formatVersion; "\n";
  "VOLUME_MAGIC = "; n.toText schema.volumeMagic; "\n";
  "KIND_FRAME_STORE = "; n.toText schema.kindFrameStore; "\n";
  "SECTOR_BYTES = "; n.toText schema.sectorBytes; "\n";
  "FIRST_LBA = "; n.toText schema.firstLba; "\n";
  "GPT_ENTRY_COUNT = "; n.toText schema.gptEntryCount; "\n";
  "GPT_ENTRY_BYTES = "; n.toText schema.gptEntryBytes; "\n";
  "MAX_PAYLOAD_BYTES = "; n.toText schema.maxPayloadBytes; "\n";
  "PARTITION_TYPE_GUID = \""; schema.partitionTypeGuid; "\"\n";
  "PARTITION_NAME = \""; schema.partitionName; "\"\n";
  "DISK_GUID_DOMAIN = \""; schema.diskGuidDomain; "\"\n";
  "PARTITION_GUID_DOMAIN = \""; schema.partitionGuidDomain; "\"\n";
  "REFUSAL_CLASSES = ("; quoted schema.refusalClasses; ")\n";
  "VOLUME_HEADER_BYTES = "; n.toText (layoutBytes layout); "\n";
};

main :: { write : FsWrite; env : Env; } -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
= caps => [
  root := env.get caps.env "SLIME_DATA_VOLUME_BINDINGS_ROOT" ?? ".";
  fs.writeAll caps.write (t.join "" { root; "/components/proto/src/data_volume.rs"; }) rust;
  fs.writeAll caps.write (t.join "" { root; "/scripts/lib/data_volume_contract.py"; }) python
];

main
