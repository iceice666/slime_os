-- Slime OS entropy-service protocol, version 1.
-- A holder's one call to the entropy service over its own declared endpoint.
-- A `draw` asks for 1..maxDraw bytes charged against the holder's generation
-- byte budget; `close` ends the holder's session. A refused draw charges
-- nothing and carries no bytes. The holder is identified by the endpoint the
-- request arrived on, never by anything in the request.

env ::= import stdlib.env;
fs ::= import stdlib.fs;
gen ::= import "gen_rust.zt";
t ::= import stdlib.text;

formatVersion :: Int = 1;
requestLen :: Int = 16;
replyLen :: Int = 48;
maxDraw :: Int = 32;
opDraw :: Int = 1;
opClose :: Int = 2;
statusOk :: Int = 0;
statusDenied :: Int = -1;
statusMalformed :: Int = -2;
statusExhausted :: Int = -3;
statusUnavailable :: Int = -4;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

EntropyServiceRequest :: type {
  magic : Int;
  version : Int;
  op : Int;
  length : Int;
};

-- `length` counts the leading `bytes` drawn: the requested length on
-- `statusOk`, zero otherwise. Bytes past `length` are zero.
EntropyServiceReply :: type {
  magic : Int;
  version : Int;
  status : Int;
  length : Int;
  bytes : Int;
};

requestSchema ::= schema EntropyServiceRequest;
replySchema ::= schema EntropyServiceReply;

requestLayout :: List WireField = {
  { name = "magic"; width = 4; signed = false; byteArray = false; };
  { name = "version"; width = 4; signed = false; byteArray = false; };
  { name = "op"; width = 4; signed = false; byteArray = false; };
  { name = "length"; width = 4; signed = false; byteArray = false; };
};

replyLayout :: List WireField = {
  { name = "magic"; width = 4; signed = false; byteArray = false; };
  { name = "version"; width = 4; signed = false; byteArray = false; };
  { name = "status"; width = 4; signed = true; byteArray = false; };
  { name = "length"; width = 4; signed = false; byteArray = false; };
  { name = "bytes"; width = 32; signed = false; byteArray = true; };
};

format ::= {
  formatVersion =;
  requestLen =;
  replyLen =;
  maxDraw =;
  opDraw =;
  opClose =;
  statusOk =;
  statusDenied =;
  statusMalformed =;
  statusExhausted =;
  statusUnavailable =;
  requestFields = requestSchema.fields ?? {;};
  replyFields = replySchema.fields ?? {;};
  requestLayout =;
  replyLayout =;
};

main :: { write : FsWrite; env : Env; } -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_ENTROPY_BINDINGS_ROOT" ?? ".";
    rustPath := t.join "" { root; "/components/proto/src/entropy_service.rs"; };
    fs.writeAll caps.write rustPath (gen.render format)
  ];

main
