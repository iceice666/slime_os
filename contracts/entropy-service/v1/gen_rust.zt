-- Pure renderer for Slime OS entropy-service protocol bindings: the Rust module
-- the entropy service and its holders import.

refl ::= import stdlib.reflect;
n ::= import stdlib.num;
w ::= import wire.rust;
c ::= import wire.codec;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

Protocol :: type {
  formatVersion : Int;
  requestLen : Int;
  replyLen : Int;
  maxDraw : Int;
  opDraw : Int;
  opClose : Int;
  statusOk : Int;
  statusDenied : Int;
  statusMalformed : Int;
  statusExhausted : Int;
  statusUnavailable : Int;
  requestFields : List refl.SchemaField;
  replyFields : List refl.SchemaField;
  requestLayout : List WireField;
  replyLayout : List WireField;
};

layoutNames :: List WireField -> List Text = c.layoutNames;
allValid :: List WireField -> Bool = c.allValid;
wireBytes :: List WireField -> Int = c.wireBytes;
offsetConsts :: Text -> Int -> List WireField -> Text = c.offsetConsts;
wireStruct :: Text -> Text -> Text -> List WireField -> Text
  = name prefix lengthName fields => c.wireStruct "entropy_service" name prefix lengthName fields;

-- "ENTR" as a little-endian u32.
magic :: Int = 1381256773;

rustBindings :: Protocol -> Text
  = protocol => w.join {
    "// @generated by contracts/entropy-service/v1/gen_rust.zt; do not edit.\n";
    "// Source contract: contracts/entropy-service/v1/schema.zt\n\n";
    "pub const FORMAT_VERSION: u32 = "; n.toText protocol.formatVersion; ";\n";
    "pub const ENTROPY_SERVICE_MAGIC: u32 = "; n.toText magic; ";\n";
    "pub const REQUEST_LEN: usize = "; n.toText protocol.requestLen; ";\n";
    "pub const REPLY_LEN: usize = "; n.toText protocol.replyLen; ";\n";
    "pub const MAX_DRAW: usize = "; n.toText protocol.maxDraw; ";\n";
    "pub const OP_DRAW: u32 = "; n.toText protocol.opDraw; ";\n";
    "pub const OP_CLOSE: u32 = "; n.toText protocol.opClose; ";\n\n";
    "pub const STATUS_OK: i32 = "; n.toText protocol.statusOk; ";\n";
    "pub const STATUS_DENIED: i32 = "; n.toText protocol.statusDenied; ";\n";
    "pub const STATUS_MALFORMED: i32 = "; n.toText protocol.statusMalformed; ";\n";
    "pub const STATUS_EXHAUSTED: i32 = "; n.toText protocol.statusExhausted; ";\n";
    "pub const STATUS_UNAVAILABLE: i32 = "; n.toText protocol.statusUnavailable; ";\n\n";
    offsetConsts "REQUEST" 0 protocol.requestLayout;
    "\n";
    offsetConsts "REPLY" 0 protocol.replyLayout;
    "\n";
    wireStruct "WireEntropyServiceRequest" "REQUEST" "REQUEST_LEN" protocol.requestLayout;
    "\n";
    wireStruct "WireEntropyServiceReply" "REPLY" "REPLY_LEN" protocol.replyLayout;
  };

-- The reply's byte field holds exactly one maximal draw, and every refusal is
-- a distinct negative status, so a refusal can never read as drawn bytes.
valid :: Protocol -> Bool
  = protocol =>
    w.schemaFieldsValid protocol.requestFields
      && w.schemaFieldsValid protocol.replyFields
      && w.schemaNames protocol.requestFields == layoutNames protocol.requestLayout
      && w.schemaNames protocol.replyFields == layoutNames protocol.replyLayout
      && allValid protocol.requestLayout
      && allValid protocol.replyLayout
      && wireBytes protocol.requestLayout == protocol.requestLen
      && wireBytes protocol.replyLayout == protocol.replyLen
      && protocol.replyLen == 16 + protocol.maxDraw
      && protocol.maxDraw > 0
      && protocol.opDraw > 0
      && protocol.opClose > 0
      && protocol.opDraw != protocol.opClose
      && protocol.statusOk == 0
      && protocol.statusDenied < 0
      && protocol.statusMalformed < 0
      && protocol.statusExhausted < 0
      && protocol.statusUnavailable < 0
      && protocol.statusDenied != protocol.statusMalformed
      && protocol.statusDenied != protocol.statusExhausted
      && protocol.statusDenied != protocol.statusUnavailable
      && protocol.statusMalformed != protocol.statusExhausted
      && protocol.statusMalformed != protocol.statusUnavailable
      && protocol.statusExhausted != protocol.statusUnavailable;

render :: Protocol -> Text
  = protocol => if valid protocol then rustBindings protocol else "INVALID_ENTROPY_SERVICE_SCHEMA";

{ render =; }
