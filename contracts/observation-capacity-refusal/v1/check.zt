s ::= import "schema.zt";
env ::= import stdlib.env;
load ::= import stdlib.load;
main :: { env : Env; load : Load; }
  -> Validation DecodeIssue s.CapacityRefusal
  ! { * env.GetEffects; * load.ZtiEffects; }
  = caps => [
    path := env.get caps.env "SLIME_CAPACITY_RECEIPT" ?? "";
    s.decodeRefusal (load.zti caps.load path)
  ];
main
