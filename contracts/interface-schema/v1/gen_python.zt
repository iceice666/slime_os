-- Generated host constants for the C8.1 interface-schema compiler.

schema ::= import "schema.zt";
env ::= import stdlib.env;
fs ::= import stdlib.fs;
n ::= import stdlib.num;
t ::= import stdlib.text;

line :: Text -> Int -> Text
  = name value => t.join "" { name; " = "; n.toText value; "\n"; };

render :: Text = t.join "" {
  "# @generated by contracts/interface-schema/v1/gen_python.zt; do not edit.\n";
  line "FORMAT_VERSION" schema.formatVersion;
  line "MAX_SCHEMAS" schema.maxSchemas;
  line "MAX_SOURCE_BYTES" schema.maxSourceBytes;
  line "MAX_NORMALIZED_BYTES" schema.maxNormalizedBytes;
  line "MAX_GENERATED_BYTES" schema.maxGeneratedBytes;
  line "MAX_NAME_BYTES" schema.maxNameBytes;
  line "MAX_TYPES" schema.maxTypes;
  line "MAX_FIELDS_PER_TYPE" schema.maxFieldsPerType;
  line "MAX_TOTAL_FIELDS" schema.maxTotalFields;
  line "MAX_DEPTH" schema.maxDepth;
  line "MAX_SEQUENCE_ELEMENTS" schema.maxSequenceElements;
  line "MAX_ENCODED_BYTES" schema.maxEncodedBytes;
  "IDENTITY_DOMAIN = "; t.show schema.identityDomain; ".encode(\"utf-8\")\n";
  "TAG_DOMAIN = "; t.show schema.tagDomain; ".encode(\"utf-8\")\n";
  "FIELD_KINDS = (";
    t.show schema.fieldKindScalar; ", ";
    t.show schema.fieldKindBytes; ", ";
    t.show schema.fieldKindRecord; ", ";
    t.show schema.fieldKindSequence; ")\n";
  "CONTRACT_KINDS = (";
    t.show schema.contractKindStream; ", ";
    t.show schema.contractKindCall; ", ";
    t.show schema.contractKindOperation; ")\n";
};

main :: { write : FsWrite; env : Env; }
  -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_INTERFACE_BINDINGS_ROOT" ?? ".";
    path := t.join "" { root; "/interface_schema_contract.py"; };
    fs.writeAll caps.write path render
  ];

main
