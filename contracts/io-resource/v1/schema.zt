-- Slime OS per-driver hardware-resource budget, version 1 (IO1).
env ::= import stdlib.env;
fs ::= import stdlib.fs;
gen ::= import "gen_rust.zt";
t ::= import stdlib.text;
formatVersion :: Int = 1;
headerBytes :: Int = 32;
entryBytes :: Int = 64;
maxDrivers :: Int = 32;
WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };
BudgetHeader :: type { magic : Int; format_version : Int; header_size : Int; required_flags : Int; driver_count : Int; total_len : Int; };
-- `device` is which attached transport this driver instance drives, as a
-- zero-based ordinal into the platform's stable device order (B84).
--
-- Declared rather than inferred. It cannot be derived from declaration order:
-- a plane with two disks declares one driver executable twice, and the root
-- assigns every non-block typed grant in an instance a single positional
-- index, so two instances would resolve to the same device. It also cannot be
-- carried on the grant record, because the same index reaches every typed kind
-- in that instance -- advancing it for one kind shifts the others.
--
-- It belongs here because this record is already keyed by the authenticated
-- driver instance identity, and which device an instance drives is a property
-- of that instance rather than of any one capability it holds. One number then
-- names the device for the instance's `device`, `mmioRegion`,
-- `interruptSource`, and `dmaAccount` authority at once, so those four cannot
-- disagree about which transport they mean.
BudgetEntry :: type { driver_identity : Int; mmio_bytes : Int; mmio_mappings : Int; dma_pages : Int; dma_mappings : Int; irq_sources : Int; outstanding_requests : Int; buffer_loans : Int; device : Int; };
headerSchema ::= schema BudgetHeader;
entrySchema ::= schema BudgetEntry;
headerLayout :: List WireField = {
  { name = "magic"; width = 8; signed = false; byteArray = true; };
  { name = "format_version"; width = 4; signed = false; byteArray = false; };
  { name = "header_size"; width = 4; signed = false; byteArray = false; };
  { name = "required_flags"; width = 8; signed = false; byteArray = false; };
  { name = "driver_count"; width = 4; signed = false; byteArray = false; };
  { name = "total_len"; width = 4; signed = false; byteArray = false; };
};
entryLayout :: List WireField = {
  { name = "driver_identity"; width = 32; signed = false; byteArray = true; };
  { name = "mmio_bytes"; width = 4; signed = false; byteArray = false; };
  { name = "mmio_mappings"; width = 4; signed = false; byteArray = false; };
  { name = "dma_pages"; width = 4; signed = false; byteArray = false; };
  { name = "dma_mappings"; width = 4; signed = false; byteArray = false; };
  { name = "irq_sources"; width = 4; signed = false; byteArray = false; };
  { name = "outstanding_requests"; width = 4; signed = false; byteArray = false; };
  { name = "buffer_loans"; width = 4; signed = false; byteArray = false; };
  { name = "device"; width = 4; signed = false; byteArray = false; };
};
format ::= { formatVersion =; headerBytes =; entryBytes =; maxDrivers =; headerFields = headerSchema.fields ?? {;}; entryFields = entrySchema.fields ?? {;}; headerLayout =; entryLayout =; };
main :: { write : FsWrite; env : Env; } -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_BOOT_BINDINGS_ROOT" ?? ".";
    bindings := gen.render format;
    pythonPath := t.join "" { root; "/io_resource.py"; };
    rustPath := t.join "" { root; "/io_resource.rs"; };
    fs.writeAll caps.write pythonPath bindings.python;
    fs.writeAll caps.write rustPath bindings.rust
  ];
main
