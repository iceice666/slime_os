refl ::= import stdlib.reflect;
n ::= import stdlib.num;
w ::= import wire.python;
r ::= import wire.rust;
c ::= import wire.codec;
Format :: type { formatVersion : Int; headerBytes : Int; entryBytes : Int; maxDrivers : Int; headerFields : List refl.SchemaField; entryFields : List refl.SchemaField; headerLayout : List w.WireField; entryLayout : List w.WireField; };
records :: Format -> List w.WireRecord = format => {
  { pythonName = "IO_RESOURCE_HEADER"; constPrefix = "IO_RESOURCE"; size = format.headerBytes; trailingPadding = 0; fields = format.headerFields; layout = format.headerLayout; };
  { pythonName = "IO_RESOURCE_ENTRY"; constPrefix = "IO_RESOURCE_ENTRY"; size = format.entryBytes; trailingPadding = 0; fields = format.entryFields; layout = format.entryLayout; };
};
pythonBindings :: Format -> Text = format => w.join {
  "IO_RESOURCE_MAGIC = b\"SLIMEIO\\0\"\n";
  "IO_RESOURCE_VERSION = "; n.toText format.formatVersion; "\n";
  "IO_RESOURCE_HEADER_BYTES = "; n.toText format.headerBytes; "\n";
  "IO_RESOURCE_ENTRY_BYTES = "; n.toText format.entryBytes; "\n";
  "MAX_IO_RESOURCE_DRIVERS = "; n.toText format.maxDrivers; "\n";
  w.renderRecords (records format);
};
offsetConsts :: Text -> Int -> List w.WireField -> Text = c.offsetConstsWithEnds;
rustBindings :: Format -> Text = format => r.join {
  "// @generated by contracts/io-resource/v1/gen_rust.zt; do not edit.\n";
  "// Source contract: contracts/io-resource/v1/schema.zt\n\n";
  r.u32Const "FORMAT_VERSION" format.formatVersion;
  r.usizeConst "HEADER_BYTES" format.headerBytes;
  r.usizeConst "ENTRY_BYTES" format.entryBytes;
  r.usizeConst "MAX_DRIVERS" format.maxDrivers;
  "\n"; offsetConsts "HEADER" 0 format.headerLayout;
  "\n"; offsetConsts "ENTRY" 0 format.entryLayout;
};
render :: Format -> { python : Text; rust : Text; }
  = format => if w.recordsValid (records format)
    then { python = pythonBindings format; rust = rustBindings format; }
    else { python = "INVALID_IO_RESOURCE_SCHEMA"; rust = "INVALID_IO_RESOURCE_SCHEMA"; };
{ render =; }
