-- Pure renderer for Slime OS spawn protocol bindings.

refl ::= import stdlib.reflect;
n ::= import stdlib.num;
t ::= import stdlib.text;
w ::= import wire.rust;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

Protocol :: type {
  formatVersion : Int;
  requestLen : Int;
  replyLen : Int;
  maxArguments : Int;
  maxArgumentBytes : Int;
  maxEnvironment : Int;
  maxEnvironmentBytes : Int;
  maxGrants : Int;
  maxCommandBytes : Int;
  requestFlagWait : Int;
  requestFlagShutdown : Int;
  requestFlagDetached : Int;
  capabilityRoleWorkingDirectory : Int;
  capabilityRoleStdin : Int;
  capabilityRoleStdout : Int;
  capabilityRoleStderr : Int;
  capabilityRoleGrant : Int;
  requestFields : List refl.SchemaField;
  replyFields : List refl.SchemaField;
  requestLayout : List WireField;
  replyLayout : List WireField;
};

layoutNames :: List WireField -> List Text
  = fields => map _.name fields;

validField :: WireField -> Bool
  = field => if field.byteArray
    then field.width > 0 && not field.signed
    else w.validWidthSigned4 { name = field.name; width = field.width; signed = field.signed; };

allValid :: List WireField -> Bool
  = fields => match fields {
    | {;} => true;
    | { field; ...rest } => validField field && allValid rest;
  };

addWidth :: Int -> WireField -> Int
  = total field => total + field.width;

wireBytes :: List WireField -> Int
  = fields => fold addWidth 0 fields;

constName :: Text -> Text -> Text
  = prefix name => w.join { "OFF_"; prefix; "_"; t.toUpper name; };

offsetConsts :: Text -> Int -> List WireField -> Text
  = prefix offset fields => match fields {
    | {;} => "";
    | { field; ...rest } => w.join {
      "pub const "; constName prefix field.name; ": usize = "; n.toText offset; ";\n";
      offsetConsts prefix (offset + field.width) rest;
    };
  };

rustType :: WireField -> Text
  = field => if field.byteArray
    then w.join { "[u8; "; n.toText field.width; "]"; }
    else w.rustType { name = field.name; width = field.width; signed = field.signed; };

fieldDecls :: List WireField -> Text
  = fields => match fields {
    | {;} => "";
    | { field; ...rest } => w.join {
      "    pub "; field.name; ": "; rustType field; ",\n";
      fieldDecls rest;
    };
  };

decodeExpr :: Text -> WireField -> Text
  = prefix field => if field.byteArray
    then w.join {
      "buf["; constName prefix field.name; ".."; constName prefix field.name; " + "; n.toText field.width;
      "].try_into().expect(\"generated spawn layout\")";
    }
    else if field.width == 1
      then w.join { "buf["; constName prefix field.name; "]"; }
      else w.join {
        rustType field; "::from_le_bytes(buf["; constName prefix field.name; ".."; constName prefix field.name;
        " + "; n.toText field.width; "].try_into().expect(\"generated spawn layout\"))";
      };

decodeFields :: Text -> List WireField -> Text
  = prefix fields => match fields {
    | {;} => "";
    | { field; ...rest } => w.join {
      "            "; field.name; ": "; decodeExpr prefix field; ",\n";
      decodeFields prefix rest;
    };
  };

encodeField :: Text -> WireField -> Text
  = prefix field => if field.byteArray
    then w.join {
      "        buf["; constName prefix field.name; ".."; constName prefix field.name; " + "; n.toText field.width;
      "].copy_from_slice(&self."; field.name; ");\n";
    }
    else if field.width == 1
      then w.join { "        buf["; constName prefix field.name; "] = self."; field.name; ";\n"; }
      else w.join {
        "        buf["; constName prefix field.name; ".."; constName prefix field.name; " + "; n.toText field.width;
        "].copy_from_slice(&self."; field.name; ".to_le_bytes());\n";
      };

encodeFields :: Text -> List WireField -> Text
  = prefix fields => match fields {
    | {;} => "";
    | { field; ...rest } => w.join { encodeField prefix field; encodeFields prefix rest; };
  };

wireStruct :: Text -> Text -> Text -> List WireField -> Text
  = name prefix lengthName fields => w.join {
    "#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n";
    "pub struct "; name; " {\n"; fieldDecls fields; "}\n\n";
    "impl "; name; " {\n";
    "    pub fn decode(buf: &[u8]) -> Option<Self> {\n";
    "        if buf.len() < "; lengthName; " { return None; }\n";
    "        Some(Self {\n"; decodeFields prefix fields; "        })\n";
    "    }\n\n";
    "    pub fn encode(self) -> [u8; "; lengthName; "] {\n";
    "        let mut buf = [0u8; "; lengthName; "];\n"; encodeFields prefix fields; "        buf\n";
    "    }\n";
    "}\n";
  };

rustBindings :: Protocol -> Text
  = protocol => w.join {
    "// @generated by contracts/spawn/v1/gen_rust.zt; do not edit.\n";
    "// Source contract: contracts/spawn/v1/schema.zt\n\n";
    "pub const FORMAT_VERSION: u32 = "; n.toText protocol.formatVersion; ";\n";
    "pub const SPAWN_MAGIC: u32 = 1313559123;\n";
    "pub const REQUEST_LEN: usize = "; n.toText protocol.requestLen; ";\n";
    "pub const REPLY_LEN: usize = "; n.toText protocol.replyLen; ";\n";
    "pub const MAX_ARGUMENTS: usize = "; n.toText protocol.maxArguments; ";\n";
    "pub const MAX_ARGUMENT_BYTES: usize = "; n.toText protocol.maxArgumentBytes; ";\n";
    "pub const MAX_ENVIRONMENT: usize = "; n.toText protocol.maxEnvironment; ";\n";
    "pub const MAX_ENVIRONMENT_BYTES: usize = "; n.toText protocol.maxEnvironmentBytes; ";\n";
    "pub const MAX_GRANTS: usize = "; n.toText protocol.maxGrants; ";\n";
    "pub const MAX_COMMAND_BYTES: usize = "; n.toText protocol.maxCommandBytes; ";\n\n";
    "pub const REQUEST_FLAG_WAIT: u32 = "; n.toText protocol.requestFlagWait; ";\n";
    "pub const REQUEST_FLAG_SHUTDOWN: u32 = "; n.toText protocol.requestFlagShutdown; ";\n";
    "pub const REQUEST_FLAG_DETACHED: u32 = "; n.toText protocol.requestFlagDetached; ";\n";
    "pub const CAPABILITY_ROLE_WORKING_DIRECTORY: u8 = "; n.toText protocol.capabilityRoleWorkingDirectory; ";\n";
    "pub const CAPABILITY_ROLE_STDIN: u8 = "; n.toText protocol.capabilityRoleStdin; ";\n";
    "pub const CAPABILITY_ROLE_STDOUT: u8 = "; n.toText protocol.capabilityRoleStdout; ";\n";
    "pub const CAPABILITY_ROLE_STDERR: u8 = "; n.toText protocol.capabilityRoleStderr; ";\n";
    "pub const CAPABILITY_ROLE_GRANT: u8 = "; n.toText protocol.capabilityRoleGrant; ";\n\n";
    offsetConsts "REQUEST" 0 protocol.requestLayout;
    "\n";
    offsetConsts "REPLY" 0 protocol.replyLayout;
    "\n";
    wireStruct "WireSpawnRequest" "REQUEST" "REQUEST_LEN" protocol.requestLayout;
    "\n";
    wireStruct "WireSpawnReply" "REPLY" "REPLY_LEN" protocol.replyLayout;
  };

cOffsetConsts :: Text -> Int -> List WireField -> Text
  = prefix offset fields => match fields {
    | {;} => "";
    | { field; ...rest } => w.join {
      "#define SLIME_SPAWN_OFF_"; prefix; "_"; t.toUpper field.name; " "; n.toText offset; "U\n";
      cOffsetConsts prefix (offset + field.width) rest;
    };
  };

cBindings :: Protocol -> Text
  = protocol => w.join {
    "/* @generated by contracts/spawn/v1/gen_rust.zt; do not edit. */\n";
    "/* Source contract: contracts/spawn/v1/schema.zt */\n";
    "#ifndef SLIME_SPAWN_H\n#define SLIME_SPAWN_H\n\n";
    "#include <stddef.h>\n#include <stdint.h>\n\n";
    "#define SLIME_SPAWN_FORMAT_VERSION "; n.toText protocol.formatVersion; "U\n";
    "#define SLIME_SPAWN_MAGIC 1313559123U\n";
    "#define SLIME_SPAWN_REQUEST_LEN "; n.toText protocol.requestLen; "U\n";
    "#define SLIME_SPAWN_REPLY_LEN "; n.toText protocol.replyLen; "U\n";
    "#define SLIME_SPAWN_MAX_COMMAND_BYTES "; n.toText protocol.maxCommandBytes; "U\n";
    "#define SLIME_SPAWN_REQUEST_FLAG_WAIT "; n.toText protocol.requestFlagWait; "U\n";
    "#define SLIME_SPAWN_REQUEST_FLAG_DETACHED "; n.toText protocol.requestFlagDetached; "U\n\n";
    cOffsetConsts "REQUEST" 0 protocol.requestLayout;
    cOffsetConsts "REPLY" 0 protocol.replyLayout;
    "\ntypedef struct {\n";
    "    uint32_t flags;\n    uint16_t command_len;\n";
    "    uint8_t argument_count;\n    uint8_t environment_count;\n";
    "    uint8_t capability_roles;\n    uint8_t client_budget;\n";
    "    uint8_t command["; n.toText protocol.maxCommandBytes; "];\n";
    "    uint8_t arguments[8];\n    uint8_t environment[8];\n";
    "    uint32_t grant_rights;\n} SlimeSpawnRequest;\n\n";
    "typedef struct {\n    int32_t status;\n    uint32_t termination_kind;\n";
    "    uint32_t supervision_slot;\n    uint64_t detail;\n} SlimeSpawnReply;\n\n";
    "static inline void slime_spawn_store_u16(uint8_t *out, uint16_t value)\n{\n";
    "    out[0] = (uint8_t)value;\n    out[1] = (uint8_t)(value >> 8);\n}\n\n";
    "static inline void slime_spawn_store_u32(uint8_t *out, uint32_t value)\n{\n";
    "    size_t index;\n    for (index = 0; index < 4; ++index) { out[index] = (uint8_t)(value >> (index * 8)); }\n}\n\n";
    "static inline uint32_t slime_spawn_load_u32(const uint8_t *in)\n{\n";
    "    size_t index;\n    uint32_t value = 0;\n    for (index = 0; index < 4; ++index) { value |= (uint32_t)in[index] << (index * 8); }\n    return value;\n}\n\n";
    "static inline uint64_t slime_spawn_load_u64(const uint8_t *in)\n{\n";
    "    size_t index;\n    uint64_t value = 0;\n    for (index = 0; index < 8; ++index) { value |= (uint64_t)in[index] << (index * 8); }\n    return value;\n}\n\n";
    "static inline void slime_spawn_request_encode(const SlimeSpawnRequest *request, uint8_t out[SLIME_SPAWN_REQUEST_LEN])\n{\n";
    "    size_t index;\n    for (index = 0; index < SLIME_SPAWN_REQUEST_LEN; ++index) { out[index] = 0; }\n";
    "    slime_spawn_store_u32(out + SLIME_SPAWN_OFF_REQUEST_MAGIC, SLIME_SPAWN_MAGIC);\n";
    "    slime_spawn_store_u32(out + SLIME_SPAWN_OFF_REQUEST_VERSION, SLIME_SPAWN_FORMAT_VERSION);\n";
    "    slime_spawn_store_u32(out + SLIME_SPAWN_OFF_REQUEST_FLAGS, request->flags);\n";
    "    slime_spawn_store_u16(out + SLIME_SPAWN_OFF_REQUEST_COMMAND_LEN, request->command_len);\n";
    "    out[SLIME_SPAWN_OFF_REQUEST_ARGUMENT_COUNT] = request->argument_count;\n";
    "    out[SLIME_SPAWN_OFF_REQUEST_ENVIRONMENT_COUNT] = request->environment_count;\n";
    "    out[SLIME_SPAWN_OFF_REQUEST_CAPABILITY_ROLES] = request->capability_roles;\n";
    "    out[SLIME_SPAWN_OFF_REQUEST_CLIENT_BUDGET] = request->client_budget;\n";
    "    for (index = 0; index < sizeof(request->command); ++index) { out[SLIME_SPAWN_OFF_REQUEST_COMMAND + index] = request->command[index]; }\n";
    "    for (index = 0; index < sizeof(request->arguments); ++index) { out[SLIME_SPAWN_OFF_REQUEST_ARGUMENTS + index] = request->arguments[index]; }\n";
    "    for (index = 0; index < sizeof(request->environment); ++index) { out[SLIME_SPAWN_OFF_REQUEST_ENVIRONMENT + index] = request->environment[index]; }\n";
    "    slime_spawn_store_u32(out + SLIME_SPAWN_OFF_REQUEST_GRANT_RIGHTS, request->grant_rights);\n}\n\n";
    "static inline int slime_spawn_reply_decode(const uint8_t *in, size_t len, SlimeSpawnReply *reply)\n{\n";
    "    if (len < SLIME_SPAWN_REPLY_LEN || reply == NULL\n";
    "        || slime_spawn_load_u32(in + SLIME_SPAWN_OFF_REPLY_MAGIC) != SLIME_SPAWN_MAGIC\n";
    "        || slime_spawn_load_u32(in + SLIME_SPAWN_OFF_REPLY_VERSION) != SLIME_SPAWN_FORMAT_VERSION) { return 0; }\n";
    "    reply->status = (int32_t)slime_spawn_load_u32(in + SLIME_SPAWN_OFF_REPLY_STATUS);\n";
    "    reply->termination_kind = slime_spawn_load_u32(in + SLIME_SPAWN_OFF_REPLY_TERMINATION_KIND);\n";
    "    reply->supervision_slot = slime_spawn_load_u32(in + SLIME_SPAWN_OFF_REPLY_SUPERVISION_SLOT);\n";
    "    reply->detail = slime_spawn_load_u64(in + SLIME_SPAWN_OFF_REPLY_DETAIL);\n    return 1;\n}\n\n";
    "#endif\n";
  };

valid :: Protocol -> Bool
  = protocol =>
    w.schemaFieldsValid protocol.requestFields
      && w.schemaFieldsValid protocol.replyFields
      && w.schemaNames protocol.requestFields == layoutNames protocol.requestLayout
      && w.schemaNames protocol.replyFields == layoutNames protocol.replyLayout
      && allValid protocol.requestLayout
      && allValid protocol.replyLayout
      && wireBytes protocol.requestLayout <= protocol.requestLen
      && wireBytes protocol.replyLayout <= protocol.replyLen;

render :: Protocol -> { rust : Text; c : Text; }
  = protocol => if valid protocol
    then { rust = rustBindings protocol; c = cBindings protocol; }
    else { rust = "INVALID_SPAWN_SCHEMA"; c = "INVALID_SPAWN_SCHEMA"; };

{ render =; }
