        { grant = "probe-mmio"; slot = 1; slotReason = "componentAbi"; };
        { grant = "probe-irq"; slot = 2; slotReason = "componentAbi"; };
        { grant = "probe-dma"; slot = 3; slotReason = "componentAbi"; };
      ]; dependencies = [ "io-driver-supervisor"; ]; executable = "io-driver-probe"; health = "optional"; name = "io-driver-worker"; owner = "io-driver-supervisor"; };
    { autostart = true; bindings = []; dependencies = []; executable = "io-driver-intruder"; health = "required"; name = "io-driver-intruder"; owner = "root"; };
  ];
  interfaceSchemas = [];
