-- Pure renderer for the Slime OS root-service syscall ABI.
--
-- Emits two artifacts from one declaration: the Rust bindings both
-- `slime-root` and `components/runtime` consume, and the `docs/syscall-abi.md`
-- operation and status tables. Generating the doc is the point -- `AGENTS.md`
-- invariant 4 previously required a renumbered operation to be hand-copied into
-- prose in the same change, which is a manual coupling rather than a guarantee.
--
-- The dialect takes no inline lambdas, so every projection and predicate below
-- is a named helper. That is also why the curried `*In`/`*Among` helpers exist:
-- `map`/`filter` receive a partially applied named function rather than a
-- closure over the surrounding scope.

l ::= import stdlib.list;
n ::= import stdlib.num;
r ::= import wire.rust;
t ::= import stdlib.text;

Operation :: type { service : Text; name : Text; label : Int; };
Service :: type { name : Text; module : Text; };
Status :: type { name : Text; code : Int; };

Abi :: type {
  formatVersion : Int;
  operations : List Operation;
  services : List Service;
  statuses : List Status;
  maxMessageBytes : Int;
  maxMessageCaps : Int;
  grantRecordBytes : Int;
  grantSlotOffset : Int;
  grantRightsOffset : Int;
};

-- Shared helpers -----------------------------------------------------------

ownedBy :: Text -> Operation -> Bool = serviceName op => op.service == serviceName;

signedText :: Int -> Text
  = code => if code == 0 then "0" else r.join { "-"; n.toText code; };

-- Rust bindings ------------------------------------------------------------

labelConst :: Operation -> Text
  = op => r.join { "    pub const "; op.name; ": u64 = "; n.toText op.label; ";\n"; };

serviceModule :: List Operation -> Service -> Text
  = operations service => r.join {
    "pub mod "; service.module; " {\n";
    r.join (map labelConst (l.filter (ownedBy service.name) operations));
    "}\n\n";
  };

statusConst :: Status -> Text
  = st => r.join {
    "pub const ERR_"; st.name; ": i64 = "; signedText st.code; ";\n";
  };

rustBindings :: Abi -> Text
  = abi => r.join {
    "// @generated by contracts/syscall-abi/v1/gen_rust.zt; do not edit.\n";
    "// Source contract: contracts/syscall-abi/v1/schema.zt\n";
    "//\n";
    "// Root-service operation labels, status codes, and message bounds,\n";
    "// consumed by both `slime-root` (dispatch) and `components/runtime` (the\n";
    "// userspace wrapper), so the two cannot disagree about what a label means.\n";
    "// Numbers are frozen: a component image built against one generation\n";
    "// invokes the same label a later root must still answer.\n\n";
    r.u32Const "FORMAT_VERSION" abi.formatVersion;
    "\n";
    r.join (map (serviceModule abi.operations) abi.services);
    r.join (map statusConst abi.statuses);
    "\n";
    r.usizeConst "MAX_MSG" abi.maxMessageBytes;
    r.usizeConst "MAX_CAPS_PER_MSG" abi.maxMessageCaps;
    "\n";
    "/// Bytes of one spawn-grant record staged in the transfer window: an\n";
    "/// 8-byte little-endian child slot, then an 8-byte little-endian rights\n";
    "/// mask. Both sides of the syscall encode and decode through these.\n";
    r.usizeConst "GRANT_RECORD_BYTES" abi.grantRecordBytes;
    r.usizeConst "GRANT_SLOT_OFFSET" abi.grantSlotOffset;
    r.usizeConst "GRANT_RIGHTS_OFFSET" abi.grantRightsOffset;
  };

-- C bindings ---------------------------------------------------------------

cLabelConst :: Operation -> Text
  = op => r.join {
    "#define SLIME_"; t.toUpper op.service; "_"; op.name; " "; n.toText op.label; "U\n";
  };

cStatusConst :: Status -> Text
  = st => r.join { "#define SLIME_ERR_"; st.name; " ("; signedText st.code; ")\n"; };

cBindings :: Abi -> Text
  = abi => r.join {
    "/* @generated by contracts/syscall-abi/v1/gen_rust.zt; do not edit. */\n";
    "/* Source contract: contracts/syscall-abi/v1/schema.zt */\n";
    "#ifndef SLIME_SYSCALL_ABI_H\n#define SLIME_SYSCALL_ABI_H\n\n";
    "#define SLIME_SYSCALL_ABI_VERSION "; n.toText abi.formatVersion; "U\n\n";
    r.join (map cLabelConst abi.operations);
    "\n";
    r.join (map cStatusConst abi.statuses);
    "\n#define SLIME_MAX_MSG "; n.toText abi.maxMessageBytes; "U\n";
    "#define SLIME_MAX_CAPS_PER_MSG "; n.toText abi.maxMessageCaps; "U\n";
    "#define SLIME_GRANT_RECORD_BYTES "; n.toText abi.grantRecordBytes; "U\n";
    "#define SLIME_GRANT_SLOT_OFFSET "; n.toText abi.grantSlotOffset; "U\n";
    "#define SLIME_GRANT_RIGHTS_OFFSET "; n.toText abi.grantRightsOffset; "U\n\n";
    "#endif\n";
  };

-- Markdown tables ----------------------------------------------------------

operationRow :: Operation -> Text
  = op => r.join {
    "| "; n.toText op.label; " | `"; op.service; "` | `"; op.name; "` |\n";
  };

statusRow :: Status -> Text
  = st => r.join {
    "| `ERR_"; st.name; "` | "; signedText st.code; " |\n";
  };

markdownTables :: Abi -> Text
  = abi => r.join {
    "<!-- @generated by contracts/syscall-abi/v1/gen_rust.zt; do not edit. -->\n";
    "<!-- Regenerate with `just syscall_abi_gen`. -->\n\n";
    "### Root service operations\n\n";
    "| Label | Service | Operation |\n";
    "|---|---|---|\n";
    r.join (map operationRow abi.operations);
    "\n";
    "### Error model\n\n";
    "| Status | Value |\n";
    "|---|---|\n";
    r.join (map statusRow abi.statuses);
    "\n";
    "### Message bounds\n\n";
    "| Bound | Value |\n";
    "|---|---|\n";
    "| `MAX_MSG` | "; n.toText abi.maxMessageBytes; " |\n";
    "| `MAX_CAPS_PER_MSG` | "; n.toText abi.maxMessageCaps; " |\n";
    "| `GRANT_RECORD_BYTES` | "; n.toText abi.grantRecordBytes; " |\n";
  };

-- Validation ---------------------------------------------------------------

sameLabel :: Operation -> Operation -> Bool = a b => a.label == b.label;

labelUniqueIn :: List Operation -> Operation -> Bool
  = operations op => l.length (l.filter (sameLabel op) operations) == 1;

sameCode :: Status -> Status -> Bool = a b => a.code == b.code;

codeUniqueIn :: List Status -> Status -> Bool
  = statuses st => l.length (l.filter (sameCode st) statuses) == 1;

-- Every operation must belong to a declared service, or its label would be
-- generated into no module and silently vanish from both crates.
namesService :: Text -> Service -> Bool = serviceName s => s.name == serviceName;

serviceDeclaredAmong :: List Service -> Operation -> Bool
  = services op => l.any (namesService op.service) services;

valid :: Abi -> Bool
  = abi =>
    l.all (labelUniqueIn abi.operations) abi.operations
      && l.all (codeUniqueIn abi.statuses) abi.statuses
      && l.all (serviceDeclaredAmong abi.services) abi.operations
      && abi.grantRecordBytes == abi.grantRightsOffset + 8
      && abi.grantSlotOffset == 0
      && abi.maxMessageCaps > 0
      && abi.maxMessageBytes > 0;

render :: Abi -> { rust : Text; c : Text; markdown : Text; }
  = abi => if valid abi
    then { rust = rustBindings abi; c = cBindings abi; markdown = markdownTables abi; }
    else {
      rust = "INVALID_SYSCALL_ABI_SCHEMA";
      c = "INVALID_SYSCALL_ABI_SCHEMA";
      markdown = "INVALID_SYSCALL_ABI_SCHEMA";
    };

{ render =; }
