-- Pure renderer for private-memory qualification messages.
refl ::= import stdlib.reflect;
n ::= import stdlib.num;
w ::= import wire.rust;
c ::= import wire.codec;
WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };
Protocol :: type {
  formatVersion : Int; messageLen : Int;
  grow : Int; verify : Int; fault : Int; finish : Int; acknowledge : Int;
  readForeign : Int; writeForeign : Int; executePrivate : Int;
  loanReady : Int; loanOffer : Int; loanSettled : Int;
  stressGrow : Int; stressRefuse : Int; stressVerify : Int;
  messageFields : List refl.SchemaField;
  messageLayout : List WireField;
};
rustBindings :: Protocol -> Text
  = p => w.join {
    "// @generated by contracts/private-memory-probe/v1/gen_rust.zt; do not edit.\n";
    "pub const FORMAT_VERSION: u32 = "; n.toText p.formatVersion; ";\n";
    "pub const MESSAGE_LEN: usize = "; n.toText p.messageLen; ";\n";
    "pub const GROW: u32 = "; n.toText p.grow; ";\n";
    "pub const VERIFY: u32 = "; n.toText p.verify; ";\n";
    "pub const FAULT: u32 = "; n.toText p.fault; ";\n";
    "pub const FINISH: u32 = "; n.toText p.finish; ";\n";
    "pub const ACKNOWLEDGE: u32 = "; n.toText p.acknowledge; ";\n";
    "pub const READ_FOREIGN: u32 = "; n.toText p.readForeign; ";\n";
    "pub const WRITE_FOREIGN: u32 = "; n.toText p.writeForeign; ";\n";
    "pub const EXECUTE_PRIVATE: u32 = "; n.toText p.executePrivate; ";\n";
    "pub const LOAN_READY: u32 = "; n.toText p.loanReady; ";\n";
    "pub const LOAN_OFFER: u32 = "; n.toText p.loanOffer; ";\n";
    "pub const LOAN_SETTLED: u32 = "; n.toText p.loanSettled; ";\n";
    "pub const STRESS_GROW: u32 = "; n.toText p.stressGrow; ";\n";
    "pub const STRESS_REFUSE: u32 = "; n.toText p.stressRefuse; ";\n";
    "pub const STRESS_VERIFY: u32 = "; n.toText p.stressVerify; ";\n";
    c.offsetConsts "MESSAGE" 0 p.messageLayout;
    c.wireStruct "private-memory-probe" "WireMessage" "MESSAGE" "MESSAGE_LEN" p.messageLayout;
  };
render :: Protocol -> { rust : Text; }
  = p => if w.schemaFieldsValid p.messageFields
    && w.schemaNames p.messageFields == c.layoutNames p.messageLayout
    && c.allValid p.messageLayout
    && c.wireBytes p.messageLayout == p.messageLen
    then { rust = rustBindings p; }
    else { rust = "INVALID_PRIVATE_MEMORY_PROBE_SCHEMA"; };
{ render =; }
