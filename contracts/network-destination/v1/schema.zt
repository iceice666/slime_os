-- Slime OS exact network-destination authority resource, version 1 (IO4).
--
-- Every entry denotes one exact transport, one exact address or bounded DNS
-- name, one exact port, and four independent right bits. Wildcards are not
-- representable: this format has no netmask, prefix length, port range, glob,
-- suffix, or wildcard-name field.

env ::= import stdlib.env;
fs ::= import stdlib.fs;
gen ::= import "gen_rust.zt";
t ::= import stdlib.text;

formatVersion :: Int = 1;
headerBytes :: Int = 32;
entryBytes :: Int = 152;
maxDestinations :: Int = 128;
maxDestinationsPerHolder :: Int = 16;
maxNameBytes :: Int = 64;
-- The IPv4 prefix of the 16-byte address field. Declared rather than written
-- as a `4` in the decoder: the padding rule ("every byte past the prefix must
-- be zero") is part of this format's canonical encoding, so the prefix length
-- is schema data like every other width here.
ipv4Bytes :: Int = 4;
maxQueueDepth :: Int = 256;
maxByteBudget :: Int = 16777216;
maxTimerBudget :: Int = 256;
maxRetryLimit :: Int = 16;
maxReconnectLimit :: Int = 16;
maxSockets :: Int = 64;
maxListeners :: Int = 16;
maxDnsRecords :: Int = 64;

transportTcp :: Int = 1;
transportUdp :: Int = 2;
addressIpv4 :: Int = 1;
addressIpv6 :: Int = 2;
addressDns :: Int = 3;
rightConnect :: Int = 1;
rightSend :: Int = 2;
rightRecv :: Int = 4;
rightListen :: Int = 8;
knownRights :: Int = 15;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

DestinationHeader :: type {
  magic : Int;
  format_version : Int;
  header_size : Int;
  required_flags : Int;
  destination_count : Int;
  total_len : Int;
};

DestinationEntry :: type {
  holder_identity : Int;
  transport : Int;
  address_kind : Int;
  rights : Int;
  port : Int;
  name_len : Int;
  address : Int;
  name : Int;
  queue_depth : Int;
  byte_budget : Int;
  timer_budget : Int;
  retry_limit : Int;
  reconnect_limit : Int;
  socket_limit : Int;
  listener_limit : Int;
  dns_record_limit : Int;
};

headerSchema ::= schema DestinationHeader;
entrySchema ::= schema DestinationEntry;
headerLayout :: List WireField = {
  { name = "magic"; width = 8; signed = false; byteArray = true; };
  { name = "format_version"; width = 4; signed = false; byteArray = false; };
  { name = "header_size"; width = 4; signed = false; byteArray = false; };
  { name = "required_flags"; width = 8; signed = false; byteArray = false; };
  { name = "destination_count"; width = 4; signed = false; byteArray = false; };
  { name = "total_len"; width = 4; signed = false; byteArray = false; };
};
entryLayout :: List WireField = {
  { name = "holder_identity"; width = 32; signed = false; byteArray = true; };
  { name = "transport"; width = 1; signed = false; byteArray = false; };
  { name = "address_kind"; width = 1; signed = false; byteArray = false; };
  { name = "rights"; width = 2; signed = false; byteArray = false; };
  { name = "port"; width = 2; signed = false; byteArray = false; };
  { name = "name_len"; width = 2; signed = false; byteArray = false; };
  { name = "address"; width = 16; signed = false; byteArray = true; };
  { name = "name"; width = 64; signed = false; byteArray = true; };
  { name = "queue_depth"; width = 4; signed = false; byteArray = false; };
  { name = "byte_budget"; width = 4; signed = false; byteArray = false; };
  { name = "timer_budget"; width = 4; signed = false; byteArray = false; };
  { name = "retry_limit"; width = 4; signed = false; byteArray = false; };
  { name = "reconnect_limit"; width = 4; signed = false; byteArray = false; };
  { name = "socket_limit"; width = 4; signed = false; byteArray = false; };
  { name = "listener_limit"; width = 4; signed = false; byteArray = false; };
  { name = "dns_record_limit"; width = 4; signed = false; byteArray = false; };
};

format ::= {
  formatVersion =; headerBytes =; entryBytes =; maxDestinations =;
  maxDestinationsPerHolder =; maxNameBytes =; ipv4Bytes =; maxQueueDepth =; maxByteBudget =;
  maxTimerBudget =; maxRetryLimit =; maxReconnectLimit =; maxSockets =;
  maxListeners =; maxDnsRecords =;
  transportTcp =; transportUdp =; addressIpv4 =; addressIpv6 =; addressDns =;
  rightConnect =; rightSend =; rightRecv =; rightListen =; knownRights =;
  headerFields = headerSchema.fields ?? {;}; entryFields = entrySchema.fields ?? {;};
  headerLayout =; entryLayout =;
};

main :: { write : FsWrite; env : Env; } -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_BOOT_BINDINGS_ROOT" ?? ".";
    bindings := gen.render format;
    fs.writeAll caps.write (t.join "" { root; "/network_destination.py"; }) bindings.python;
    fs.writeAll caps.write (t.join "" { root; "/network_destination.rs"; }) bindings.rust
  ];

main
