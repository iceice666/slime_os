-- Schema-reflected Python + Rust renderer for network-destination/v1.
refl ::= import stdlib.reflect;
n ::= import stdlib.num;
w ::= import wire.python;
r ::= import wire.rust;

Format :: type {
  formatVersion : Int; headerBytes : Int; entryBytes : Int; maxDestinations : Int;
  maxDestinationsPerHolder : Int; maxNameBytes : Int; maxQueueDepth : Int; maxByteBudget : Int;
  maxTimerBudget : Int; maxRetryLimit : Int; maxReconnectLimit : Int; maxSockets : Int;
  maxListeners : Int; maxDnsRecords : Int;
  transportTcp : Int; transportUdp : Int; addressIpv4 : Int; addressIpv6 : Int; addressDns : Int;
  rightConnect : Int; rightSend : Int; rightRecv : Int; rightListen : Int; knownRights : Int;
  headerFields : List refl.SchemaField; entryFields : List refl.SchemaField;
  headerLayout : List w.WireField; entryLayout : List w.WireField;
};
records :: Format -> List w.WireRecord = f => {
  { pythonName = "NETWORK_DESTINATION_HEADER"; constPrefix = "NETWORK_DESTINATION"; size = f.headerBytes; trailingPadding = 0; fields = f.headerFields; layout = f.headerLayout; };
  { pythonName = "NETWORK_DESTINATION_ENTRY"; constPrefix = "NETWORK_DESTINATION_ENTRY"; size = f.entryBytes; trailingPadding = 0; fields = f.entryFields; layout = f.entryLayout; };
};
pythonBindings :: Format -> Text = f => w.join {
  "NETWORK_DESTINATION_MAGIC = b\"SLIMEND\\0\"\n";
  "NETWORK_DESTINATION_VERSION = "; n.toText f.formatVersion; "\n";
  "NETWORK_DESTINATION_HEADER_BYTES = "; n.toText f.headerBytes; "\nNETWORK_DESTINATION_ENTRY_BYTES = "; n.toText f.entryBytes; "\n";
  "MAX_NETWORK_DESTINATIONS = "; n.toText f.maxDestinations; "\nMAX_NETWORK_DESTINATIONS_PER_HOLDER = "; n.toText f.maxDestinationsPerHolder; "\nMAX_NETWORK_NAME_BYTES = "; n.toText f.maxNameBytes; "\n";
  w.renderRecords (records f);
};
rustBindings :: Format -> Text = f => r.join {
  "// @generated by contracts/network-destination/v1/gen_rust.zt; do not edit.\n// Source contract: contracts/network-destination/v1/schema.zt\n\n";
  r.u32Const "FORMAT_VERSION" f.formatVersion; r.usizeConst "HEADER_BYTES" f.headerBytes; r.usizeConst "ENTRY_BYTES" f.entryBytes;
  r.usizeConst "MAX_DESTINATIONS" f.maxDestinations; r.usizeConst "MAX_DESTINATIONS_PER_HOLDER" f.maxDestinationsPerHolder; r.usizeConst "MAX_NAME_BYTES" f.maxNameBytes;
  r.u32Const "MAX_QUEUE_DEPTH" f.maxQueueDepth; r.u32Const "MAX_BYTE_BUDGET" f.maxByteBudget; r.u32Const "MAX_TIMER_BUDGET" f.maxTimerBudget;
  r.u32Const "MAX_RETRY_LIMIT" f.maxRetryLimit; r.u32Const "MAX_RECONNECT_LIMIT" f.maxReconnectLimit; r.u32Const "MAX_SOCKETS" f.maxSockets;
  r.u32Const "MAX_LISTENERS" f.maxListeners; r.u32Const "MAX_DNS_RECORDS" f.maxDnsRecords;
  r.join { "pub const TRANSPORT_TCP: u8 = "; n.toText f.transportTcp; ";\npub const TRANSPORT_UDP: u8 = "; n.toText f.transportUdp; ";\n"; };
  r.join { "pub const ADDRESS_IPV4: u8 = "; n.toText f.addressIpv4; ";\npub const ADDRESS_IPV6: u8 = "; n.toText f.addressIpv6; ";\npub const ADDRESS_DNS: u8 = "; n.toText f.addressDns; ";\n"; };
  r.join { "pub const RIGHT_CONNECT: u16 = "; n.toText f.rightConnect; ";\npub const RIGHT_SEND: u16 = "; n.toText f.rightSend; ";\npub const RIGHT_RECV: u16 = "; n.toText f.rightRecv; ";\npub const RIGHT_LISTEN: u16 = "; n.toText f.rightListen; ";\npub const KNOWN_RIGHTS: u16 = "; n.toText f.knownRights; ";\n"; };
};
render :: Format -> { python : Text; rust : Text; } = f => if w.recordsValid (records f)
  then { python = pythonBindings f; rust = rustBindings f; }
  else { python = "INVALID_NETWORK_DESTINATION_SCHEMA"; rust = "INVALID_NETWORK_DESTINATION_SCHEMA"; };
{ render =; }
