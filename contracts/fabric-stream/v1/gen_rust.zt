-- Pure renderer for Slime OS fabric stream framing bindings (C8.4).

refl ::= import stdlib.reflect;
n ::= import stdlib.num;
t ::= import stdlib.text;
w ::= import wire.rust;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

Protocol :: type {
  formatVersion : Int;
  sampleLen : Int;
  ackLen : Int;
  eventLen : Int;
  maxInlineBytes : Int;
  streamSampleMagic : Int;
  streamAckMagic : Int;
  streamEventMagic : Int;
  flagLast : Int;
  knownSampleFlags : Int;
  knownAckFlags : Int;
  knownEventFlags : Int;
  eventSampleLost : Int;
  eventStreamEnd : Int;
  eventSampleTaken : Int;
  sampleFields : List refl.SchemaField;
  ackFields : List refl.SchemaField;
  eventFields : List refl.SchemaField;
  sampleLayout : List WireField;
  ackLayout : List WireField;
  eventLayout : List WireField;
};

layoutNames :: List WireField -> List Text
  = fields => map _.name fields;

validField :: WireField -> Bool
  = field => if field.byteArray
    then field.width > 0 && not field.signed
    else w.validWidthSigned4 { name = field.name; width = field.width; signed = field.signed; };

allValid :: List WireField -> Bool
  = fields => match fields {
    | {;} => true;
    | { field; ...rest } => validField field && allValid rest;
  };

addWidth :: Int -> WireField -> Int
  = total field => total + field.width;

wireBytes :: List WireField -> Int
  = fields => fold addWidth 0 fields;

constName :: Text -> Text -> Text
  = prefix name => w.join { "OFF_"; prefix; "_"; t.toUpper name; };

offsetConsts :: Text -> Int -> List WireField -> Text
  = prefix offset fields => match fields {
    | {;} => "";
    | { field; ...rest } => w.join {
      "pub const "; constName prefix field.name; ": usize = "; n.toText offset; ";\n";
      offsetConsts prefix (offset + field.width) rest;
    };
  };

rustType :: WireField -> Text
  = field => if field.byteArray
    then w.join { "[u8; "; n.toText field.width; "]"; }
    else w.rustType { name = field.name; width = field.width; signed = field.signed; };

fieldDecls :: List WireField -> Text
  = fields => match fields {
    | {;} => "";
    | { field; ...rest } => w.join {
      "    pub "; field.name; ": "; rustType field; ",\n";
      fieldDecls rest;
    };
  };

decodeExpr :: Text -> WireField -> Text
  = prefix field => if field.byteArray
    then w.join {
      "buf["; constName prefix field.name; ".."; constName prefix field.name; " + "; n.toText field.width;
      "].try_into().expect(\"generated fabric-stream layout\")";
    }
    else if field.width == 1
      then w.join { "buf["; constName prefix field.name; "]"; }
      else w.join {
        rustType field; "::from_le_bytes(buf["; constName prefix field.name; ".."; constName prefix field.name;
        " + "; n.toText field.width; "].try_into().expect(\"generated fabric-stream layout\"))";
      };

decodeFields :: Text -> List WireField -> Text
  = prefix fields => match fields {
    | {;} => "";
    | { field; ...rest } => w.join {
      "            "; field.name; ": "; decodeExpr prefix field; ",\n";
      decodeFields prefix rest;
    };
  };

encodeField :: Text -> WireField -> Text
  = prefix field => if field.byteArray
    then w.join {
      "        buf["; constName prefix field.name; ".."; constName prefix field.name; " + "; n.toText field.width;
      "].copy_from_slice(&self."; field.name; ");\n";
    }
    else if field.width == 1
      then w.join { "        buf["; constName prefix field.name; "] = self."; field.name; ";\n"; }
      else w.join {
        "        buf["; constName prefix field.name; ".."; constName prefix field.name; " + "; n.toText field.width;
        "].copy_from_slice(&self."; field.name; ".to_le_bytes());\n";
      };

encodeFields :: Text -> List WireField -> Text
  = prefix fields => match fields {
    | {;} => "";
    | { field; ...rest } => w.join { encodeField prefix field; encodeFields prefix rest; };
  };

wireStruct :: Text -> Text -> Text -> List WireField -> Text
  = name prefix lengthName fields => w.join {
    "#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n";
    "pub struct "; name; " {\n"; fieldDecls fields; "}\n\n";
    "impl "; name; " {\n";
    "    pub fn decode(buf: &[u8]) -> Option<Self> {\n";
    "        if buf.len() < "; lengthName; " { return None; }\n";
    "        Some(Self {\n"; decodeFields prefix fields; "        })\n";
    "    }\n\n";
    "    pub fn encode(self) -> [u8; "; lengthName; "] {\n";
    "        let mut buf = [0u8; "; lengthName; "];\n"; encodeFields prefix fields; "        buf\n";
    "    }\n";
    "}\n";
  };

rustBindings :: Protocol -> Text
  = protocol => w.join {
    "// @generated by contracts/fabric-stream/v1/gen_rust.zt; do not edit.\n";
    "// Source contract: contracts/fabric-stream/v1/schema.zt\n\n";
    "pub const FORMAT_VERSION: u32 = "; n.toText protocol.formatVersion; ";\n";
    "pub const STREAM_SAMPLE_MAGIC: u32 = "; n.toText protocol.streamSampleMagic; ";\n";
    "pub const STREAM_ACK_MAGIC: u32 = "; n.toText protocol.streamAckMagic; ";\n";
    "pub const STREAM_EVENT_MAGIC: u32 = "; n.toText protocol.streamEventMagic; ";\n";
    "pub const SAMPLE_LEN: usize = "; n.toText protocol.sampleLen; ";\n";
    "pub const ACK_LEN: usize = "; n.toText protocol.ackLen; ";\n";
    "pub const EVENT_LEN: usize = "; n.toText protocol.eventLen; ";\n";
    "pub const MAX_INLINE_BYTES: usize = "; n.toText protocol.maxInlineBytes; ";\n";
    "pub const FLAG_LAST: u32 = "; n.toText protocol.flagLast; ";\n";
    "pub const KNOWN_SAMPLE_FLAGS: u32 = "; n.toText protocol.knownSampleFlags; ";\n";
    "pub const KNOWN_ACK_FLAGS: u32 = "; n.toText protocol.knownAckFlags; ";\n";
    "pub const KNOWN_EVENT_FLAGS: u32 = "; n.toText protocol.knownEventFlags; ";\n";
    "pub const EVENT_SAMPLE_LOST: u32 = "; n.toText protocol.eventSampleLost; ";\n";
    "pub const EVENT_STREAM_END: u32 = "; n.toText protocol.eventStreamEnd; ";\n";
    "pub const EVENT_SAMPLE_TAKEN: u32 = "; n.toText protocol.eventSampleTaken; ";\n\n";
    offsetConsts "SAMPLE" 0 protocol.sampleLayout;
    "\n";
    wireStruct "WireStreamSample" "SAMPLE" "SAMPLE_LEN" protocol.sampleLayout;
    "\n";
    offsetConsts "ACK" 0 protocol.ackLayout;
    "\n";
    wireStruct "WireStreamAck" "ACK" "ACK_LEN" protocol.ackLayout;
    "\n";
    offsetConsts "EVENT" 0 protocol.eventLayout;
    "\n";
    wireStruct "WireStreamEvent" "EVENT" "EVENT_LEN" protocol.eventLayout;
  };

valid :: Protocol -> Bool
  = protocol =>
    w.schemaFieldsValid protocol.sampleFields
      && w.schemaFieldsValid protocol.ackFields
      && w.schemaFieldsValid protocol.eventFields
      && w.schemaNames protocol.sampleFields == layoutNames protocol.sampleLayout
      && w.schemaNames protocol.ackFields == layoutNames protocol.ackLayout
      && w.schemaNames protocol.eventFields == layoutNames protocol.eventLayout
      && allValid protocol.sampleLayout
      && allValid protocol.ackLayout
      && allValid protocol.eventLayout
      && wireBytes protocol.sampleLayout <= protocol.sampleLen
      && wireBytes protocol.ackLayout <= protocol.ackLen
      && wireBytes protocol.eventLayout <= protocol.eventLen;

render :: Protocol -> { rust : Text; }
  = protocol => if valid protocol
    then { rust = rustBindings protocol; }
    else { rust = "INVALID_FABRIC_STREAM_SCHEMA"; };

{ render =; }
