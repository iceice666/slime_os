-- Slime OS fabric stream framing, version 1 (C8.4).
--
-- Three fixed 64-byte messages that a bounded many-to-many `Stream<T>` moves
-- over ordinary kernel channels. None is authority: a participant reaches a
-- route only through the endpoint the fabric provisioned for it (C8.3), and
-- these bytes describe what travels over that endpoint once it exists.
--
-- `StreamSample` carries a control-bound sample inline. The whole record is one
-- channel message, so a sample only travels this way when its payload fits
-- `maxInlineBytes`. A payload larger than the control-message bound never takes
-- this path: it travels as a C7.6 `SampleDescriptor` naming a receiver-bound
-- shared-buffer loan, which the fabric brokers with exactly one copy. The
-- records are told apart by their magic, so one channel carries all of them
-- without a length or a mode flag deciding how the next bytes are read.
--
-- `StreamAck` is how a subscriber releases one delivery slot. KEEP_LAST is only
-- meaningful against a bound on undelivered samples: without a release signal
-- the kernel channel's own queue would be the buffer, and the declared history
-- depth would never be the thing that evicts. An ack names the sequence it
-- releases, so a subscriber cannot free a slot it never consumed.
--
-- `StreamEvent` is how a subscriber learns what it did not receive. BEST_EFFORT
-- delivery drops a sample rather than growing a queue, so loss has to be
-- reportable without retry state: the fabric counts drops per subscriber and
-- emits exactly one event when delivery resumes, naming the count and the
-- oldest sequence lost. A stalled subscriber therefore costs one counter and
-- one event, never an unbounded backlog.
--
-- Logical records and concrete packed little-endian layouts live together. The
-- renderer reflects each record, checks field order against its layout, and
-- writes the Rust binding fragment consumed by slime-proto.

env ::= import stdlib.env;
fs ::= import stdlib.fs;
gen ::= import "gen_rust.zt";
t ::= import stdlib.text;

formatVersion :: Int = 1;
sampleLen :: Int = 64;
ackLen :: Int = 64;
eventLen :: Int = 64;
maxInlineBytes :: Int = 32;

-- Record discriminators, little-endian `SSTR`, `SACK`, and `SEVT`. They live
-- here rather than in the renderer: a receiver tells an inline sample from an
-- ack or an event (and from a C7.6 descriptor) by comparing `magic`, so these
-- values are part of the wire format the schema owns.
streamSampleMagic :: Int = 1381258067;
streamAckMagic :: Int = 1262698835;
streamEventMagic :: Int = 1414939987;

-- The last sample of a bounded publication. A publisher sets it so the fabric
-- can retire the route's ingress without waiting for the peer to die.
flagLast :: Int = 1;
knownSampleFlags :: Int = 1;
knownAckFlags :: Int = 0;
knownEventFlags :: Int = 0;

-- Event kinds. `sampleLost` reports BEST_EFFORT drops. `sampleTaken` tells a
-- publisher its loaned sample has been copied and its loan settled, so it may
-- reclaim its buffer: a lender's own termination settles every loan it made, so
-- without this signal a publisher that exits promptly would pull the pages out
-- from under the copy. `streamEnd` reports that every matched publisher on the
-- route has finished, so a subscriber stops waiting on a route that will
-- produce nothing further. The three are distinct because a per-sample credit
-- and an end-of-route notice mean different things to their reader.
eventSampleLost :: Int = 1;
eventStreamEnd :: Int = 2;
eventSampleTaken :: Int = 3;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

StreamSample :: type {
  magic : Int;
  version : Int;
  flags : Int;
  payload_len : Int;
  sequence : Int;
  type_identity : Int;
  payload : Int;
};

StreamAck :: type {
  magic : Int;
  version : Int;
  flags : Int;
  reserved0 : Int;
  sequence : Int;
  type_identity : Int;
  reserved : Int;
};

StreamEvent :: type {
  magic : Int;
  version : Int;
  event : Int;
  flags : Int;
  lost : Int;
  sequence : Int;
  type_identity : Int;
  reserved : Int;
};

sampleSchema ::= schema StreamSample;
ackSchema ::= schema StreamAck;
eventSchema ::= schema StreamEvent;

sampleLayout :: List WireField = {
  { name = "magic"; width = 4; signed = false; byteArray = false; };
  { name = "version"; width = 4; signed = false; byteArray = false; };
  { name = "flags"; width = 4; signed = false; byteArray = false; };
  { name = "payload_len"; width = 4; signed = false; byteArray = false; };
  { name = "sequence"; width = 8; signed = false; byteArray = false; };
  { name = "type_identity"; width = 8; signed = false; byteArray = false; };
  { name = "payload"; width = 32; signed = false; byteArray = true; };
};

ackLayout :: List WireField = {
  { name = "magic"; width = 4; signed = false; byteArray = false; };
  { name = "version"; width = 4; signed = false; byteArray = false; };
  { name = "flags"; width = 4; signed = false; byteArray = false; };
  { name = "reserved0"; width = 4; signed = false; byteArray = false; };
  { name = "sequence"; width = 8; signed = false; byteArray = false; };
  { name = "type_identity"; width = 8; signed = false; byteArray = false; };
  { name = "reserved"; width = 32; signed = false; byteArray = true; };
};

eventLayout :: List WireField = {
  { name = "magic"; width = 4; signed = false; byteArray = false; };
  { name = "version"; width = 4; signed = false; byteArray = false; };
  { name = "event"; width = 4; signed = false; byteArray = false; };
  { name = "flags"; width = 4; signed = false; byteArray = false; };
  { name = "lost"; width = 8; signed = false; byteArray = false; };
  { name = "sequence"; width = 8; signed = false; byteArray = false; };
  { name = "type_identity"; width = 8; signed = false; byteArray = false; };
  { name = "reserved"; width = 24; signed = false; byteArray = true; };
};

format ::= {
  formatVersion =;
  sampleLen =;
  ackLen =;
  eventLen =;
  maxInlineBytes =;
  streamSampleMagic =;
  streamAckMagic =;
  streamEventMagic =;
  flagLast =;
  knownSampleFlags =;
  knownAckFlags =;
  knownEventFlags =;
  eventSampleLost =;
  eventStreamEnd =;
  eventSampleTaken =;
  sampleFields = sampleSchema.fields ?? {;};
  ackFields = ackSchema.fields ?? {;};
  eventFields = eventSchema.fields ?? {;};
  sampleLayout =;
  ackLayout =;
  eventLayout =;
};

main :: { write : FsWrite; env : Env; } -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_FABRIC_STREAM_BINDINGS_ROOT" ?? ".";
    bindings := gen.render format;
    path := t.join "" { root; "/components/proto/src/fabric_stream.rs"; };
    fs.writeAll caps.write path bindings.rust
  ];

main
