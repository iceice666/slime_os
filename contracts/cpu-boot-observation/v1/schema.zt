-- Slime OS physical CPU-boot observation contract, version 1 (P6.6).
--
-- This is the persisted record of a boot that was observed on a named physical
-- machine, written from the exact removable medium `contracts/boot-media/v1`
-- identifies. It exists because a physical claim is not reproducible: nobody
-- can re-run the boot from the artifact, so what the repository keeps is the
-- operator's bounded, machine-checked account of it.
--
-- The record deliberately separates three things a blank screen cannot tell
-- apart:
--
--   * what was written to the medium, bound to the boot-media identity and the
--     exact removable device it went to;
--   * what the machine and its firmware were, which no host build can infer;
--   * what was observed per cold boot, as the ordered readiness fields the
--     panel rendered plus the protected-region digests taken around the run.
--
-- The internal-storage claim is a pair of digests over one declared region,
-- read before and after the boot with the medium's own device absent from the
-- comparison. A serial or panel marker saying "no writes" would be the root
-- asserting its own innocence; two digests over the real device are evidence.
--
-- QEMU cannot produce this record. The `emulated` discriminator does not exist
-- here on purpose: a field that can say "this was an emulator" invites a gate
-- that accepts one.

env ::= import stdlib.env;
fs ::= import stdlib.fs;
n ::= import stdlib.num;
t ::= import stdlib.text;

formatVersion :: Int = 1;
kind :: Text = "slime-cpu-boot-observation";
identityDomain :: Text = "slime-cpu-boot-observation-v1:";

recordFileName :: Text = "slime-cpu-boot.observation.json";

-- Two cold boots, which is what distinguishes "it booted" from "it boots".
-- Fixed rather than a minimum: a gate that accepts more would accept a run
-- retried until it passed.
requiredBoots :: Int = 2;

-- The protected comparison region on the internal device, in bytes from LBA 0.
-- The GPT, its backup-independent primary copy, and the start of the first
-- partition all lie inside this span, which is where a firmware or a stray
-- root write would land first.
comparisonRegionBytes :: Int = 16777216;

maxRecordBytes :: Int = 65536;
maxPathBytes :: Int = 192;
maxTextBytes :: Int = 128;
maxBoots :: Int = 4;
maxRecordLines :: Int = 16;

-- The only target profile this contract admits. P6.6 is one machine's gate,
-- and a profile field that accepted the QEMU build would let emulated bytes
-- claim a physical boot.
targetProfile :: Text = "x86_64-sel4-framework13-ai300";

-- Observed states a cold boot may end in. `ready` is the only one that
-- satisfies the milestone; the others exist so a failed observation is
-- recordable rather than unrepresentable, which is what keeps an operator from
-- describing a failure as an absence.
bootOutcomes :: List Text = { "ready"; "no-boot"; "firmware-refused"; "wrong-profile"; "faulted"; };

-- The exact removable device the image was written to, as the host saw it.
--
-- `sha256` is the digest read back from the block device over the image's own
-- length, not the digest of the file that was written: the claim is about the
-- bytes the firmware will read.
WriteTarget :: type {
  devicePath : Text;
  model : Text;
  serial : Text;
  sizeBytes : Int;
  removable : Bool;
  sha256 : Text;
};

-- The machine, named rather than probed. Every field here is something an
-- operator reads off the hardware or its setup screens; none of it can be
-- derived from the build, and all of it changes what a boot claim means.
Machine :: type {
  vendor : Text;
  product : Text;
  cpu : Text;
  firmwareVendor : Text;
  firmwareVersion : Text;
  secureBoot : Bool;
};

-- The internal device the boot must not modify, with one digest per side of
-- the run.
--
-- `devicePath` is recorded so the record names which device was protected;
-- `serial` is what identifies it across reboots, since kernel device names are
-- not stable.
ProtectedRegion :: type {
  devicePath : Text;
  model : Text;
  serial : Text;
  regionBytes : Int;
  sha256Before : Text;
  sha256After : Text;
};

-- One cold boot.
--
-- `recordLines` is the bounded text the panel rendered, in order, which is the
-- evidence channel itself rather than a summary of it. `panelSha256` is the
-- digest of the captured panel image when one was captured; a physical boot
-- observed by eye has none, and the field is empty rather than absent so the
-- record's shape does not depend on how it was observed.
BootObservation :: type {
  index : Int;
  outcome : Text;
  coldStart : Bool;
  keyboardUsed : Bool;
  targetProfile : Text;
  generationNumber : Int;
  generationIdentityPrefix : Text;
  displayWidth : Int;
  displayHeight : Int;
  displayBitsPerPixel : Int;
  recordLines : List Text;
  panelSha256 : Text;
};

CpuBootObservation :: type {
  formatVersion : Int;
  kind : Text;
  identity : Text;
  targetProfile : Text;
  observedOn : Text;
  operator : Text;
  bootMediaIdentity : Text;
  bootMediaImageSha256 : Text;
  writeTarget : WriteTarget;
  machine : Machine;
  protectedRegion : ProtectedRegion;
  boots : List BootObservation;
};

cpuBootObservationSchema ::= schema CpuBootObservation;

line :: Text -> Int -> Text
  = name value => t.join "" { name; " = "; n.toText value; "\n"; };
text :: Text -> Text -> Text
  = name value => t.join "" { name; " = "; t.show value; "\n"; };
textTuple :: List Text -> Text
  = values => match values {
    | {;} => "";
    | { entry; ...rest } => t.join "" { t.show entry; ", "; textTuple rest; };
  };
tuple :: Text -> List Text -> Text
  = name values => t.join "" { name; " = ("; textTuple values; ")\n"; };

render :: Text = t.join "" {
  "# @generated by contracts/cpu-boot-observation/v1/schema.zt; do not edit.\n";
  line "FORMAT_VERSION" formatVersion;
  text "KIND" kind;
  "IDENTITY_DOMAIN = "; t.show identityDomain; ".encode(\"utf-8\")\n";
  text "RECORD_FILE_NAME" recordFileName;
  line "REQUIRED_BOOTS" requiredBoots;
  line "COMPARISON_REGION_BYTES" comparisonRegionBytes;
  line "MAX_RECORD_BYTES" maxRecordBytes;
  line "MAX_PATH_BYTES" maxPathBytes;
  line "MAX_TEXT_BYTES" maxTextBytes;
  line "MAX_BOOTS" maxBoots;
  line "MAX_RECORD_LINES" maxRecordLines;
  text "TARGET_PROFILE" targetProfile;
  tuple "BOOT_OUTCOMES" bootOutcomes;
};

main :: { write : FsWrite; env : Env; }
  -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_CPU_BOOT_OBSERVATION_BINDINGS_ROOT" ?? ".";
    path := t.join "" { root; "/cpu_boot_observation_contract.py"; };
    fs.writeAll caps.write path render
  ];

main
