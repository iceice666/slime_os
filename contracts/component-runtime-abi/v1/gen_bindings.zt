-- Pure Rust and C renderer for the language-neutral component runtime ABI.

l ::= import stdlib.list;
n ::= import stdlib.num;
r ::= import wire.rust;
t ::= import stdlib.text;

ConsoleOperation :: type { name : Text; label : Int; };

Abi :: type {
  formatVersion : Int;
  wordBytes : Int;
  granuleBytes : Int;
  maxThreads : Int;
  fastRegisters : Int;
  inlineBytes : Int;
  minimumTransferWindowBytes : Int;
  descriptorLengthShift : Int;
  descriptorLengthBits : Int;
  descriptorCapsShift : Int;
  descriptorCapsBits : Int;
  descriptorFormShift : Int;
  descriptorFormBits : Int;
  descriptorThreadShift : Int;
  descriptorFormInline : Int;
  descriptorFormWindow : Int;
  childCnodeSizeBits : Int;
  rootServiceSlot : Int;
  tcbSlot : Int;
  faultSlot : Int;
  childCnodeSlot : Int;
  transferredEndpointBase : Int;
  consoleServiceSlot : Int;
  nativeEndpointBase : Int;
  nativeNotificationBase : Int;
  nativeAuthorityBase : Int;
  nativeRegionSlots : Int;
  nativeReceiveSlot : Int;
  transferredEndpointHandleTag : Int;
  consoleOperations : List ConsoleOperation;
};

rustConsoleLabel :: ConsoleOperation -> Text
  = operation => r.join {
    "    pub const "; operation.name; ": u64 = "; n.toText operation.label; ";\n";
  };

rustBindings :: Abi -> Text
  = abi => r.join {
    "// @generated by contracts/component-runtime-abi/v1/gen_bindings.zt; do not edit.\n";
    "// Source contract: contracts/component-runtime-abi/v1/schema.zt\n\n";
    r.u32Const "FORMAT_VERSION" abi.formatVersion;
    r.usizeConst "WORD_BYTES" abi.wordBytes;
    r.usizeConst "GRANULE_BYTES" abi.granuleBytes;
    r.usizeConst "MAX_THREADS" abi.maxThreads;
    r.usizeConst "FAST_REGISTERS" abi.fastRegisters;
    r.usizeConst "INLINE_BYTES" abi.inlineBytes;
    r.usizeConst "MIN_TRANSFER_WINDOW_BYTES" abi.minimumTransferWindowBytes;
    "\n";
    r.u32Const "DESCRIPTOR_LENGTH_SHIFT" abi.descriptorLengthShift;
    r.u32Const "DESCRIPTOR_LENGTH_BITS" abi.descriptorLengthBits;
    r.u32Const "DESCRIPTOR_CAPS_SHIFT" abi.descriptorCapsShift;
    r.u32Const "DESCRIPTOR_CAPS_BITS" abi.descriptorCapsBits;
    r.u32Const "DESCRIPTOR_FORM_SHIFT" abi.descriptorFormShift;
    r.u32Const "DESCRIPTOR_FORM_BITS" abi.descriptorFormBits;
    r.u32Const "DESCRIPTOR_THREAD_SHIFT" abi.descriptorThreadShift;
    r.u64Const "DESCRIPTOR_FORM_INLINE" abi.descriptorFormInline;
    r.u64Const "DESCRIPTOR_FORM_WINDOW" abi.descriptorFormWindow;
    "\n";
    r.u32Const "CHILD_CNODE_SIZE_BITS" abi.childCnodeSizeBits;
    r.u32Const "ROOT_SERVICE_SLOT" abi.rootServiceSlot;
    r.u32Const "TCB_SLOT" abi.tcbSlot;
    r.u32Const "FAULT_SLOT" abi.faultSlot;
    r.u32Const "CHILD_CNODE_SLOT" abi.childCnodeSlot;
    r.u32Const "TRANSFERRED_ENDPOINT_BASE" abi.transferredEndpointBase;
    r.u32Const "CONSOLE_SERVICE_SLOT" abi.consoleServiceSlot;
    r.u32Const "NATIVE_ENDPOINT_BASE" abi.nativeEndpointBase;
    r.u32Const "NATIVE_NOTIFICATION_BASE" abi.nativeNotificationBase;
    r.u32Const "NATIVE_AUTHORITY_BASE" abi.nativeAuthorityBase;
    r.u32Const "NATIVE_REGION_SLOTS" abi.nativeRegionSlots;
    r.u32Const "NATIVE_RECEIVE_SLOT" abi.nativeReceiveSlot;
    r.u32Const "TRANSFERRED_ENDPOINT_HANDLE_TAG" abi.transferredEndpointHandleTag;
    "\npub mod console_labels {\n";
    r.join (map rustConsoleLabel abi.consoleOperations);
    "}\n";
  };

cLine :: Text -> Int -> Text
  = name value => r.join { "#define SLIME_"; name; " "; n.toText value; "U\n"; };

cConsoleLabel :: ConsoleOperation -> Text
  = operation => cLine (t.join "" { "CONSOLE_LABEL_"; operation.name; }) operation.label;

cBindings :: Abi -> Text
  = abi => r.join {
    "/* @generated by contracts/component-runtime-abi/v1/gen_bindings.zt; do not edit. */\n";
    "/* Source contract: contracts/component-runtime-abi/v1/schema.zt */\n";
    "#ifndef SLIME_COMPONENT_RUNTIME_ABI_H\n#define SLIME_COMPONENT_RUNTIME_ABI_H\n\n";
    cLine "COMPONENT_RUNTIME_ABI_VERSION" abi.formatVersion;
    cLine "WORD_BYTES" abi.wordBytes;
    cLine "GRANULE_BYTES" abi.granuleBytes;
    cLine "MAX_THREADS" abi.maxThreads;
    cLine "FAST_REGISTERS" abi.fastRegisters;
    cLine "INLINE_BYTES" abi.inlineBytes;
    cLine "MIN_TRANSFER_WINDOW_BYTES" abi.minimumTransferWindowBytes;
    "\n";
    cLine "DESCRIPTOR_LENGTH_SHIFT" abi.descriptorLengthShift;
    cLine "DESCRIPTOR_LENGTH_BITS" abi.descriptorLengthBits;
    cLine "DESCRIPTOR_CAPS_SHIFT" abi.descriptorCapsShift;
    cLine "DESCRIPTOR_CAPS_BITS" abi.descriptorCapsBits;
    cLine "DESCRIPTOR_FORM_SHIFT" abi.descriptorFormShift;
    cLine "DESCRIPTOR_FORM_BITS" abi.descriptorFormBits;
    cLine "DESCRIPTOR_THREAD_SHIFT" abi.descriptorThreadShift;
    cLine "DESCRIPTOR_FORM_INLINE" abi.descriptorFormInline;
    cLine "DESCRIPTOR_FORM_WINDOW" abi.descriptorFormWindow;
    "\n";
    cLine "CHILD_CNODE_SIZE_BITS" abi.childCnodeSizeBits;
    cLine "ROOT_SERVICE_SLOT" abi.rootServiceSlot;
    cLine "TCB_SLOT" abi.tcbSlot;
    cLine "FAULT_SLOT" abi.faultSlot;
    cLine "CHILD_CNODE_SLOT" abi.childCnodeSlot;
    cLine "TRANSFERRED_ENDPOINT_BASE" abi.transferredEndpointBase;
    cLine "CONSOLE_SERVICE_SLOT" abi.consoleServiceSlot;
    cLine "NATIVE_ENDPOINT_BASE" abi.nativeEndpointBase;
    cLine "NATIVE_NOTIFICATION_BASE" abi.nativeNotificationBase;
    cLine "NATIVE_AUTHORITY_BASE" abi.nativeAuthorityBase;
    cLine "NATIVE_REGION_SLOTS" abi.nativeRegionSlots;
    cLine "NATIVE_RECEIVE_SLOT" abi.nativeReceiveSlot;
    cLine "TRANSFERRED_ENDPOINT_HANDLE_TAG" abi.transferredEndpointHandleTag;
    "\n";
    r.join (map cConsoleLabel abi.consoleOperations);
    "\n#endif\n";
  };

sameConsoleLabel :: ConsoleOperation -> ConsoleOperation -> Bool
  = a b => a.label == b.label;

consoleLabelUniqueIn :: List ConsoleOperation -> ConsoleOperation -> Bool
  = operations operation => l.length (l.filter (sameConsoleLabel operation) operations) == 1;

powerOfTwo :: Int -> Bool
  = value => value > 0 && (value == 1 || value == 2 || value == 4 || value == 8 || value == 16 || value == 32 || value == 64 || value == 128 || value == 256 || value == 512 || value == 1024 || value == 2048 || value == 4096 || value == 8192 || value == 16384 || value == 32768 || value == 65536);

valid :: Abi -> Bool
  = abi =>
    abi.formatVersion == 1
      && abi.wordBytes == 8
      && powerOfTwo abi.granuleBytes
      && abi.maxThreads > 0
      && abi.fastRegisters == 4
      && abi.inlineBytes == 2 * abi.wordBytes
      && abi.minimumTransferWindowBytes == abi.granuleBytes
      && abi.descriptorLengthShift == 0
      && abi.descriptorCapsShift == abi.descriptorLengthBits
      && abi.descriptorFormShift == abi.descriptorCapsShift + abi.descriptorCapsBits
      && abi.descriptorThreadShift == abi.descriptorFormShift + abi.descriptorFormBits
      && abi.descriptorFormInline != abi.descriptorFormWindow
      && abi.rootServiceSlot > 0
      && abi.consoleServiceSlot < 128
      && abi.nativeEndpointBase == abi.consoleServiceSlot + 1
      && abi.nativeNotificationBase == abi.nativeEndpointBase + abi.nativeRegionSlots
      && abi.nativeAuthorityBase == abi.nativeNotificationBase + abi.nativeRegionSlots
      && abi.nativeReceiveSlot == 2 * abi.nativeRegionSlots + abi.nativeNotificationBase + 1
      && l.all (consoleLabelUniqueIn abi.consoleOperations) abi.consoleOperations;

render :: Abi -> { rust : Text; c : Text; }
  = abi => if valid abi
    then { rust = rustBindings abi; c = cBindings abi; }
    else { rust = "INVALID_COMPONENT_RUNTIME_ABI_SCHEMA"; c = "INVALID_COMPONENT_RUNTIME_ABI_SCHEMA"; };

{ render =; }
