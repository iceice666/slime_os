refl ::= import stdlib.reflect;
n ::= import stdlib.num;
t ::= import stdlib.text;
w ::= import wire.rust;
c ::= import wire.codec;
WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };
Protocol :: type { formatVersion : Int; recordLen : Int; magic : Int; fields : List refl.SchemaField; layout : List WireField; };
-- Offset and codec emitters come from `wire.codec`, which owns the
-- byte-array-aware mechanics fourteen renderers previously each copied. The
-- validity predicate below stays here: what makes *this* layout admissible is
-- contract-specific.
layoutNames :: List WireField -> List Text = c.layoutNames;
allValid :: List WireField -> Bool = c.allValid;
wireBytes :: List WireField -> Int = c.wireBytes;
offsetConsts :: Text -> Int -> List WireField -> Text = c.offsetConsts;
wireStruct :: Text -> Text -> Text -> List WireField -> Text
  = name prefix lengthName fields => c.wireStruct "fabric-time" name prefix lengthName fields;


rustBindings :: Protocol -> Text = p => w.join { "// @generated by contracts/fabric-time/v1/gen_rust.zt; do not edit.\n// Source contract: contracts/fabric-time/v1/schema.zt\n\n"; "pub const FORMAT_VERSION: u32 = "; n.toText p.formatVersion; ";\n"; "pub const TIME_ADVANCE_MAGIC: u32 = "; n.toText p.magic; ";\n"; "pub const TIME_ADVANCE_LEN: usize = "; n.toText p.recordLen; ";\n\n"; offsetConsts "TIME" 0 p.layout; "\n"; wireStruct "WireTimeAdvance" "TIME" "TIME_ADVANCE_LEN" p.layout; };
valid :: Protocol -> Bool = p => w.schemaFieldsValid p.fields && w.schemaNames p.fields == layoutNames p.layout && allValid p.layout && wireBytes p.layout == p.recordLen;
render :: Protocol -> { rust : Text; } = p => if valid p then { rust = rustBindings p; } else { rust = "INVALID_FABRIC_TIME_SCHEMA"; };
{ render =; }
