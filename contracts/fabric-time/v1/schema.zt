-- Slime OS explicit monotonic-time input, version 1 (C8.5).
-- A capability-routed sender advances one fabric instance's simulated clock.
-- The timestamp is absolute monotonic nanoseconds and must never decrease.

env ::= import stdlib.env;
fs ::= import stdlib.fs;
gen ::= import "gen_rust.zt";
t ::= import stdlib.text;

formatVersion :: Int = 1;
recordLen :: Int = 64;
magic :: Int = 1296650836; -- `TIME`

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };
TimeAdvance :: type { magic : Int; version : Int; flags : Int; reserved0 : Int; now_ns : Int; reserved : Int; };
schemaValue ::= schema TimeAdvance;
layout :: List WireField = {
  { name = "magic"; width = 4; signed = false; byteArray = false; };
  { name = "version"; width = 4; signed = false; byteArray = false; };
  { name = "flags"; width = 4; signed = false; byteArray = false; };
  { name = "reserved0"; width = 4; signed = false; byteArray = false; };
  { name = "now_ns"; width = 8; signed = false; byteArray = false; };
  { name = "reserved"; width = 40; signed = false; byteArray = true; };
};
format ::= { formatVersion =; recordLen =; magic =; fields = schemaValue.fields ?? {;}; layout =; };
main :: { write : FsWrite; env : Env; } -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [ root := env.get caps.env "SLIME_FABRIC_TIME_BINDINGS_ROOT" ?? "."; bindings := gen.render format; path := t.join "" { root; "/components/proto/src/fabric_time.rs"; }; fs.writeAll caps.write path bindings.rust ];
main
