-- MAVLink v2 HEARTBEAT frame, as Slime OS emits it, version 1.
--
-- One unsigned MAVLink v2 frame carrying message 0 with a nine-byte payload,
-- 21 bytes on the wire. The identity a Slime heartbeat declares is fixed here:
-- an onboard computer (`MAV_COMP_ID_ONBOARD_COMPUTER`, `MAV_TYPE_ONBOARD_CONTROLLER`)
-- with no autopilot (`MAV_AUTOPILOT_INVALID`), active (`MAV_STATE_ACTIVE`),
-- speaking MAVLink 2. The payload's last byte is the protocol version, never
-- zero, so v2's trailing-zero truncation never shortens the frame.
--
-- The checksum is CRC-16/MCRF4XX (reflected polynomial `crcPoly`, initial value
-- `crcInit`, no final inversion) over every byte after the start marker and
-- before the checksum, then over the one byte `crcExtra`; it is sent low byte
-- first. The arithmetic is not a format and is not rendered: the Rust encoder
-- and the checkers' decoder each implement it, and both must reproduce the
-- pinned vectors below byte for byte.

env ::= import stdlib.env;
fs ::= import stdlib.fs;
gen ::= import "gen_rust.zt";
t ::= import stdlib.text;

stx :: Int = 253;
headerLen :: Int = 10;
checksumLen :: Int = 2;
payloadLen :: Int = 9;
frameLen :: Int = 21;
msgId :: Int = 0;
crcExtra :: Int = 50;
crcInit :: Int = 65535;
-- 0x8408, the reflected form of the CCITT polynomial 0x1021.
crcPoly :: Int = 33800;

sysId :: Int = 1;
compId :: Int = 191;
mavType :: Int = 18;
autopilot :: Int = 8;
baseMode :: Int = 0;
customMode :: Int = 0;
systemStatus :: Int = 4;
mavlinkVersion :: Int = 3;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

-- Wire order. The payload fields follow MAVLink's rule, descending field width,
-- which puts `custom_mode` first although the message declares it second.
HeartbeatFrame :: type {
  stx : Int;
  payload_len : Int;
  incompat_flags : Int;
  compat_flags : Int;
  seq : Int;
  sysid : Int;
  compid : Int;
  msgid : Int;
  custom_mode : Int;
  mav_type : Int;
  autopilot : Int;
  base_mode : Int;
  system_status : Int;
  mavlink_version : Int;
  checksum : Int;
};

frameSchema ::= schema HeartbeatFrame;

frameLayout :: List WireField = {
  { name = "stx"; width = 1; signed = false; byteArray = false; };
  { name = "payload_len"; width = 1; signed = false; byteArray = false; };
  { name = "incompat_flags"; width = 1; signed = false; byteArray = false; };
  { name = "compat_flags"; width = 1; signed = false; byteArray = false; };
  { name = "seq"; width = 1; signed = false; byteArray = false; };
  { name = "sysid"; width = 1; signed = false; byteArray = false; };
  { name = "compid"; width = 1; signed = false; byteArray = false; };
  { name = "msgid"; width = 3; signed = false; byteArray = true; };
  { name = "custom_mode"; width = 4; signed = false; byteArray = false; };
  { name = "mav_type"; width = 1; signed = false; byteArray = false; };
  { name = "autopilot"; width = 1; signed = false; byteArray = false; };
  { name = "base_mode"; width = 1; signed = false; byteArray = false; };
  { name = "system_status"; width = 1; signed = false; byteArray = false; };
  { name = "mavlink_version"; width = 1; signed = false; byteArray = false; };
  { name = "checksum"; width = 2; signed = false; byteArray = false; };
};

-- The declared heartbeat at sequence 0, 1, and 255: both ends of the sequence
-- byte and one step. Checked against the published CRC-16/MCRF4XX check value
-- `"123456789" -> 0x6F91` by both implementations' tests.
vectorSeq0 :: List Int = {
  253; 9; 0; 0; 0; 1; 191; 0; 0; 0; 0; 0; 0; 0; 18; 8; 0; 4; 3; 174; 198;
};
vectorSeq1 :: List Int = {
  253; 9; 0; 0; 1; 1; 191; 0; 0; 0; 0; 0; 0; 0; 18; 8; 0; 4; 3; 190; 72;
};
vectorSeq255 :: List Int = {
  253; 9; 0; 0; 255; 1; 191; 0; 0; 0; 0; 0; 0; 0; 18; 8; 0; 4; 3; 183; 124;
};

format ::= {
  stx =;
  headerLen =;
  checksumLen =;
  payloadLen =;
  frameLen =;
  msgId =;
  crcExtra =;
  crcInit =;
  crcPoly =;
  sysId =;
  compId =;
  mavType =;
  autopilot =;
  baseMode =;
  customMode =;
  systemStatus =;
  mavlinkVersion =;
  frameFields = frameSchema.fields ?? {;};
  frameLayout =;
  vectorSeq0 =;
  vectorSeq1 =;
  vectorSeq255 =;
};

main :: { write : FsWrite; env : Env; } -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_MAVLINK_HEARTBEAT_BINDINGS_ROOT" ?? ".";
    bindings := gen.render format;
    rustPath := t.join "" { root; "/components/proto/src/mavlink_heartbeat.rs"; };
    pythonPath := t.join "" { root; "/scripts/lib/mavlink_heartbeat_contract.py"; };
    fs.writeAll caps.write rustPath bindings.rust;
    fs.writeAll caps.write pythonPath bindings.python
  ];

main
