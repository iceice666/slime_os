-- Pure renderer for the MAVLink v2 HEARTBEAT frame: the Rust module the
-- heartbeat component encodes with, and the Python module the checkers decode
-- against, carrying the same constants, layout, and pinned vectors.

refl ::= import stdlib.reflect;
n ::= import stdlib.num;
l ::= import stdlib.list;
w ::= import wire.rust;
c ::= import wire.codec;
py ::= import wire.python;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

Format :: type {
  stx : Int;
  headerLen : Int;
  checksumLen : Int;
  payloadLen : Int;
  frameLen : Int;
  msgId : Int;
  crcExtra : Int;
  crcInit : Int;
  crcPoly : Int;
  sysId : Int;
  compId : Int;
  mavType : Int;
  autopilot : Int;
  baseMode : Int;
  customMode : Int;
  systemStatus : Int;
  mavlinkVersion : Int;
  frameFields : List refl.SchemaField;
  frameLayout : List WireField;
  vectorSeq0 : List Int;
  vectorSeq1 : List Int;
  vectorSeq255 : List Int;
};

layoutNames :: List WireField -> List Text = c.layoutNames;
allValid :: List WireField -> Bool = c.allValid;
wireBytes :: List WireField -> Int = c.wireBytes;
offsetConsts :: Text -> Int -> List WireField -> Text = c.offsetConsts;
wireStruct :: Text -> Text -> Text -> List WireField -> Text
  = name prefix lengthName fields => c.wireStruct "mavlink-heartbeat" name prefix lengthName fields;

-- `a, b, c`: comma-separated, with no trailing separator.
byteText :: List Int -> Text
  = bytes => match bytes {
    | {;} => "";
    | { byte; ...rest } => match rest {
      | {;} => n.toText byte;
      | { next; ...more } => w.join { n.toText byte; ", "; byteText rest; };
    };
  };

isByte :: Int -> Bool = value => value >= 0 && value <= 255;

-- The element at `index`, or -1 past the end (never a byte, so never agrees).
at :: Int -> List Int -> Int
  = index values => match l.drop index values {
    | {;} => -1;
    | { value; ...rest } => value;
  };

-- A vector is admissible only if it is a frame of this format's length whose
-- header and payload bytes say what the constants say; the checksum is left to
-- the two encoders' tests, which is the point of pinning it.
vectorAgrees :: Format -> Int -> List Int -> Bool
  = format seq vector =>
    l.length vector == format.frameLen
      && l.all isByte vector
      && at 0 vector == format.stx
      && at 1 vector == format.payloadLen
      && at 2 vector == 0
      && at 3 vector == 0
      && at 4 vector == seq
      && at 5 vector == format.sysId
      && at 6 vector == format.compId
      && at 7 vector == format.msgId
      && at 8 vector == 0
      && at 9 vector == 0
      && at 10 vector == format.customMode
      && at 11 vector == 0
      && at 12 vector == 0
      && at 13 vector == 0
      && at 14 vector == format.mavType
      && at 15 vector == format.autopilot
      && at 16 vector == format.baseMode
      && at 17 vector == format.systemStatus
      && at 18 vector == format.mavlinkVersion;

rustBindings :: Format -> Text
  = format => w.join {
    "// @generated by contracts/mavlink-heartbeat/v1/gen_rust.zt; do not edit.\n";
    "// Source contract: contracts/mavlink-heartbeat/v1/schema.zt\n\n";
    "pub const STX: u8 = "; n.toText format.stx; ";\n";
    "pub const HEADER_LEN: usize = "; n.toText format.headerLen; ";\n";
    "pub const CHECKSUM_LEN: usize = "; n.toText format.checksumLen; ";\n";
    "pub const PAYLOAD_LEN: usize = "; n.toText format.payloadLen; ";\n";
    "pub const FRAME_LEN: usize = "; n.toText format.frameLen; ";\n";
    "pub const MSG_ID: u32 = "; n.toText format.msgId; ";\n";
    "pub const CRC_EXTRA: u8 = "; n.toText format.crcExtra; ";\n";
    "pub const CRC_INIT: u16 = "; n.toText format.crcInit; ";\n";
    "pub const CRC_POLY: u16 = "; n.toText format.crcPoly; ";\n\n";
    "pub const SYS_ID: u8 = "; n.toText format.sysId; ";\n";
    "pub const COMP_ID: u8 = "; n.toText format.compId; ";\n";
    "pub const MAV_TYPE: u8 = "; n.toText format.mavType; ";\n";
    "pub const AUTOPILOT: u8 = "; n.toText format.autopilot; ";\n";
    "pub const BASE_MODE: u8 = "; n.toText format.baseMode; ";\n";
    "pub const CUSTOM_MODE: u32 = "; n.toText format.customMode; ";\n";
    "pub const SYSTEM_STATUS: u8 = "; n.toText format.systemStatus; ";\n";
    "pub const MAVLINK_VERSION: u8 = "; n.toText format.mavlinkVersion; ";\n\n";
    "pub const VECTOR_SEQ_0: [u8; FRAME_LEN] = ["; byteText format.vectorSeq0; "];\n";
    "pub const VECTOR_SEQ_1: [u8; FRAME_LEN] = ["; byteText format.vectorSeq1; "];\n";
    "pub const VECTOR_SEQ_255: [u8; FRAME_LEN] = ["; byteText format.vectorSeq255; "];\n\n";
    offsetConsts "FRAME" 0 format.frameLayout;
    "\n";
    wireStruct "WireHeartbeat" "FRAME" "FRAME_LEN" format.frameLayout;
  };

records :: Format -> List py.WireRecord
  = format => {
    {
      pythonName = "HEARTBEAT_FRAME";
      constPrefix = "HEARTBEAT_FRAME";
      size = format.frameLen;
      trailingPadding = 0;
      fields = format.frameFields;
      layout = format.frameLayout;
    };
  };

pythonBindings :: Format -> Text
  = format => py.join {
    "# @generated by contracts/mavlink-heartbeat/v1/gen_rust.zt; do not edit.\n";
    "# Source contract: contracts/mavlink-heartbeat/v1/schema.zt\n\n";
    "import struct\n\n";
    "MAVLINK_STX = "; n.toText format.stx; "\n";
    "MAVLINK_HEADER_LEN = "; n.toText format.headerLen; "\n";
    "MAVLINK_CHECKSUM_LEN = "; n.toText format.checksumLen; "\n";
    "MAVLINK_CRC_INIT = "; n.toText format.crcInit; "\n";
    "MAVLINK_CRC_POLY = "; n.toText format.crcPoly; "\n";
    "HEARTBEAT_MSGID = "; n.toText format.msgId; "\n";
    "HEARTBEAT_PAYLOAD_LEN = "; n.toText format.payloadLen; "\n";
    "HEARTBEAT_FRAME_LEN = "; n.toText format.frameLen; "\n";
    "HEARTBEAT_CRC_EXTRA = "; n.toText format.crcExtra; "\n";
    "HEARTBEAT_SYSID = "; n.toText format.sysId; "\n";
    "HEARTBEAT_COMPID = "; n.toText format.compId; "\n";
    "HEARTBEAT_MAV_TYPE = "; n.toText format.mavType; "\n";
    "HEARTBEAT_AUTOPILOT = "; n.toText format.autopilot; "\n";
    "HEARTBEAT_BASE_MODE = "; n.toText format.baseMode; "\n";
    "HEARTBEAT_CUSTOM_MODE = "; n.toText format.customMode; "\n";
    "HEARTBEAT_SYSTEM_STATUS = "; n.toText format.systemStatus; "\n";
    "HEARTBEAT_MAVLINK_VERSION = "; n.toText format.mavlinkVersion; "\n\n";
    "HEARTBEAT_VECTORS: dict[int, bytes] = {\n";
    "    0: bytes([\n        "; byteText format.vectorSeq0; ",\n    ]),\n";
    "    1: bytes([\n        "; byteText format.vectorSeq1; ",\n    ]),\n";
    "    255: bytes([\n        "; byteText format.vectorSeq255; ",\n    ]),\n";
    "}\n\n";
    py.renderRecords (records format);
  };

valid :: Format -> Bool
  = format =>
    w.schemaFieldsValid format.frameFields
      && w.schemaNames format.frameFields == layoutNames format.frameLayout
      && allValid format.frameLayout
      && py.recordsValid (records format)
      && wireBytes format.frameLayout == format.frameLen
      && format.frameLen == format.headerLen + format.payloadLen + format.checksumLen
      && format.frameLen == 21
      && format.mavlinkVersion > 0
      && isByte format.crcExtra
      && format.crcInit == 65535
      && format.crcPoly == 33800
      && vectorAgrees format 0 format.vectorSeq0
      && vectorAgrees format 1 format.vectorSeq1
      && vectorAgrees format 255 format.vectorSeq255;

render :: Format -> { rust : Text; python : Text; }
  = format => if valid format
    then { rust = rustBindings format; python = pythonBindings format; }
    else { rust = "INVALID_MAVLINK_HEARTBEAT_SCHEMA"; python = "INVALID_MAVLINK_HEARTBEAT_SCHEMA"; };

{ render =; }
