-- Schema-reflected Python + Rust renderer for network-interface/v1.
refl ::= import stdlib.reflect;
n ::= import stdlib.num;
w ::= import wire.python;
r ::= import wire.rust;
t ::= import stdlib.text;
c ::= import wire.codec;

Format :: type {
  formatVersion : Int; headerBytes : Int; entryBytes : Int; maxInterfaces : Int;
  ipv4Bytes : Int; macBytes : Int; minPrefixLen : Int; maxPrefixLen : Int;
  headerFields : List refl.SchemaField; entryFields : List refl.SchemaField;
  headerLayout : List w.WireField; entryLayout : List w.WireField;
};
records :: Format -> List w.WireRecord = f => {
  { pythonName = "NETWORK_INTERFACE_HEADER"; constPrefix = "NETWORK_INTERFACE"; size = f.headerBytes; trailingPadding = 0; fields = f.headerFields; layout = f.headerLayout; };
  { pythonName = "NETWORK_INTERFACE_ENTRY"; constPrefix = "NETWORK_INTERFACE_ENTRY"; size = f.entryBytes; trailingPadding = 0; fields = f.entryFields; layout = f.entryLayout; };
};
pythonBindings :: Format -> Text = f => w.join {
  "NETWORK_INTERFACE_MAGIC = b\"SLIMENI\\0\"\n";
  "NETWORK_INTERFACE_VERSION = "; n.toText f.formatVersion; "\n";
  "NETWORK_INTERFACE_HEADER_BYTES = "; n.toText f.headerBytes; "\nNETWORK_INTERFACE_ENTRY_BYTES = "; n.toText f.entryBytes; "\n";
  "MAX_NETWORK_INTERFACES = "; n.toText f.maxInterfaces; "\n";
  "NETWORK_INTERFACE_MIN_PREFIX_LEN = "; n.toText f.minPrefixLen; "\nNETWORK_INTERFACE_MAX_PREFIX_LEN = "; n.toText f.maxPrefixLen; "\n";
  w.renderRecords (records f);
};

-- Offsets come from `wire.codec` as `network-destination/v1`'s do: the
-- byte-array fields (holder identity, address, gateway, MAC) are read as
-- ranges, so every offset has its `_END` companion.
layoutNames :: List w.WireField -> List Text = c.layoutNames;
wireBytes :: List w.WireField -> Int = c.wireBytes;
offsetConsts :: Text -> Int -> List w.WireField -> Text = c.offsetConstsWithEnds;
rustBindings :: Format -> Text = f => r.join {
  "// @generated by contracts/network-interface/v1/gen_rust.zt; do not edit.\n// Source contract: contracts/network-interface/v1/schema.zt\n\n";
  r.u32Const "FORMAT_VERSION" f.formatVersion; r.usizeConst "HEADER_BYTES" f.headerBytes; r.usizeConst "ENTRY_BYTES" f.entryBytes;
  r.usizeConst "MAX_INTERFACES" f.maxInterfaces; r.usizeConst "IPV4_BYTES" f.ipv4Bytes; r.usizeConst "MAC_BYTES" f.macBytes;
  r.join { "pub const MIN_PREFIX_LEN: u8 = "; n.toText f.minPrefixLen; ";\npub const MAX_PREFIX_LEN: u8 = "; n.toText f.maxPrefixLen; ";\n"; };
  "\n"; offsetConsts "HEADER" 0 f.headerLayout;
  "\n"; offsetConsts "ENTRY" 0 f.entryLayout;
};
render :: Format -> { python : Text; rust : Text; } = f => if w.recordsValid (records f)
  && wireBytes f.headerLayout == f.headerBytes
  && wireBytes f.entryLayout == f.entryBytes
  && f.ipv4Bytes == 4 && f.macBytes == 6
  && f.minPrefixLen > 0 && f.minPrefixLen <= f.maxPrefixLen && f.maxPrefixLen < 32
  then { python = pythonBindings f; rust = rustBindings f; }
  else { python = "INVALID_NETWORK_INTERFACE_SCHEMA"; rust = "INVALID_NETWORK_INTERFACE_SCHEMA"; };
{ render =; }
