-- Schema-reflected Python + Rust renderer for scheduling-class/v1.

refl ::= import stdlib.reflect;
n ::= import stdlib.num;
t ::= import stdlib.text;
w ::= import wire.python;
r ::= import wire.rust;

ClassName :: type { name : Text; id : Int; manifest : Text; };

Format :: type {
  formatVersion : Int;
  headerBytes : Int;
  classBytes : Int;
  entryBytes : Int;
  promotionBytes : Int;
  maxClasses : Int;
  maxInstances : Int;
  maxPromotions : Int;
  undeclaredClassId : Int;
  classNames : List ClassName;
  headerFields : List refl.SchemaField;
  bandFields : List refl.SchemaField;
  entryFields : List refl.SchemaField;
  promotionFields : List refl.SchemaField;
  headerLayout : List w.WireField;
  bandLayout : List w.WireField;
  entryLayout : List w.WireField;
  promotionLayout : List w.WireField;
};

records :: Format -> List w.WireRecord = format => {
  { pythonName = "SCHEDULING_CLASS_HEADER"; constPrefix = "SCHEDULING_CLASS"; size = format.headerBytes; trailingPadding = 0; fields = format.headerFields; layout = format.headerLayout; };
  { pythonName = "SCHEDULING_CLASS_BAND"; constPrefix = "SCHEDULING_CLASS_BAND"; size = format.classBytes; trailingPadding = 0; fields = format.bandFields; layout = format.bandLayout; };
  { pythonName = "SCHEDULING_CLASS_ENTRY"; constPrefix = "SCHEDULING_CLASS_ENTRY"; size = format.entryBytes; trailingPadding = 0; fields = format.entryFields; layout = format.entryLayout; };
  { pythonName = "SCHEDULING_PROMOTION_ENTRY"; constPrefix = "SCHEDULING_PROMOTION_ENTRY"; size = format.promotionBytes; trailingPadding = 0; fields = format.promotionFields; layout = format.promotionLayout; };
};

-- `SCHEDULING_CLASS_ID_BY_MANIFEST_NAME` is the builder's whole class
-- vocabulary, rendered from the same list the Rust constants come from, so the
-- manifest spelling a `.zti` writes and the id both readers compare cannot be
-- two hand-synchronized tables.
pythonClassIds :: List ClassName -> Text
  = names => match names {
    | {;} => "";
    | { entry; ...rest } => w.join {
      "    \""; entry.manifest; "\": "; n.toText entry.id; ",\n";
      pythonClassIds rest;
    };
  };

pythonClassConsts :: List ClassName -> Text
  = names => match names {
    | {;} => "";
    | { entry; ...rest } => w.join {
      "SCHEDULING_CLASS_"; entry.name; " = "; n.toText entry.id; "\n";
      pythonClassConsts rest;
    };
  };

rustClassConsts :: List ClassName -> Text
  = names => match names {
    | {;} => "";
    | { entry; ...rest } => r.join {
      r.u32Const (t.join "" { "CLASS_"; entry.name; }) entry.id;
      rustClassConsts rest;
    };
  };

pythonBindings :: Format -> Text = format => w.join {
  "SCHEDULING_CLASS_MAGIC = b\"SLIMESC\\0\"\n";
  "SCHEDULING_CLASS_VERSION = "; n.toText format.formatVersion; "\n";
  "SCHEDULING_CLASS_HEADER_BYTES = "; n.toText format.headerBytes; "\n";
  "SCHEDULING_CLASS_BAND_BYTES = "; n.toText format.classBytes; "\n";
  "SCHEDULING_CLASS_ENTRY_BYTES = "; n.toText format.entryBytes; "\n";
  "SCHEDULING_PROMOTION_ENTRY_BYTES = "; n.toText format.promotionBytes; "\n";
  "SCHEDULING_CLASS_MAX_CLASSES = "; n.toText format.maxClasses; "\n";
  "SCHEDULING_CLASS_MAX_INSTANCES = "; n.toText format.maxInstances; "\n";
  "SCHEDULING_CLASS_MAX_PROMOTIONS = "; n.toText format.maxPromotions; "\n";
  "SCHEDULING_CLASS_UNDECLARED_ID = "; n.toText format.undeclaredClassId; "\n";
  pythonClassConsts format.classNames;
  "SCHEDULING_CLASS_ID_BY_MANIFEST_NAME = {\n";
  pythonClassIds format.classNames;
  "}\n";
  w.renderRecords (records format);
};

rustBindings :: Format -> Text = format => r.join {
  "// @generated by contracts/scheduling-class/v1/gen_rust.zt; do not edit.\n";
  "// Source contract: contracts/scheduling-class/v1/schema.zt\n\n";
  r.u32Const "FORMAT_VERSION" format.formatVersion;
  r.usizeConst "HEADER_BYTES" format.headerBytes;
  r.usizeConst "BAND_BYTES" format.classBytes;
  r.usizeConst "ENTRY_BYTES" format.entryBytes;
  r.usizeConst "PROMOTION_BYTES" format.promotionBytes;
  r.usizeConst "MAX_CLASSES" format.maxClasses;
  r.usizeConst "MAX_INSTANCES" format.maxInstances;
  r.usizeConst "MAX_PROMOTIONS" format.maxPromotions;
  r.u32Const "UNDECLARED_CLASS_ID" format.undeclaredClassId;
  rustClassConsts format.classNames;
};

render :: Format -> { python : Text; rust : Text; }
  = format => if w.recordsValid (records format)
    then { python = pythonBindings format; rust = rustBindings format; }
    else { python = "INVALID_SCHEDULING_CLASS_SCHEMA"; rust = "INVALID_SCHEDULING_CLASS_SCHEMA"; };
{ render =; }
