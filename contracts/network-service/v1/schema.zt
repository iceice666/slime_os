-- Slime OS network service control protocol, version 1 (IO4).
--
-- This is the application-facing protocol. It names exact destinations and
-- typed service capabilities; it deliberately contains no NIC identity, raw
-- frame operation, ambient socket operation, or resolver-wide authority.
-- Send and receive data travel in the IO0 buffer slice beside these payloads.
--
-- `LoanDelegation` is the descriptor a client sends beside each shared-buffer
-- loan it delegates to the service: first its IO0 queue page, then its data
-- pages. It names the buffer and loan the pages carry and which of the two
-- kinds they are; the authority itself is claimed from the client's endpoint
-- through the runtime, never from these bytes. Its magic differs from the
-- request magic so the service tells the two apart by decoding, not by size.
--
-- Completion `status_detail` values, the shutdown sentinel a client closes to
-- end its session, and the depth of the IO0 data ring a client lends are named
-- here too: a client written against the generated bindings shares them with
-- the service instead of restating them.

env ::= import stdlib.env;
fs ::= import stdlib.fs;
gen ::= import "gen_rust.zt";
t ::= import stdlib.text;

formatVersion :: Int = 1;
requestBytes :: Int = 56;
completionBytes :: Int = 24;
maxNameBytes :: Int = 24;
delegationBytes :: Int = 64;
networkMagic :: Int = 1414745678;
-- Little-endian `NNLD`.
delegationMagic :: Int = 1145851470;

opConnect :: Int = 1;
opSend :: Int = 2;
opRecv :: Int = 3;
opClose :: Int = 4;
opListen :: Int = 5;
opAccept :: Int = 6;
opResolve :: Int = 7;

transportNone :: Int = 0;
transportTcp :: Int = 1;
transportUdp :: Int = 2;

addressNone :: Int = 0;
addressIpv4 :: Int = 1;
addressIpv6 :: Int = 2;
addressDns :: Int = 3;

capabilityNone :: Int = 0;
capabilityTcpConnection :: Int = 1;
capabilityUdpEndpoint :: Int = 2;
capabilityTcpListener :: Int = 3;
capabilityDnsRecord :: Int = 4;

flagNonblocking :: Int = 1;
knownRequestFlags :: Int = 1;
flagEndOfStream :: Int = 1;
knownCompletionFlags :: Int = 1;

delegationQueue :: Int = 1;
delegationData :: Int = 2;

-- Completion `status_detail`: zero is success; a refusal reports one of these
-- with no capability.
statusDenied :: Int = -1;
statusMalformed :: Int = -2;
statusUnsupported :: Int = -3;
statusResetByPeer :: Int = -4;
statusUnreachable :: Int = -5;
-- The capability number whose `OP_CLOSE` ends a client's session; no minted
-- capability ever carries it. `u64::MAX`, as text: Zutai's Int is i64.
shutdownCapabilityText :: Text = "18446744073709551615";
-- The depth of the IO0 data ring a client lends; the service attaches at
-- exactly this count.
dataQueueSlots :: Int = 8;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

NetworkRequest :: type {
  magic : Int;
  version : Int;
  op : Int;
  transport : Int;
  flags : Int;
  port : Int;
  name_len : Int;
  capability : Int;
  address_kind : Int;
  reserved : Int;
  endpoint : Int;
};

NetworkCompletion :: type {
  magic : Int;
  version : Int;
  op : Int;
  capability_kind : Int;
  status_detail : Int;
  flags : Int;
  capability : Int;
};

LoanDelegation :: type {
  magic : Int;
  version : Int;
  kind : Int;
  reserved : Int;
  buffer : Int;
  lease : Int;
  padding : Int;
};

requestSchema ::= schema NetworkRequest;
completionSchema ::= schema NetworkCompletion;
delegationSchema ::= schema LoanDelegation;

requestLayout :: List WireField = {
  { name = "magic"; width = 4; signed = false; byteArray = false; };
  { name = "version"; width = 2; signed = false; byteArray = false; };
  { name = "op"; width = 1; signed = false; byteArray = false; };
  { name = "transport"; width = 1; signed = false; byteArray = false; };
  { name = "flags"; width = 4; signed = false; byteArray = false; };
  { name = "port"; width = 2; signed = false; byteArray = false; };
  { name = "name_len"; width = 2; signed = false; byteArray = false; };
  { name = "capability"; width = 8; signed = false; byteArray = false; };
  { name = "address_kind"; width = 1; signed = false; byteArray = false; };
  { name = "reserved"; width = 7; signed = false; byteArray = true; };
  { name = "endpoint"; width = 24; signed = false; byteArray = true; };
};

completionLayout :: List WireField = {
  { name = "magic"; width = 4; signed = false; byteArray = false; };
  { name = "version"; width = 2; signed = false; byteArray = false; };
  { name = "op"; width = 1; signed = false; byteArray = false; };
  { name = "capability_kind"; width = 1; signed = false; byteArray = false; };
  { name = "status_detail"; width = 4; signed = true; byteArray = false; };
  { name = "flags"; width = 4; signed = false; byteArray = false; };
  { name = "capability"; width = 8; signed = false; byteArray = false; };
};

delegationLayout :: List WireField = {
  { name = "magic"; width = 4; signed = false; byteArray = false; };
  { name = "version"; width = 2; signed = false; byteArray = false; };
  { name = "kind"; width = 1; signed = false; byteArray = false; };
  { name = "reserved"; width = 1; signed = false; byteArray = false; };
  { name = "buffer"; width = 8; signed = false; byteArray = false; };
  { name = "lease"; width = 8; signed = false; byteArray = false; };
  { name = "padding"; width = 40; signed = false; byteArray = true; };
};

protocol ::= {
  formatVersion =;
  requestBytes =;
  completionBytes =;
  maxNameBytes =;
  delegationBytes =;
  networkMagic =;
  delegationMagic =;
  opConnect =; opSend =; opRecv =; opClose =; opListen =; opAccept =; opResolve =;
  transportNone =; transportTcp =; transportUdp =;
  addressNone =; addressIpv4 =; addressIpv6 =; addressDns =;
  capabilityNone =; capabilityTcpConnection =; capabilityUdpEndpoint =;
  capabilityTcpListener =; capabilityDnsRecord =;
  flagNonblocking =; knownRequestFlags =; flagEndOfStream =; knownCompletionFlags =;
  delegationQueue =; delegationData =;
  statusDenied =; statusMalformed =; statusUnsupported =; statusResetByPeer =; statusUnreachable =;
  shutdownCapabilityText =; dataQueueSlots =;
  requestFields = requestSchema.fields ?? {;};
  completionFields = completionSchema.fields ?? {;};
  delegationFields = delegationSchema.fields ?? {;};
  requestLayout =;
  completionLayout =;
  delegationLayout =;
};

main :: { write : FsWrite; env : Env; } -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_NETWORK_SERVICE_BINDINGS_ROOT" ?? ".";
    bindings := gen.render protocol;
    path := t.join "" { root; "/components/proto/src/network_service.rs"; };
    fs.writeAll caps.write path bindings.rust
  ];

main
