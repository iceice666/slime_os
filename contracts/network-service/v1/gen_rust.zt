-- Pure renderer for Slime OS network-service/v1 bindings.
refl ::= import stdlib.reflect;
n ::= import stdlib.num;
t ::= import stdlib.text;
l ::= import stdlib.list;
w ::= import wire.rust;
py ::= import wire.python;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

Protocol :: type {
  formatVersion : Int; requestBytes : Int; completionBytes : Int; maxNameBytes : Int;
  networkMagic : Int;
  loanBytes : Int; loanRoleRing : Int; loanRoleData : Int;
  launchBytes : Int; launchPayloadBytes : Int; launchUrlBytes : Int; launchSeed : Int; launchUrl : Int;
  launchFields : List refl.SchemaField; launchLayout : List WireField;
  queueSlots : Int; ringPages : Int; dataPages : Int; ringBytes : Int; dataBytes : Int;
  statusSuccess : Int; statusDenied : Int; statusMalformed : Int; statusUnsupported : Int;
  statusWouldBlock : Int; statusExhausted : Int; statusRefused : Int; statusTimeout : Int; statusReset : Int;
  opAttach : Int; opAbort : Int; opShutdown : Int;
  loanFields : List refl.SchemaField; loanLayout : List WireField;
  opConnect : Int; opSend : Int; opRecv : Int; opClose : Int; opListen : Int; opAccept : Int; opResolve : Int;
  transportNone : Int; transportTcp : Int; transportUdp : Int;
  addressNone : Int; addressIpv4 : Int; addressIpv6 : Int; addressDns : Int;
  capabilityNone : Int; capabilityTcpConnection : Int; capabilityUdpEndpoint : Int;
  capabilityTcpListener : Int; capabilityDnsRecord : Int;
  flagNonblocking : Int; knownRequestFlags : Int; flagEndOfStream : Int; knownCompletionFlags : Int;
  requestFields : List refl.SchemaField; completionFields : List refl.SchemaField;
  requestLayout : List WireField; completionLayout : List WireField;
};

layoutNames :: List WireField -> List Text = fields => map _.name fields;
validField :: WireField -> Bool = field => if field.byteArray then field.width > 0 && not field.signed else w.validWidthSigned4 { name = field.name; width = field.width; signed = field.signed; };
allValid :: List WireField -> Bool = fields => match fields { | {;} => true; | { field; ...rest } => validField field && allValid rest; };
addWidth :: Int -> WireField -> Int = total field => total + field.width;
wireBytes :: List WireField -> Int = fields => fold addWidth 0 fields;
constName :: Text -> Text -> Text = prefix name => w.join { "OFF_"; prefix; "_"; t.toUpper name; };
offsetConsts :: Text -> Int -> List WireField -> Text = prefix offset fields => match fields {
  | {;} => "";
  | { field; ...rest } => w.join { "pub const "; constName prefix field.name; ": usize = "; n.toText offset; ";\n"; offsetConsts prefix (offset + field.width) rest; };
};
rustType :: WireField -> Text = field => if field.byteArray then w.join { "[u8; "; n.toText field.width; "]"; } else w.rustType { name = field.name; width = field.width; signed = field.signed; };
fieldDecls :: List WireField -> Text = fields => match fields { | {;} => ""; | { field; ...rest } => w.join { "    pub "; field.name; ": "; rustType field; ",\n"; fieldDecls rest; }; };
decodeExpr :: Text -> WireField -> Text = prefix field => if field.byteArray
  then w.join { "buf["; constName prefix field.name; ".."; constName prefix field.name; " + "; n.toText field.width; "].try_into().expect(\"generated network-service layout\")"; }
  else if field.width == 1 then w.join { "buf["; constName prefix field.name; "]"; }
  else w.join { rustType field; "::from_le_bytes(buf["; constName prefix field.name; ".."; constName prefix field.name; " + "; n.toText field.width; "].try_into().expect(\"generated network-service layout\"))"; };
decodeFields :: Text -> List WireField -> Text = prefix fields => match fields { | {;} => ""; | { field; ...rest } => w.join { "            "; field.name; ": "; decodeExpr prefix field; ",\n"; decodeFields prefix rest; }; };
encodeField :: Text -> WireField -> Text = prefix field => if field.byteArray
  then w.join { "        buf["; constName prefix field.name; ".."; constName prefix field.name; " + "; n.toText field.width; "].copy_from_slice(&self."; field.name; ");\n"; }
  else if field.width == 1 then w.join { "        buf["; constName prefix field.name; "] = self."; field.name; ";\n"; }
  else w.join { "        buf["; constName prefix field.name; ".."; constName prefix field.name; " + "; n.toText field.width; "].copy_from_slice(&self."; field.name; ".to_le_bytes());\n"; };
encodeFields :: Text -> List WireField -> Text = prefix fields => match fields { | {;} => ""; | { field; ...rest } => w.join { encodeField prefix field; encodeFields prefix rest; }; };
wireStruct :: Text -> Text -> Text -> List WireField -> Text = name prefix lengthName fields => w.join {
  "#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n"; "pub struct "; name; " {\n"; fieldDecls fields; "}\n\n";
  "impl "; name; " {\n    pub fn decode(buf: &[u8]) -> Option<Self> {\n        if buf.len() < "; lengthName; " { return None; }\n        Some(Self {\n"; decodeFields prefix fields; "        })\n    }\n\n    pub fn encode(self) -> [u8; "; lengthName; "] {\n        let mut buf = [0u8; "; lengthName; "];\n"; encodeFields prefix fields; "        buf\n    }\n}\n";
};

rustBindings :: Protocol -> Text = p => w.join {
  "// @generated by contracts/network-service/v1/gen_rust.zt; do not edit.\n// Source contract: contracts/network-service/v1/schema.zt\n\n";
  "pub const FORMAT_VERSION: u16 = "; n.toText p.formatVersion; ";\n";
  "pub const REQUEST_BYTES: usize = "; n.toText p.requestBytes; ";\npub const COMPLETION_BYTES: usize = "; n.toText p.completionBytes; ";\npub const MAX_NAME_BYTES: usize = "; n.toText p.maxNameBytes; ";\n";
  "pub const NETWORK_MAGIC: u32 = "; n.toText p.networkMagic; ";\n";
  "pub const OP_CONNECT: u8 = "; n.toText p.opConnect; ";\npub const OP_SEND: u8 = "; n.toText p.opSend; ";\npub const OP_RECV: u8 = "; n.toText p.opRecv; ";\npub const OP_CLOSE: u8 = "; n.toText p.opClose; ";\npub const OP_LISTEN: u8 = "; n.toText p.opListen; ";\npub const OP_ACCEPT: u8 = "; n.toText p.opAccept; ";\npub const OP_RESOLVE: u8 = "; n.toText p.opResolve; ";\n";
  "pub const TRANSPORT_NONE: u8 = "; n.toText p.transportNone; ";\npub const TRANSPORT_TCP: u8 = "; n.toText p.transportTcp; ";\npub const TRANSPORT_UDP: u8 = "; n.toText p.transportUdp; ";\n";
  "pub const ADDRESS_NONE: u8 = "; n.toText p.addressNone; ";\npub const ADDRESS_IPV4: u8 = "; n.toText p.addressIpv4; ";\npub const ADDRESS_IPV6: u8 = "; n.toText p.addressIpv6; ";\npub const ADDRESS_DNS: u8 = "; n.toText p.addressDns; ";\n";
  "pub const CAPABILITY_NONE: u8 = "; n.toText p.capabilityNone; ";\npub const CAPABILITY_TCP_CONNECTION: u8 = "; n.toText p.capabilityTcpConnection; ";\npub const CAPABILITY_UDP_ENDPOINT: u8 = "; n.toText p.capabilityUdpEndpoint; ";\npub const CAPABILITY_TCP_LISTENER: u8 = "; n.toText p.capabilityTcpListener; ";\npub const CAPABILITY_DNS_RECORD: u8 = "; n.toText p.capabilityDnsRecord; ";\n";
  "pub const FLAG_NONBLOCKING: u32 = "; n.toText p.flagNonblocking; ";\npub const KNOWN_REQUEST_FLAGS: u32 = "; n.toText p.knownRequestFlags; ";\npub const FLAG_END_OF_STREAM: u32 = "; n.toText p.flagEndOfStream; ";\npub const KNOWN_COMPLETION_FLAGS: u32 = "; n.toText p.knownCompletionFlags; ";\n\n";
  "pub const LOAN_BYTES: usize = "; n.toText p.loanBytes; ";\n";
  "pub const LOAN_ROLE_RING: u8 = "; n.toText p.loanRoleRing; ";\n";
  "pub const LOAN_ROLE_DATA: u8 = "; n.toText p.loanRoleData; ";\n";
  "pub const QUEUE_SLOTS: usize = "; n.toText p.queueSlots; ";\n";
  "pub const RING_PAGES: usize = "; n.toText p.ringPages; ";\n";
  "pub const DATA_PAGES: usize = "; n.toText p.dataPages; ";\n";
  "pub const RING_BYTES: usize = "; n.toText p.ringBytes; ";\n";
  "pub const DATA_BYTES: usize = "; n.toText p.dataBytes; ";\n";
  "pub const OP_ATTACH: u8 = "; n.toText p.opAttach; ";\n";
  "pub const OP_ABORT: u8 = "; n.toText p.opAbort; ";\n";
  "pub const OP_SHUTDOWN: u8 = "; n.toText p.opShutdown; ";\n";
  "pub const STATUS_SUCCESS: i32 = "; n.toText p.statusSuccess; ";\n";
  "pub const STATUS_DENIED: i32 = "; n.toText p.statusDenied; ";\n";
  "pub const STATUS_MALFORMED: i32 = "; n.toText p.statusMalformed; ";\n";
  "pub const STATUS_UNSUPPORTED: i32 = "; n.toText p.statusUnsupported; ";\n";
  "pub const STATUS_WOULD_BLOCK: i32 = "; n.toText p.statusWouldBlock; ";\n";
  "pub const STATUS_EXHAUSTED: i32 = "; n.toText p.statusExhausted; ";\n";
  "pub const STATUS_REFUSED: i32 = "; n.toText p.statusRefused; ";\n";
  "pub const STATUS_TIMEOUT: i32 = "; n.toText p.statusTimeout; ";\n";
  "pub const STATUS_RESET: i32 = "; n.toText p.statusReset; ";\n";
  "pub const LAUNCH_BYTES: usize = "; n.toText p.launchBytes; ";\n";
  "pub const LAUNCH_PAYLOAD_BYTES: usize = "; n.toText p.launchPayloadBytes; ";\n";
  "pub const LAUNCH_URL_BYTES: usize = "; n.toText p.launchUrlBytes; ";\n";
  "pub const LAUNCH_SEED: u8 = "; n.toText p.launchSeed; ";\n";
  "pub const LAUNCH_URL: u8 = "; n.toText p.launchUrl; ";\n";
  offsetConsts "LAUNCH" 0 p.launchLayout; "\n"; wireStruct "WireNetworkLaunch" "LAUNCH" "LAUNCH_BYTES" p.launchLayout; "\n";
  offsetConsts "LOAN" 0 p.loanLayout; "\n"; wireStruct "WireNetworkLoan" "LOAN" "LOAN_BYTES" p.loanLayout; "\n";
  offsetConsts "REQUEST" 0 p.requestLayout; "\n"; wireStruct "WireNetworkRequest" "REQUEST" "REQUEST_BYTES" p.requestLayout; "\n";
  offsetConsts "COMPLETION" 0 p.completionLayout; "\n"; wireStruct "WireNetworkCompletion" "COMPLETION" "COMPLETION_BYTES" p.completionLayout;
};

valid :: Protocol -> Bool = p =>
  w.schemaFieldsValid p.requestFields
    && w.schemaFieldsValid p.completionFields
    && w.schemaNames p.requestFields == layoutNames p.requestLayout
    && w.schemaNames p.completionFields == layoutNames p.completionLayout
    && allValid p.requestLayout
    && allValid p.completionLayout
    && wireBytes p.requestLayout == p.requestBytes
    && wireBytes p.completionLayout == p.completionBytes
    && w.schemaFieldsValid p.loanFields
    && w.schemaNames p.loanFields == layoutNames p.loanLayout
    && allValid p.loanLayout
    && wireBytes p.loanLayout == p.loanBytes
    && p.loanBytes == 64
    && w.schemaFieldsValid p.launchFields
    && w.schemaNames p.launchFields == layoutNames p.launchLayout
    && allValid p.launchLayout
    && wireBytes p.launchLayout == p.launchBytes
    && p.launchBytes == 64
    && p.launchPayloadBytes == 48
    && p.launchUrlBytes == 2048
    && p.maxNameBytes <= 24;
pythonBindings :: Protocol -> Text = p => w.join {
  "# @generated by contracts/network-service/v1/gen_rust.zt; do not edit.\nimport struct\n\n";
  "NETWORK_MAGIC = "; n.toText p.networkMagic; "\nFORMAT_VERSION = "; n.toText p.formatVersion; "\n";
  "LAUNCH_BYTES = "; n.toText p.launchBytes; "\nLAUNCH_PAYLOAD_BYTES = "; n.toText p.launchPayloadBytes; "\nLAUNCH_URL_BYTES = "; n.toText p.launchUrlBytes; "\n";
  "LAUNCH_SEED = "; n.toText p.launchSeed; "\nLAUNCH_URL = "; n.toText p.launchUrl; "\n";
  py.renderRecords { { pythonName = "NETWORK_LAUNCH"; constPrefix = "NETWORK_LAUNCH"; size = p.launchBytes; trailingPadding = 0; fields = p.launchFields; layout = p.launchLayout; }; };
};
render :: Protocol -> { rust : Text; python : Text; } = p => if valid p then { rust = rustBindings p; python = pythonBindings p; } else { rust = "INVALID_NETWORK_SERVICE_SCHEMA"; python = "INVALID_NETWORK_SERVICE_SCHEMA"; };
{ render =; }
