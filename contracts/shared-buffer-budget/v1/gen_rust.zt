-- Schema-reflected Python + Rust renderer for shared-buffer-budget/v1.
-- Shared struct.Struct mechanics live in the `wire.python` package module;
-- shared Rust scalar-const mechanics live in `wire.rust`.

refl ::= import stdlib.reflect;
n ::= import stdlib.num;
w ::= import wire.python;
r ::= import wire.rust;

Format :: type {
  formatVersion : Int;
  headerBytes : Int;
  entryBytes : Int;
  maxHolders : Int;
  headerFields : List refl.SchemaField;
  entryFields : List refl.SchemaField;
  headerLayout : List w.WireField;
  entryLayout : List w.WireField;
};

records :: Format -> List w.WireRecord = format => {
  { pythonName = "SHARED_BUFFER_BUDGET_HEADER"; constPrefix = "SHARED_BUFFER_BUDGET"; size = format.headerBytes; trailingPadding = 0; fields = format.headerFields; layout = format.headerLayout; };
  { pythonName = "SHARED_BUFFER_BUDGET_ENTRY"; constPrefix = "SHARED_BUFFER_BUDGET_ENTRY"; size = format.entryBytes; trailingPadding = 0; fields = format.entryFields; layout = format.entryLayout; };
};

pythonBindings :: Format -> Text = format => w.join {
  "SHARED_BUFFER_BUDGET_MAGIC = b\"SLIMESB\\0\"\n";
  "SHARED_BUFFER_BUDGET_VERSION = "; n.toText format.formatVersion; "\n";
  "SHARED_BUFFER_BUDGET_HEADER_BYTES = "; n.toText format.headerBytes; "\n";
  "SHARED_BUFFER_BUDGET_ENTRY_BYTES = "; n.toText format.entryBytes; "\n";
  "MAX_SHARED_BUFFER_BUDGET_HOLDERS = "; n.toText format.maxHolders; "\n";
  w.renderRecords (records format);
};

-- Schema-owned scalars shared with boot-contracts/src/shared_buffer_budget.rs.
-- The magic tag, derived MAX_BYTES, and decode machinery stay hand-written in
-- that module.
rustBindings :: Format -> Text = format => r.join {
  "// @generated by contracts/shared-buffer-budget/v1/gen_rust.zt; do not edit.\n";
  "// Source contract: contracts/shared-buffer-budget/v1/schema.zt\n\n";
  r.u32Const "FORMAT_VERSION" format.formatVersion;
  r.usizeConst "HEADER_BYTES" format.headerBytes;
  r.usizeConst "ENTRY_BYTES" format.entryBytes;
  r.usizeConst "MAX_HOLDERS" format.maxHolders;
};

render :: Format -> { python : Text; rust : Text; }
  = format => if w.recordsValid (records format)
    then { python = pythonBindings format; rust = rustBindings format; }
    else { python = "INVALID_SHARED_BUFFER_BUDGET_SCHEMA"; rust = "INVALID_SHARED_BUFFER_BUDGET_SCHEMA"; };
{ render = render; }
