schema ::= import "schema.zt";
env ::= import stdlib.env;
fs ::= import stdlib.fs;
n ::= import stdlib.num;
t ::= import stdlib.text;

line :: Text -> Int -> Text
  = name value => t.join "" { name; " = "; n.toText value; "\n"; };

render :: Text = t.join "" {
  "# @generated by contracts/system-image-closure/v3/gen_python.zt; do not edit.\n";
  line "FORMAT_VERSION" schema.formatVersion;
  line "MAX_SOURCE_BYTES" schema.maxSourceBytes;
};

main :: { write : FsWrite; env : Env; }
  -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_SYSTEM_IMAGE_CLOSURE_SOURCE_BINDINGS_ROOT" ?? ".";
    path := t.join "" { root; "/system_image_closure_source_contract.py"; };
    fs.writeAll caps.write path render
  ];

main
