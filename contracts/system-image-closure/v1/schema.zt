-- Slime OS canonical system-image closure contract, version 1 (CP11).
--
-- A closure names every identity-bearing input to one bootable image build. It
-- references the logical system and immutable build inputs instead of copying
-- their records. Paths are normalized, closure-relative locators; their bytes
-- are never trusted without the recorded identity.
ArtifactReference :: type {
  path : Text;
  kind : Text;
  identity : Text;
};

-- Which implementation a composition selects for one component, and under
-- which build profile.
--
-- `buildProfile` is the executable-changing scenario selector. Several planes
-- need one component compiled to behave differently — a proxy that dies
-- mid-route, a publisher that ends its stream early, a staging client that
-- expects a specific refusal — and each is a `option_env!` knob the component
-- reads at compile time, so it changes that component's ELF bytes. Before
-- CP14 the knobs arrived as ambient `SLIME_*` variables set per variant by
-- `build-sel4.py`, which meant the ELF a closure named and the ELF a build
-- produced could differ with nothing in the identity to say so.
--
-- Closed to the profiles below. `default` is the ordinary build every product
-- closure uses; the rest are test-only and each maps to exactly one knob that
-- exactly one set of components reads:
--
--   `proxyEarlyExit`         -- `SLIME_FABRIC_PROXY_EARLY_EXIT`: the route
--                               interposition hop dies mid-route, so the graph
--                               must degrade rather than tolerate a task it
--                               stopped tracking.
--   `streamEarlyExit`        -- `SLIME_FABRIC_STREAM_EARLY_EXIT`: a publisher
--                               dies mid-stream, which must stay distinct from
--                               an orderly `FLAG_LAST` end.
--   `generationCmdBadClosure`-- `SLIME_GENERATION_CMD_SCENARIO=bad-closure`:
--                               the staging client expects the object-closure
--                               refusal rather than success.
--   `generationCmdBadRelease`-- `SLIME_GENERATION_CMD_SCENARIO=bad-release`:
--                               the same client expects the release-signature
--                               refusal.
--   `bootSelectionFail`      -- `SLIME_BOOT_SELECTION_FAIL`: init reports
--                               unhealthy so the selector must roll back.
--   `recoveryImage`          -- `SLIME_RECOVERY_IMAGE`: the recovery build of
--                               the graph.
--
-- A profile is per implementation rather than per closure because exactly one
-- component's bytes change: naming it on the closure would make every other
-- component's ELF look scenario-dependent when it is not.
ImplementationSelection :: type {
  component : Text;
  provider : Text;
  artifact : ArtifactReference;
  identity : Text;
  buildProfile : Text;
};

buildProfileDefault :: Text = "default";
buildProfileProxyEarlyExit :: Text = "proxyEarlyExit";
buildProfileStreamEarlyExit :: Text = "streamEarlyExit";
buildProfileGenerationCmdBadClosure :: Text = "generationCmdBadClosure";
buildProfileGenerationCmdBadRelease :: Text = "generationCmdBadRelease";
buildProfileBootSelectionFail :: Text = "bootSelectionFail";
buildProfileRecoveryImage :: Text = "recoveryImage";

TargetSelection :: type {
  profile : Text;
  platform : Text;
  sdkRelease : ArtifactReference;
  prefix : ArtifactReference;
  toolchain : Text;
  rustSel4Commit : Text;
};

BuildRole :: type {
  role : Text;
  implementation : ArtifactReference;
  parameters : List Text;
};

NamedInput :: type {
  name : Text;
  artifact : ArtifactReference;
};

-- One normalized build parameter: a value that changes generation or
-- executable bytes and is therefore part of the closure identity.
--
-- CP14's reason for existing. Three deltas used to reach the generation
-- builder as ambient environment variables — `SLIME_GENERATION_NUMBER`,
-- `SLIME_FABRIC_LIMIT_OVERRIDE`, `SLIME_FABRIC_QOS_OVERRIDE` — set from a
-- per-variant table in `build-sel4.py`. Each changes what the generation
-- encodes, so a build key that omitted them described a different build than
-- the one that ran, and two closures differing only in a saturation ceiling
-- computed one identity.
--
-- `name` is closed to the three below, so a fourth ambient knob cannot appear
-- here without a contract change, and the resolver refuses any name outside
-- the set:
--
--   `generationNumber`   -- the generation number the manifest is built with,
--                           overriding what the system spec declares. A
--                           positive decimal integer.
--   `fabricLimitOverride`-- one declared `fabricGraph.limits` ceiling,
--                           narrowed for this build. `<limit>=<value>`, and
--                           the limit must already exist in the graph.
--   `fabricQosOverride`  -- one declared participant QoS field, changed for
--                           this build. `<route>:<component>:<field>:<value>`,
--                           and every part must resolve against the declared
--                           graph.
--
-- The value stays `Text` rather than a union because each parameter's own
-- grammar differs and the generation builder is the authority that parses it;
-- what this contract owns is that the value is *in the identity*.
BuildParameter :: type {
  name : Text;
  value : Text;
};

parameterGenerationNumber :: Text = "generationNumber";
parameterFabricLimitOverride :: Text = "fabricLimitOverride";
parameterFabricQosOverride :: Text = "fabricQosOverride";

SystemImageClosure :: type {
  formatVersion : Int;
  name : Text;
  systemSpec : ArtifactReference;
  systemIdentity : Text;
  implementations : List ImplementationSelection;
  target : TargetSelection;
  root : BuildRole;
  loader : BuildRole;
  releaseInputs : List NamedInput;
  buildParameters : List BuildParameter;
  expectedOutputs : List Text;
};

ResultArtifact :: type {
  path : Text;
  bytes : Int;
  sha256 : Text;
};

SystemImageBuildResult :: type {
  formatVersion : Int;
  closureIdentity : Text;
  systemIdentity : Text;
  targetProfile : Text;
  platform : Text;
  rootRole : Text;
  loaderRole : Text;
  generation : ResultArtifact;
  root : ResultArtifact;
  loader : ResultArtifact;
  image : ResultArtifact;
  identityManifest : ResultArtifact;
};

FromData @ArtifactReference :: derive
FromData @ImplementationSelection :: derive
FromData @TargetSelection :: derive
FromData @BuildRole :: derive
FromData @NamedInput :: derive
FromData @BuildParameter :: derive
FromData @SystemImageClosure :: derive
FromData @ResultArtifact :: derive
FromData @SystemImageBuildResult :: derive

formatVersion :: Int = 1;
identityDomain :: Text = "slime-system-image-closure-v1:";
buildResultIdentityDomain :: Text = "slime-system-image-build-result-v1:";

artifactKindFile :: Text = "file";
artifactKindTree :: Text = "tree";
providerWorkspace :: Text = "workspace";
providerExternal :: Text = "external";
rootRoleEmbeddedGeneration :: Text = "embedded-generation";
rootRoleBootSelector :: Text = "boot-selector";
loaderRoleKernelLoader :: Text = "kernel-loader";

outputGeneration :: Text = "generation";
outputRoot :: Text = "root";
outputLoader :: Text = "loader";
outputImage :: Text = "image";
outputIdentityManifest :: Text = "identity-manifest";

maxSourceBytes :: Int = 262144;
maxNormalizedBytes :: Int = 262144;
maxNameBytes :: Int = 96;
maxPathBytes :: Int = 256;
maxTextBytes :: Int = 256;
maxDigestBytes :: Int = 64;
maxImplementations :: Int = 64;
maxReleaseInputs :: Int = 32;
maxBuildParameters :: Int = 32;
maxRoleParameters :: Int = 16;
maxOutputs :: Int = 8;

decodeSystemImageClosure :: Data -> Validation DecodeIssue SystemImageClosure
  = data => decode data;

decodeSystemImageBuildResult :: Data -> Validation DecodeIssue SystemImageBuildResult
  = data => decode data;
{
  ArtifactReference =;
  ImplementationSelection =;
  TargetSelection =;
  BuildRole =;
  NamedInput =;
  BuildParameter =;
  SystemImageClosure =;
  ResultArtifact =;
  SystemImageBuildResult =;
  decodeSystemImageClosure =;
  decodeSystemImageBuildResult =;
  formatVersion =;
  identityDomain =;
  buildResultIdentityDomain =;
  artifactKindFile =;
  artifactKindTree =;
  providerWorkspace =;
  providerExternal =;
  buildProfileDefault =;
  buildProfileProxyEarlyExit =;
  buildProfileStreamEarlyExit =;
  buildProfileGenerationCmdBadClosure =;
  buildProfileGenerationCmdBadRelease =;
  buildProfileBootSelectionFail =;
  buildProfileRecoveryImage =;
  rootRoleEmbeddedGeneration =;
  rootRoleBootSelector =;
  loaderRoleKernelLoader =;
  parameterGenerationNumber =;
  parameterFabricLimitOverride =;
  parameterFabricQosOverride =;
  outputGeneration =;
  outputRoot =;
  outputLoader =;
  outputImage =;
  outputIdentityManifest =;
  maxSourceBytes =;
  maxNormalizedBytes =;
  maxNameBytes =;
  maxPathBytes =;
  maxTextBytes =;
  maxDigestBytes =;
  maxImplementations =;
  maxReleaseInputs =;
  maxBuildParameters =;
  maxRoleParameters =;
  maxOutputs =;
}
