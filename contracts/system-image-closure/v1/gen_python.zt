schema ::= import "schema.zt";
env ::= import stdlib.env;
fs ::= import stdlib.fs;
n ::= import stdlib.num;
t ::= import stdlib.text;

line :: Text -> Int -> Text
  = name value => t.join "" { name; " = "; n.toText value; "\n"; };
text :: Text -> Text -> Text
  = name value => t.join "" { name; " = "; t.show value; "\n"; };
textTuple :: List Text -> Text
  = values => match values {
    | {;} => "";
    | { entry; ...rest } => t.join "" { t.show entry; ", "; textTuple rest; };
  };
tuple :: Text -> List Text -> Text
  = name values => t.join "" { name; " = ("; textTuple values; ")\n"; };

render :: Text = t.join "" {
  "# @generated by contracts/system-image-closure/v1/gen_python.zt; do not edit.\n";
  line "FORMAT_VERSION" schema.formatVersion;
  "IDENTITY_DOMAIN = "; t.show schema.identityDomain; ".encode(\"utf-8\")\n";
  "BUILD_RESULT_IDENTITY_DOMAIN = "; t.show schema.buildResultIdentityDomain; ".encode(\"utf-8\")\n";
  tuple "ARTIFACT_KINDS" { schema.artifactKindFile; schema.artifactKindTree; };
  tuple "PROVIDERS" { schema.providerWorkspace; schema.providerExternal; };
  text "PROVIDER_WORKSPACE" schema.providerWorkspace;
  text "PROVIDER_EXTERNAL" schema.providerExternal;
  "NEGATIVE_IDENTITY_DOMAIN = "; t.show schema.negativeIdentityDomain; ".encode(\"utf-8\")\n";
  tuple "MUTATIONS" {
    schema.mutationMissing;
    schema.mutationExtra;
    schema.mutationAliased;
    schema.mutationWrongSlot;
    schema.mutationWrongType;
    schema.mutationWrongRights;
  };
  tuple "BUILD_PROFILES" {
    schema.buildProfileDefault;
    schema.buildProfileProxyEarlyExit;
    schema.buildProfileStreamEarlyExit;
    schema.buildProfileGenerationCmdBadClosure;
    schema.buildProfileGenerationCmdBadRelease;
    schema.buildProfileBootSelectionFail;
    schema.buildProfileRecoveryImage;
  };
  text "BUILD_PROFILE_DEFAULT" schema.buildProfileDefault;
  text "BUILD_PROFILE_PROXY_EARLY_EXIT" schema.buildProfileProxyEarlyExit;
  text "BUILD_PROFILE_STREAM_EARLY_EXIT" schema.buildProfileStreamEarlyExit;
  text "BUILD_PROFILE_GENERATION_CMD_BAD_CLOSURE" schema.buildProfileGenerationCmdBadClosure;
  text "BUILD_PROFILE_GENERATION_CMD_BAD_RELEASE" schema.buildProfileGenerationCmdBadRelease;
  text "BUILD_PROFILE_BOOT_SELECTION_FAIL" schema.buildProfileBootSelectionFail;
  text "BUILD_PROFILE_RECOVERY_IMAGE" schema.buildProfileRecoveryImage;
  tuple "ROOT_ROLES" {
    schema.rootRoleEmbeddedGeneration;
    schema.rootRoleBootSelector;
    schema.rootRoleFixture;
    schema.rootRoleReclamationUnwind;
  };
  text "ROOT_ROLE_EMBEDDED_GENERATION" schema.rootRoleEmbeddedGeneration;
  text "ROOT_ROLE_BOOT_SELECTOR" schema.rootRoleBootSelector;
  text "ROOT_ROLE_FIXTURE" schema.rootRoleFixture;
  text "ROOT_ROLE_RECLAMATION_UNWIND" schema.rootRoleReclamationUnwind;
  tuple "ROOT_PARAMETERS" {
    schema.rootParameterQemuKeyboard;
    schema.rootParameterDuoTestTerminator;
  };
  text "ROOT_PARAMETER_QEMU_KEYBOARD" schema.rootParameterQemuKeyboard;
  text "ROOT_PARAMETER_DUO_TEST_TERMINATOR" schema.rootParameterDuoTestTerminator;
  tuple "LOADER_ROLES" { schema.loaderRoleKernelLoader; };
  text "LOADER_ROLE_KERNEL_LOADER" schema.loaderRoleKernelLoader;
  tuple "BUILD_PARAMETERS" {
    schema.parameterGenerationNumber;
    schema.parameterFabricLimitOverride;
    schema.parameterFabricQosOverride;
  };
  text "PARAMETER_GENERATION_NUMBER" schema.parameterGenerationNumber;
  text "PARAMETER_FABRIC_LIMIT_OVERRIDE" schema.parameterFabricLimitOverride;
  text "PARAMETER_FABRIC_QOS_OVERRIDE" schema.parameterFabricQosOverride;
  tuple "OUTPUT_CLASSES" {
    schema.outputGeneration;
    schema.outputRoot;
    schema.outputLoader;
    schema.outputImage;
    schema.outputIdentityManifest;
  };
  line "MAX_SOURCE_BYTES" schema.maxSourceBytes;
  line "MAX_NORMALIZED_BYTES" schema.maxNormalizedBytes;
  line "MAX_NAME_BYTES" schema.maxNameBytes;
  line "MAX_PATH_BYTES" schema.maxPathBytes;
  line "MAX_TEXT_BYTES" schema.maxTextBytes;
  line "MAX_DIGEST_BYTES" schema.maxDigestBytes;
  line "MAX_IMPLEMENTATIONS" schema.maxImplementations;
  line "MAX_RELEASE_INPUTS" schema.maxReleaseInputs;
  line "MAX_BUILD_PARAMETERS" schema.maxBuildParameters;
  line "MAX_ROLE_PARAMETERS" schema.maxRoleParameters;
  line "MAX_OUTPUTS" schema.maxOutputs;
};

main :: { write : FsWrite; env : Env; }
  -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_SYSTEM_IMAGE_CLOSURE_BINDINGS_ROOT" ?? ".";
    path := t.join "" { root; "/system_image_closure_contract.py"; };
    fs.writeAll caps.write path render
  ];

main
