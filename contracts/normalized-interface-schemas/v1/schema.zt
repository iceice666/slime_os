-- Deterministic normalized interface-schema corpus, version 1 (C8.9).
--
-- The artifact preserves the exact C8.1 normalized bytes for the schemas in one
-- resolved fabric graph, ordered by full interface identity. It is a derived
-- build artifact: the source schemas remain the authoritative declarations.

env ::= import stdlib.env;
fs ::= import stdlib.fs;
gen ::= import "gen_rust.zt";
t ::= import stdlib.text;

formatVersion :: Int = 1;
headerBytes :: Int = 32;
entryBytes :: Int = 40;
maxSchemas :: Int = 64;
maxArtifactBytes :: Int = 4194304;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

NormalizedSchemasHeader :: type {
  magic : Int;
  format_version : Int;
  header_size : Int;
  required_flags : Int;
  schema_count : Int;
  total_len : Int;
};

NormalizedSchemaEntry :: type {
  identity : Int;
  normalized_len : Int;
  reserved : Int;
};

headerSchema ::= schema NormalizedSchemasHeader;
entrySchema ::= schema NormalizedSchemaEntry;

headerLayout :: List WireField = {
  { name = "magic"; width = 8; signed = false; byteArray = true; };
  { name = "format_version"; width = 4; signed = false; byteArray = false; };
  { name = "header_size"; width = 4; signed = false; byteArray = false; };
  { name = "required_flags"; width = 8; signed = false; byteArray = false; };
  { name = "schema_count"; width = 4; signed = false; byteArray = false; };
  { name = "total_len"; width = 4; signed = false; byteArray = false; };
};

entryLayout :: List WireField = {
  { name = "identity"; width = 32; signed = false; byteArray = true; };
  { name = "normalized_len"; width = 4; signed = false; byteArray = false; };
  { name = "reserved"; width = 4; signed = false; byteArray = false; };
};

format ::= {
  formatVersion =;
  headerBytes =;
  entryBytes =;
  maxSchemas =;
  maxArtifactBytes =;
  headerFields = headerSchema.fields ?? {;};
  entryFields = entrySchema.fields ?? {;};
  headerLayout =;
  entryLayout =;
};

main :: { write : FsWrite; env : Env; } -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_BOOT_BINDINGS_ROOT" ?? ".";
    bindings := gen.render format;
    pythonPath := t.join "" { root; "/normalized_interface_schemas.py"; };
    rustPath := t.join "" { root; "/normalized_interface_schemas.rs"; };
    fs.writeAll caps.write pythonPath bindings.python;
    fs.writeAll caps.write rustPath bindings.rust
  ];

main
