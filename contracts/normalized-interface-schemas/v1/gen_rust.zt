-- Schema-reflected Python + Rust renderer for normalized-interface-schemas/v1.
refl ::= import stdlib.reflect;
n ::= import stdlib.num;
w ::= import wire.python;
r ::= import wire.rust;

Format :: type {
  formatVersion : Int;
  headerBytes : Int;
  entryBytes : Int;
  maxSchemas : Int;
  maxArtifactBytes : Int;
  headerFields : List refl.SchemaField;
  entryFields : List refl.SchemaField;
  headerLayout : List w.WireField;
  entryLayout : List w.WireField;
};

records :: Format -> List w.WireRecord = format => {
  { pythonName = "NORMALIZED_SCHEMAS_HEADER"; constPrefix = "NORMALIZED_SCHEMAS_HEADER"; size = format.headerBytes; trailingPadding = 0; fields = format.headerFields; layout = format.headerLayout; };
  { pythonName = "NORMALIZED_SCHEMAS_ENTRY"; constPrefix = "NORMALIZED_SCHEMAS_ENTRY"; size = format.entryBytes; trailingPadding = 0; fields = format.entryFields; layout = format.entryLayout; };
};

pythonBindings :: Format -> Text = format => w.join {
  "NORMALIZED_SCHEMAS_MAGIC = b\"SLIMENS\\0\"\n";
  "NORMALIZED_SCHEMAS_VERSION = "; n.toText format.formatVersion; "\n";
  "NORMALIZED_SCHEMAS_HEADER_BYTES = "; n.toText format.headerBytes; "\n";
  "NORMALIZED_SCHEMAS_ENTRY_BYTES = "; n.toText format.entryBytes; "\n";
  "MAX_NORMALIZED_SCHEMAS = "; n.toText format.maxSchemas; "\n";
  "MAX_NORMALIZED_SCHEMAS_ARTIFACT_BYTES = "; n.toText format.maxArtifactBytes; "\n";
  w.renderRecords (records format);
};

rustBindings :: Format -> Text = format => r.join {
  "// @generated by contracts/normalized-interface-schemas/v1/gen_rust.zt; do not edit.\n";
  "// Source contract: contracts/normalized-interface-schemas/v1/schema.zt\n\n";
  r.u32Const "FORMAT_VERSION" format.formatVersion;
  r.usizeConst "HEADER_BYTES" format.headerBytes;
  r.usizeConst "ENTRY_BYTES" format.entryBytes;
  r.usizeConst "MAX_SCHEMAS" format.maxSchemas;
  r.usizeConst "MAX_ARTIFACT_BYTES" format.maxArtifactBytes;
};

render :: Format -> { python : Text; rust : Text; }
  = format => if w.recordsValid (records format)
    then { python = pythonBindings format; rust = rustBindings format; }
    else { python = "INVALID_NORMALIZED_SCHEMAS_SCHEMA"; rust = "INVALID_NORMALIZED_SCHEMAS_SCHEMA"; };
{ render = render; }
