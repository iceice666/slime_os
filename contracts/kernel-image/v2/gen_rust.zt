-- Schema-reflected Python + Rust renderer for kernel-image/v2.
-- Shared struct.Struct mechanics live in the `wire.python` package module;
-- shared Rust scalar-const mechanics live in `wire.rust`.

refl ::= import stdlib.reflect;
n ::= import stdlib.num;
w ::= import wire.python;
r ::= import wire.rust;

Format :: type {
  formatVersion : Int; kernelAbiVersion : Int; headerLen : Int; segmentLen : Int; relocationLen : Int;
  maxImageBytes : Int; maxSegments : Int; maxRelocations : Int; preferredBaseText : Text; loadBaseText : Text;
  segmentWrite : Int; segmentExec : Int; legacyFormatVersion : Int; legacyHeaderLen : Int;
  headerFields : List refl.SchemaField; segmentFields : List refl.SchemaField;
  relocationFields : List refl.SchemaField; headerLayout : List w.WireField; segmentLayout : List w.WireField; relocationLayout : List w.WireField;
};

records :: Format -> List w.WireRecord = format => {
  { pythonName = "KERNEL_HEADER"; constPrefix = "KERNEL_HEADER"; size = format.headerLen; trailingPadding = 0; fields = format.headerFields; layout = format.headerLayout; };
  { pythonName = "KERNEL_SEGMENT"; constPrefix = "KERNEL_SEGMENT"; size = format.segmentLen; trailingPadding = 0; fields = format.segmentFields; layout = format.segmentLayout; };
  { pythonName = "KERNEL_RELOCATION"; constPrefix = "KERNEL_RELOCATION"; size = format.relocationLen; trailingPadding = 0; fields = format.relocationFields; layout = format.relocationLayout; };
};
pythonBindings :: Format -> Text = format => w.join {
  "KERNEL_MAGIC = b\"SLIMEKR2\"\n"; "KERNEL_LEGACY_MAGIC = b\"SLIMEKRN\"\n";
  "KERNEL_VERSION = "; n.toText format.formatVersion; "\n";
  "KERNEL_LEGACY_VERSION = "; n.toText format.legacyFormatVersion; "\n";
  "KERNEL_LEGACY_HEADER_LEN = "; n.toText format.legacyHeaderLen; "\n";
  "KERNEL_ABI_VERSION = "; n.toText format.kernelAbiVersion; "\n";
  w.renderRecords (records format);
  "KERNEL_PREFERRED_BASE = "; format.preferredBaseText; "\n"; "KERNEL_LOAD_BASE = "; format.loadBaseText; "\n";
  "MAX_KERNEL_IMAGE_BYTES = "; n.toText format.maxImageBytes; "\n"; "MAX_KERNEL_SEGMENTS = "; n.toText format.maxSegments; "\n"; "MAX_KERNEL_RELOCATIONS = "; n.toText format.maxRelocations; "\n";
  "SEGMENT_WRITE = "; n.toText format.segmentWrite; "\n"; "SEGMENT_EXEC = "; n.toText format.segmentExec; "\n";
};

-- Schema-owned scalar constants shared with boot-contracts/src/kernel_image.rs.
-- The magic tags and decode/impl machinery stay hand-written in that module.
rustBindings :: Format -> Text = format => r.join {
  "// @generated by contracts/kernel-image/v2/gen_rust.zt; do not edit.\n";
  "// Source contract: contracts/kernel-image/v2/schema.zt\n\n";
  r.u32Const "FORMAT_VERSION" format.formatVersion;
  r.u32Const "LEGACY_FORMAT_VERSION" format.legacyFormatVersion;
  r.usizeConst "LEGACY_HEADER_LEN" format.legacyHeaderLen;
  r.u32Const "KERNEL_ABI_VERSION" format.kernelAbiVersion;
  r.usizeConst "HEADER_LEN" format.headerLen;
  r.usizeConst "SEGMENT_LEN" format.segmentLen;
  r.usizeConst "RELOCATION_LEN" format.relocationLen;
  r.u64Const "MAX_IMAGE_BYTES" format.maxImageBytes;
  r.usizeConst "MAX_SEGMENTS" format.maxSegments;
  r.usizeConst "MAX_RELOCATIONS" format.maxRelocations;
  r.u64TextConst "LOAD_BASE" format.loadBaseText;
  r.u64TextConst "PREFERRED_BASE" format.preferredBaseText;
  r.u32Const "SEGMENT_WRITE" format.segmentWrite;
  r.u32Const "SEGMENT_EXEC" format.segmentExec;
  "\n";
  r.usizeConst "OFF_HEADER_MAGIC" (w.fieldOffset "magic" 0 format.headerLayout);
  r.usizeConst "OFF_HEADER_FORMAT_VERSION" (w.fieldOffset "format_version" 0 format.headerLayout);
  r.usizeConst "OFF_HEADER_HEADER_SIZE" (w.fieldOffset "header_size" 0 format.headerLayout);
  r.usizeConst "OFF_HEADER_KERNEL_ABI" (w.fieldOffset "kernel_abi" 0 format.headerLayout);
  r.usizeConst "OFF_HEADER_REQUIRED_FLAGS" (w.fieldOffset "required_flags" 0 format.headerLayout);
  r.usizeConst "OFF_HEADER_ARCHITECTURE" (w.fieldOffset "architecture" 0 format.headerLayout);
  r.usizeConst "OFF_HEADER_ABI" (w.fieldOffset "abi" 0 format.headerLayout);
  r.usizeConst "OFF_HEADER_PAGE_PROFILE" (w.fieldOffset "page_profile" 0 format.headerLayout);
  r.usizeConst "OFF_HEADER_TARGET_PROFILE" (w.fieldOffset "target_profile" 0 format.headerLayout);
  r.usizeConst "OFF_HEADER_REQUIRED_FEATURES" (w.fieldOffset "required_features" 0 format.headerLayout);
  r.usizeConst "OFF_HEADER_PREFERRED_BASE" (w.fieldOffset "preferred_base" 0 format.headerLayout);
  r.usizeConst "OFF_HEADER_ENTRY_OFFSET" (w.fieldOffset "entry_offset" 0 format.headerLayout);
  r.usizeConst "OFF_HEADER_SEGMENT_COUNT" (w.fieldOffset "segment_count" 0 format.headerLayout);
  r.usizeConst "OFF_HEADER_RELOCATION_COUNT" (w.fieldOffset "relocation_count" 0 format.headerLayout);
  r.usizeConst "OFF_HEADER_PAYLOAD_OFFSET" (w.fieldOffset "payload_offset" 0 format.headerLayout);
  r.usizeConst "OFF_HEADER_TOTAL_LEN" (w.fieldOffset "total_len" 0 format.headerLayout);
  "\n";
  r.usizeConst "OFF_SEGMENT_VADDR_OFFSET" (w.fieldOffset "vaddr_offset" 0 format.segmentLayout);
  r.usizeConst "OFF_SEGMENT_MEM_LEN" (w.fieldOffset "mem_len" 0 format.segmentLayout);
  r.usizeConst "OFF_SEGMENT_FILE_OFFSET" (w.fieldOffset "file_offset" 0 format.segmentLayout);
  r.usizeConst "OFF_SEGMENT_FILE_LEN" (w.fieldOffset "file_len" 0 format.segmentLayout);
  r.usizeConst "OFF_SEGMENT_FLAGS" (w.fieldOffset "flags" 0 format.segmentLayout);
  r.usizeConst "OFF_SEGMENT_RESERVED" (w.fieldOffset "reserved" 0 format.segmentLayout);
  "\n";
  r.usizeConst "OFF_RELOCATION_TARGET_OFFSET" (w.fieldOffset "target_offset" 0 format.relocationLayout);
  r.usizeConst "OFF_RELOCATION_ADDEND" (w.fieldOffset "addend" 0 format.relocationLayout);
  "\n";
  "// Retained v1 header offsets. A v1 image is an `x86_64-qemu-virtio` image\n";
  "// whose target was implied by its builder, so its layout is pinned here\n";
  "// rather than derived: the rollback window must decode exactly the bytes\n";
  "// that were written, not whatever the current header happens to look like.\n";
  r.usizeConst "OFF_LEGACY_HEADER_PREFERRED_BASE" 24;
  r.usizeConst "OFF_LEGACY_HEADER_ENTRY_OFFSET" 32;
  r.usizeConst "OFF_LEGACY_HEADER_SEGMENT_COUNT" 40;
  r.usizeConst "OFF_LEGACY_HEADER_RELOCATION_COUNT" 44;
  r.usizeConst "OFF_LEGACY_HEADER_PAYLOAD_OFFSET" 48;
  r.usizeConst "OFF_LEGACY_HEADER_TOTAL_LEN" 56;
};

render :: Format -> { python : Text; rust : Text; }
  = format => if w.recordsValid (records format)
    then { python = pythonBindings format; rust = rustBindings format; }
    else { python = "INVALID_KERNEL_IMAGE_SCHEMA"; rust = "INVALID_KERNEL_IMAGE_SCHEMA"; };
{ render = render; }
