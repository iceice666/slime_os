-- Raspberry Pi 5 ROS 2 two-node demo acceptance contract, version 1 (RP0).
--
-- This is a host-side activation contract. It fixes the exact physical target,
-- DDS/ROS profile, workload, resource ceilings, authority inventory, evidence
-- trace, and operator markers that later implementation milestones must satisfy.

BoardProfile :: type {
  id : Text;
  model : Text;
  acceptedRevisionCodes : List Text;
  soc : Text;
  architecture : Text;
  abi : Text;
  pageProfile : Text;
  firmwareId : Text;
  bootFlow : Text;
  kernelPath : Text;
  configPath : Text;
  deviceTreePath : Text;
  mediaKind : Text;
  mediaLayout : Text;
  memoryMapSource : Text;
  interruptController : Text;
  genericTimer : Text;
  serialPath : Text;
  serialBaud : Int;
  requiredDevices : List Text;
};

RosProfile :: type {
  id : Text;
  distribution : Text;
  nodeRoute : Text;
  apiSubset : List Text;
  rmwBoundary : Text;
  ddsRuntime : Text;
  ddsSecurity : Bool;
};

Locator :: type {
  name : Text;
  address : Text;
  port : Int;
  direction : Text;
};

DdsProfile :: type {
  id : Text;
  rtpsVersion : Text;
  representation : Text;
  endianness : Text;
  domainId : Int;
  discoveryMode : Text;
  publisherParticipantGuidPrefix : Text;
  subscriberParticipantGuidPrefix : Text;
  writerEntityId : Text;
  readerEntityId : Text;
  locators : List Locator;
  requiredSubmessages : List Text;
  history : Text;
  historyDepth : Int;
  reliability : Text;
  durability : Text;
  liveliness : Text;
  deadlineNs : Int;
  lifespanNs : Int;
  leaseNs : Int;
  heartbeatPeriodNs : Int;
  ackTimeoutNs : Int;
  retryLimit : Int;
  fragmentSizeBytes : Int;
  teardown : Text;
};

NodeProfile :: type {
  component : Text;
  name : Text;
  namespace : Text;
  role : Text;
};

MessageField :: type {
  name : Text;
  kind : Text;
  bound : Int;
};

MessageType :: type {
  rosName : Text;
  typeIdentity : Text;
  idl : Text;
  fields : List MessageField;
  maxSerializedBytes : Int;
};

Workload :: type {
  publisher : NodeProfile;
  subscriber : NodeProfile;
  topic : Text;
  message : MessageType;
  publishCount : Int;
  publishPeriodNs : Int;
  expectedSequences : List Int;
  expectedValues : List Int;
  expectedSubscriberLine : Text;
};

ResourceBounds :: type {
  maxTextBytes : Int;
  maxSequenceItems : Int;
  maxMessageBytes : Int;
  maxXcdrBytes : Int;
  maxRtpsMessageBytes : Int;
  maxRtpsSubmessages : Int;
  maxParameterListBytes : Int;
  maxFragmentBytes : Int;
  maxFragmentsPerSample : Int;
  maxQueueDepth : Int;
  maxHistoryDepth : Int;
  maxParticipants : Int;
  maxWriters : Int;
  maxReaders : Int;
  maxOutstandingSamples : Int;
  maxRetries : Int;
  maxTraceRecords : Int;
  maxTraceRecordBytes : Int;
  maxTraceBytes : Int;
  maxSerialLineBytes : Int;
  maxLogBytes : Int;
  maxCapabilityGrants : Int;
};

CapabilityGrant :: type {
  holder : Text;
  kind : Text;
  object : Text;
  rights : List Text;
};

TraceContract :: type {
  id : Text;
  version : Int;
  recordKinds : List Text;
  requiredSuccessSequence : List Text;
};

OperatorMarkers :: type {
  success : Text;
  denial : Text;
  timeout : Text;
  wrongBoard : Text;
  wrongTarget : Text;
  malformedRtps : Text;
  malformedXcdr : Text;
  malformedGeneration : Text;
};

DemoContract :: type {
  formatVersion : Int;
  id : Text;
  targetProfile : Text;
  board : BoardProfile;
  ros : RosProfile;
  dds : DdsProfile;
  workload : Workload;
  bounds : ResourceBounds;
  capabilities : List CapabilityGrant;
  trace : TraceContract;
  markers : OperatorMarkers;
};

FromData @BoardProfile :: derive
FromData @RosProfile :: derive
FromData @Locator :: derive
FromData @DdsProfile :: derive
FromData @NodeProfile :: derive
FromData @MessageField :: derive
FromData @MessageType :: derive
FromData @Workload :: derive
FromData @ResourceBounds :: derive
FromData @CapabilityGrant :: derive
FromData @TraceContract :: derive
FromData @OperatorMarkers :: derive
FromData @DemoContract :: derive

decodeDemoContract :: Data -> Validation DecodeIssue DemoContract
= data => decode data;

{
  BoardProfile = BoardProfile;
  RosProfile = RosProfile;
  Locator = Locator;
  DdsProfile = DdsProfile;
  NodeProfile = NodeProfile;
  MessageField = MessageField;
  MessageType = MessageType;
  Workload = Workload;
  ResourceBounds = ResourceBounds;
  CapabilityGrant = CapabilityGrant;
  TraceContract = TraceContract;
  OperatorMarkers = OperatorMarkers;
  DemoContract = DemoContract;
  decodeDemoContract = decodeDemoContract;
}
