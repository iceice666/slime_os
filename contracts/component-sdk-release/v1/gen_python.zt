-- Generated host constants for the CP6 component-SDK-release contract.
--
-- `scripts/lib/component_sdk_release.py` and the CP6-CP10 gates consume these
-- rather than restating the bounds and vocabularies `schema.zt` declares. An
-- exporter with its own copy of the record's file names or a classifier with
-- its own copy of the compatibility axes is a second authority on the format,
-- which is exactly the failure B60 and B70 were opened for.

schema ::= import "schema.zt";
env ::= import stdlib.env;
fs ::= import stdlib.fs;
n ::= import stdlib.num;
t ::= import stdlib.text;

line :: Text -> Int -> Text
  = name value => t.join "" { name; " = "; n.toText value; "\n"; };

text :: Text -> Text -> Text
  = name value => t.join "" { name; " = "; t.show value; "\n"; };

textTuple :: List Text -> Text
  = values => match values {
    | {;} => "";
    | { entry; ...rest } => t.join "" { t.show entry; ", "; textTuple rest; };
  };

tuple :: Text -> List Text -> Text
  = name values => t.join "" { name; " = ("; textTuple values; ")\n"; };

render :: Text = t.join "" {
  "# @generated by contracts/component-sdk-release/v1/gen_python.zt; do not edit.\n";
  line "FORMAT_VERSION" schema.formatVersion;
  "IDENTITY_DOMAIN = "; t.show schema.identityDomain; ".encode(\"utf-8\")\n";
  "MATRIX_IDENTITY_DOMAIN = "; t.show schema.matrixIdentityDomain; ".encode(\"utf-8\")\n";
  text "RECORD_FILE_NAME" schema.recordFileName;
  text "NORMALIZED_FILE_NAME" schema.normalizedFileName;
  text "IDENTITY_FILE_NAME" schema.identityFileName;
  -- The exclusion set `treeIdentity` is defined over. Emitted as a tuple so a
  -- consumer recomputing the digest reads the same three names the exporter
  -- skipped rather than an independently maintained list.
  tuple "RECORD_FILE_NAMES" {
    schema.recordFileName;
    schema.normalizedFileName;
    schema.identityFileName;
  };
  line "MAX_SOURCE_BYTES" schema.maxSourceBytes;
  line "MAX_NORMALIZED_BYTES" schema.maxNormalizedBytes;
  line "MAX_NAME_BYTES" schema.maxNameBytes;
  line "MAX_PATH_BYTES" schema.maxPathBytes;
  line "MAX_TEXT_BYTES" schema.maxTextBytes;
  line "MAX_DIGEST_BYTES" schema.maxDigestBytes;
  line "MAX_COMMIT_BYTES" schema.maxCommitBytes;
  line "MAX_VERSION_BYTES" schema.maxVersionBytes;
  line "MAX_FILES" schema.maxFiles;
  line "MAX_CRATES" schema.maxCrates;
  line "MAX_CONTRACTS" schema.maxContracts;
  line "MAX_PROFILES" schema.maxProfiles;
  line "MAX_ROWS" schema.maxRows;
  line "MAX_EVIDENCE" schema.maxEvidence;
  tuple "CLASSIFICATIONS" {
    schema.classificationInitial;
    schema.classificationPatch;
    schema.classificationCompatibleFeature;
    schema.classificationBreaking;
  };
  text "CLASSIFICATION_INITIAL" schema.classificationInitial;
  text "CLASSIFICATION_PATCH" schema.classificationPatch;
  text "CLASSIFICATION_COMPATIBLE_FEATURE" schema.classificationCompatibleFeature;
  text "CLASSIFICATION_BREAKING" schema.classificationBreaking;
  tuple "STATUSES" { schema.statusSupported; };
  text "STATUS_SUPPORTED" schema.statusSupported;
  -- Ordered, not a set: a classifier reports the first changed breaking axis,
  -- so the order is part of the observable message.
  tuple "BREAKING_AXES" schema.breakingAxes;
  -- Two parallel tuples rather than a mapping, because the generator emits
  -- flat constants: `STRUCTURAL_AXES[i]` is keyed by `STRUCTURAL_KEYS[i]`, and
  -- the classifier zips them so a mismatched length is a Python-side error
  -- rather than a silent misread.
  tuple "STRUCTURAL_AXES" schema.structuralAxes;
  tuple "STRUCTURAL_KEYS" schema.structuralKeys;
};

main :: { write : FsWrite; env : Env; }
  -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_COMPONENT_SDK_RELEASE_BINDINGS_ROOT" ?? ".";
    path := t.join "" { root; "/component_sdk_release_contract.py"; };
    fs.writeAll caps.write path render
  ];

main
