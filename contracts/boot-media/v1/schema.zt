-- Slime OS deterministic removable boot-media contract, version 1 (P6.5).
--
-- This is the persisted identity record for the raw GPT/FAT32 image written to
-- removable media. The GPT and FAT layouts are fixed here rather than inferred
-- from whichever host tools assemble them: a QEMU boot and a physical boot may
-- be compared only when they name the same complete disk bytes and the same
-- embedded EFI tree.
--
-- P6.5 deliberately admits one partition kind: one read-only EFI System
-- Partition. Product/state partitions remain absent until their owning storage
-- milestone. The writer validates this record before it opens a block device.

env ::= import stdlib.env;
fs ::= import stdlib.fs;
n ::= import stdlib.num;
t ::= import stdlib.text;

formatVersion :: Int = 1;
kind :: Text = "slime-boot-media-identity";
identityDomain :: Text = "slime-boot-media-identity-v1:";

sectorBytes :: Int = 512;
diskSectors :: Int = 133120;
partitionEntries :: Int = 128;
partitionEntryBytes :: Int = 128;
primaryHeaderLba :: Int = 1;
primaryEntriesLba :: Int = 2;
espFirstLba :: Int = 2048;
espLastLba :: Int = 131071;
backupEntriesLba :: Int = 133087;
backupHeaderLba :: Int = 133119;
fatSectors :: Int = 129024;
fatHeads :: Int = 64;
fatTrackSectors :: Int = 32;
fatVolumeId :: Int = 1397508429;
fatVolumeLabel :: Text = "SLIMEBOOT";
partitionName :: Text = "Slime OS boot";
sourceDateEpoch :: Int = 946684800;

-- GUID byte order is the exact 16-byte GPT on-disk representation, not RFC
-- textual order. Values are fixed so two builds have identical headers.
diskGuidHex :: Text = "534c494d454f534449534b4750543031";
espTypeGuidHex :: Text = "28732ac11ff8d211ba4b00a0c93ec93b";
espGuidHex :: Text = "534c494d454f53455350475054303031";

recordFileName :: Text = "slime-boot-media.identity.json";
imageFileName :: Text = "slime-framework.img";

maxRecordBytes :: Int = 65536;
maxPathBytes :: Int = 192;
maxDigestBytes :: Int = 64;
maxFiles :: Int = 8;
allowedPartitionTypeGuids :: List Text = { espTypeGuidHex; };

FileIdentity :: type {
  bytes : Int;
  sha256 : Text;
};

ImageIdentity :: type {
  path : Text;
  bytes : Int;
  sha256 : Text;
};

SourceManifestIdentity :: type {
  path : Text;
  sha256 : Text;
};

EfiFileIdentity :: type {
  path : Text;
  bytes : Int;
  sha256 : Text;
};

EfiTreeIdentity :: type {
  sha256 : Text;
  files : List EfiFileIdentity;
};

PartitionIdentity :: type {
  typeGuid : Text;
  uniqueGuid : Text;
  firstLba : Int;
  lastLba : Int;
  attributes : Int;
  name : Text;
  filesystem : Text;
  volumeId : Int;
  volumeLabel : Text;
  writableProductState : Bool;
};

DiskIdentity :: type {
  sectorBytes : Int;
  sectors : Int;
  diskGuid : Text;
  partitionCount : Int;
  partitions : List PartitionIdentity;
};

BootMediaIdentity :: type {
  formatVersion : Int;
  kind : Text;
  identity : Text;
  targetProfile : Text;
  image : ImageIdentity;
  sourceManifest : SourceManifestIdentity;
  efiTree : EfiTreeIdentity;
  disk : DiskIdentity;
};

bootMediaIdentitySchema ::= schema BootMediaIdentity;

line :: Text -> Int -> Text
  = name value => t.join "" { name; " = "; n.toText value; "\n"; };
text :: Text -> Text -> Text
  = name value => t.join "" { name; " = "; t.show value; "\n"; };
textTuple :: List Text -> Text
  = values => match values {
    | {;} => "";
    | { entry; ...rest } => t.join "" { t.show entry; ", "; textTuple rest; };
  };
tuple :: Text -> List Text -> Text
  = name values => t.join "" { name; " = ("; textTuple values; ")\n"; };

render :: Text = t.join "" {
  "# @generated by contracts/boot-media/v1/schema.zt; do not edit.\n";
  line "FORMAT_VERSION" formatVersion;
  text "KIND" kind;
  "IDENTITY_DOMAIN = "; t.show identityDomain; ".encode(\"utf-8\")\n";
  line "SECTOR_BYTES" sectorBytes;
  line "DISK_SECTORS" diskSectors;
  line "PARTITION_ENTRIES" partitionEntries;
  line "PARTITION_ENTRY_BYTES" partitionEntryBytes;
  line "PRIMARY_HEADER_LBA" primaryHeaderLba;
  line "PRIMARY_ENTRIES_LBA" primaryEntriesLba;
  line "ESP_FIRST_LBA" espFirstLba;
  line "ESP_LAST_LBA" espLastLba;
  line "BACKUP_ENTRIES_LBA" backupEntriesLba;
  line "BACKUP_HEADER_LBA" backupHeaderLba;
  line "FAT_SECTORS" fatSectors;
  line "FAT_HEADS" fatHeads;
  line "FAT_TRACK_SECTORS" fatTrackSectors;
  line "FAT_VOLUME_ID" fatVolumeId;
  text "FAT_VOLUME_LABEL" fatVolumeLabel;
  text "PARTITION_NAME" partitionName;
  line "SOURCE_DATE_EPOCH" sourceDateEpoch;
  text "DISK_GUID_HEX" diskGuidHex;
  text "ESP_TYPE_GUID_HEX" espTypeGuidHex;
  text "ESP_GUID_HEX" espGuidHex;
  text "RECORD_FILE_NAME" recordFileName;
  text "IMAGE_FILE_NAME" imageFileName;
  line "MAX_RECORD_BYTES" maxRecordBytes;
  line "MAX_PATH_BYTES" maxPathBytes;
  line "MAX_DIGEST_BYTES" maxDigestBytes;
  line "MAX_FILES" maxFiles;
  tuple "ALLOWED_PARTITION_TYPE_GUIDS" allowedPartitionTypeGuids;
};

main :: { write : FsWrite; env : Env; }
  -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_BOOT_MEDIA_BINDINGS_ROOT" ?? ".";
    path := t.join "" { root; "/boot_media_contract.py"; };
    fs.writeAll caps.write path render
  ];

main
