-- Schema-reflected Python + Rust renderer for clock-authority/v1.

refl ::= import stdlib.reflect;
n ::= import stdlib.num;
w ::= import wire.python;
r ::= import wire.rust;

Format :: type {
  formatVersion : Int;
  headerBytes : Int;
  entryBytes : Int;
  maxHolders : Int;
  maxLiveTimersPerHolder : Int;
  maxLiveTimers : Int;
  headerFields : List refl.SchemaField;
  entryFields : List refl.SchemaField;
  headerLayout : List w.WireField;
  entryLayout : List w.WireField;
};

records :: Format -> List w.WireRecord = format => {
  { pythonName = "CLOCK_AUTHORITY_HEADER"; constPrefix = "CLOCK_AUTHORITY"; size = format.headerBytes; trailingPadding = 0; fields = format.headerFields; layout = format.headerLayout; };
  { pythonName = "CLOCK_AUTHORITY_ENTRY"; constPrefix = "CLOCK_AUTHORITY_ENTRY"; size = format.entryBytes; trailingPadding = 0; fields = format.entryFields; layout = format.entryLayout; };
};

pythonBindings :: Format -> Text = format => w.join {
  "CLOCK_AUTHORITY_MAGIC = b\"SLIMECA\\0\"\n";
  "CLOCK_AUTHORITY_VERSION = "; n.toText format.formatVersion; "\n";
  "CLOCK_AUTHORITY_HEADER_BYTES = "; n.toText format.headerBytes; "\n";
  "CLOCK_AUTHORITY_ENTRY_BYTES = "; n.toText format.entryBytes; "\n";
  "CLOCK_AUTHORITY_MAX_HOLDERS = "; n.toText format.maxHolders; "\n";
  "CLOCK_AUTHORITY_MAX_LIVE_TIMERS_PER_HOLDER = "; n.toText format.maxLiveTimersPerHolder; "\n";
  "CLOCK_AUTHORITY_MAX_LIVE_TIMERS = "; n.toText format.maxLiveTimers; "\n";
  w.renderRecords (records format);
};

rustBindings :: Format -> Text = format => r.join {
  "// @generated by contracts/clock-authority/v1/gen_rust.zt; do not edit.\n";
  "// Source contract: contracts/clock-authority/v1/schema.zt\n\n";
  r.u32Const "FORMAT_VERSION" format.formatVersion;
  r.usizeConst "HEADER_BYTES" format.headerBytes;
  r.usizeConst "ENTRY_BYTES" format.entryBytes;
  r.usizeConst "MAX_HOLDERS" format.maxHolders;
  r.usizeConst "MAX_LIVE_TIMERS_PER_HOLDER" format.maxLiveTimersPerHolder;
  r.usizeConst "MAX_LIVE_TIMERS" format.maxLiveTimers;
};

render :: Format -> { python : Text; rust : Text; }
  = format => if w.recordsValid (records format)
    then { python = pythonBindings format; rust = rustBindings format; }
    else { python = "INVALID_CLOCK_AUTHORITY_SCHEMA"; rust = "INVALID_CLOCK_AUTHORITY_SCHEMA"; };
{ render =; }