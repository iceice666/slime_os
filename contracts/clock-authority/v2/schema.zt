-- Slime OS clock authority, version 2 (C9.1).
--
-- A generation resource object that declares two independent service
-- authorities for each named instance: arming/cancelling bounded timers, and
-- reading/advancing simulated time. Omission is deny-by-default. The timer
-- fields also declare which generation-owned Notification receives expiry
-- signals and which badge bit identifies them, so timer delivery joins an
-- existing userspace wait source rather than inventing another wake mechanism.
--
-- Version 2 retires the monotonic read right (generation right bit 26).
-- Reading the monotonic counter and its rate is ambient: AArch64 and RISC-V
-- components read the architectural counter directly, and on x86_64 the root
-- answers every task. An entry whose flags carry bit 26, or no flag at all, is
-- refused, and the decoder refuses a version 1 table. The layout is version
-- 1's unchanged.
--
-- This contract gates Slime's service semantics, not raw architectural timer
-- register access. On the current AArch64 seL4 profiles `CNTKCTL_EL1.EL0PTEN`
-- is enabled globally at kernel boot because `slime-root` itself programs the
-- EL1 physical timer from EL0. The setting is not per-TCB, so a hostile
-- component can write `CNTP_CVAL_EL0`/`CNTP_CTL_EL0`, disrupting the root's
-- programmed deadline regardless of this table. Closing that path requires a
-- kernel/platform change; no contract claim here treats timer availability as
-- capability-gated against hostile native code.
--
-- Logical records and concrete packed little-endian layouts live together.
-- The renderer reflects every record, checks field order against its layout,
-- and writes the Python and Rust binding fragments consumed by the boot binding
-- assembler.

env ::= import stdlib.env;
fs ::= import stdlib.fs;
gen ::= import "gen_rust.zt";
t ::= import stdlib.text;

formatVersion :: Int = 2;
headerBytes :: Int = 32;
entryBytes :: Int = 64;
maxHolders :: Int = 48;
maxLiveTimersPerHolder :: Int = 4;
maxLiveTimers :: Int = 64;


WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

AuthorityHeader :: type {
  magic : Int;
  format_version : Int;
  header_size : Int;
  required_flags : Int;
  holder_count : Int;
  total_len : Int;
};

AuthorityEntry :: type {
  holder_identity : Int;
  authority_flags : Int;
  timer_quota : Int;
  reserved : Int;
  notification_grant_identity : Int;
  notification_badge : Int;
};

headerSchema ::= schema AuthorityHeader;
entrySchema ::= schema AuthorityEntry;

headerLayout :: List WireField = {
  { name = "magic"; width = 8; signed = false; byteArray = true; };
  { name = "format_version"; width = 4; signed = false; byteArray = false; };
  { name = "header_size"; width = 4; signed = false; byteArray = false; };
  { name = "required_flags"; width = 8; signed = false; byteArray = false; };
  { name = "holder_count"; width = 4; signed = false; byteArray = false; };
  { name = "total_len"; width = 4; signed = false; byteArray = false; };
};

entryLayout :: List WireField = {
  { name = "holder_identity"; width = 32; signed = false; byteArray = true; };
  { name = "authority_flags"; width = 8; signed = false; byteArray = false; };
  { name = "timer_quota"; width = 4; signed = false; byteArray = false; };
  { name = "reserved"; width = 4; signed = false; byteArray = false; };
  { name = "notification_grant_identity"; width = 8; signed = false; byteArray = false; };
  { name = "notification_badge"; width = 8; signed = false; byteArray = false; };
};

format ::= {
  formatVersion =;
  headerBytes =;
  entryBytes =;
  maxHolders =;
  maxLiveTimersPerHolder =;
  maxLiveTimers =;
  headerFields = headerSchema.fields ?? {;};
  entryFields = entrySchema.fields ?? {;};
  headerLayout =;
  entryLayout =;
};

main :: { write : FsWrite; env : Env; } -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_BOOT_BINDINGS_ROOT" ?? ".";
    bindings := gen.render format;
    pythonPath := t.join "" { root; "/clock_authority.py"; };
    rustPath := t.join "" { root; "/clock_authority.rs"; };
    fs.writeAll caps.write pythonPath bindings.python;
    fs.writeAll caps.write rustPath bindings.rust
  ];

main