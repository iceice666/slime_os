-- Slime OS boot capability layout, version 1 (B10).
--
-- A generation resource object that declares which capability slot of the
-- bootstrap component holds which role, under which name, with which rights.
-- Embedded as a KIND_RESOURCE object in a generation and authenticated by the
-- generation's existing per-object digest table; it adds no ad-hoc record
-- fields to the generation header.
--
-- Before this contract, init's capability table was built by writing fixed
-- indices in kernel source (`caps[46] = ...`), and the component images
-- addressed the same slots through hand-maintained constants. Neither side
-- could state the layout, so the two could disagree and nothing would fail
-- until a component used a slot for something it did not hold.
--
-- An entry declares a *role*, not a concrete kernel object. The distinction is
-- load-bearing: the storage slot resolves to a block device when the platform
-- enumerates one and to an object store when it does not, and that is decided
-- by PCI enumeration at boot. The host builder cannot know it. Declaring the
-- role keeps hardware probing in the kernel, where the knowledge is, while
-- still fixing which slot holds it — which is the coupling this contract
-- exists to remove.
--
-- A name grants nothing on its own. The entry names *which* executable or
-- channel half occupies a slot; the authority is the rights field, and the
-- generation's capability grants remain the gate on whether that authority may
-- be delegated at all.
--
-- Logical records and concrete packed little-endian layouts live together.
-- The renderer reflects every record, checks field order against its layout,
-- derives struct.Struct format strings and offsets, and writes the Python and
-- Rust binding fragments consumed by the boot binding assembler.

env ::= import stdlib.env;
fs ::= import stdlib.fs;
gen ::= import "gen_rust.zt";
t ::= import stdlib.text;

formatVersion :: Int = 1;
headerBytes :: Int = 40;
entryBytes :: Int = 48;

-- One entry per capability slot, so this is the kernel's `MAX_CAPS`. A layout
-- that declared more slots than the capability table holds could not be
-- installed; the decoder rejects it before reading any untrusted count.
maxEntries :: Int = 64;

-- Roles a slot may hold. Each names what the kernel must place there, not the
-- object it resolves to: `roleStorageCapability` is one role whose kind
-- depends on the platform, and `roleTransferReceiver`/`roleTransferSource`
-- occupy their slots only when the matching block devices are present.
roleEndpointFactory :: Int = 1;
roleSharedBufferFactory :: Int = 2;
roleExecutable :: Int = 3;
roleEndpointClient :: Int = 4;
roleEndpointService :: Int = 5;
roleObjectStore :: Int = 6;
roleDirectoryRoot :: Int = 7;
roleInput :: Int = 8;
roleGenerationControl :: Int = 9;
roleStorageCapability :: Int = 10;
roleTransferReceiver :: Int = 11;
roleTransferSource :: Int = 12;

-- Folded into `name_identity`, so a name in one namespace can never collide
-- with the same text in another. A component named `x` and a channel labelled
-- `x` are distinct identities.
componentDomain :: Text = "slime-boot-layout-component-v1:";
channelDomain :: Text = "slime-boot-layout-channel-v1:";

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

LayoutHeader :: type {
  magic : Int;
  format_version : Int;
  header_size : Int;
  required_flags : Int;
  generation_number : Int;
  entry_count : Int;
  total_len : Int;
};

-- `name_identity` is all-zero for a role that names nothing — the endpoint
-- factory, the input device, the generation control. `rights` is 64-bit to
-- match the generation's v3 grant width, so a layout can carry every
-- kernel-checked operation the capability model defines.
LayoutEntry :: type {
  name_identity : Int;
  slot : Int;
  role : Int;
  rights : Int;
};

headerSchema ::= schema LayoutHeader;
entrySchema ::= schema LayoutEntry;

headerLayout :: List WireField = {
  { name = "magic"; width = 8; signed = false; byteArray = true; };
  { name = "format_version"; width = 4; signed = false; byteArray = false; };
  { name = "header_size"; width = 4; signed = false; byteArray = false; };
  { name = "required_flags"; width = 8; signed = false; byteArray = false; };
  { name = "generation_number"; width = 8; signed = false; byteArray = false; };
  { name = "entry_count"; width = 4; signed = false; byteArray = false; };
  { name = "total_len"; width = 4; signed = false; byteArray = false; };
};

entryLayout :: List WireField = {
  { name = "name_identity"; width = 32; signed = false; byteArray = true; };
  { name = "slot"; width = 4; signed = false; byteArray = false; };
  { name = "role"; width = 4; signed = false; byteArray = false; };
  { name = "rights"; width = 8; signed = false; byteArray = false; };
};

format ::= {
  formatVersion =;
  headerBytes =;
  entryBytes =;
  maxEntries =;
  roleEndpointFactory =;
  roleSharedBufferFactory =;
  roleExecutable =;
  roleEndpointClient =;
  roleEndpointService =;
  roleObjectStore =;
  roleDirectoryRoot =;
  roleInput =;
  roleGenerationControl =;
  roleStorageCapability =;
  roleTransferReceiver =;
  roleTransferSource =;
  componentDomain =;
  channelDomain =;
  headerFields = headerSchema.fields ?? {;};
  entryFields = entrySchema.fields ?? {;};
  headerLayout =;
  entryLayout =;
};

main :: { write : FsWrite; env : Env; } -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_BOOT_BINDINGS_ROOT" ?? ".";
    bindings := gen.render format;
    pythonPath := t.join "" { root; "/boot_layout.py"; };
    rustPath := t.join "" { root; "/boot_layout.rs"; };
    fs.writeAll caps.write pythonPath bindings.python;
    fs.writeAll caps.write rustPath bindings.rust
  ];

main
