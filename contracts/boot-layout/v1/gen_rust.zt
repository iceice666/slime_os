-- Schema-reflected Python + Rust renderer for boot-layout/v1.
-- Shared struct.Struct mechanics live in the `wire.python` package module;
-- shared Rust scalar-const mechanics live in `wire.rust`.

refl ::= import stdlib.reflect;
n ::= import stdlib.num;
w ::= import wire.python;
r ::= import wire.rust;

Format :: type {
  formatVersion : Int;
  headerBytes : Int;
  entryBytes : Int;
  maxEntries : Int;
  roleEndpointFactory : Int;
  roleSharedBufferFactory : Int;
  roleExecutable : Int;
  roleEndpointClient : Int;
  roleEndpointService : Int;
  roleObjectStore : Int;
  roleDirectoryRoot : Int;
  roleInput : Int;
  roleGenerationControl : Int;
  roleStorageCapability : Int;
  roleTransferReceiver : Int;
  roleTransferSource : Int;
  componentDomain : Text;
  channelDomain : Text;
  headerFields : List refl.SchemaField;
  entryFields : List refl.SchemaField;
  headerLayout : List w.WireField;
  entryLayout : List w.WireField;
};

records :: Format -> List w.WireRecord = format => {
  { pythonName = "BOOT_LAYOUT_HEADER"; constPrefix = "BOOT_LAYOUT"; size = format.headerBytes; trailingPadding = 0; fields = format.headerFields; layout = format.headerLayout; };
  { pythonName = "BOOT_LAYOUT_ENTRY"; constPrefix = "BOOT_LAYOUT_ENTRY"; size = format.entryBytes; trailingPadding = 0; fields = format.entryFields; layout = format.entryLayout; };
};

pythonBindings :: Format -> Text = format => w.join {
  "BOOT_LAYOUT_MAGIC = b\"SLIMEBL\\0\"\n";
  "BOOT_LAYOUT_VERSION = "; n.toText format.formatVersion; "\n";
  "BOOT_LAYOUT_HEADER_BYTES = "; n.toText format.headerBytes; "\n";
  "BOOT_LAYOUT_ENTRY_BYTES = "; n.toText format.entryBytes; "\n";
  "MAX_BOOT_LAYOUT_ENTRIES = "; n.toText format.maxEntries; "\n";
  "BOOT_LAYOUT_ROLE_ENDPOINT_FACTORY = "; n.toText format.roleEndpointFactory; "\n";
  "BOOT_LAYOUT_ROLE_SHARED_BUFFER_FACTORY = "; n.toText format.roleSharedBufferFactory; "\n";
  "BOOT_LAYOUT_ROLE_EXECUTABLE = "; n.toText format.roleExecutable; "\n";
  "BOOT_LAYOUT_ROLE_ENDPOINT_CLIENT = "; n.toText format.roleEndpointClient; "\n";
  "BOOT_LAYOUT_ROLE_ENDPOINT_SERVICE = "; n.toText format.roleEndpointService; "\n";
  "BOOT_LAYOUT_ROLE_OBJECT_STORE = "; n.toText format.roleObjectStore; "\n";
  "BOOT_LAYOUT_ROLE_DIRECTORY_ROOT = "; n.toText format.roleDirectoryRoot; "\n";
  "BOOT_LAYOUT_ROLE_INPUT = "; n.toText format.roleInput; "\n";
  "BOOT_LAYOUT_ROLE_GENERATION_CONTROL = "; n.toText format.roleGenerationControl; "\n";
  "BOOT_LAYOUT_ROLE_STORAGE_CAPABILITY = "; n.toText format.roleStorageCapability; "\n";
  "BOOT_LAYOUT_ROLE_TRANSFER_RECEIVER = "; n.toText format.roleTransferReceiver; "\n";
  "BOOT_LAYOUT_ROLE_TRANSFER_SOURCE = "; n.toText format.roleTransferSource; "\n";
  "BOOT_LAYOUT_COMPONENT_DOMAIN = b\""; format.componentDomain; "\"\n";
  "BOOT_LAYOUT_CHANNEL_DOMAIN = b\""; format.channelDomain; "\"\n";
  w.renderRecords (records format);
};

-- Schema-owned scalars shared with boot-contracts/src/boot_layout.rs. The
-- magic tag and decode machinery stay hand-written in that module.
rustBindings :: Format -> Text = format => r.join {
  "// @generated by contracts/boot-layout/v1/gen_rust.zt; do not edit.\n";
  "// Source contract: contracts/boot-layout/v1/schema.zt\n\n";
  r.u32Const "FORMAT_VERSION" format.formatVersion;
  r.usizeConst "HEADER_BYTES" format.headerBytes;
  r.usizeConst "ENTRY_BYTES" format.entryBytes;
  r.usizeConst "MAX_ENTRIES" format.maxEntries;
  r.u32Const "ROLE_ENDPOINT_FACTORY" format.roleEndpointFactory;
  r.u32Const "ROLE_SHARED_BUFFER_FACTORY" format.roleSharedBufferFactory;
  r.u32Const "ROLE_EXECUTABLE" format.roleExecutable;
  r.u32Const "ROLE_ENDPOINT_CLIENT" format.roleEndpointClient;
  r.u32Const "ROLE_ENDPOINT_SERVICE" format.roleEndpointService;
  r.u32Const "ROLE_OBJECT_STORE" format.roleObjectStore;
  r.u32Const "ROLE_DIRECTORY_ROOT" format.roleDirectoryRoot;
  r.u32Const "ROLE_INPUT" format.roleInput;
  r.u32Const "ROLE_GENERATION_CONTROL" format.roleGenerationControl;
  r.u32Const "ROLE_STORAGE_CAPABILITY" format.roleStorageCapability;
  r.u32Const "ROLE_TRANSFER_RECEIVER" format.roleTransferReceiver;
  r.u32Const "ROLE_TRANSFER_SOURCE" format.roleTransferSource;
};

render :: Format -> { python : Text; rust : Text; }
  = format => if w.recordsValid (records format)
    then { python = pythonBindings format; rust = rustBindings format; }
    else { python = "INVALID_BOOT_LAYOUT_SCHEMA"; rust = "INVALID_BOOT_LAYOUT_SCHEMA"; };
{ render = render; }
