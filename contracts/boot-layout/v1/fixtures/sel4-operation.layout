[layout] 3 executable fabric-op-client 0x1000c
[layout] 4 executable fabric-op-client-b 0x1000c
[layout] 5 executable fabric-op-client-b-restart 0x1000c
[layout] 6 executable fabric-op-server 0x1000c
[layout] 7 executable fabric-op-time 0x10008
[layout] end
