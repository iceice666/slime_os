[layout] path=init slots=7 max=64
[layout] 0 endpoint-factory - 0x20000
[layout] 1 shared-buffer-factory - 0x1000000
[layout] 2 executable fabric-service 0x1000c
[layout] 3 executable fabric-call-client 0x10008
[layout] 4 executable fabric-call-client-b 0x10008
[layout] 5 executable fabric-call-server 0x10008
[layout] 6 executable fabric-call-time 0x10008
[layout] end
