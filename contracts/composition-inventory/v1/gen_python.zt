-- Generated host constants for the CP12 composition inventory.
--
-- `scripts/check/check-composition-inventory.py` consumes these rather than
-- restating the bounds and closed vocabularies `schema.zt` declares, on the
-- same terms `contracts/system-spec/v1` does.

schema ::= import "schema.zt";
env ::= import stdlib.env;
fs ::= import stdlib.fs;
n ::= import stdlib.num;
t ::= import stdlib.text;

line :: Text -> Int -> Text
  = name value => t.join "" { name; " = "; n.toText value; "\n"; };

text :: Text -> Text -> Text
  = name value => t.join "" { name; " = "; t.show value; "\n"; };

render :: Text = t.join "" {
  "# @generated by contracts/composition-inventory/v1/gen_python.zt; do not edit.\n";
  line "FORMAT_VERSION" schema.formatVersion;
  "IDENTITY_DOMAIN = "; t.show schema.identityDomain; ".encode(\"utf-8\")\n";
  line "MAX_SOURCE_BYTES" schema.maxSourceBytes;
  line "MAX_ENTRIES" schema.maxEntries;
  line "MAX_NAME_BYTES" schema.maxNameBytes;
  line "MAX_PATH_BYTES" schema.maxPathBytes;
  text "STATE_DERIVED" schema.stateDerived;
  text "STATE_HAND_AUTHORED" schema.stateHandAuthored;
  "STATES = (STATE_DERIVED, STATE_HAND_AUTHORED)\n";
  text "DEFERRAL_MULTI_INSTANCE_EXECUTABLE" schema.deferralMultiInstanceExecutable;
  text "DEFERRAL_EXECUTABLE_NAME_COLLISION" schema.deferralExecutableNameCollision;
  text "DEFERRAL_ROUTE_NAME_VARIANCE" schema.deferralRouteNameVariance;
  text "DEFERRAL_UNPINNED_EXTERNAL_IMPLEMENTATION" schema.deferralUnpinnedExternalImplementation;
  "DEFERRAL_REASONS = (\n";
  "    DEFERRAL_MULTI_INSTANCE_EXECUTABLE,\n";
  "    DEFERRAL_EXECUTABLE_NAME_COLLISION,\n";
  "    DEFERRAL_ROUTE_NAME_VARIANCE,\n";
  "    DEFERRAL_UNPINNED_EXTERNAL_IMPLEMENTATION,\n";
  ")\n";
};

main :: { write : FsWrite; env : Env; }
  -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_COMPOSITION_INVENTORY_BINDINGS_ROOT" ?? ".";
    path := t.join "" { root; "/composition_inventory_contract.py"; };
    fs.writeAll caps.write path render
  ];

main
