-- Schema-reflected Python + Rust renderer for block-authority/v1.
refl ::= import stdlib.reflect;
n ::= import stdlib.num;
w ::= import wire.python;
r ::= import wire.rust;

Format :: type {
  formatVersion : Int; headerBytes : Int; entryBytes : Int; maxRings : Int;
  maxRingsPerHolder : Int;
  rightRead : Int; rightWrite : Int; knownRights : Int;
  headerFields : List refl.SchemaField; entryFields : List refl.SchemaField;
  headerLayout : List w.WireField; entryLayout : List w.WireField;
};
records :: Format -> List w.WireRecord = f => {
  { pythonName = "BLOCK_AUTHORITY_HEADER"; constPrefix = "BLOCK_AUTHORITY"; size = f.headerBytes; trailingPadding = 0; fields = f.headerFields; layout = f.headerLayout; };
  { pythonName = "BLOCK_AUTHORITY_ENTRY"; constPrefix = "BLOCK_AUTHORITY_ENTRY"; size = f.entryBytes; trailingPadding = 0; fields = f.entryFields; layout = f.entryLayout; };
};
pythonBindings :: Format -> Text = f => w.join {
  "BLOCK_AUTHORITY_MAGIC = b\"SLIMEBLK\"\n";
  "BLOCK_AUTHORITY_VERSION = "; n.toText f.formatVersion; "\n";
  "BLOCK_AUTHORITY_HEADER_BYTES = "; n.toText f.headerBytes; "\nBLOCK_AUTHORITY_ENTRY_BYTES = "; n.toText f.entryBytes; "\n";
  "MAX_BLOCK_RINGS = "; n.toText f.maxRings; "\nMAX_BLOCK_RINGS_PER_HOLDER = "; n.toText f.maxRingsPerHolder; "\n";
  "BLOCK_RIGHT_READ = "; n.toText f.rightRead; "\nBLOCK_RIGHT_WRITE = "; n.toText f.rightWrite; "\nBLOCK_KNOWN_RIGHTS = "; n.toText f.knownRights; "\n";
  w.renderRecords (records f);
};
rustBindings :: Format -> Text = f => r.join {
  "// @generated by contracts/block-authority/v1/gen_rust.zt; do not edit.\n// Source contract: contracts/block-authority/v1/schema.zt\n\n";
  r.u32Const "FORMAT_VERSION" f.formatVersion; r.usizeConst "HEADER_BYTES" f.headerBytes; r.usizeConst "ENTRY_BYTES" f.entryBytes;
  r.usizeConst "MAX_RINGS" f.maxRings; r.usizeConst "MAX_RINGS_PER_HOLDER" f.maxRingsPerHolder;
  r.join { "pub const RIGHT_READ: u16 = "; n.toText f.rightRead; ";\npub const RIGHT_WRITE: u16 = "; n.toText f.rightWrite; ";\npub const KNOWN_RIGHTS: u16 = "; n.toText f.knownRights; ";\n"; };
};
render :: Format -> { python : Text; rust : Text; } = f => if w.recordsValid (records f)
  then { python = pythonBindings f; rust = rustBindings f; }
  else { python = "INVALID_BLOCK_AUTHORITY_SCHEMA"; rust = "INVALID_BLOCK_AUTHORITY_SCHEMA"; };
{ render =; }
