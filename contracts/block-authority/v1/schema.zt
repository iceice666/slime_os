-- Slime OS exact per-ring block authority resource, version 1 (B83).
--
-- Every entry binds one exact client identity, on one exact device, to one
-- exact ring epoch, and carries independent read and write right bits. A
-- userspace block driver reads this table through the authenticated,
-- cursor-paged generation-resource path and refuses a write submitted on a
-- read-only ring.
--
-- This exists because an IO0 ring is shared memory: a submission carries a
-- request, a buffer slice, and a lease, but no rights identity. The root's
-- retired `BlockTransact` gated each request on the badge-derived caller's
-- own capability; a driver serving a ring has no badge to derive. Declaring
-- the ring's rights in the generation restores that gate without trusting
-- any request byte or any client-side check.
--
-- Rights are not widenable by any field here: there is no wildcard client, no
-- device range, no "all rights" value, and no rights field the driver may
-- reinterpret. A client whose rights differ uses a different ring, because
-- rights are a property of the ring rather than of a submission.

env ::= import stdlib.env;
fs ::= import stdlib.fs;
gen ::= import "gen_rust.zt";
t ::= import stdlib.text;

formatVersion :: Int = 1;
headerBytes :: Int = 32;
entryBytes :: Int = 64;
maxRings :: Int = 64;
maxRingsPerHolder :: Int = 4;

rightRead :: Int = 1;
rightWrite :: Int = 2;
knownRights :: Int = 3;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

AuthorityHeader :: type {
  magic : Int;
  format_version : Int;
  header_size : Int;
  required_flags : Int;
  ring_count : Int;
  total_len : Int;
};

AuthorityEntry :: type {
  holder_identity : Int;
  device : Int;
  ring : Int;
  rights : Int;
  sector_limit : Int;
  reserved : Int;
};

headerSchema ::= schema AuthorityHeader;
entrySchema ::= schema AuthorityEntry;
headerLayout :: List WireField = {
  { name = "magic"; width = 8; signed = false; byteArray = true; };
  { name = "format_version"; width = 4; signed = false; byteArray = false; };
  { name = "header_size"; width = 4; signed = false; byteArray = false; };
  { name = "required_flags"; width = 8; signed = false; byteArray = false; };
  { name = "ring_count"; width = 4; signed = false; byteArray = false; };
  { name = "total_len"; width = 4; signed = false; byteArray = false; };
};
entryLayout :: List WireField = {
  { name = "holder_identity"; width = 32; signed = false; byteArray = true; };
  { name = "device"; width = 4; signed = false; byteArray = false; };
  { name = "ring"; width = 4; signed = false; byteArray = false; };
  { name = "rights"; width = 2; signed = false; byteArray = false; };
  { name = "sector_limit"; width = 8; signed = false; byteArray = false; };
  { name = "reserved"; width = 14; signed = false; byteArray = true; };
};

format ::= {
  formatVersion =; headerBytes =; entryBytes =; maxRings =; maxRingsPerHolder =;
  rightRead =; rightWrite =; knownRights =;
  headerFields = headerSchema.fields ?? {;}; entryFields = entrySchema.fields ?? {;};
  headerLayout =; entryLayout =;
};

main :: { write : FsWrite; env : Env; } -> Unit ! { * fs.WholeWriteEffects; * env.GetEffects; }
  = caps => [
    root := env.get caps.env "SLIME_BOOT_BINDINGS_ROOT" ?? ".";
    bindings := gen.render format;
    fs.writeAll caps.write (t.join "" { root; "/block_authority.py"; }) bindings.python;
    fs.writeAll caps.write (t.join "" { root; "/block_authority.rs"; }) bindings.rust
  ];

main
