-- Pure renderer for Slime OS powerbox protocol bindings.

refl ::= import stdlib.reflect;
n ::= import stdlib.num;
t ::= import stdlib.text;
w ::= import wire.rust;
c ::= import wire.codec;

WireField :: type { name : Text; width : Int; signed : Bool; byteArray : Bool; };

Protocol :: type {
  formatVersion : Int;
  requestLen : Int;
  replyLen : Int;
  maxPurposeBytes : Int;
  objectKindFile : Int;
  replyFlagSelected : Int;
  replyFlagCancelled : Int;
  requestFields : List refl.SchemaField;
  replyFields : List refl.SchemaField;
  requestLayout : List WireField;
  replyLayout : List WireField;
};

-- Offset and codec emitters come from `wire.codec`, which owns the
-- byte-array-aware mechanics fourteen renderers previously each copied. The
-- validity predicate below stays here: what makes *this* layout admissible is
-- contract-specific.
layoutNames :: List WireField -> List Text = c.layoutNames;
allValid :: List WireField -> Bool = c.allValid;
wireBytes :: List WireField -> Int = c.wireBytes;
offsetConsts :: Text -> Int -> List WireField -> Text = c.offsetConsts;
wireStruct :: Text -> Text -> Text -> List WireField -> Text
  = name prefix lengthName fields => c.wireStruct "powerbox" name prefix lengthName fields;


rustBindings :: Protocol -> Text
  = protocol => w.join {
    "// @generated by contracts/powerbox/v1/gen_rust.zt; do not edit.\n";
    "// Source contract: contracts/powerbox/v1/schema.zt\n\n";
    "pub const FORMAT_VERSION: u32 = "; n.toText protocol.formatVersion; ";\n";
    "pub const POWERBOX_MAGIC: u32 = 1346522187;\n";
    "pub const REQUEST_LEN: usize = "; n.toText protocol.requestLen; ";\n";
    "pub const REPLY_LEN: usize = "; n.toText protocol.replyLen; ";\n";
    "pub const MAX_PURPOSE_BYTES: usize = "; n.toText protocol.maxPurposeBytes; ";\n";
    "pub const OBJECT_KIND_FILE: u8 = "; n.toText protocol.objectKindFile; ";\n";
    "pub const REPLY_FLAG_SELECTED: u8 = "; n.toText protocol.replyFlagSelected; ";\n";
    "pub const REPLY_FLAG_CANCELLED: u8 = "; n.toText protocol.replyFlagCancelled; ";\n\n";
    offsetConsts "REQUEST" 0 protocol.requestLayout;
    "\n";
    offsetConsts "REPLY" 0 protocol.replyLayout;
    "\n";
    wireStruct "WirePowerboxRequest" "REQUEST" "REQUEST_LEN" protocol.requestLayout;
    "\n";
    wireStruct "WirePowerboxReply" "REPLY" "REPLY_LEN" protocol.replyLayout;
  };

valid :: Protocol -> Bool
  = protocol =>
    w.schemaFieldsValid protocol.requestFields
      && w.schemaFieldsValid protocol.replyFields
      && w.schemaNames protocol.requestFields == layoutNames protocol.requestLayout
      && w.schemaNames protocol.replyFields == layoutNames protocol.replyLayout
      && allValid protocol.requestLayout
      && allValid protocol.replyLayout
      && wireBytes protocol.requestLayout <= protocol.requestLen
      && wireBytes protocol.replyLayout <= protocol.replyLen;

render :: Protocol -> { rust : Text; }
  = protocol => if valid protocol
    then { rust = rustBindings protocol; }
    else { rust = "INVALID_POWERBOX_SCHEMA"; };

{ render =; }
