-- Schema-reflected Python + Rust renderer for recording-policy/v1.

refl ::= import stdlib.reflect;
n ::= import stdlib.num;
w ::= import wire.python;
r ::= import wire.rust;

Format :: type {
  formatVersion : Int;
  headerBytes : Int;
  entryBytes : Int;
  maxInstances : Int;
  recordBytes : Int;
  maxRecordCapacity : Int;
  roleRecord : Int;
  roleReplay : Int;
  maxRole : Int;
  flagDeterministic : Int;
  knownFlags : Int;
  headerFields : List refl.SchemaField;
  entryFields : List refl.SchemaField;
  headerLayout : List w.WireField;
  entryLayout : List w.WireField;
};

records :: Format -> List w.WireRecord = format => {
  { pythonName = "RECORDING_POLICY_HEADER"; constPrefix = "RECORDING_POLICY"; size = format.headerBytes; trailingPadding = 0; fields = format.headerFields; layout = format.headerLayout; };
  { pythonName = "RECORDING_POLICY_ENTRY"; constPrefix = "RECORDING_POLICY_ENTRY"; size = format.entryBytes; trailingPadding = 0; fields = format.entryFields; layout = format.entryLayout; };
};

-- The nondeterminism classification is not rendered here: it lives on each
-- right in `contracts/generation/v5`, and both readers consume it as the
-- generated `RIGHT_RECORDED`/`RIGHT_UNRECORDED` masks. Restating it here would
-- be a second classification that could drift from the one a right declares.

pythonBindings :: Format -> Text = format => w.join {
  "RECORDING_POLICY_MAGIC = b\"SLIMERC\\0\"\n";
  "RECORDING_POLICY_VERSION = "; n.toText format.formatVersion; "\n";
  "RECORDING_POLICY_HEADER_BYTES = "; n.toText format.headerBytes; "\n";
  "RECORDING_POLICY_ENTRY_BYTES = "; n.toText format.entryBytes; "\n";
  "RECORDING_POLICY_MAX_INSTANCES = "; n.toText format.maxInstances; "\n";
  "RECORDING_POLICY_RECORD_BYTES = "; n.toText format.recordBytes; "\n";
  "RECORDING_POLICY_MAX_RECORD_CAPACITY = "; n.toText format.maxRecordCapacity; "\n";
  "RECORDING_POLICY_ROLE_RECORD = "; n.toText format.roleRecord; "\n";
  "RECORDING_POLICY_ROLE_REPLAY = "; n.toText format.roleReplay; "\n";
  "RECORDING_POLICY_MAX_ROLE = "; n.toText format.maxRole; "\n";
  "RECORDING_POLICY_FLAG_DETERMINISTIC = "; n.toText format.flagDeterministic; "\n";
  "RECORDING_POLICY_KNOWN_FLAGS = "; n.toText format.knownFlags; "\n";
  "RECORDING_POLICY_ROLE_BY_MANIFEST_NAME = {\n";
  "    \"record\": "; n.toText format.roleRecord; ",\n";
  "    \"replay\": "; n.toText format.roleReplay; ",\n";
  "}\n";
  w.renderRecords (records format);
};

rustBindings :: Format -> Text = format => r.join {
  "// @generated by contracts/recording-policy/v1/gen_rust.zt; do not edit.\n";
  "// Source contract: contracts/recording-policy/v1/schema.zt\n\n";
  r.u32Const "FORMAT_VERSION" format.formatVersion;
  r.usizeConst "HEADER_BYTES" format.headerBytes;
  r.usizeConst "ENTRY_BYTES" format.entryBytes;
  r.usizeConst "MAX_INSTANCES" format.maxInstances;
  r.usizeConst "RECORD_BYTES" format.recordBytes;
  r.usizeConst "MAX_RECORD_CAPACITY" format.maxRecordCapacity;
  r.u32Const "ROLE_RECORD" format.roleRecord;
  r.u32Const "ROLE_REPLAY" format.roleReplay;
  r.u32Const "MAX_ROLE" format.maxRole;
  r.u32Const "FLAG_DETERMINISTIC" format.flagDeterministic;
  r.u32Const "KNOWN_FLAGS" format.knownFlags;
};

-- A role vocabulary whose maximum is not its last declared value would admit a
-- role no reader implements, and a flag word wider than the flags declared would
-- admit a bit nothing sets. The capacity ceiling must also divide into whole
-- records: a stream bounded in bytes that did not end on a record boundary would
-- make truncation and completeness the same observation.
boundsValid :: Format -> Bool
  = format => format.maxRole == format.roleReplay
    && format.knownFlags == format.flagDeterministic
    && format.maxRecordCapacity > 0
    && format.recordBytes > 0;

render :: Format -> { python : Text; rust : Text; }
  = format => if w.recordsValid (records format) && boundsValid format
    then { python = pythonBindings format; rust = rustBindings format; }
    else { python = "INVALID_RECORDING_POLICY_SCHEMA"; rust = "INVALID_RECORDING_POLICY_SCHEMA"; };
{ render =; }
