#!/usr/bin/env python3
"""End-to-end exercise of scripts/spec on a throwaway clone.

    scripts/spec/e2e [--keep]

Clones this checkout (no submodules), adds a synthetic area, exam recipe
and checker, then walks: check -> status claimed -> record -> local
enforced -> human gate -> publish -> enforced from the evidence ref ->
grader edit stales it -> check --base rules 1-4 and approvers -> predicate
failure -> dirty and stale records refused by publish -> human signature
tamper. Never touches the real checkout or its refs.
"""

from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]
PASSED = 0
FAILED: list[str] = []


def ok(condition: bool, label: str) -> None:
    global PASSED
    if condition:
        PASSED += 1
    else:
        FAILED.append(label)
        print(f"FAIL {label}", file=sys.stderr)


class Clone:
    def __init__(self, root: Path, key: Path) -> None:
        self.root = root
        self.key = key
        self.env = os.environ | {"SPEC_EVIDENCE_REF": "refs/heads/evidence", "HOME": str(root / "home")}

    def run(self, *args: str, check: bool = True) -> subprocess.CompletedProcess:
        return subprocess.run(args, cwd=self.root, env=self.env, check=check, text=True, capture_output=True)

    def spec(self, tool: str, *args: str) -> subprocess.CompletedProcess:
        return self.run(sys.executable, str(self.root / "scripts" / "spec" / tool), *args, check=False)

    def git(self, *args: str) -> str:
        return self.run("git", *args).stdout

    def write(self, path: str, text: str) -> None:
        target = self.root / path
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(text, encoding="utf-8")

    def commit(self, message: str) -> None:
        self.run("git", "add", "-A")
        self.run("git", "-c", "user.name=e2e", "-c", "user.email=e2e@example", "commit", "-q", "-m", message)

    def state(self, requirement: str, local: bool = False) -> str:
        done = self.spec("status", "--json", *(["--local"] if local else []))
        import json

        report = json.loads(done.stdout)
        for area in report["areas"]:
            for row in area["requirements"]:
                if row["id"] == requirement:
                    return row["state"]
        return "missing"


EXAM = """import sys
sys.path.insert(0, "scripts/lib")
import devloop_observations
devloop_observations.record(casesObserved={cases}, negativeControlsRefused={controls})
sys.exit({exit})
"""

R1 = "01a1b3bb-e2e0-7000-8000-000000000001"
R2 = "01a1b3bb-e2e0-7000-8000-000000000002"


def area_text(statement: str = "The e2e exam observes three cases.", invariant: str = "Never.") -> str:
    return f'''s ::= import "./schema.zt";
h ::= import "./helpers.zt";
area :: s.Area = (h.area "e2e" "End-to-end fixture" {{ "components/e2e/**"; }} {{
  h.req "{R1}" "{statement}" "fixture" {{
    h.observedWhere "cases" "e2e_exam" {{ h.count "casesObserved" 3; h.atLeast "negativeControlsRefused" 1; }} "counts";
    h.human "looked" "Did a person look?" "fixture";
  }};
  h.planned "{R2}" "A later promise." "fixture" "waits for the next phase" h.noAcceptance;
}}) with {{ invariants = {{ h.invariant "i1" "{invariant}"; }}; }};
area
'''


def lib_items(root: Path) -> list[Path]:
    return [*(root / ".tasks" / "items").glob("*.zt"), *(root / ".tasks" / "terminal").glob("*.zt")]


I1 = "01a1c147-e2e0-7000-8000-000000000001"
I2 = "01a1c147-e2e0-7000-8000-000000000002"


def item_text(slug: str = "e2e-item", uid: str = I1, target: str = "e2e_exam", extra: str = "", acceptance: str = "") -> str:
    acceptance = acceptance or f'h.observedWhere "{target}" {{ h.count "casesObserved" 3; }};'
    return f'''s ::= import "./schema.zt";
h ::= import "./helpers.zt";
item :: s.Item = (h.task "{uid}" "{slug}" "e2e" "Fixture" "The e2e fixture item.") with {{
  owns = {{ "components/e2e/**"; "docs/e2e/**"; }};
  requirements = {{ h.req "cases" "The exam observes three cases." {{ "{target}"; }}; }};
  acceptance = {{ {acceptance} }};
  {extra}
}};
item
'''


def items(clone: Clone) -> None:
    """tasks check: a valid item passes, each malformed one is refused."""
    clone.write(".tasks/items/e2e-item.zt", item_text())
    done = clone.spec("tasks", "check")
    ok(done.returncode == 0, f"tasks check passes a valid item: {done.stderr[-300:]}")
    refusals = {
        "slug": ("e2e-item.zt", item_text(slug="other")),
        "not a UUIDv7": ("e2e-item.zt", item_text(uid="not-a-uuid")),
        "does not declare": ("e2e-item.zt", item_text(target="no_such_target")),
        "which is no item": ("e2e-item.zt", item_text(extra=f'parent = "{I2}";')),
        "already used": ("e2e-copy.zt", item_text(slug="e2e-copy")),
        "needs a non-empty": ("e2e-item.zt", item_text().replace("h.task", "h.milestone")),
        "ratchet in": ("e2e-item.zt", item_text(extra='knownLimits = { h.knownLimit "R9" "x" "y" h.agentDefault; };')),
        "does not exist": ("e2e-item.zt", item_text(extra='nonGoals = { h.nonGoal "x" (h.fromDecision "docs/none.md"); };')),
    }
    for label, (name, text) in refusals.items():
        clone.write(f".tasks/items/{name}", text)
        done = clone.spec("tasks", "check")
        ok(done.returncode == 1 and label in done.stderr, f"tasks check refuses ({label}): {done.stderr[-300:]}")
        clone.write(".tasks/items/e2e-item.zt", item_text())
        (clone.root / ".tasks" / "items" / "e2e-copy.zt").unlink(missing_ok=True)
    helpers = clone.root / ".tasks" / "terminal" / "helpers.zt"
    helpers.write_text(helpers.read_text() + "-- drift\n")
    done = clone.spec("tasks", "check")
    ok(done.returncode == 1 and "byte-identical" in done.stderr, "a drifted terminal copy is refused")
    helpers.write_text((clone.root / ".tasks" / "items" / "helpers.zt").read_text())


def item_state(clone: Clone, local: bool = False) -> str:
    import json  # noqa: PLC0415

    done = clone.spec("tasks", "status", "--json", *(["--local"] if local else []))
    return next((i["state"] for i in json.loads(done.stdout)["items"] if i["slug"] == "e2e-item"), "missing")


def item_status(clone: Clone) -> None:
    """tasks status computes done; T1 refuses an early close; T2 refuses touching a failing item's owns."""
    clone.write("scripts/check/e2e-exam.py", EXAM.format(controls=3, cases=3, exit=0))
    clone.write(".tasks/items/e2e-item.zt", item_text(acceptance='h.observedWhere "e2e_exam" { h.count "casesObserved" 3; }; h.human "looked" "Did a person look?";'))
    clone.commit("item with a human gate")
    clone.spec("record", "e2e_exam")
    done = clone.spec("publish")
    ok(done.returncode == 0, f"publish the item's record: {done.stderr[-300:]}")
    ok(item_state(clone) == "claimed", "a mandatory human gate without a record keeps the item claimed")
    done = clone.spec("tasks", "human", "e2e-item", "looked", "yes", "--signer", "tester", "--key", str(clone.key))
    ok(done.returncode == 0, f"tasks human signs: {done.stderr[-300:]}")
    ok(item_state(clone, local=True) == "done", "the item is done once the human gate is signed")
    clone.spec("publish")
    ok(item_state(clone) == "done", "done from the evidence ref")

    clone.run("git", "mv", ".tasks/items/e2e-item.zt", ".tasks/terminal/e2e-item.zt")
    clone.commit("close the item")
    done = clone.spec("tasks", "check", "--base", "HEAD~1")
    ok(done.returncode == 0, f"T1: a done item may enter terminal/: {done.stderr[-300:]}")
    clone.run("git", "mv", ".tasks/terminal/e2e-item.zt", ".tasks/items/e2e-item.zt")
    clone.write(".tasks/items/e2e-item.zt", item_text().replace('h.count "casesObserved" 3', 'h.count "casesObserved" 4'))
    clone.commit("reopen with a failing predicate")
    ok(item_state(clone) == "failing", "a predicate that does not hold makes the item failing")
    clone.run("git", "mv", ".tasks/items/e2e-item.zt", ".tasks/terminal/e2e-item.zt")
    clone.commit("close early")
    done = clone.spec("tasks", "check", "--base", "HEAD~1")
    ok(done.returncode == 1 and "T1" in done.stderr, "T1: a failing item may not enter terminal/")
    clone.run("git", "reset", "-q", "--hard", "HEAD~1")

    clone.write("docs/e2e/note.md", "Touched by a later PR outside the exam's closure.\n")
    clone.commit("touch the failing item's owns")
    done = clone.spec("tasks", "check", "--base", "HEAD~1")
    ok(done.returncode == 1 and "T2" in done.stderr, "T2: touching a failing item's owns is refused")
    limit = 'knownLimits = { h.knownLimit "failing" "e2e_exam" "the fixture waits" h.agentDefault; };'
    clone.write(".tasks/items/e2e-item.zt", item_text(extra=limit).replace('h.count "casesObserved" 3', 'h.count "casesObserved" 4'))
    clone.commit("accept the failure as a known limit")
    done = clone.spec("tasks", "check", "--base", "HEAD~2")
    ok(done.returncode == 1 and "approval" in done.stderr and "T2" not in done.stderr, "a new known limit needs an approval")
    done = clone.spec("tasks", "check", "--base", "HEAD~2", "--approvers", "owner")
    ok(done.returncode == 0, f"HUMAN_OWNERS approval admits the known limit: {done.stderr[-300:]}")


def ratchets(clone: Clone) -> None:
    """R4: dropping a negative control and its floor is refused without an approved known limit."""
    def item(floor: int, limit: str = "") -> str:
        acceptance = f'h.observedWhere "e2e_exam" {{ h.count "casesObserved" 3; h.count "negativeControlsRefused" {floor}; }};'
        return item_text(acceptance=acceptance, extra=limit)

    clone.write(".tasks/items/e2e-item.zt", item(3))
    clone.commit("item pins three controls")
    clone.write("scripts/check/e2e-exam.py", EXAM.format(controls=2, cases=3, exit=0))
    clone.write(".tasks/items/e2e-item.zt", item(2))
    clone.commit("drop a negative control")
    done = clone.spec("ratchet", "--base", "HEAD~1")
    ok(done.returncode == 1 and "R4 e2e_exam: 3 -> 2" in done.stderr, f"R4: a dropped control is refused: {done.stderr[-300:]}")
    limit = 'knownLimits = { h.knownLimit "R4" "e2e_exam" "the third control duplicated the second" h.agentDefault; };'
    clone.write(".tasks/items/e2e-item.zt", item(2, limit))
    clone.commit("accept the drop")
    done = clone.spec("ratchet", "--base", "HEAD~2")
    ok(done.returncode == 1 and "approval" in done.stderr, "R4: a known limit without approval is refused")
    done = clone.spec("ratchet", "--base", "HEAD~2", "--approvers", "owner")
    ok(done.returncode == 0, f"R4: an approved known limit admits the drop: {done.stderr[-300:]}")
    clone.write(".tasks/items/e2e-item.zt", item(4, limit))
    clone.commit("raise the floor")
    done = clone.spec("ratchet", "--base", "HEAD~1")
    ok(done.returncode == 0, "R4: raising a floor needs nobody")


def clauses(clone: Clone) -> None:
    """tasks check resolves h.clause; R1 refuses a deleted clause."""
    def clause_item(clause: str) -> str:
        return item_text(acceptance=f'h.observed "e2e_exam"; h.clause "spawn-arguments" "argument-framing" "{clause}" h.hostSim;')

    for clause, label in (("no-such-clause", "names no clause"), ("refusal-releases-capabilities", "unchecked clause")):
        clone.write(".tasks/items/e2e-item.zt", clause_item(clause))
        done = clone.spec("tasks", "check")
        ok(done.returncode == 1 and label in done.stderr, f"h.clause refused ({label}): {done.stderr[-300:]}")
    clone.write(".tasks/items/e2e-item.zt", item_text())
    clone.commit("item without clauses")
    path = clone.root / "contracts" / "spawn-arguments-dbc" / "v1" / "clauses.zt"
    text = path.read_text()
    start = text.index("        {\n          id = \"refusal-releases-capabilities\"")
    end = text.index("        };\n", start) + len("        };\n")
    path.write_text(text[:start] + text[end:])
    clone.commit("delete a clause")
    done = clone.spec("ratchet", "--base", "HEAD~1", "--only", "R1")
    ok(done.returncode == 1 and "R1 spawn-arguments: 7 -> 6" in done.stderr, f"R1: a deleted clause is refused: {done.stderr[-300:]}")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--keep", action="store_true")
    args = parser.parse_args()
    temporary = Path(tempfile.mkdtemp(prefix="slime-spec-e2e-"))
    try:
        root = temporary / "repo"
        subprocess.run(["git", "clone", "-q", "--no-local", "--depth", "1", f"file://{ROOT}", str(root)], check=True)
        # The clone's working tree must carry what the real checkout has uncommitted in scripts/spec and specs.
        for sub in ("scripts/spec", "specs", ".tasks", "just", "contracts/observation", "contracts/spawn-arguments-dbc", "verification/dbc", "HUMAN_OWNERS"):
            source = ROOT / sub
            if source.is_dir():
                shutil.rmtree(root / sub, ignore_errors=True)
                shutil.copytree(source, root / sub, ignore=shutil.ignore_patterns("__pycache__"))
            elif source.is_file():
                shutil.copyfile(source, root / sub)
        (root / "home").mkdir()
        key = temporary / "key"
        subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-f", str(key)], check=True)
        clone = Clone(root, key)
        public = key.with_suffix(".pub").read_text().split()
        clone.write("specs/allowed_signers", f'tester namespaces="slime-spec" {public[0]} {public[1]}\n')
        clone.write("HUMAN_OWNERS", "owner\n")
        for stale in [*(root / "specs").glob("*.zt"), *lib_items(root)]:
            if stale.name not in {"schema.zt", "helpers.zt"}:
                stale.unlink()
        clone.write("specs/e2e.zt", area_text())
        clone.write("scripts/check/e2e-exam.py", EXAM.format(controls=3, cases=3, exit=0))
        with (root / "Justfile").open("a") as handle:
            handle.write("\ne2e_exam:\n    python3 scripts/check/e2e-exam.py\n")
        clone.commit("e2e fixture")

        done = clone.spec("check")
        ok(done.returncode == 0, f"check passes on fixture: {done.stderr[-300:]}")
        ok(clone.state(R1) == "claimed", "fresh requirement is claimed")
        ok(clone.state(R2) == "advisory", "planned requirement is advisory")
        done = clone.spec("status", "--claimed")
        ok(done.stdout.split() == ["e2e_exam"], "--claimed names the exam")

        done = clone.spec("record", "e2e_exam")
        ok(done.returncode == 0, f"record runs the exam: {done.stderr[-300:]}")
        ok(clone.state(R1, local=True) == "advisory", "observed enforced locally, human gate still advisory")
        done = clone.spec("human", "e2e", R1, "looked", "yes", "--signer", "tester", "--key", str(key))
        ok(done.returncode == 0, f"human signs yes: {done.stderr[-300:]}")
        ok(clone.state(R1, local=True) == "enforced", "requirement enforced locally after human yes")
        ok(clone.state(R1) == "claimed", "without --local nothing is published yet")

        done = clone.spec("publish")
        ok(done.returncode == 0 and "nothing new" not in done.stdout, f"publish commits: {done.stdout} {done.stderr[-200:]}")
        ok(clone.state(R1) == "enforced", "enforced from the evidence ref")
        done = clone.spec("publish")
        ok("nothing new" in done.stdout, "publish is idempotent")
        shutil.rmtree(root / "build" / "observations")

        clone.write("scripts/check/e2e-exam.py", EXAM.format(controls=3, cases=3, exit=0) + "# touched\n")
        clone.commit("touch grader")
        ok(clone.state(R1) == "claimed", "grader edit stales the record")
        done = clone.spec("check", "--base", "HEAD~1")
        ok(done.returncode == 0, "a grader edit needs no human approval")
        done = clone.spec("roles", "--base", "HEAD~1")
        ok(done.returncode == 1 and "Devloop-Role" in done.stderr, "a checker edit without a role is refused")
        clone.run("git", "commit", "-q", "--amend", "-m", "touch grader\n\nDevloop-Role: implementer")
        done = clone.spec("roles", "--base", "HEAD~1")
        ok(done.returncode == 1 and "may not touch scripts/check/e2e-exam.py" in done.stderr, "an implementer may not touch a checker")
        clone.run("git", "commit", "-q", "--amend", "-m", "touch grader\n\nDevloop-Role: breaker")
        done = clone.spec("roles", "--base", "HEAD~1")
        ok(done.returncode == 0, f"a breaker may touch a checker: {done.stderr[-300:]}")
        clone.write("components/e2e/lib.rs", "// product\n")
        clone.write("scripts/check/e2e-exam.py", EXAM.format(controls=3, cases=3, exit=0))
        clone.run("git", "add", "-A")
        clone.run("git", "-c", "user.name=e2e", "-c", "user.email=e2e@example", "commit", "-q", "-m", "both\n\nDevloop-Role: breaker")
        done = clone.spec("roles", "--base", "HEAD~1")
        ok(done.returncode == 1 and "components/e2e/lib.rs (product)" in done.stderr, "one commit may not change a checker and product code")
        clone.run("git", "reset", "-q", "--hard", "HEAD~1")

        clone.write("docs/e2e.md", "Unclassified.\n")
        clone.commit("docs only")
        done = clone.spec("roles", "--base", "HEAD~1")
        ok(done.returncode == 0, "an unclassified commit needs no role")

        clone.write("components/e2e/lib.rs", "// owned\n")
        clone.write("components/other/lib.rs", "// not owned\n")
        clone.commit("product files")
        done = clone.spec("check", "--base", "HEAD~1", "--enforce-owns")
        ok(done.returncode == 1 and "components/other/lib.rs" in done.stderr and "components/e2e/lib.rs" not in done.stderr, "rule 4: owns coverage")
        done = clone.spec("check", "--base", "HEAD~1")
        ok(done.returncode == 0, "rule 4 only reports without --enforce-owns")

        clone.write("scripts/check/e2e-exam.py", EXAM.format(controls=3, cases=2, exit=0))
        clone.commit("exam reports two")
        clone.spec("record", "e2e_exam")
        ok(clone.state(R1, local=True) == "failing", "predicate failure is failing")
        clone.write("scripts/check/e2e-exam.py", EXAM.format(controls=3, cases=3, exit=1))
        clone.commit("exam exits 1")
        done = clone.spec("record", "e2e_exam")
        ok(done.returncode == 1 and clone.state(R1, local=True) == "failing", "exit 1 is failing and propagates")

        clone.write("scripts/check/e2e-exam.py", EXAM.format(controls=3, cases=3, exit=0))
        clone.commit("exam fixed")
        clone.spec("record", "e2e_exam")
        clone.write("scripts/check/e2e-exam.py", EXAM.format(controls=3, cases=3, exit=0) + "# dirty\n")
        done = clone.spec("publish")
        ok(done.returncode == 1 and "closure digest" in done.stderr, "a record whose digest is not HEAD's is refused")
        clone.write("scripts/check/e2e-exam.py", EXAM.format(controls=3, cases=3, exit=0))
        clone.write("components/e2e/lib.rs", "// edited\n")
        done = clone.spec("record", "e2e_exam")
        ok("dirty" in done.stderr, "record from a dirty tree says so")
        done = clone.spec("publish")
        ok(done.returncode == 1 and "dirty" in done.stderr, "a dirty record is refused")
        clone.run("git", "checkout", "--", "components/e2e/lib.rs")

        clone.write("specs/e2e.zt", area_text(statement="The e2e exam observes three cases, reworded.", invariant="Changed."))
        clone.commit("statement reworded")
        ok(clone.state(R1) in {"claimed", "advisory"}, "rewording the statement asks the human again")
        human = next((root / "build" / "observations" / "human").rglob("*.zt"), None)
        if human is not None:
            human.write_text(human.read_text().replace("value = true", "value = false"))
            done = clone.spec("publish")
            ok("signature does not verify" in done.stderr, "a tampered human record is refused")

        clone.write("specs/e2e.zti", "{}")
        done = clone.spec("check")
        ok(done.returncode == 1 and ".zti" in done.stderr, ".zti under specs/ is refused")
        (root / "specs" / "e2e.zti").unlink()

        items(clone)
        item_status(clone)
        ratchets(clone)
        clauses(clone)
    finally:
        if args.keep:
            print(f"kept {temporary}")
        else:
            shutil.rmtree(temporary, ignore_errors=True)
    print(f"e2e: {PASSED} passed, {len(FAILED)} failed")
    sys.path.insert(0, str(ROOT / "scripts" / "lib"))
    import devloop_observations  # noqa: PLC0415

    devloop_observations.record(casesObserved=PASSED + len(FAILED), casesFailed=len(FAILED))
    return 1 if FAILED else 0


if __name__ == "__main__":
    raise SystemExit(main())
