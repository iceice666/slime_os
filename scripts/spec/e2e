#!/usr/bin/env python3
"""End-to-end exam of the v1.5 devloop on a throwaway fixture repository.

    scripts/spec/e2e [--keep]

Builds a fresh Git repository from this checkout's scripts/spec, the task
and observation contracts and the area schema, with one area, a Justfile,
a product directory, two signing keys and two HUMAN_OWNERS. It then walks
the exit fixtures of devloop-v1.5-bootstrap:

  M1  an area target gets a signed record on the evidence branch; a
      #planned item's target is not claimed and a planning merge records
      nothing; an illegal intent transition and a milestone that starts
      beside an open backlog bug are refused.
  M2  refused: a pull request carrying a checker and product code, one its
      author approved alone, one that rewrites scripts/spec/check to pass
      itself, one touching an unlisted path, and product code no #active
      item owns.
  M3  planning -> implementation -> closeout with no re-record; the closeout
      still passes after main moves past the witness; a missing or forged
      witness and an edited terminal item are refused.

Every negative control has a positive twin in the same walk. Reports
`casesObserved` and `negativeControlsRefused` through the gate protocol
and exits non-zero when any case fails. Never touches this checkout.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]
sys.dont_write_bytecode = True  # scripts/spec is under codePaths; no ignored bytes beside it
sys.path.insert(0, str(HERE))
import lib  # noqa: E402

PASSED: list[str] = []
FAILED: list[str] = []
REFUSED: list[str] = []


def ok(condition: bool, label: str, detail: str = "") -> None:
    (PASSED if condition else FAILED).append(label)
    if not condition:
        print(f"FAIL {label}\n{detail[-1500:]}", file=sys.stderr)


def refused(done: subprocess.CompletedProcess, rule: str, label: str) -> None:
    """A negative control: the judge exits 1 and names `rule`."""
    hit = done.returncode == 1 and f"error: {rule}" in done.stderr
    ok(hit, f"refuses: {label}", done.stdout + done.stderr)
    if hit:
        REFUSED.append(label)


EXAM = '''import json, os, sys
from pathlib import Path
sys.path.insert(0, "scripts/lib")
import e2e_judge
target = os.environ.get("DEVLOOP_JUST_TARGET")
if target:
    out = Path("build/devloop-observations") / f"{target}.json"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps({"casesObserved": e2e_judge.CASES, "negativeControlsRefused": 3}))
sys.exit(0)
'''

AREA = '''s ::= import "./schema.zt";
h ::= import "./helpers.zt";
area :: s.Area = (h.area "e2e" "End-to-end fixture" { "components/e2e/**"; } {
  h.req "01a1c4a0-e2e0-7000-8000-000000000001" "The area exam observes three cases." "fixture" {
    h.observedWhere "cases" "area_exam" { h.count "casesObserved" 3; } "counts";
  };
}) with { invariants = { h.invariant "i1" "Never."; }; };
area
'''

JUSTFILE = '''area_exam:
    python3 scripts/check/area-exam.py
'''

FEATURE_RECIPE = '''
feature_exam:
    python3 scripts/check/feature-exam.py
'''

FEATURE = "01a1c4a0-e2e0-7000-8000-0000000000f1"
BUG = "01a1c4a0-e2e0-7000-8000-0000000000b1"
MILESTONE = "01a1c4a0-e2e0-7000-8000-0000000000a1"


def item(kind: str, uid: str, slug: str, intent: str = "planned", target: str = "feature_exam", extra: str = "") -> str:
    return f'''s ::= import "./schema.zt";
h ::= import "./helpers.zt";
item :: s.Item = (h.{kind} "{uid}" "{slug}" "e2e" "Fixture {slug}" "The e2e fixture item {slug}.") with {{
  intent = #{intent};
  owns = {{ "components/e2e/**"; }};
  requirements = {{ (h.req "cases" "The exam observes three cases." {{ "{target}"; }}) with {{ provenance = h.fromHuman "three cases, each one a refusal" "docs/e2e.md"; }}; }};
  acceptance = {{ h.observedWhere "{target}" {{ h.count "casesObserved" 3; h.atLeast "negativeControlsRefused" 1; }}; }};
  {extra}
}};
item
'''


MILESTONE_EXTRA = '''nonGoals = { h.nonGoal "No more." h.agentDefault; };
  invariants = { h.invariant "m1" "Holds." h.agentDefault; };
  decisions = { h.decided "d1" "Do it." "Because." h.agentDefault { "cases"; }; };'''


class Fixture:
    def __init__(self, root: Path, keys: Path) -> None:
        self.root = root
        self.keys = keys
        self.env = os.environ | {
            "SPEC_EVIDENCE_REF": "refs/heads/evidence",
            "HOME": str(root.parent / "home"),
            "ZUTAI": lib.zutai(),
            "ZUTAI_STDLIB_ROOT": lib.stdlib_root(),
            "GIT_AUTHOR_NAME": "e2e", "GIT_AUTHOR_EMAIL": "e2e@example",
            "GIT_COMMITTER_NAME": "e2e", "GIT_COMMITTER_EMAIL": "e2e@example",
        }
        for key in ("SPEC_ROOT", "SPEC_JUDGE", "GITHUB_ACTIONS", "DEVLOOP_JUST_TARGET"):
            self.env.pop(key, None)

    def run(self, *args: str, check: bool = True) -> subprocess.CompletedProcess:
        return subprocess.run(args, cwd=self.root, env=self.env, check=check, text=True, capture_output=True)

    def spec(self, tool: str, *args: str) -> subprocess.CompletedProcess:
        return self.run(sys.executable, str(self.root / "scripts" / "spec" / tool), *args, check=False)

    def check(self, base: str = "main", author: str = "dev", approvers: str = "", *extra: str) -> subprocess.CompletedProcess:
        """Judge HEAD as CI does: the judge is extracted from `base`, never run from the head."""
        judge = self.root.parent / "judge"
        shutil.rmtree(judge, ignore_errors=True)
        judge.mkdir()
        archive = subprocess.run(["git", "archive", base, *lib.JUDGE_PATHS], cwd=self.root, capture_output=True, check=True).stdout
        subprocess.run(["tar", "-x", "-C", str(judge)], input=archive, check=True)
        env = self.env | {"SPEC_ROOT": str(self.root), "SPEC_JUDGE": "base"}
        command = [sys.executable, str(judge / "scripts" / "spec" / "check"), "--base", base, "--author", author, "--approvers", approvers, *extra]
        return subprocess.run(command, cwd=self.root, env=env, check=False, text=True, capture_output=True)

    def write(self, path: str, text: str) -> None:
        target = self.root / path
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(text, encoding="utf-8")

    def commit(self, message: str) -> None:
        self.run("git", "add", "-A")
        self.run("git", "commit", "-q", "-m", message)

    def branch(self, name: str, start: str = "main") -> None:
        self.run("git", "checkout", "-q", "-B", name, start)

    def merge(self, name: str) -> None:
        self.run("git", "checkout", "-q", "main")
        self.run("git", "merge", "-q", "--ff-only", name)

    def records(self, target: str) -> int:
        listing = self.run("git", "ls-tree", "--name-only", f"refs/heads/evidence:{target}", check=False).stdout.split()
        return sum(1 for name in listing if name.endswith(".zt"))

    def sign_key(self, name: str) -> str:
        return str(self.keys / name)


def build(root: Path, keys: Path) -> Fixture:
    root.mkdir(parents=True)
    for source in ("scripts/spec", "contracts/observation", "contracts/task"):
        shutil.copytree(ROOT / source, root / source, ignore=shutil.ignore_patterns("__pycache__", "e2e"))
    shutil.copyfile(HERE / "e2e", root / "scripts" / "spec" / "e2e")
    (root / "specs").mkdir()
    for name in ("schema.zt", "helpers.zt"):
        shutil.copyfile(ROOT / "specs" / name, root / "specs" / name)
    for directory in ("items", "terminal"):
        (root / ".tasks" / directory).mkdir(parents=True)
        for name in lib.ITEM_SOURCES:
            shutil.copyfile(ROOT / "contracts" / "task" / "v2" / name, root / ".tasks" / directory / name)
    keys.mkdir()
    signers = []
    for name in ("ci", "owner", "forger"):
        subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", name, "-f", str(keys / name)], check=True)
        if name != "forger":
            kind, key = (keys / f"{name}.pub").read_text().split()[:2]
            signers.append(f'{name} namespaces="slime-spec" {kind} {key}')
    fixture = Fixture(root, keys)
    fixture.write("specs/allowed_signers", "\n".join(signers) + "\n")
    fixture.write("HUMAN_OWNERS", "owner\nsecond\n")
    fixture.write("AGENT_ACCOUNTS", "# none yet\n")
    fixture.write("specs/e2e.zt", AREA)
    fixture.write("docs/e2e.md", "# Fixture\n")
    fixture.write("scripts/lib/e2e_judge.py", "CASES = 3\n")
    fixture.write("scripts/check/area-exam.py", EXAM)
    fixture.write("components/e2e/lib.rs", "// product\n")
    fixture.write("Justfile", JUSTFILE)
    fixture.write(".gitignore", "build/\n__pycache__/\n")
    fixture.run("git", "init", "-q", "-b", "main")
    fixture.commit("fixture")
    return fixture


def m1_planning(f: Fixture) -> None:
    done = f.spec("check")
    ok(done.returncode == 0, "check passes on the fixture", done.stdout + done.stderr)
    done = f.spec("ci", "--signer", "ci", "--key", f.sign_key("ci"))
    ok(done.returncode == 0 and f.records("area_exam") == 1, "an area target gets a record on the evidence branch", done.stdout + done.stderr)
    listing = f.run("git", "ls-tree", "--name-only", "refs/heads/evidence:area_exam", check=False).stdout.split()
    ok(any(name.endswith(".zt.sig") for name in listing), "the area record is signed", " ".join(listing))

    f.branch("planning")
    f.write(".tasks/items/feature-a.zt", item("task", FEATURE, "feature-a"))
    f.write("scripts/check/feature-exam.py", EXAM)
    f.write("Justfile", JUSTFILE + FEATURE_RECIPE)
    f.commit("plan feature-a")
    done = f.check()
    ok(done.returncode == 0 and "class: planning" in done.stdout, "a planning pull request passes", done.stdout + done.stderr)
    done = f.spec("tasks", "status", "--claimed")
    ok("feature_exam" not in done.stdout.split(), "a #planned item's target is not claimed", done.stdout + done.stderr)
    f.merge("planning")
    done = f.spec("ci", "--signer", "ci", "--key", f.sign_key("ci"))
    ok("claimed: none" in done.stdout and f.records("feature_exam") == 0, "a planning merge records nothing", done.stdout + done.stderr)

    f.branch("illegal")
    f.write(".tasks/items/feature-a.zt", item("task", FEATURE, "feature-a", intent="blocked"))
    f.commit("planned to blocked")
    refused(f.check(), "V5", "an illegal intent transition (#planned -> #blocked)")
    f.branch("cancel")
    f.write(".tasks/items/feature-a.zt", item("task", FEATURE, "feature-a", intent="cancelled"))
    f.commit("cancel")
    refused(f.check(), "V4", "entering #cancelled without an approval")
    done = f.check("main", "dev", "owner")
    ok(done.returncode == 0, "entering #cancelled with an owner's approval passes", done.stdout + done.stderr)

    f.branch("backlog-base")
    f.write(".tasks/items/open-bug.zt", item("bug", BUG, "open-bug", target="area_exam"))
    f.write(".tasks/items/big-thing.zt", item("milestone", MILESTONE, "big-thing", target="area_exam", extra=MILESTONE_EXTRA))
    f.commit("bug and milestone")
    f.branch("backlog", "backlog-base")
    f.write(".tasks/items/big-thing.zt", item("milestone", MILESTONE, "big-thing", intent="active", target="area_exam", extra=MILESTONE_EXTRA))
    f.write("components/e2e/lib.rs", "// milestone work\n")
    f.commit("start the milestone")
    refused(f.check("backlog-base"), "V7", "a milestone starting beside an open backlog bug")
    f.branch("backlog-clear-base", "backlog-base")
    f.write(".tasks/items/open-bug.zt", item("bug", BUG, "open-bug", intent="deferred", target="area_exam"))
    f.commit("defer the bug")
    f.branch("backlog-clear", "backlog-clear-base")
    f.write(".tasks/items/big-thing.zt", item("milestone", MILESTONE, "big-thing", intent="active", target="area_exam", extra=MILESTONE_EXTRA))
    f.write("components/e2e/lib.rs", "// milestone work\n")
    f.commit("start the milestone")
    done = f.check("backlog-clear-base")
    ok(done.returncode == 0, "a milestone starts once the backlog bug is deferred", done.stdout + done.stderr)
    f.run("git", "checkout", "-q", "main")


def m2_classes(f: Fixture) -> None:
    f.branch("mixed")
    f.write("scripts/check/feature-exam.py", EXAM + "# stricter\n")
    f.write("components/e2e/lib.rs", "// product and checker together\n")
    f.commit("checker and product")
    refused(f.check("main", "dev", "owner"), "V1", "a pull request carrying a checker and product code")

    f.branch("self-approved")
    f.write("scripts/check/feature-exam.py", EXAM + "# stricter\n")
    f.commit("checker change")
    refused(f.check("main", "owner", "owner"), "V4", "a grader change its author approved alone")
    done = f.check("main", "owner", "second")
    ok(done.returncode == 0 and "class: planning" in done.stdout, "the same change approved by another owner passes", done.stdout + done.stderr)

    f.branch("judge-rewrite")
    judge = f.root / "scripts" / "spec" / "check"
    judge.write_text(judge.read_text().replace("def main() -> int:\n", "def main() -> int:\n    return 0\n", 1))
    f.commit("make the judge pass")
    refused(f.check(), "V4", "a pull request rewriting scripts/spec/check to pass itself")

    f.branch("unlisted")
    f.write("weird/thing.txt", "?\n")
    f.commit("unlisted")
    refused(f.check(), "V1", "a pull request touching a path the class table does not list")

    f.branch("unowned")
    f.write("components/other/lib.rs", "// nobody owns this\n")
    f.commit("unowned product code")
    refused(f.check(), "V2", "product code no #active item owns")
    f.run("git", "checkout", "-q", "main")


def m3_closeout(f: Fixture) -> None:
    f.branch("implementation")
    f.write(".tasks/items/feature-a.zt", item("task", FEATURE, "feature-a", intent="active"))
    f.write("components/e2e/lib.rs", "// feature-a\n")
    f.commit("implement feature-a")
    done = f.check()
    ok(done.returncode == 0 and "class: implementation" in done.stdout, "an implementation pull request passes", done.stdout + done.stderr)
    f.merge("implementation")
    done = f.spec("ci", "--signer", "ci", "--key", f.sign_key("ci"))
    ok(f.records("feature_exam") == 1, "the #active item's target is recorded", done.stdout + done.stderr)
    area_records = f.records("area_exam")
    before_witness = f.run("git", "rev-parse", "refs/heads/evidence").stdout.strip()
    done = f.spec("ci", "--witness", "--signer", "ci", "--key", f.sign_key("ci"))
    publish = f.spec("ci", "--publish")
    witness = f.run("git", "ls-tree", "-r", "--name-only", "refs/heads/evidence", "done").stdout
    ok(FEATURE in witness and witness.count(".zt.sig") == 1, "a signed done witness reaches the evidence branch", done.stdout + done.stderr + publish.stdout + publish.stderr)

    f.write("docs/e2e.md", "# Fixture\n\nMain moves on.\n")
    f.commit("docs on main")
    done = f.spec("ci", "--signer", "ci", "--key", f.sign_key("ci"))
    ok("claimed: none" in done.stdout and f.records("feature_exam") == 1 and f.records("area_exam") == area_records, "no target is recorded again after main moves", done.stdout + done.stderr)

    done = f.spec("closeout", "--forge", "local", "--dry-run")
    ok("closeout/feature-a" in done.stdout, "the closeout bot prepares one move", done.stdout + done.stderr)
    f.run("git", "checkout", "-q", "closeout/feature-a")
    done = f.check()
    ok(done.returncode == 0 and "class: closeout" in done.stdout, "the closeout pull request passes after main moved past the witness", done.stdout + done.stderr)
    refused(f.check("main", "dev", "", "--evidence", before_witness), "V6", "a closeout without a done witness")

    forged = f.root.parent / "forged" / "done"
    shutil.copytree(f.root / "build" / "observations" / "done", forged)
    for path in forged.rglob("*.zt"):
        path.with_name(path.name + ".sig").unlink(missing_ok=True)
        subprocess.run(["ssh-keygen", "-q", "-Y", "sign", "-f", f.sign_key("forger"), "-n", lib.SIGN_NAMESPACE, str(path)], check=True, stdin=subprocess.DEVNULL)
    entries = {p.relative_to(forged.parent).as_posix(): p.read_bytes() for p in forged.rglob("*") if p.is_file()}
    refused(f.check("main", "dev", "", "--evidence", forge_commit(f, before_witness, entries)), "V6", "a closeout whose witness a key outside allowed_signers signed")

    f.merge("closeout/feature-a")
    f.branch("edit-terminal")
    path = f.root / ".tasks" / "terminal" / "feature-a.zt"
    path.write_text(path.read_text().replace("Fixture feature-a", "Fixture feature-a, edited"))
    f.commit("edit a terminal item")
    refused(f.check(), "V6", "an edited terminal item")
    f.run("git", "checkout", "-q", "main")


def forge_commit(f: Fixture, parent: str, entries: dict[str, bytes]) -> str:
    """An evidence commit holding `entries` on top of `parent`, for the forged-witness control."""
    index = f.root.parent / "forged-index"
    env = f.env | {"GIT_INDEX_FILE": str(index)}
    subprocess.run(["git", "read-tree", parent], cwd=f.root, env=env, check=True)
    for path, data in entries.items():
        blob = subprocess.run(["git", "hash-object", "-w", "--stdin"], cwd=f.root, input=data, capture_output=True, check=True).stdout.decode().strip()
        subprocess.run(["git", "update-index", "--add", "--cacheinfo", f"100644,{blob},{path}"], cwd=f.root, env=env, check=True)
    tree = subprocess.run(["git", "write-tree"], cwd=f.root, env=env, capture_output=True, text=True, check=True).stdout.strip()
    return subprocess.run(["git", "commit-tree", tree, "-p", parent, "-m", "forged"], cwd=f.root, env=f.env, capture_output=True, text=True, check=True).stdout.strip()


def owners_floor(f: Fixture) -> None:
    f.branch("one-owner-base")
    f.write("HUMAN_OWNERS", "owner\n")
    f.commit("one owner")
    f.branch("one-owner", "one-owner-base")
    f.write("docs/e2e.md", "# Fixture\n\nA process change.\n")
    f.commit("docs")
    refused(f.check("one-owner-base"), "V4", "any pull request while HUMAN_OWNERS lists one person")
    f.run("git", "checkout", "-q", "main")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--keep", action="store_true")
    args = parser.parse_args()
    temporary = Path(tempfile.mkdtemp(prefix="slime-spec-e2e-"))
    try:
        (temporary / "home").mkdir()
        fixture = build(temporary / "repo", temporary / "keys")
        m1_planning(fixture)
        m2_classes(fixture)
        m3_closeout(fixture)
        owners_floor(fixture)
    finally:
        if args.keep:
            print(f"kept {temporary}")
        else:
            shutil.rmtree(temporary, ignore_errors=True)
    print(f"e2e: {len(PASSED)} passed, {len(FAILED)} failed, {len(REFUSED)} negative control(s) refused")
    target = os.environ.get("DEVLOOP_JUST_TARGET")
    if target:
        report = ROOT / "build" / "devloop-observations" / f"{target}.json"
        report.parent.mkdir(parents=True, exist_ok=True)
        report.write_text(json.dumps({"casesObserved": len(PASSED) + len(FAILED), "negativeControlsRefused": len(REFUSED)}, sort_keys=True) + "\n")
    return 1 if FAILED else 0


if __name__ == "__main__":
    raise SystemExit(main())
