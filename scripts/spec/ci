#!/usr/bin/env python3
"""Run every claimed target and commit the records: the evidence job's body.

    scripts/spec/ci [--runner ci] [--signer PRINCIPAL --key PATH]

Host-neutral: the workflow fetches the evidence ref before and pushes
`refs/heads/evidence` after. A failing target still yields a record (it
publishes as failing); the exit status is non-zero only when publish
itself refused something or no record could be written.
"""

from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import lib  # noqa: E402

HERE = Path(__file__).resolve().parent


def claimed() -> list[str]:
    evidence = lib.Evidence()
    targets: set[str] = set()
    for area in lib.load_areas():
        for requirement in area.requirements:
            if requirement["planned"]:
                continue
            for tag, payload in lib.acceptances(requirement):
                if tag == "observed" and evidence.record(payload["justTarget"])[0] == "claimed":
                    targets.add(payload["justTarget"])
    return sorted(targets)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--runner", default="ci")
    parser.add_argument("--signer")
    parser.add_argument("--key")
    args = parser.parse_args()

    targets = claimed()
    print(f"[ci] claimed: {' '.join(targets) or 'none'}", flush=True)
    if not targets:
        return 0
    outcomes = {}
    for target in targets:
        command = [sys.executable, str(HERE / "record"), target, "--runner", args.runner]
        if args.signer and args.key:
            command += ["--signer", args.signer, "--key", args.key]
        outcomes[target] = subprocess.run(command, cwd=lib.ROOT, check=False).returncode
    for target, code in outcomes.items():
        print(f"[ci] {target}: {'passed' if code == 0 else f'failed ({code})'}", flush=True)
    published = subprocess.run([sys.executable, str(HERE / "publish")], cwd=lib.ROOT, check=False).returncode
    return published


if __name__ == "__main__":
    raise SystemExit(main())
