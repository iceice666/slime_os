#!/usr/bin/env python3
"""Rehome dev-spec/v1 work items into one `specs/<area>.zt`.

    scripts/spec/migrate --plane planes-runtime --area runtime --title "..." \
        [--owns GLOB ...] [--out specs/runtime.zt] [--include-open]

Every spec-driven item whose acceptances bind a `just` target declared in
`just/<plane>.just` becomes requirements of the area: the item's UUID
becomes a legacy id in `supersedes`, each requirement gets a fresh UUIDv7,
acceptance predicates are translated to `specs/helpers.zt`, and the item's
`nonGoals` join the area's. `cancelled` items are skipped; `open` items
become `planned` only with `--include-open`. `deferred` and `blocked`
items have prose bodies and are not rehomed. The output is a starting
point for a person to review, not a finished area file.
"""

from __future__ import annotations

import argparse
import json
import re
import sys
import tempfile
import textwrap
import uuid
from collections import defaultdict
from pathlib import Path

import yaml

sys.path.insert(0, str(Path(__file__).resolve().parent))
import lib  # noqa: E402

ITEMS = lib.ROOT / ".tasks" / "items"
INPUTS = lib.ROOT / ".devloop" / "inputs"
FENCE = re.compile(r"```zti\n(.*?)\n```", re.S)
ADMISSION = re.compile(r"^slime-(.*?)-\d{8}[a-z]?$")


def text(value: str) -> str:
    return json.dumps(value, ensure_ascii=False)


def plane_of_recipes() -> dict[str, str]:
    """recipe name -> `just/<stem>.just` stem it is declared in."""
    planes: dict[str, str] = {}
    for just in sorted((lib.ROOT / "just").glob("*.just")):
        for match in re.finditer(r"^([a-z][a-z0-9_]*)(?:\s+[^:\n]*)?:(?!=)", just.read_text(), re.M):
            planes.setdefault(match.group(1), just.stem)
    return planes


def inputs_by_digest() -> dict[str, tuple[str, str]]:
    """sha256 of an inputs file -> (file name, justTarget)."""
    import hashlib

    table = {}
    for path in INPUTS.glob("*.json"):
        target = json.loads(path.read_text()).get("justTarget", "")
        table[hashlib.sha256(path.read_bytes()).hexdigest()] = (path.name, target)
    return table


def inputs_by_name() -> dict[str, str]:
    return {path.stem: json.loads(path.read_text()).get("justTarget", "") for path in INPUTS.glob("*.json")}


def load_item(path: Path) -> tuple[dict, dict] | None:
    raw = path.read_text(encoding="utf-8")
    if "dev-spec/v1" not in raw:
        return None
    head, _, rest = raw[4:].partition("\n---\n")
    front = yaml.safe_load(head)
    match = FENCE.search(rest)
    if not match:
        return None
    with tempfile.NamedTemporaryFile("w", suffix=".zti", delete=False, encoding="utf-8") as handle:
        handle.write(match.group(1))
        temp = Path(handle.name)
    try:
        body = lib.zutai_json(temp)
    finally:
        temp.unlink(missing_ok=True)
    title = re.search(r"^# (.+)$", rest, re.M)
    front["title"] = title.group(1).strip() if title else path.stem
    return front, body


def predicates_of(body: dict) -> dict[str, dict]:
    return {p["id"]: p for p in body.get("predicates", [])}


def translate(predicate_id: str, table: dict[str, dict], warnings: list[str]) -> list[str]:
    """Helper calls for one dev-spec/v1 predicate; `passed = true` is implicit."""
    predicate = table[predicate_id]
    kind, key, expected = predicate["kind"], predicate["observation"], predicate["expected"]
    if kind == "all":
        return [call for member in predicate["members"] for call in translate(member, table, warnings)]
    if kind == "equal" and expected["kind"] == "bool":
        if key == "passed" and expected["boolValue"]:
            return []
        if expected["boolValue"]:
            return [f'h.flag {text(key)}']
        warnings.append(f"predicate {predicate_id}: `{key} = false` has no helper; dropped")
        return []
    if kind == "equal" and expected["kind"] == "int":
        return [f'h.count {text(key)} {expected["intValue"]}']
    if kind == "bounds":
        calls = []
        lower = predicate["lower"] if predicate["lowerInclusive"] else predicate["lower"] + 1
        upper = predicate["upper"] if predicate["upperInclusive"] else predicate["upper"] - 1
        calls.append(f"h.atLeast {text(key)} {lower}")
        if upper < 1_000_000:
            calls.append(f"h.atMost {text(key)} {upper}")
        return calls
    warnings.append(f"predicate {predicate_id}: kind {kind}/{expected['kind']} has no helper; dropped")
    return []


def target_of(acceptance_id: str, front: dict, by_digest: dict, by_name: dict) -> str:
    for record in front.get("devloop", {}).get("evidence", []):
        if record.get("acceptance") == acceptance_id:
            hit = by_digest.get(record.get("identity", {}).get("inputs", ""))
            if hit:
                return hit[1]
    admission = front.get("devloop", {}).get("admission", "")
    match = ADMISSION.match(admission)
    if match and match.group(1) in by_name:
        return by_name[match.group(1)]
    return ""


def render_acceptance(acc: dict, target: str, table: dict, warnings: list[str]) -> str:
    rationale = text(acc["rationale"])
    if acc["mode"] == "human":
        return f'        h.human {text(acc["id"])} {text(acc["gate"])} {rationale};'
    if acc["gate"] == "work-item-store":
        target = target or "tasks_check"
    if not target:
        warnings.append(f"acceptance {acc['id']}: no just target resolved; left as TODO")
        target = "TODO"
    calls = translate(acc["predicate"], table, warnings)
    preds = "h.noPredicates" if not calls else "{ " + " ".join(c + ";" for c in calls) + " }"
    return f'        h.observedWhere {text(acc["id"])} {text(target)} {preds} {rationale};'


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--plane", required=True, help="stem of just/<plane>.just")
    parser.add_argument("--area", required=True)
    parser.add_argument("--title", required=True)
    parser.add_argument("--owns", action="append", default=[])
    parser.add_argument("--out", type=Path)
    parser.add_argument("--include-open", action="store_true")
    args = parser.parse_args()

    planes = plane_of_recipes()
    by_digest = inputs_by_digest()
    by_name = inputs_by_name()
    warnings: list[str] = []
    blocks: list[str] = []
    non_goals: list[str] = []
    counts: dict[str, int] = defaultdict(int)

    for path in sorted(ITEMS.glob("*.md")):
        loaded = load_item(path)
        if loaded is None:
            continue
        front, body = loaded
        state = front["state"]
        if state == "cancelled" or (state == "open" and not args.include_open):
            continue
        accs = {a["id"]: a for a in body["acceptance"]}
        targets = {a["id"]: target_of(a["id"], front, by_digest, by_name) for a in body["acceptance"]}
        item_planes = {planes.get(t) for t in targets.values() if t}
        if args.plane not in item_planes:
            continue
        if len(item_planes - {None}) > 1:
            warnings.append(f"{front['id']} ({front['title']}): targets span planes {sorted(p for p in item_planes if p)}")
        counts[state] += 1
        non_goals.extend(g for g in body.get("nonGoals", []) if g not in non_goals)
        table = predicates_of(body)
        blocks.append(f"    -- legacy {front['id']} ({state}): {front['title']}")
        blocks.extend(f"    -- {line}" for line in textwrap.wrap(body["problem"], 100))
        for requirement in body["requirements"]:
            lines = [render_acceptance(accs[a], targets.get(a, ""), table, warnings) for a in requirement["acceptance"]]
            rendered = "{\n" + "\n".join(lines) + "\n      }" if lines else "h.noAcceptance"
            new_id = str(uuid.uuid7())
            if state == "open":
                head = f'    (h.planned {text(new_id)}\n      {text(requirement["statement"])}\n      {text(front["title"])}\n      {text("open when rehomed; see legacy item")}\n      {rendered})'
            else:
                head = f'    (h.req {text(new_id)}\n      {text(requirement["statement"])}\n      {text(front["title"])}\n      {rendered})'
            blocks.append(f'{head} with {{ supersedes = {{ {text(front["id"])}; }}; }};')

    owns = "".join(f"\n    {text(g)};" for g in args.owns) or ";"
    goals = "".join(f"\n      {text(g)};" for g in non_goals) or ";"
    out = (
        "s ::= import \"./schema.zt\";\n"
        "h ::= import \"./helpers.zt\";\n\n"
        f"area :: s.Area = (h.area {text(args.area)} {text(args.title)} {{{owns}\n  }} {{\n"
        + "\n".join(blocks)
        + "\n  }) with {\n"
        f"    nonGoals = {{{goals}\n    }};\n"
        "  };\n\narea\n"
    )
    if args.out:
        args.out.write_text(out, encoding="utf-8")
    else:
        sys.stdout.write(out)
    for warning in warnings:
        print(f"warning: {warning}", file=sys.stderr)
    print(f"rehomed {dict(counts)} items into area {args.area}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
