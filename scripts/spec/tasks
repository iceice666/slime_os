#!/usr/bin/env python3
"""Work items under `.tasks/` (decision: docs/decisions/work-item-devloop.md).

    scripts/spec/tasks check [--base <ref> --approvers a,b]
    scripts/spec/tasks status [--local] [--json] [--item SLUG]
    scripts/spec/tasks human <slug> <acceptance> yes|no --signer <principal> [--key K]
    scripts/spec/tasks new <task|bug|milestone> <slug> --area <area>

`check` refuses: a file whose final value is not a `task/v1` Item, a slug
that is not the file name, an id that is not a UUIDv7 or repeats, a
`parent` or `depends` that names no item, an `area` with no
`specs/<area>.zt`, an acceptance id that repeats, a requirement that names
no acceptance of its item, an item without a mandatory machine acceptance
(`h.observed` or `h.clause`), a `justTarget` that `just --dump` does not
declare, a milestone with an empty owns, nonGoals, requirements,
acceptance, invariants or decisions list, a decision `binds` that names
nothing, a `#decision` provenance whose page does not exist, a known limit
outside R1-R4, a `.zti` under `.tasks/`, and a `terminal/` copy of
`schema.zt` or `helpers.zt` that differs from `items/`.

`check --base` also judges the diff merge-base..HEAD. T1: an item that
enters `.tasks/terminal/` must be done. T2: if the diff touches the `owns`
of an item whose mandatory acceptance is failing at the current closure
digest, that item must carry a known limit `failing` naming the acceptance;
a known limit the diff adds needs an approval from `HUMAN_OWNERS`.

`status` computes each acceptance from the evidence branch, as
`scripts/spec/status` does for areas. An item is done when every mandatory
acceptance is enforced; otherwise it reports its worst mandatory state.
It prints the `agentDefault` share of each item's rules.

`human` signs an answer to an item's `h.human` acceptance; the record binds
to the item's requirements digest.

`new` prints a skeleton with a fresh UUIDv7; redirect it to the file.
"""

from __future__ import annotations

import argparse
import json
import sys
import time
import uuid
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import lib  # noqa: E402

RATCHETS = ("R1", "R2", "R3", "R4", "failing")
MILESTONE_LISTS = ("owns", "nonGoals", "requirements", "acceptance", "invariants", "decisions")


def check_provenance(where: str, provenance: object, errors: list[str]) -> None:
    kind = lib.tag(provenance)
    body = lib.payload(provenance)
    if kind == "human" and not (body.get("quote", "").strip() and body.get("source", "").strip()):
        errors.append(f"{where}: a #human provenance needs a quote and a source")
    if kind == "decision" and not (lib.ROOT / body.get("page", "")).is_file():
        errors.append(f"{where}: provenance names {body.get('page')!r}, which does not exist")


def check_item(item: lib.Item, recipes: lib.Recipes, areas: set[str], errors: list[str]) -> None:
    v, where = item.value, item.where
    if v["slug"] != item.path.stem:
        errors.append(f"{where}: slug {v['slug']!r} is not the file name")
    if not lib.UUID7.match(v["id"]):
        errors.append(f"{where}: id {v['id']!r} is not a UUIDv7")
    if v["area"] not in areas:
        errors.append(f"{where}: area {v['area']!r} has no specs/<area>.zt")
    for field in ("title", "problem"):
        if not v[field].strip():
            errors.append(f"{where}: {field} is empty")
    if lib.tag(v["kind"]) == "milestone":
        for field in MILESTONE_LISTS:
            if not v[field]:
                errors.append(f"{where}: a milestone needs a non-empty {field}")
    ids = [a["id"] for a in v["acceptance"]]
    if len(ids) != len(set(ids)):
        errors.append(f"{where}: acceptance ids repeat: {ids}")
    machine = [a for a in v["acceptance"] if a["mandatory"] and lib.tag(a["check"]) in {"observed", "clause"}]
    if not machine:
        errors.append(f"{where}: an item needs at least one mandatory h.observed or h.clause acceptance")
    for acceptance in v["acceptance"]:
        body = lib.payload(acceptance["check"])
        if lib.tag(acceptance["check"]) == "observed" and body["justTarget"] not in recipes:
            errors.append(f"{where}: acceptance {acceptance['id']} binds {body['justTarget']!r}, which `just --dump` does not declare")
    binders = set(ids)
    for requirement in v["requirements"]:
        binders.add(requirement["id"])
        if not requirement["statement"].strip():
            errors.append(f"{where}: requirement {requirement['id']} has an empty statement")
        for named in requirement["acceptance"]:
            if named not in ids:
                errors.append(f"{where}: requirement {requirement['id']} names acceptance {named!r}, which this item lacks")
        check_provenance(f"{where} requirement {requirement['id']}", requirement["provenance"], errors)
    for decision in v["decisions"]:
        for bound in decision["binds"]:
            if bound not in binders:
                errors.append(f"{where}: decision {decision['id']} binds {bound!r}, which is no requirement or acceptance of this item")
        check_provenance(f"{where} decision {decision['id']}", decision["provenance"], errors)
    for entry in v["invariants"] + v["nonGoals"]:
        check_provenance(f"{where} {entry.get('id', 'nonGoal')}", entry["provenance"], errors)
    for limit in v["knownLimits"]:
        if limit["ratchet"] not in RATCHETS or not limit["subject"].strip() or not limit["reason"].strip():
            errors.append(f"{where}: known limit {limit} needs a ratchet in {RATCHETS}, a subject and a reason")
        check_provenance(f"{where} known limit {limit['ratchet']}", limit["provenance"], errors)


def check(items: list[lib.Item], recipes: lib.Recipes) -> list[str]:
    errors: list[str] = []
    for stray in (lib.ROOT / ".tasks").rglob("*.zti"):
        errors.append(f"{stray.relative_to(lib.ROOT)}: .zti is computed, never committed")
    if lib.TERMINAL.is_dir():
        for name in lib.ITEM_SOURCES:
            copy, canonical = lib.TERMINAL / name, lib.ITEMS / name
            if not copy.is_file() or copy.read_bytes() != canonical.read_bytes():
                errors.append(f".tasks/terminal/{name}: must be a byte-identical copy of .tasks/items/{name}")
    areas = {p.stem for p in lib.area_files()}
    by_id: dict[str, lib.Item] = {}
    for item in items:
        check_item(item, recipes, areas, errors)
        if item.id in by_id:
            errors.append(f"{item.where}: id {item.id} is already used by {by_id[item.id].where}")
        by_id[item.id] = item
    for item in items:
        for named in [item.value["parent"]] * bool(item.value["parent"]) + item.value["depends"]:
            if named not in by_id:
                errors.append(f"{item.where}: parent or depends names {named!r}, which is no item")
    return errors


def statuses(items: list[lib.Item], evidence: lib.Evidence) -> list[dict]:
    report = []
    for item in items:
        rows = []
        for acceptance in item.value["acceptance"]:
            state, detail = lib.item_acceptance_state(acceptance, item.value, evidence)
            body = lib.payload(acceptance["check"])
            rows.append({"id": acceptance["id"], "kind": lib.tag(acceptance["check"]), "target": body.get("justTarget", ""),
                         "mandatory": acceptance["mandatory"], "state": state, "reason": detail})
        agent, total = lib.provenance_share(item.value)
        report.append({
            "id": item.id, "slug": item.value["slug"], "kind": lib.tag(item.value["kind"]), "area": item.value["area"],
            "title": item.value["title"], "parent": item.value["parent"], "terminal": item.terminal,
            "state": lib.item_state([(r["mandatory"], r["state"]) for r in rows]),
            "agentDefault": agent, "rules": total, "acceptances": rows,
        })
    return report


def judge_base(base: str, approvers: set[str], items: list[lib.Item], errors: list[str]) -> None:
    changed = lib.changed_files(base)
    merge_base = lib.git("merge-base", base, "HEAD").strip()
    before = {i.id: i for i in lib.load_items_at(merge_base)}
    evidence = lib.Evidence()
    by_id = {r["id"]: r for r in statuses(items, evidence)}
    reasons: list[str] = []
    for item in items:
        row, old = by_id[item.id], before.get(item.id)
        if item.terminal and not (old and old.terminal) and row["state"] != "done":
            errors.append(f"T1: {item.where} enters terminal/ but its state is {row['state']}")
        limits = {(k["ratchet"], k["subject"]) for k in item.value["knownLimits"]}
        added = limits - {(k["ratchet"], k["subject"]) for k in (old.value["knownLimits"] if old else [])}
        reasons += [f"known limit {r} {s} added to {item.value['slug']}" for r, s in sorted(added)]
        if not any(lib.owns_match(p, item.value["owns"]) for p in changed):
            continue
        for acc in row["acceptances"]:
            if acc["mandatory"] and acc["state"] == "failing" and ("failing", acc["id"]) not in limits:
                errors.append(f"T2: the diff touches the owns of {item.value['slug']}, whose acceptance {acc['id']} is failing ({acc['reason']}); fix it or add h.knownLimit \"failing\" \"{acc['id']}\"")
    humans = approvers & lib.human_owners()
    for reason in reasons:
        print(f"approval: {reason}", file=sys.stderr)
    if reasons and not humans:
        errors.append(f"approval: {len(reasons)} known limit(s) need an approval from HUMAN_OWNERS; approvers given: {sorted(approvers) or 'none'}")


def human(slug: str, acceptance_id: str, value: str, signer: str, key: str, note: str) -> int:
    item = next((i for i in lib.load_items() if i.value["slug"] == slug), None)
    if item is None:
        raise lib.SpecError(f"tasks human: no item {slug!r}")
    gate = next((a for a in item.value["acceptance"] if a["id"] == acceptance_id and lib.tag(a["check"]) == "human"), None)
    if gate is None:
        raise lib.SpecError(f"tasks human: item {slug} has no h.human acceptance {acceptance_id!r}")
    print(f"{lib.payload(gate['check'])['question']}\nanswer: {value}", file=sys.stderr)
    observed_at = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    text = lib.human_record_text(item.value["area"], item.id, acceptance_id, lib.item_digest(item.value), value == "yes", note, signer, observed_at)
    out = lib.OBSERVATIONS / lib.item_human_path(item.value, acceptance_id)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(text, encoding="utf-8")
    lib.parse_record(out.read_bytes(), "HumanRecord")
    signature = lib.sign(out, key)
    ok = lib.verify_signature(out.read_bytes(), signature.read_bytes(), signer)
    print(f"tasks human: wrote {out.relative_to(lib.ROOT)}" + ("" if ok else f" (WARNING: {signer!r} does not verify)"))
    return 0 if ok else 1


def print_status(report: list[dict], evidence: lib.Evidence, local: bool) -> None:
    for row in report:
        where = "terminal" if row["terminal"] else "open"
        print(f"{row['state']:<9} {row['slug']} ({row['kind']}, {where}, area {row['area']}): {row['title']}")
        print(f"          agentDefault {row['agentDefault']}/{row['rules']} rule(s)")
        for acc in row["acceptances"]:
            target = f" {acc['target']}" if acc["target"] else ""
            print(f"          {acc['state']:<9} {acc['id']}{target}: {acc['reason']}")
    done = sum(1 for row in report if row["state"] == "done")
    print(f"evidence: {evidence.ref or 'none'}{' + local' if local else ''}; {done}/{len(report)} item(s) done")


SKELETON = '''s ::= import "./schema.zt";
h ::= import "./helpers.zt";

item :: s.Item = (h.{kind} "{id}" "{slug}" "{area}"
  "<title>"
  "<problem: what is wrong or missing today, in two or three sentences>")
  with {{
    owns = {{ "<path glob>"; }};
    requirements = {{
      h.req "<requirement id>" "<statement>" {{ "<just target>"; }};
    }};
    acceptance = {{
      h.observed "<just target>";
    }};
  }};

item
'''


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    checker = sub.add_parser("check")
    checker.add_argument("--base")
    checker.add_argument("--approvers", default="")
    status = sub.add_parser("status")
    status.add_argument("--local", action="store_true")
    status.add_argument("--json", action="store_true")
    status.add_argument("--item")
    answer = sub.add_parser("human")
    answer.add_argument("slug")
    answer.add_argument("acceptance")
    answer.add_argument("value", choices=("yes", "no"))
    answer.add_argument("--signer", required=True)
    answer.add_argument("--key", default=str(Path.home() / ".ssh" / "id_ed25519"))
    answer.add_argument("--note", default="")
    new = sub.add_parser("new")
    new.add_argument("kind", choices=("task", "bug", "milestone"))
    new.add_argument("slug")
    new.add_argument("--area", required=True)
    args = parser.parse_args()

    if args.command == "new":
        if not lib.AREA_ID.match(args.slug):
            parser.error(f"slug must match {lib.AREA_ID.pattern}")
        print(SKELETON.format(kind=args.kind, id=uuid.uuid7(), slug=args.slug, area=args.area), end="")
        return 0

    if args.command == "human":
        return human(args.slug, args.acceptance, args.value, args.signer, args.key, args.note)
    items = lib.load_items()
    if args.command == "status":
        evidence = lib.Evidence(local=args.local)
        report = statuses([i for i in items if not args.item or i.value["slug"] == args.item], evidence)
        if args.json:
            json.dump({"schema": "task-status/v1", "evidenceRef": evidence.ref, "items": report}, sys.stdout, indent=1, sort_keys=True)
            print()
        else:
            print_status(report, evidence, args.local)
        return 0
    errors = check(items, lib.Recipes.load())
    if args.base:
        judge_base(args.base, {a.strip() for a in args.approvers.split(",") if a.strip()}, items, errors)
    for error in errors:
        print(f"error: {error}", file=sys.stderr)
    if errors:
        return 1
    terminal = sum(1 for i in items if i.terminal)
    print(f"tasks check: {len(items) - terminal} open, {terminal} terminal item(s)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
