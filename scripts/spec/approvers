#!/usr/bin/env python3
"""Print the logins whose latest review approves the pull request's head commit.

    scripts/spec/approvers <owner/repo> <pr number> <head sha>

Reads every page of the reviews through `gh api`. A review of an earlier
commit, or an approval a later review by the same login replaced, does not
count. Prints the logins comma-separated; the gates intersect them with
HUMAN_OWNERS at the base.
"""

from __future__ import annotations

import json
import subprocess
import sys


def main() -> int:
    if len(sys.argv) != 4:
        raise SystemExit(__doc__)
    repo, number, head = sys.argv[1:]
    done = subprocess.run(
        ["gh", "api", "--paginate", f"repos/{repo}/pulls/{number}/reviews", "--jq", ".[] | {login: .user.login, state, commit: .commit_id}"],
        check=True,
        text=True,
        capture_output=True,
    )
    latest: dict[str, str] = {}
    for line in done.stdout.splitlines():
        review = json.loads(line)
        if review["state"] in {"APPROVED", "CHANGES_REQUESTED", "DISMISSED"}:
            latest[review["login"]] = review["state"] if review["commit"] == head else "STALE"
    print(",".join(sorted(login for login, state in latest.items() if state == "APPROVED")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
