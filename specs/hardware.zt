      }) with { supersedes = { "01a18328-71de-7291-922f-87adc0b3a8cc"; }; };
    (h.req "01a1b49c-ada1-7700-83f1-0e8f53178c55"
      "`just zenoh_service_client_wire_check` exits zero and reports its observations through the gate adapter."
      "Generate and judge the Zenoh service client wire records"
      {
        h.observedWhere "recipe-passed" "zenoh_service_client_wire_check" h.noPredicates "The gate adapter reports the recipe's exit code, so the checker cannot vouch for itself. The recipe fails until the generated file lands.";
