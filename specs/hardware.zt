        h.observedWhere "cases-observed" "zenoh_service_client_check" { h.count "casesObserved" 24; } "The checker counts 24 facts that the judge derives from the schema text. They are constants, layouts, IO0 fit, signs, the row index, the data page, distinct values, flags and a served holder. The count is exact. The judge reads no Rust, so these facts come from the schema and the two contracts it is checked against.";
      }) with { supersedes = { "01a17dad-fa21-739d-a55e-ef59fa3ce0ea"; }; };
