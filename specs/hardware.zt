      }) with { supersedes = { "01a1514d-8af5-7fa1-a4c2-70be8785fb2e"; }; };
    -- legacy 01a15d1f-1f52-7d62-806f-90ef3c119b59 (done): Zenoh Profile 0 session holding several subscriptions of its own
    -- A Zenoh Profile 0 session holds one subscription of its own. `Session::send_declare_subscriber`
    -- refuses the second as `subscriber-limit`, because the limit is a constant in the code. `zenoh-link-
    -- limits/v1` can raise the peer's count and cannot raise this one. A component that serves several
    -- consumers must declare one subscription per key, so it cannot be built on this session. A probe on
    -- the unmodified session accepted the first declaration and refused the second.
    (h.req "01a1b49c-aca0-7188-a162-b7471bd089a4"
      "A session built with `local` 3 accepts three declarations of its own and refuses a fourth as `subscriber-limit`."
      "Zenoh Profile 0 session holding several subscriptions of its own"
      {
        h.observedWhere "cases-observed" "zenoh_subscribers_check" { h.count "casesObserved" 28; } "The checker counts 7 scenarios and 8 delivered samples, 15 in all, and 13 refusals by name and class. The total is 28. The count is exact, because a missing or extra case changes it. The checker reports it only after the links exam and the stock-peer exam pass.";
      }) with { supersedes = { "01a15d1f-1f52-7d62-806f-90ef3c119b59"; }; };
    (h.req "01a1b49c-aca0-7188-a162-b7485d2c796b"
      "A declaration that reuses a held id is refused as `subscriber-limit`."
      "Zenoh Profile 0 session holding several subscriptions of its own"
      {
        h.observedWhere "cases-observed" "zenoh_subscribers_check" { h.count "casesObserved" 28; } "The checker counts 7 scenarios and 8 delivered samples, 15 in all, and 13 refusals by name and class. The total is 28. The count is exact, because a missing or extra case changes it. The checker reports it only after the links exam and the stock-peer exam pass.";
