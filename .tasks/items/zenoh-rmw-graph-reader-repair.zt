s ::= import "./schema.zt";
h ::= import "./helpers.zt";

item :: s.Item = (h.task "01a1d4ef-2383-70fa-88a9-81383f9f491b" "zenoh-rmw-graph-reader-repair" "zenoh-transport"
  "Repair the reader of the rmw graph exam so it sees the first line a test prints"
  "The checker reads the graph exam's Rust output with `exam_lines_graph`, which keeps a line only when it starts with `[zenoh-exam] graph `. With `--nocapture`, libtest starts a test's output on the line that names the test, so the first graph line begins with `test zenoh_rmw_graph::the_rmw_graph_exam ... ` and the reader drops it. The judge then sees 105 of 106 lines and refuses an honest run. The other slices read Rust output with `exam_lines`, which searches each line for the marker and sees all of it. No implementation can pass `zenoh_rmw_graph_check` while the reader drops that line.")
  with {
    depends = { "01a1cc3c-6d0f-7a22-9b6e-4d41c0a7d9a2"; };
    owns = {
      "scripts/check/check-zenoh-profile0.py";
    };
    nonGoals = {
      h.nonGoal "Changing the graph exam's cases, controls or counts. The reader changes and nothing else." h.agentDefault;
      h.nonGoal "Changing any other slice's reader. Every other slice already reads Rust output with `exam_lines`." h.agentDefault;
      h.nonGoal "Moving the rmw exams out of `check-zenoh-profile0.py`." h.agentDefault;
    };
    requirements = {
      h.req "graph-reader-sees-every-line"
        "Given Rust output in which libtest starts the first graph line after the test name on one line, `exam_lines_graph` returns every graph line, so a run of 106 lines is read as 106."
        { "zenoh_rmw_graph_check"; };
    };
    acceptance = {
      h.observedWhere "zenoh_rmw_graph_check" {
        h.count "casesObserved" 106;
        h.count "negativeControlsRefused" 196;
      };
    };
    decisions = {
      h.decided "the-reader-reuses-exam-lines"
        "`exam_lines_graph` keeps the graph lines of `exam_lines` and adds no matching rule of its own."
        "the other slices read the same output with `exam_lines`, and a second rule is what dropped the line"
        h.agentDefault
        { "graph-reader-sees-every-line"; };
    };
  };

item
