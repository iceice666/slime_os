s ::= import "./schema.zt";
h ::= import "./helpers.zt";

item :: s.Item = (h.task "01a1c858-c278-7934-9c02-cdf9f35e4860" "system-spec-check-shards" "quality"
  "Split the system-spec check across CI jobs so it stops bounding main's critical path"
  "The CI job \"System specs and system-image closures\" is the critical path of every main run that runs the seL4 jobs. Runs 1020, 1023 and 1036 took 3317, 3523 and 3368 s from the first job starting to the CI aggregate finishing, and that one job took 3296 to 3499 s of it. Inside its main step, scripts/check/check-system-spec.py took 2370 to 2481 s, compiling 78 systems and refusing 214 named mutations and 18 computed-source controls; check-system-image-builder.py took about 440 s. The job's Zutai evaluation store was cold in all three runs: a store key covers every contracts .zt file, so one contract change misses every entry, and run 1036's 349 hits were what a cancelled run had stored. One host cannot run the check much faster: each of the 78 schema checks takes 36 to 105 s and 4.2 GB, so at most 3 fit at once in a 16 GB runner, and system-spec-check-parallel only stops the kernel from killing a fourth. The change: give check-system-spec.py a shard index and count, as check-generation-v5.py has, so that the shards together run exactly the systems, mutations and controls the unsharded check runs, and run its shards as parallel CI jobs ahead of the image-builder check.")
  with {
    intent = #active;
    owns = {
      ".github/workflows/**";
    };
    nonGoals = {
      h.nonGoal "Removing or weakening any system, mutation or control the check runs today, or changing what it asserts." h.agentDefault;
      h.nonGoal "Changing the Zutai evaluation store, the build-output or Nix caches, or the contract-source job." h.agentDefault;
    };
    requirements = {
      h.req "same-assertions"
        "Running every shard of check-system-spec.py for one shard count runs each system's own checks, each named mutation and each control exactly once across the shards; a shard also compiles the systems its controls derive from. The unsharded run (shard 0 of 1) runs every check the unsharded check ran before this item. image_builder_closures_check runs what system_image_builder_check runs except the system-spec check."
        { "system_spec_check"; "system_image_builder_check"; "image_builder_closures_check"; };
      h.req "off-critical-path"
        "In main's CI, the system-spec check runs as parallel shard jobs, the check step of every shard but shard 0 takes at most 900 s, and the CI critical path takes at most 1800 s; the image-builder job no longer runs the unsharded system-spec check."
        { "critical-path-observed"; };
    };
    acceptance = {
      h.observed "system_spec_check";
      h.observed "system_image_builder_check";
      h.observed "image_builder_closures_check";
      h.human "critical-path-observed"
        "Reading 3 consecutive main-branch CI runs after the implementation merged that ran the seL4 jobs to success: did the check step of every system-spec shard but shard 0 take at most 900 s in each, did the image-builder job run without the unsharded system-spec check, and did the slowest run take at most 1800 s from its first job starting to the CI aggregate finishing? Note the last run's URL.";
    };
    decisions = {
      h.decided "grader-first"
        "The shard arguments of check-system-spec.py and the just recipe that passes them land in a planning pull request before the implementation pull request, which changes only .github/workflows/"
        "the checker and the recipe are the grader set of system_spec_check and system_image_builder_check, which V3 keeps out of an implementation pull request and V4 gives to a human approval"
        h.agentDefault
        { "same-assertions"; };
      h.decided "identity-per-shard"
        "A shard asserts distinct identities among the systems it compiles, not across shards"
        "an identity hashes the normalized spec, whose name compile_system binds to the file stem, and two system files cannot share a stem; comparing across shards would make every shard compile all 78 systems"
        h.agentDefault
        { "same-assertions"; };
      h.decided "time-bounds"
        "The check step of every shard but shard 0 is bounded at 900 s, and the critical path at 1800 s; shard 0 is bounded only by the critical path"
        "shard 0 also runs generate-generation-from-spec.py --check, which evaluates all 78 systems while the shard's store holds its own 20; in CI run 1051, the first main run with shard jobs, shard 0's step took 1438 s, shards 1 to 3 took 863, 785 and 294 s, and the critical path took 1677 s"
        (h.fromHuman "照 2 開 planning PR" "Claude Code session session_01Udthewm8RwFz3LWFnV5Vji, 2026-11-11, choosing option 2: bound every shard but shard 0 at 900 s and keep the 1800 s critical-path bound")
        { "off-critical-path"; "critical-path-observed"; };
    };
  };

item
