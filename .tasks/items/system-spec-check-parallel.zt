s ::= import "./schema.zt";
h ::= import "./helpers.zt";

item :: s.Item = (h.task "01a1c957-47f3-7e68-a2c3-ce16ed194835" "system-spec-check-parallel" "quality"
  "Evaluate the system-spec check's independent evaluations in parallel"
  "check-system-spec.py runs most of its Zutai evaluations one at a time. It warms only each system's schema check, then projects each of the 78 systems serially, and renders the 6 computed sources 54 times, one at a time, through an adapter whose output is not stored. A cold profile on 4 CPUs spent about 1235 s in serial projections and 735 s in renders, out of 4114 s. The change: warm both evaluations of each system at once, and render the computed sources in parallel within a memory budget, without changing what any evaluation asserts.")
  with {
    owns = {
      ".github/workflows/ci.yml";
    };
    nonGoals = {
      h.nonGoal "Splitting the check across CI jobs; system-spec-check-shards owns that." h.agentDefault;
      h.nonGoal "Changing the Zutai evaluation store, its key, or the adapter that renders a computed source." h.agentDefault;
    };
    requirements = {
      h.req "same-refusals"
        "check-system-spec.py runs every system, named mutation and control it ran before this item, and a refused source reports the same diagnostic text in the same order as a serial run reports it."
        { "system_spec_check"; };
    };
    acceptance = {
      h.observed "system_spec_check";
    };
    decisions = {
      h.decided "planning-only"
        "The checker change lands in the planning pull request that adds this item; an implementation pull request changes only the CI workflow, to set SLIME_ZUTAI_JOBS where a runner's memory needs it"
        "check-system-spec.py and scripts/lib/system_spec.py are the grader set of system_spec_check, which V3 keeps out of an implementation pull request"
        h.agentDefault
        { "same-refusals"; };
      h.decided "render-memory-budget"
        "Each parallel computed-source render is budgeted 4.5 GiB of available memory; the worker count is the smaller of the CPU count and MemAvailable divided by that budget, and SLIME_ZUTAI_JOBS overrides it"
        "one render peaked near 3.7 GB of resident memory, and four renders at once on a 16 GB host exceeded the memory limit, so the kernel killed one and a control failed with an empty diagnostic"
        h.agentDefault
        { "same-refusals"; };
    };
  };

item
