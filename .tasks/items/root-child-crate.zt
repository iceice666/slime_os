s ::= import "./schema.zt";
h ::= import "./helpers.zt";

item :: s.Item = (h.task "01a1ed2c-6a01-7d68-84f5-f3057766f1ab" "root-child-crate" "planes-mechanism"
  "The fixture's child program is a crate outside slime-root/"
  "slime-root/child/ holds the program that the root fixture loads as its child task. It is a crate of its own, it builds for another target than the root, and it runs without the root's authority. root_size_check still counts its 390 code lines as root source, in the fixture role of 950. docs/decisions/root-task-scope.md lets the fixture role leave the root in two steps, and this crate is the first.")
  with {
    owns = {
      "slime-root/child/**";
      "components/root-child/**";
      "slime-root/src/main.rs";
      "scripts/build/build-sel4.py";
      "just/quality.just";
      "contracts/system-image-closure/v3/closures/**";
    };
    nonGoals = {
      h.nonGoal "A change to what the child program does. The crate moves, and no line of its source changes." h.agentDefault;
      h.nonGoal "A change to the root's code. In slime-root/src/main.rs only the comments that name the crate's path change." h.agentDefault;
      h.nonGoal "A new name for the package. It stays slime-root-child, so no artifact name and no pin changes." h.agentDefault;
      h.nonGoal "The root side of the fixture, slime-root/src/fixture_runtime.rs. It leaves when the library holds the boot sequence of main." h.agentDefault;
      h.nonGoal "The child image that every root embeds. The product root still links it until the fixture is a root binary of its own." h.agentDefault;
      h.nonGoal "Lower ceilings in scripts/check/check-root-size.py. The checker grades promises, so it changes only with a new item (V4). The planning pull request of the next root item lowers them." h.agentDefault;
    };
    requirements = {
      h.req "fixture-role-without-the-child"
        "root_size_check counts at most 600 code lines in the fixture role, and reports the count as fixtureCodeLines."
        { "root_size_check"; };
      h.req "series-without-the-child"
        "root_size_check counts at most 34010 code lines in the nine series roles, and reports the count as seriesCodeLines."
        { "root_size_check"; };
      h.req "fixture-boots-on-aarch64"
        "sel4_root_boot_check passes: the root fixture boots on qemu-arm-virt with the child built from its new place."
        { "sel4_root_boot_check"; };
      h.req "fixture-boots-on-x86-64"
        "x86_64_sel4_root_boot_check passes: the root fixture boots on qemu-pc99 with the child built from its new place."
        { "x86_64_sel4_root_boot_check"; };
      h.req "fixture-boots-on-riscv64"
        "riscv64_qemu_check passes: the root fixture boots on qemu-riscv-virt with the child built from its new place."
        { "riscv64_qemu_check"; };
      h.req "closures-name-the-new-place"
        "system_image_closure_gates_check passes: every closure source names the child crate's tree at its new place, and no closure source is stale."
        { "system_image_closure_gates_check"; };
    };
    acceptance = {
      h.observedWhere "root_size_check" {
        h.atMost "fixtureCodeLines" 600;
        h.atMost "seriesCodeLines" 34010;
      };
      h.observed "sel4_root_boot_check";
      h.observed "x86_64_sel4_root_boot_check";
      h.observed "riscv64_qemu_check";
      h.observed "system_image_closure_gates_check";
    };
    decisions = {
      h.decided "components-root-child"
        "The crate moves to components/root-child/."
        "scripts/lib/component_paths.py requires each crate under components/testkit/ to declare exactly one [[bin]], and component_crate_split_check holds each to the shape of a component. The child is no component: it is a workspace of its own and uses no component runtime"
        h.agentDefault
        { "fixture-role-without-the-child"; };
      h.decided "bounds-from-the-count-on-main"
        "The fixture bound is 600 and the series bound is 34010."
        "on main at 676b9d8 the fixture role holds 950 lines and the series 34331. The child holds 390. 950 less 390 is 560, rounded up to a multiple of 50 as the ceilings are. 34010 is the series ceiling of 34400 less 390"
        h.agentDefault
        { "fixture-role-without-the-child"; "series-without-the-child"; };
      h.decided "ci-environment-first"
        "A process pull request lets .github/actions/slime-env fetch the child's crates from either place, before the implementation pull request moves the crate. A second one removes the old place after it."
        "the action runs cargo fetch on slime-root/child/Cargo.toml, a pull request runs the action of its own head, and a pull request carries one class (V1): .github/ is a process path"
        h.agentDefault
        { "fixture-boots-on-aarch64"; };
      h.decided "generator-finds-either-place"
        "The planning pull request of this item makes scripts/generate/generate-system-image-closures.py name the child crate's tree at whichever place holds it. The implementation pull request moves the crate and regenerates the closure sources. The planning pull request of the next root item removes the old place from the generator."
        "the generator is in the grader set of system_image_closure_gates_check, which promises in specs/contracts.zt bind, so it changes only in a pull request that adds an item (V4). The crate is product code, which a planning pull request cannot move (V1)"
        h.agentDefault
        { "closures-name-the-new-place"; };
      h.decided "a-task-not-a-milestone"
        "This item is a task."
        "it moves one crate and changes no behavior. The owner confirmed four items in place of one testability milestone in the session of 2026-11-18. The kind of this one is the agent's choice"
        h.agentDefault
        { "fixture-role-without-the-child"; };
    };
  };

item
