{
  schema = "dev-spec/v1";
  problem = "After a service restarts under a fresh epoch, a client holding a handle minted under the predecessor epoch must be refused on every operation, and the predecessor's queued completions must never be delivered. Today the plane gate asserts only that the restart marker chain completes, so an implementation that lets one stale handle through still passes it.";
  scope = [
    "Bound stale-handle rejection to counted observations on the existing lifecycle-restart plane (scripts/check/check-sel4-lifecycle-restart-plane.py) rather than to the plane's exit code.";
    "Ownership: the restart path in slime-root/src/task.rs and slime-root/src/supervision.rs, and the plane checker's counting of refusal markers.";
  ];
  nonGoals = [
    "Transparent reconnection or replay of in-flight requests across a restart.";
    "Physical-machine evidence; the plane is AArch64 seL4 under QEMU.";
  ];
  requirements = [
    {
      id = "stale-refused";
      statement = "Every operation attempted with a predecessor-epoch handle after the successor is ready is refused with the stale-epoch error, and the refusal is observable on the serial transcript as one counted marker per attempt.";
      acceptance = [
        "stale-refused-counted";
      ];
    };
    {
      id = "controls-hold";
      statement = "The plane's negative controls -- a missing refusal marker, a reordered restart chain, and an explicit failure marker -- each cause the gate to fail, so a passing gate is evidence of rejection rather than of a quiet transcript.";
      acceptance = [
        "controls-refused";
      ];
    };
    {
      id = "plane-passes";
      statement = "The lifecycle-restart plane still reaches its terminal marker with the successor serving fresh handles after the stale ones were refused.";
      acceptance = [
        "plane-passed";
      ];
    };
  ];
  predicates = [
    {
      id = "four-stale-attempts-refused";
      kind = "equal";
      observation = "staleHandlesRejected";
      expected = {
        kind = "int";
        intValue = 4;
        boolValue = false;
        textValue = "";
      };
      lower = 0;
      upper = 0;
      lowerInclusive = false;
      upperInclusive = false;
      members = [];
    };
    {
      id = "at-least-three-controls";
      kind = "bounds";
      observation = "negativeControlsRefused";
      expected = {
        kind = "int";
        intValue = 0;
        boolValue = false;
        textValue = "";
      };
      lower = 3;
      upper = 64;
      lowerInclusive = true;
      upperInclusive = true;
      members = [];
    };
    {
      id = "recipe-passed";
      kind = "equal";
      observation = "passed";
      expected = {
        kind = "bool";
        intValue = 0;
        boolValue = true;
        textValue = "";
      };
      lower = 0;
      upper = 0;
      lowerInclusive = false;
      upperInclusive = false;
      members = [];
    };
    {
      id = "stale-and-passed";
      kind = "all";
      observation = "";
      expected = {
        kind = "bool";
        intValue = 0;
        boolValue = false;
        textValue = "";
      };
      lower = 0;
      upper = 0;
      lowerInclusive = false;
      upperInclusive = false;
      members = [
        "four-stale-attempts-refused";
        "recipe-passed";
      ];
    };
  ];
  acceptance = [
    {
      id = "stale-refused-counted";
      rationale = "The plane fixture makes exactly four attempts with predecessor handles after the successor's ready marker; the checker counts the refusal markers it matched and reports the count. Four is the number the fixture makes, not a lower bound: a fifth refusal means an attempt the fixture does not make, a third means one got through.";
      gate = "just-observations";
      mode = "automated";
      mandatory = true;
      predicate = "stale-and-passed";
    };
    {
      id = "controls-refused";
      rationale = "The checker runs its own mutation controls -- missing marker, reordered chain, explicit failure -- against the captured transcript and reports how many it refused. The bound is inclusive at three so a checker that drops a control is caught; the upper bound is a sanity limit, not a target.";
      gate = "just-observations";
      mode = "automated";
      mandatory = true;
      predicate = "at-least-three-controls";
    };
    {
      id = "plane-passed";
      rationale = "The recipe's exit code, reported by the gate adapter rather than by the checker, so a checker cannot vouch for itself.";
      gate = "just-observations";
      mode = "automated";
      mandatory = true;
      predicate = "recipe-passed";
    };
  ];
}
